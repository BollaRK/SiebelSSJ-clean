			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetTransferNumberDetails"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mGetTransferNumberDetails(sCustAccntId,sMSISDN,sOrderId)
{
	try
		{
			var sTranNumBO = TheApplication().GetBusObject(&quot;VF MNP Transfer Number Request&quot;);
			var sTranNumBC = sTranNumBO. GetBusComp(&quot;VF Transfer Number Request - Without BC Read Prop&quot;);
			var sExistCarrierAccntNum =&quot;&quot;;
			if((sCustAccntId != &quot;&quot; &amp;&amp; sCustAccntId != null) &amp;&amp; (sMSISDN != &quot;&quot; &amp;&amp; sMSISDN != null) &amp;&amp; (sOrderId != &quot;&quot; &amp;&amp; sOrderId != null))
			{
				with(sTranNumBC)
				{
					ActivateField(&quot;AccountReferenceNumber&quot;);
					ActivateField(&quot;CustomerDOB&quot;);
					ClearToQuery();
					SetViewMode(AllView);
					SetSearchExpr(&quot;[Customer Account Id] = &apos;&quot;+sCustAccntId+&quot;&apos; AND [MSISDN] = &apos;&quot;+sMSISDN+&quot;&apos; AND [Connect Order Id] = &apos;&quot;+sOrderId+&quot;&apos; AND ([Status Summary] = &apos;Open&apos; OR [Status] = &apos;Complete&apos;) AND [Transfer Type] = &apos;External Port&apos;&quot;);
					ExecuteQuery(ForwardOnly);
					if(FirstRecord())
					{
						if(GetFieldValue(&quot;AccountReferenceNumber&quot;) != &quot;&quot; &amp;&amp; GetFieldValue(&quot;AccountReferenceNumber&quot;) != null)
							sExistCarrierAccntNum = GetFieldValue(&quot;AccountReferenceNumber&quot;);
						else if (GetFieldValue(&quot;CustomerDOB&quot;) != &quot;&quot; &amp;&amp; GetFieldValue(&quot;CustomerDOB&quot;) != null)
							sExistCarrierAccntNum = GetFieldValue(&quot;CustomerDOB&quot;);
					}
				}
			}
			return (sExistCarrierAccntNum);
		}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		sTranNumBC = null;
		sTranNumBO = null;
	}
}"
