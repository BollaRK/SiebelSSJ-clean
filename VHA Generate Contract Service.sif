			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mDeleteExistingContract"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/* 
 * Component Name        : 	Delete Existing NSA Contract
 * Method Name           : 	DeleteExistingContract
 * Component Information : 	This function will delete the existing NSA
 *							contract
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 17/07/2020	Saravanan J				Initial Version
 */
function mDeleteExistingContract(Inputs,Outputs)
{
	try
	{
		var sBO = TheApplication().GetBusObject(&quot;VHA Contract Doc Object&quot;);
		var sBCHeader = sBO.GetBusComp(&quot;VHA Contract Doc Header&quot;);
		var sBCAttch = sBO.GetBusComp(&quot;Order Entry Attachment (Simple)&quot;);
		//var sBCService = sBO.GetBusComp(&quot;VHA Contract Doc Service&quot;);
		var sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
		var sAttachmentName = &quot;&quot;;
		var NSADocName = TheApplication().InvokeMethod(&quot;LookUpValue&quot;,&quot;VHA_NSA_DOC_NAME&quot;,&quot;NSADocName|NSAVoiceMBB&quot;);
		var NBNDocName = TheApplication().InvokeMethod(&quot;LookUpValue&quot;,&quot;VHA_NSA_DOC_NAME&quot;,&quot;NSADocName|NBNNSA&quot;);
		var PrepayDocName = TheApplication().InvokeMethod(&quot;LookUpValue&quot;,&quot;VHA_NSA_DOC_NAME&quot;,&quot;AU_Prepay_FORM&quot;);
		//var sFBBOnly = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_FBB_PROPOSITION_TYPE&quot;,&quot;FBB Only&quot;);
		//var sFBBwithMBB = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_FBB_PROPOSITION_TYPE&quot;,&quot;FBB with MBB&quot;);
		//var sSiebelProdType = &quot;&quot;;

		with(sBCHeader)
		{
			ActivateField(&quot;Generate Contract Flag&quot;);
			SetViewMode(AllView);
			ClearToQuery();
			SetSearchSpec(&quot;Id&quot;, sOrderId);
			ExecuteQuery(ForwardOnly);
			if(FirstRecord())
			{
				with(sBCAttch)
				{					
					ActivateField(&quot;Order Id&quot;);
					ActivateField(&quot;OrderFileName&quot;);
					SetViewMode(AllView);
					ClearToQuery();
					SetSearchSpec(&quot;Order Id&quot;, sOrderId);
					ExecuteQuery(ForwardBackward);
					var iRec = FirstRecord();					
					while(iRec)
					{
						sAttachmentName = GetFieldValue(&quot;OrderFileName&quot;);
						if(sAttachmentName.indexOf(NSADocName) &gt;= 0 || sAttachmentName.indexOf(NBNDocName) &gt;= 0 || sAttachmentName.indexOf(PrepayDocName) &gt;= 0)
						{
							DeleteRecord();
							iRec = FirstRecord();
						}
						else
							iRec = NextRecord();
					}
				}//with(sBCAttch)

			/*	with(sBCService)
				{
					ActivateField(&quot;Siebel Product Type&quot;);
					ActivateField(&quot;Order Id&quot;);
					SetViewMode(AllView);
					ClearToQuery();
					SetSearchSpec(&quot;Order Id&quot;, sOrderId);
					ExecuteQuery(ForwardOnly);
					if(FirstRecord())
					{
						sSiebelProdType = GetFieldValue(&quot;Siebel Product Type&quot;);
						if(sSiebelProdType == sFBBOnly || sSiebelProdType == sFBBwithMBB)
						{
							Outputs.SetProperty(&quot;TransactionType&quot;,&quot;ConnectNBN&quot;);
						}							
					}
				}//with(sBCService)*/

				SetFieldValue(&quot;Generate Contract Flag&quot;, &quot;N&quot;);
				WriteRecord();
			}
		}//with(sBCHeader)
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		sBCAttch = null;
		//sBCService = null;
		sBCHeader = null;
		sBO = null;
	}
}"
