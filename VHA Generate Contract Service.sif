			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="Service_PreInvokeMethod"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function Service_PreInvokeMethod (MethodName, Inputs, Outputs)
{
	try
	{
		switch(MethodName)
		{
			case &quot;WaiveETC&quot;:
				var sWaive = fnCheckWaiveOff(Inputs.GetProperty(&quot;CurrPlanId&quot;), Inputs.GetProperty(&quot;NewPlanSAMID&quot;), Inputs.GetProperty(&quot;OfferType&quot;));
				Outputs.SetProperty(&quot;Waive&quot;, sWaive);
			break;

			case &quot;AssociatePrice&quot;:
				fnAssociatePrice(Inputs, Outputs);
			break;

			case &quot;AssociateServiceDetails&quot;:
				fnAssociateServiceDetails(Inputs, Outputs);
			break;

			case &quot;GetServiceDetails&quot;:
				fnGetServiceDetails(Inputs, Outputs);
			break;
		
			case &quot;RearrangeSiebMsg&quot;:
				fnRearrangeSiebMsg(Inputs, Outputs);
			break;
			
			case &quot;GetProgressiveDiscount&quot;:
				mGetProgressiveDiscount(Inputs,Outputs);
			break;
			
			case &quot;GetSalesPersonName&quot;:
				fnGetSalesPersonName(Inputs,Outputs);
			break;			
			
			case &quot;GetTotalMonthlyCost&quot;:
				if(TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_NSA_DISP_TOTAL&quot;,&quot;Display Total&quot;) == &quot;Y&quot;)
					fnGetTotalMonthlyCost(Inputs,Outputs);
			break;
			
			case &quot;GetNSAEmailDetails&quot;:
				fnGetNSAEmailDetails(Inputs,Outputs);
			break;

			case &quot;GetNSAQuoteEmailDetails&quot;:
				fnGetNSAQuoteEmailDetails(Inputs,Outputs);
			break;

			case &quot;GetSSJQuoteEmailDetails&quot;:
				fnGetSSJQuoteEmailDetails(Inputs,Outputs);
			break;

			case &quot;GetDiscountPrice&quot;:
				fnGetDiscountPrice(Inputs,Outputs);
			break;

			case &quot;DeleteExistingContract&quot;:
				mDeleteExistingContract(Inputs,Outputs);
			break;

			case &quot;CopyFile&quot;:
				mCopyFile(Inputs,Outputs);
			break;

			case &quot;GetNSAEmailInputs&quot;:
				mGetNSAEmailInputs(Inputs,Outputs);
			break;

			case &quot;GenerateNSAContract&quot;:
				mGenerateNSAContract(Inputs,Outputs);
			break;

			case &quot;GetSIM&quot;:
				mGetSIM(Inputs,Outputs);
			break;

			case &quot;GenerateNSAContractForUpgrade&quot;:
				fnTSUpgradeGenerateNSAContract(Inputs,Outputs);
			break;

			case &quot;TSUpgradeMapServiceDetails&quot;:
				fnTSUpgradeMapServiceDetails(Inputs,Outputs);
			break;

			case &quot;GetRatePlanAttrValuesFromProduct&quot;:
				mGetRatePlanAttrValuesFromProduct(Inputs,Outputs);
			break;
			
			case &quot;ValidatePegaProduct&quot;:
				mValidatePegaProduct(Inputs,Outputs);
			break;
			
			default:
			break;
		}
		return (CancelOperation);
	}
	catch(e)
	{
		throw e;
	}
	finally
	{
	}
	return (ContinueOperation);
}"
			   SEQUENCE="49"
