			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fnGetNSAQuoteEmailDetails"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function fnGetNSAQuoteEmailDetails(Inputs,Outputs)
{
	try
	{
		var sRowId = Inputs.GetProperty(&quot;RowId&quot;);
		var sQuoteId = Inputs.GetProperty(&quot;QuoteId&quot;);
		var sQuoteNum = Inputs.GetProperty(&quot;QuoteNumber&quot;); // TULASIY:07May2024::Created for QuoteNo Attachment Change

		var sParentBO = TheApplication().GetBusObject(&quot;Quote Attachment&quot;);
		var	sAttachmentBC = sParentBO.GetBusComp(&quot;Quote Attachment&quot;);

		var sAttachName = &quot;&quot;, sEmailTempName = &quot;&quot;, sAttachFile = &quot;&quot;, sAbsoluteFilePath = &quot;&quot;,sQuoteAttCreated = &quot;&quot;;
		
		with(sAttachmentBC)
		{
			ClearToQuery();   
			SetViewMode(AllView);
			ActivateField(&quot;QuoteFileName&quot;);
			ActivateField(&quot;Created&quot;);
			ActivateField(&quot;Quote Id&quot;);
			SetSearchSpec(&quot;Id&quot;, sRowId);
			SetSortSpec(&quot;Created (DESC)&quot;);
			ExecuteQuery(ForwardOnly);
			var isrec = FirstRecord();
			if(isrec)
			{
				sQuoteAttCreated = GetFieldValue(&quot;Created&quot;);
				sAttachName = GetFieldValue(&quot;QuoteFileName&quot;);
				sEmailTempName = &quot;VHA NSA Sales Calculator&quot;;

				sAttachFile = InvokeMethod(&quot;GetFile&quot;, &quot;QuoteFileName&quot;);
				sAbsoluteFilePath = sAttachFile.substring(sAttachFile.indexOf(&quot;,&quot;) + 1);
			}
		}
		sQuoteAttCreated = new Date(sQuoteAttCreated);
		var sMonth = ToString(sQuoteAttCreated.getMonth() + 1); 
	  if (sMonth.length == 1) {sMonth = &quot;0&quot; + sMonth;}
	
	  var sDay = ToString(sQuoteAttCreated.getDate()); 
	  if (sDay.length == 1) {sDay = &quot;0&quot; + sDay;}
	
	  var sHours = ToString(sQuoteAttCreated.getHours()); 
	  if (sHours.length == 1) {sHours = &quot;0&quot; + sHours;}
	
	  var sMinutes = ToString(sQuoteAttCreated.getMinutes()); 
	  if (sMinutes.length == 1) {sMinutes = &quot;0&quot; + sMinutes;}
	
	  var sSeconds = ToString(sQuoteAttCreated.getSeconds()); 
	  if (sSeconds.length == 1) {sSeconds = &quot;0&quot; + sSeconds;}
	
	  sQuoteAttCreated =  (sDay +sMonth +sQuoteAttCreated.getFullYear() +  sHours  + sMinutes + sSeconds);

		//sQuoteAttCreated = (ToString(sQuoteAttCreated.getDate())+ToString(sQuoteAttCreated.getMonth()+1)+ToString(sQuoteAttCreated.getFullYear())+ToString(sQuoteAttCreated.getHours())+ToString(sQuoteAttCreated.getMinutes())+ToString(sQuoteAttCreated.getSeconds()));
		sAttachName = &quot;Quote_&quot; +sQuoteNum+ &quot;_FORM&quot; + sQuoteAttCreated +  &quot;.pdf&quot;; // TULASIY:07May2024::Created for QuoteNo Attachment Change
		TheApplication().SetProfileAttr(&quot;TestDate&quot;,sQuoteAttCreated + sAttachName);
		Outputs.SetProperty(&quot;EmailTemplateName&quot;, sEmailTempName);
		Outputs.SetProperty(&quot;AttachFileList&quot;, sAbsoluteFilePath);
		Outputs.SetProperty(&quot;AttachNameList&quot;, sAttachName);
	}
	catch(e)
	{
		throw(e);
	}
	finally	{
		sAttachmentBC = null;
		sParentBO = null;
	}
}"
