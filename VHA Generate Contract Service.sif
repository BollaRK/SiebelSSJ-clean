			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fnGetSDInsurance"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function fnGetSDInsurance(sService, aSerIndex, aSDIndex, aSDId, aSDInsId, aSDIns)
{
	try
	{
		for(var i=0; i &lt; aSDId.length; i++)
		{
			for(var j=0; j &lt; aSDInsId.length; j++)
			{
				if(aSDId[i] == aSDInsId[j])
				{
					sService.GetChild(aSerIndex[i]).GetChild(aSDIndex[i]).SetProperty(&quot;SD Insurance&quot;, aSDIns[j]);
					break;
				}
			}
		}
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
	}
}"
