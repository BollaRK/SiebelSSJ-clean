			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetSIMDetails"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mGetSIMDetails(Inputs,Outputs)
{
	try
	{
		var sOrdBO,sOrdItemBC,sSIMNumber=&quot;&quot;,sOrderItemId,sOrderId,sSIMBC = &quot;&quot;, sOrderFunction = &quot;&quot;, OrderSubTypeTBUI = &quot;&quot;;
		var sAssetIntId,sAssetBO,sSIMRelBC,sAssetBC = &quot;&quot;;
		
		var sOrderTyp = Inputs.GetProperty(&quot;OrderType&quot;);
		sOrderFunction = Inputs.GetProperty(&quot;Order Function&quot;);
		sAssetIntId = Inputs.GetProperty(&quot;CustAssetIntId&quot;);
		sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
		sOrderItemId = Inputs.GetProperty(&quot;OrderItemId&quot;);
		OrderSubTypeTBUI = Inputs.GetProperty(&quot;OrderSubTypeTBUI&quot;);
		
		sOrdBO = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
		sOrdItemBC = sOrdBO.GetBusComp(&quot;Order Entry - Line Items&quot;);
		sSIMBC = sOrdBO.GetBusComp(&quot;VF Order Entry - SIM - IMSI&quot;);
		sAssetBO = TheApplication().GetBusObject(&quot;VF Asset&quot;);
		sAssetBC = sAssetBO.GetBusComp(&quot;Asset Mgmt - Asset - Header&quot;);
		sSIMRelBC = sAssetBO.GetBusComp(&quot;VF Resource Mgmt - SIM - IMSI&quot;);
		
		if(sOrderFunction == &quot;UPGRADE&quot; || sOrderFunction == &quot;Upgrade&quot; || sOrderTyp ==&quot;TOT&quot; || OrderSubTypeTBUI == &quot;New APP&quot;)
		{
			with(sAssetBC)
			{
				SetViewMode(AllView);
				ClearToQuery();
				SetSearchSpec(&quot;Integration Id&quot;, sAssetIntId);
				ExecuteQuery(ForwardOnly);
				if(FirstRecord())
				{
					with(sSIMRelBC)
					{
						ActivateField(&quot;Asset Number&quot;);
						ClearToQuery();   
						SetViewMode(AllView);
						SetSearchExpr(&quot;[Product Type] = &apos;SIM&apos;&quot;);
						ExecuteQuery(ForwardOnly);
						if(FirstRecord())
						{
							sSIMNumber = GetFieldValue(&quot;Asset Number&quot;);
						}
					}
				}
			}
		}
		else
		{
			if(sOrderItemId != &quot;&quot; &amp;&amp; sOrderItemId != null)
			{
				with(sOrdItemBC)
				{
					ClearToQuery();
					SetViewMode(AllView);
					SetSearchSpec(&quot;Id&quot;,sOrderItemId);
					ExecuteQuery(ForwardOnly);
					if(FirstRecord())
					{
						with(sSIMBC)
						{
							ActivateField(&quot;Asset Number&quot;);
							ClearToQuery();
							SetViewMode(AllView);
							SetSearchExpr(&quot;[Product Type] = &apos;SIM&apos;&quot;);
							ExecuteQuery(ForwardOnly);
							if(FirstRecord())
							{
								sSIMNumber = GetFieldValue(&quot;Asset Number&quot;);
							}
						}
					}
				}
			}
		}
		if(sSIMNumber == &quot;&quot; || sSIMNumber ==null)
		{
			sSIMNumber = &apos;NA&apos;;
		}
		
		Outputs.SetProperty(&quot;SIM&quot;,sSIMNumber);
		return sSIMNumber;
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		sSIMBC = null;
		sOrdItemBC = null;
		sOrdBO = null;
		sSIMRelBC = null;
		sAssetBC = null;
		sAssetBO = null;
	}
}"
			   SEQUENCE="42"
			   UPDATED="09/03/2025 17:18:13"
			   UPDATED_BY="SUMA"
			   CREATED="11/06/2019 14:56:32"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetSIMDetailsfromAsset"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mGetSIMDetailsfromAsset(Inputs,Outputs){
try
	{
		var sSIMNumber = &quot;NA&quot;;
		var sMSISDN = &quot;&quot;,sAssetBO = &quot;&quot;,sSIMRelBC = &quot;&quot;,sAssetBC = &quot;&quot;, sAssetParId = &quot;&quot;;
		
		var sOrderTyp = Inputs.GetProperty(&quot;OrderType&quot;);
		sMSISDN = Inputs.GetProperty(&quot;MSISDN&quot;);

		sAssetBO = TheApplication().GetBusObject(&quot;VF Resource&quot;);
		sAssetBC = sAssetBO.GetBusComp(&quot;VF Resource Mgmt - MSISDN Relationship&quot;);
		sSIMRelBC = sAssetBO.GetBusComp(&quot;VF Resource Mgmt - SIM Relationship&quot;);
		
		if(sOrderTyp == &quot;TOT&quot; &amp;&amp; sMSISDN != &quot;&quot; &amp;&amp; sMSISDN != null)
		{		
			with(sAssetBC)
			{
				ActivateField(&quot;Asset Number&quot;);
				ActivateField(&quot;Parent Asset Id&quot;);
				ActivateField(&quot;Status&quot;);
				SetViewMode(AllView);
				ClearToQuery();
				SetSearchSpec(&quot;Asset Number&quot;, sMSISDN);
				SetSearchSpec(&quot;Status&quot;, &quot;Active&quot;);
				ExecuteQuery(ForwardOnly);
				if(FirstRecord())
				{
					sAssetParId = GetFieldValue(&quot;Parent Asset Id&quot;);

					with(sSIMRelBC)
					{
						ActivateField(&quot;Asset Number&quot;);
						ActivateField(&quot;Parent Asset Id&quot;);
						ActivateField(&quot;Status&quot;);
						ClearToQuery();   
						SetViewMode(AllView);
						SetSearchSpec(&quot;Parent Asset Id&quot;, sAssetParId);
						SetSearchSpec(&quot;Status&quot;, &quot;Active&quot;);
						ExecuteQuery(ForwardOnly);
						if(FirstRecord())
						{
							sSIMNumber = GetFieldValue(&quot;Asset Number&quot;);	
						}
					}
				}
			}
		}
		
		Outputs.SetProperty(&quot;SIM&quot;,sSIMNumber);
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		sSIMRelBC = null;
		sAssetBC = null;
		sAssetBO = null;
	}
}"
