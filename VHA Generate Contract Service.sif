			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fnRearrangeSiebMsg"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function fnRearrangeSiebMsg(Inputs, Outputs)
{
	try
	{
		var sSiebMsg = TheApplication().NewPropertySet();
		var sTempMsg = TheApplication().NewPropertySet();
		var sListService = TheApplication().NewPropertySet();
		var sService = TheApplication().NewPropertySet();
		var ListOfDevice = TheApplication().NewPropertySet();
		var ListOfDevCharge = TheApplication().NewPropertySet();//NDC
		var ListOfSecondaryDevice = TheApplication().NewPropertySet();
		var ListOfAccessory = TheApplication().NewPropertySet();
		var ListOfRollOverPrepay = TheApplication().NewPropertySet();
		var ListOfAddOn = TheApplication().NewPropertySet();
		var ListOfLoyaltyDiscount = TheApplication().NewPropertySet();
		var ListOfBonus = TheApplication().NewPropertySet();
		var ListOfCredit = TheApplication().NewPropertySet();
		var ListOfPreviousDiscount = TheApplication().NewPropertySet();
		
		if(Inputs.GetChildCount() &gt; 0)
		{
			Outputs.AddChild(Inputs.GetChild(0));
			sTempMsg = Inputs.GetChild(0);
			
			while(sTempMsg.GetChildCount())
			{
				if(sTempMsg.GetType() == &quot;ListOfService&quot;)
				{
					sListService = sTempMsg;
					break;
				}
				sTempMsg = sTempMsg.GetChild(0);
			}
			
			for(var i = 0; i &lt; sListService.GetChildCount(); i++)
			{
				sService = sListService.GetChild(i);			
				
				for(var j = 0; j &lt; sService.GetChildCount(); j++)
				{
					sSiebMsg.Reset();
					sSiebMsg = sService.GetChild(j).Copy();
					
					if(sSiebMsg.GetType() == &quot;ListOfDevice&quot;)
					{
						ListOfDevice = sSiebMsg.Copy();
					}
					if(sSiebMsg.GetType() == &quot;ListOfDevCharge&quot;)//added for Imagine:NDC
					{
						ListOfDevCharge = sSiebMsg.Copy();
					}
					if(sSiebMsg.GetType() == &quot;ListOfSecondaryDevice&quot;)
					{
						ListOfSecondaryDevice = sSiebMsg.Copy();
					}
					if(sSiebMsg.GetType() == &quot;ListOfAccessory&quot;)
					{
						ListOfAccessory = sSiebMsg.Copy();
					}
					if(sSiebMsg.GetType() == &quot;ListOfRollOverPrepay&quot;)
					{
						ListOfRollOverPrepay = sSiebMsg.Copy();
					}
					if(sSiebMsg.GetType() == &quot;ListOfAddOn&quot;)
					{
						ListOfAddOn = sSiebMsg.Copy();
					}
					if(sSiebMsg.GetType() == &quot;ListOfLoyaltyDiscount&quot;)
					{
						ListOfLoyaltyDiscount = sSiebMsg.Copy();
					}
					if(sSiebMsg.GetType() == &quot;ListOfBonus&quot;)
					{
						ListOfBonus = sSiebMsg.Copy();
					}
					if(sSiebMsg.GetType() == &quot;ListOfCredit&quot;)
					{
						ListOfCredit = sSiebMsg.Copy();
					}
					if(sSiebMsg.GetType() == &quot;ListOfPreviousDiscount&quot;)
					{
						ListOfPreviousDiscount = sSiebMsg.Copy();
					}
				}
				
				while(sService.GetChildCount())
				{
					sService.RemoveChild(0);
				}
				sService.AddChild(ListOfDevice);
				sService.AddChild(ListOfDevCharge);//NDC
				sService.AddChild(ListOfSecondaryDevice);
				sService.AddChild(ListOfAccessory);
				sService.AddChild(ListOfRollOverPrepay);
				sService.AddChild(ListOfAddOn);
				sService.AddChild(ListOfLoyaltyDiscount);
				sService.AddChild(ListOfBonus);
				sService.AddChild(ListOfCredit);
				sService.AddChild(ListOfPreviousDiscount);
			} // service: End
		}
	}
	catch(e)
	{
		throw e;
	}
	finally
	{
	}
}"
