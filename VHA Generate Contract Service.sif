			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fnCheckWaiveOff"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function fnCheckWaiveOff(sExistingPlanId, PlanSAMId, sUpgOfferType)
{
	var mWaiveOffETC = &quot;N&quot;, boGroupWavMTX = &quot;&quot;, bcGroupWavMTX = &quot;&quot;, sFromGroup = &quot;&quot;, sToGroup = &quot;&quot;, sTransType = &quot;UPGRADE&quot;;
	try
	{
		var sExtSAMID = GetProductSAMId(sExistingPlanId); 
		
		if (sUpgOfferType.toUpperCase() == &quot;RESIGN&quot;) // Upgrade Resign Case
		{
			sFromGroup = fnGetGroupName(sExtSAMID);
			sToGroup   = sFromGroup;
		}
		else if (sUpgOfferType.toUpperCase() == &quot;UPGRADE TO NEW PLAN&quot;) // Upgrade NewPlan Case
		{
			sFromGroup= fnGetGroupName(sExtSAMID)
			sToGroup  = fnGetGroupName(PlanSAMId)
		}
		else if (sUpgOfferType.toUpperCase() == &quot;RRP INSTALLMENT&quot;) // Upgrade Outright Case
		{ 
			sFromGroup= &quot;&quot;;
			sToGroup  = &quot;&quot;;
		}  

		if (sToGroup !=&quot;&quot; &amp;&amp; sFromGroup !=&quot;&quot;)
		{ 
			boGroupWavMTX = TheApplication().GetBusObject(&quot;VHA Freedom BO&quot;);
			bcGroupWavMTX = boGroupWavMTX.GetBusComp(&quot;VHA Plan Group Waive Matrix&quot;);
			with(bcGroupWavMTX)
			{
				ClearToQuery;
				SetViewMode(AllView);
				ActivateField(&quot;From Group&quot;);
				ActivateField(&quot;To Group&quot;);
				ActivateField(&quot;Trans Type&quot;);
				SetSearchSpec(&quot;From Group&quot;, &quot;&apos;&quot; + sFromGroup + &quot;&apos;&quot;); 
				SetSearchSpec(&quot;To Group&quot;, &quot;&apos;&quot; + sToGroup + &quot;&apos;&quot;);
				SetSearchSpec(&quot;Trans Type&quot;, &quot;= &apos;&quot; + sTransType + &quot;&apos; OR [Trans Type] = &apos;&apos;&quot;);
				ExecuteQuery(ForwardOnly);
				if (FirstRecord())
				{   
					mWaiveOffETC =&quot;Y&quot;;
				} 
			}   
		}  //End of if sToGroup !=&quot;&quot; &amp;&amp; sFromGroup !=&quot;&quot;

		return mWaiveOffETC;
	}
	catch(e)
	{
		throw e; 
	}
	finally
	{
		bcGroupWavMTX = &quot;&quot;;
		boGroupWavMTX = &quot;&quot;;
	}
}"
