			   UPDATED_BY="SUMA"
			   CREATED="08/28/2020 16:53:54"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetProductEntitlementsData"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mGetProductEntitlementsData(sProductSAMId,sGlobalProdIdent,&amp;Outputs)
{
	try
	{
		var sProdEntBO,sProdEntBC,sGigaByte=0,sByte = 0,sKiloByte =0 ,sValue=0,sMetric,IDDZone = 0,IsGBAvailable= &quot;&quot;, IDDMetric=&quot;&quot;;
		var sSrchSpec = &quot;&quot;;
		sProdEntBO = TheApplication().GetBusObject(&quot;VHA Sharing Entitlement BO&quot;);
		sProdEntBC = sProdEntBO.GetBusComp(&quot;VHA Entitlements Matrix BC&quot;);
		if((sGlobalProdIdent != &quot;&quot; &amp;&amp; sGlobalProdIdent != &quot;&quot; ) &amp;&amp; (sProductSAMId != &quot;&quot; &amp;&amp; sProductSAMId != &quot;&quot;))
		{
			if(sGlobalProdIdent == &quot;BaseData&quot; || sGlobalProdIdent == &quot;BonusData&quot;)
				sSrchSpec = &quot;[SAM Id] =&apos;&quot;+sProductSAMId+&quot;&apos; AND ([Metric] = &apos;GB&apos; OR [Metric] = &apos;MB&apos; OR [Metric] = &apos;KB&apos; OR [Metric] = &apos;B&apos;)&quot;;
			else if (sGlobalProdIdent == &quot;IDDZone1&quot;)
			 	sSrchSpec = &quot;[SAM Id] =&apos;&quot;+sProductSAMId+&quot;&apos; AND [Entitlement Type] = &apos;IDD Zone 1&apos;&quot;
			else if (sGlobalProdIdent == &quot;IDDZone2&quot;)
				sSrchSpec = &quot;[SAM Id] =&apos;&quot;+sProductSAMId+&quot;&apos; AND [Entitlement Type] = &apos;IDD Zone 2&apos;&quot;
			with(sProdEntBC)
			{
				ActivateField(&quot;Metric&quot;);
				ActivateField(&quot;Value&quot;);
				ClearToQuery();   
				SetViewMode(AllView); 
				SetSearchExpr(sSrchSpec);
				ExecuteQuery(ForwardOnly); 
				var isrec = FirstRecord();
				while(isrec)  
				{
					sMetric = GetFieldValue(&quot;Metric&quot;);
					sValue = GetFieldValue(&quot;Value&quot;);
					if(sGlobalProdIdent == &quot;BaseData&quot; || sGlobalProdIdent == &quot;BonusData&quot;)
					{
						 if(sMetric == &quot;MB&quot;)
						 	sGigaByte = sGigaByte + (1048576*sValue);
						 else if (sMetric == &quot;KB&quot;)
						 	sKiloByte = sKiloByte + sValue;
						 else if (sMetric == &quot;B&quot;)
						 	sByte = sByte + sValue;
						 else if(sMetric == &quot;GB&quot;)
						 	sGigaByte = (1073741824*ToNumber(sValue)) + ToNumber(sGigaByte);
					}
					else if(sGlobalProdIdent == &quot;IDDZone1&quot; || sGlobalProdIdent == &quot;IDDZone2&quot;)
					{
						IDDZone = sValue; 
						IDDMetric = sMetric;
					}
						                                        
					isrec = NextRecord();
				}
			}
		}
		Outputs.SetProperty(&quot;KB&quot;,sKiloByte);
		Outputs.SetProperty(&quot;B&quot;,sByte);
		Outputs.SetProperty(&quot;GB&quot;,sGigaByte/1073741824);
		Outputs.SetProperty(&quot;IDDZone&quot;,IDDZone); 
		Outputs.SetProperty(&quot;IDDMetric&quot;,IDDMetric);        
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		sProdEntBC = null;
		sProdEntBO = null;
	}
}"
			   SEQUENCE="37"
			   UPDATED="09/03/2025 17:18:13"
			   UPDATED_BY="SUMA"
			   CREATED="11/06/2019 14:56:32"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetProgressiveDiscount"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mGetProgressiveDiscount(Inputs,Outputs)
{
	try
	{
	   var sOrderId = &quot;&quot;,sOrderType = &quot;&quot;,sBillAccId = &quot;&quot;,sServAccId = &quot;&quot;,sCurrView=&quot;&quot;;
	   sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
	   sOrderType = Inputs.GetProperty(&quot;OrderType&quot;);
	   sBillAccId = Inputs.GetProperty(&quot;BillAccId&quot;);
	   sServAccId = Inputs.GetProperty(&quot;ServAccId&quot;);
	   var inps = TheApplication().NewPropertySet();
	   var z = 1, sComments = &quot;&quot;, sMSISDN = &quot;&quot;;
	   
		if(sOrderId != &quot;&quot; &amp;&amp; sOrderId != null)
		{
			var sBo=TheApplication().GetBusObject(&quot;VHA Bundle Save Offers BO&quot;);
			var sBc=sBo.GetBusComp(&quot;VHA Bundle Save Offers BC&quot;);			   	
			with(sBc)
			{
				ActivateField(&quot;Status&quot;);
				ActivateField(&quot;Session Id&quot;);
				ActivateField(&quot;MSISDN&quot;);
				ActivateField(&quot;Comments&quot;);
				ClearToQuery();	
				SetSearchExpr(&quot;[Status]=&apos;Active&apos; AND [Session Id] = &apos;&quot;+sOrderId+&quot;&apos;&quot;);
				ExecuteQuery(ForwardOnly);
				var irec=FirstRecord();
				while(irec)
				{
					sComments = GetFieldValue(&quot;Comments&quot;);
					sMSISDN = GetFieldValue(&quot;MSISDN&quot;);
					//JS:14082020 Added for bundle save strategic
					if (sComments != &quot;&quot; &amp;&amp; sComments != null &amp;&amp; sMSISDN != &quot;&quot; &amp;&amp; sMSISDN != null)
					{
						if (sComments.substring(0,17) == &quot;REMOVE_OFFER_CODE&quot;)
						{
							inps.SetProperty(&quot;MSISDN&quot;+z, sMSISDN + sComments);
							z=z+1;
						}
					}
					SetFieldValue(&quot;Status&quot;,&quot;Expired&quot;);
					WriteRecord();
					irec=NextRecord();
				}
			}
		}
		if (sBillAccId != &quot;&quot; &amp;&amp; sBillAccId != null)
		{
			//var inps = TheApplication().NewPropertySet();
			var outps = TheApplication().NewPropertySet();
			var sWF = TheApplication().GetService(&quot;Workflow Process Manager&quot;);
			inps.SetProperty(&quot;CurrView&quot;,sCurrView);
			inps.SetProperty(&quot;BillAccId&quot;,sBillAccId);
			inps.SetProperty(&quot;OrderId&quot;,sOrderId);
			inps.SetProperty(&quot;OrderType&quot;,sOrderType);
			inps.SetProperty(&quot;Recalculate&quot;,&quot;Y&quot;);
			inps.SetProperty(&quot;ProcessName&quot;,&quot;VHA Bundle Save Offers Wrapper Workflow&quot;);
			sWF.InvokeMethod(&quot;RunProcess&quot;,inps,outps);
		}
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		sBc = null;
		sBo = null;
	}
}"
			   SEQUENCE="38"
			   UPDATED="09/03/2025 17:18:13"
			   UPDATED_BY="SUMA"
			   CREATED="11/06/2019 14:56:32"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetRatePlanAttr"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mGetRatePlanAttr(sOrderItemId,sOrderId,&amp;sPlan,&amp;sTerm,&amp;NBNSpeedTier,&amp;NBNPlanValue,&amp;PlanValueExGST,&amp;PlanSAMId,&amp;sSharingIndicator,&amp;sPlanValue)//MADHUR::09-MAY-23::Added var sPlanValue for XS-NSA 
//function mGetRatePlanAttr(sOrderItemId,sOrderId,&amp;sPlan,&amp;sTerm,&amp;NBNSpeedTier,&amp;NBNPlanValue,&amp;PlanValueExGST,&amp;PlanSAMId,&amp;sSharingIndicator,sVHAProdDesc) //MADHUR::27-JAN-23::Modified for XS-NSA for postpay refresh//::MADHUR::09-MAY-23::Inactivated for XS-NSA
{
	try
	{
		var sOrdBO,sOrdItemBC,sOrdItemAttrBC,sPlanTerm,sNewTerm = &quot;&quot;;
		sOrdBO = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
		sOrdItemBC = sOrdBO.GetBusComp(&quot;VF Order Entry - Line Items - Primary Product - TBUI&quot;);
		var sProvider = mNetworkProvider(sOrderItemId,sOrderId);//Imagine T&amp;C
		var SpeedTier = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_NSA_SPEED_PREIX&quot;,sProvider);//Imagine T&amp;C
		
		with(sOrdItemBC)
		{
			ActivateField(&quot;Product&quot;);
		//	ActivateField(&quot;VHA Product Description&quot;);//MADHUR::27-JAN-23::Added for XS-NSA for postpay refresh//::MADHUR::09-MAY-23::Inactivated for XS-NSA	
			ActivateField(&quot;Plan Term&quot;);
			ActivateField(&quot;VF Term TBUI&quot;);
			ActivateField(&quot;VHA NBN SpeedTier&quot;);
			ActivateField(&quot;VHA FBB SpeedTier&quot;);
			ActivateField(&quot;VHA Current Price List&quot;);
			ActivateField(&quot;Sam Id&quot;);
			ActivateField(&quot;Product Id&quot;);
			ActivateField(&quot;VF Sharing Indicator&quot;);
			ClearToQuery();   
			SetViewMode(AllView); 
			SetSearchExpr(&quot;[Root Order Item Id] =&apos;&quot;+sOrderItemId+&quot;&apos; AND [Order Header Id] = &apos;&quot;+sOrderId+&quot;&apos; AND [Action Code] &lt;&gt; &apos;Delete&apos;&quot;);
			ExecuteQuery(ForwardOnly); 
			if(FirstRecord())  
			{
			    if(sProvider == &quot;NBN&quot;)
				NBNSpeedTier = SpeedTier+&quot; &quot;+GetFieldValue(&quot;VHA NBN SpeedTier&quot;);
				else if(sProvider == &quot;OPTICOMM&quot; || sProvider == &quot;VISION&quot;)
				NBNSpeedTier = SpeedTier+&quot; &quot;+GetFieldValue(&quot;VHA FBB SpeedTier&quot;);
				PlanValueExGST = fnGetPricefromPriceList(GetFieldValue(&quot;VHA Current Price List&quot;), GetFieldValue(&quot;Product Id&quot;), &quot;&quot;);
				NBNPlanValue = (ToNumber(PlanValueExGST) + (ToNumber(PlanValueExGST)* nGST)/100);
				NBNPlanValue = fnFormatPrice(NBNPlanValue, &quot;&quot;, &quot;&quot;);
               
				sPlan = GetFieldValue(&quot;Product&quot;);
				sPlanValue = NBNPlanValue;//MADHUR::09-MAY-23::Added var sPlanValue for XS-NSA 
				sNewTerm = GetFieldValue(&quot;Plan Term&quot;);
				sPlanTerm = GetFieldValue(&quot;VF Term TBUI&quot;);
				PlanSAMId = GetFieldValue(&quot;Sam Id&quot;);
				sSharingIndicator = GetFieldValue(&quot;VF Sharing Indicator&quot;);
				//sVHAProdDesc = GetFieldValue(&quot;VHA Product Description&quot;);//MADHUR::27-JAN-23::Added for XS-NSA for postpay refresh//::MADHUR::09-MAY-23::Inactivated for XS-NSA
			/*	if(sVHAProdDesc == &quot;Y&quot;)//MADHUR::27-JAN-23::Added for XS-NSA for postpay refresh//::MADHUR::09-MAY-23::Inactivated for XS-NSA	
				{
					sPlan = GetFieldValue(&quot;VHA Product Description&quot;);
				}//MADHUR::27-JAN-23::Added for XS-NSA for postpay refresh	*/
				if(sNewTerm != &quot;&quot; &amp;&amp; sNewTerm != null &amp;&amp; sNewTerm != &quot;_&quot;)
					sTerm = sNewTerm;
				else if(sPlanTerm != &quot;&quot; &amp;&amp; sPlanTerm != null &amp;&amp; sPlanTerm != &quot;_&quot;)
					sTerm = sPlanTerm;
				else
					sTerm = &quot;Month to Month&quot;;
			}
		}
	//	Outputs.SetProperty(&quot;Plan&quot;,sPlan);
	//	Outputs.SetProperty(&quot;Plan Term&quot;,sTerm);
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		sOrdItemBC = null;
		sOrdBO = null;
	}
}"
