			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fnDateFormat"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function fnDateFormat (sDateTime)
{
	var weekDay = new Array(&quot;Sunday&quot;, &quot;Monday&quot;, &quot;Tuesday&quot;,&quot;Wednesday&quot;, &quot;Thursday&quot;, &quot;Friday&quot;, &quot;Saturday&quot;);
	var Month = new Array(&quot;January&quot;,&quot;February&quot;,&quot;March&quot;,&quot;April&quot;,&quot;May&quot;,&quot;June&quot;,&quot;July&quot;,&quot;August&quot;,&quot;September&quot;,&quot;October&quot;,&quot;November&quot;,&quot;December&quot;);
	var sDateSplit = sDateTime.split(&quot; &quot;);
	var sDate = new Date(sDateSplit[0]);
	var sActDate=&quot;&quot;,theYear = &quot;&quot;, sDay = &quot;&quot;, sMonth=&quot;&quot;, result=&quot;&quot;;
	if(sDateSplit != &quot;&quot;)
	{
		sDate = new Date(sDateSplit[0]);
		sActDate=sDate.getDate();
		theYear = sDate.getFullYear()
		sDay = &quot;&quot;, sMonth=&quot;&quot;, result=&quot;&quot;;
		   
		sDay= weekDay[sDate.getDay()];
		sMonth= Month[sDate.getMonth()];
	
		if(sActDate == &quot;1&quot; || sActDate == &quot;21&quot;)
			sActDate = sActDate+&quot;st&quot;;
		else if(sActDate == &quot;2&quot; || sActDate == &quot;22&quot;)
			sActDate = sActDate+&quot;nd&quot;;
		else if(sActDate == &quot;3&quot; || sActDate == &quot;23&quot;)
			sActDate = sActDate+&quot;rd&quot;;
		else
			sActDate = sActDate+&quot;th&quot;;
		
		result = sDay+&quot;, &quot;+sActDate+&quot; &quot;+sMonth+&quot;, &quot;+theYear;
	}
	
	return result;
}"
			   SEQUENCE="6"
