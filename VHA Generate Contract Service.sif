			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function fnGetSSJQuoteEmailDetails(Inputs,Outputs)
{
	try
	{
		var sRowId = Inputs.GetProperty(&quot;RowId&quot;);
		var sQuoteId = Inputs.GetProperty(&quot;OrderId&quot;);
		var sQuoteNum = Inputs.GetProperty(&quot;OrderNumber&quot;); // TULASIY:07May2024::Created for QuoteNo Attachment Change

		var sParentBO = TheApplication().GetBusObject(&quot;Order Entry Attachment Simple&quot;);
		var	sAttachmentBC = sParentBO.GetBusComp(&quot;Order Entry Attachment (Simple)&quot;);

		var sAttachName = &quot;&quot;, sEmailTempName = &quot;&quot;, sAttachFile = &quot;&quot;, sAbsoluteFilePath = &quot;&quot;,sQuoteAttCreated = &quot;&quot;;
		
