			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="GetProductSAMId"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function GetProductSAMId(ProdId)
{
 	try
	{
		var boProduct = TheApplication().GetBusObject(&quot;Internal Product&quot;);
		var bcProduct = boProduct.GetBusComp(&quot;Internal Product&quot;);
		var sSAMID = &quot;&quot;;

		if(ProdId != null &amp;&amp; ProdId != &quot;&quot;)
		{
			with(bcProduct)
			{
				ClearToQuery();
				SetViewMode(AllView);
				ActivateField(&quot;Name&quot;);
				ActivateField(&quot;Vendor Part Number&quot;);
				SetSearchSpec(&quot;Id&quot;, ProdId);
				SetSearchSpec(&quot;Version Status&quot;, &quot;Active&quot;);
				ExecuteQuery();
				
				if(FirstRecord())
				{
					sSAMID = GetFieldValue(&quot;Vendor Part Number&quot;);
					
				}
			}

		}			
		return sSAMID;
	}
	catch(e)
	{
		throw (e);	
	}
	finally
	{
		bcProduct = null;
		boProduct = null;	
	}
}"
