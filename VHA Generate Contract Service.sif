			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mValidatePegaProduct"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mValidatePegaProduct(Inputs,Outputs)
{
try
{
	var boProduct = TheApplication().GetBusObject(&quot;Internal Product&quot;);
	var bcProduct = boProduct.GetBusComp(&quot;Internal Product&quot;);
	var sProdName = Inputs.GetProperty(&quot;ProdName&quot;);
	var sDiscAmount = Math.abs(Inputs.GetProperty(&quot;DiscountAmount&quot;));
	var sSAMId = &quot;&quot;, sProdDName = &quot;&quot;, sPriceAftGST = &quot;&quot;, sFormatAmnt = &quot;&quot;, IsCreditProd = &quot;N&quot;;
	if(sProdName != null &amp;&amp; sProdName != &quot;&quot;)
	{
		with(bcProduct)
		{
			ClearToQuery();
			SetViewMode(AllView);
			ActivateField(&quot;Vendor Part Number&quot;);
			SetSearchSpec(&quot;Name&quot;,sProdName);
			ExecuteQuery();			
			if(FirstRecord())
			{
				sSAMId = GetFieldValue(&quot;Vendor Part Number&quot;);
			}
		}
	}

	if(sSAMId != &quot;&quot; &amp;&amp; sSAMId != null &amp;&amp; TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;COLT_BRMPROD_LOYALITY&quot;,sSAMId) == &quot;Y&quot;)
	{	
		var svc = TheApplication().GetService(&quot;VF Network Settings BS&quot;);
        var Inp = TheApplication().NewPropertySet();
        var Out = TheApplication().NewPropertySet();
        Inp.SetProperty(&quot;Type&quot;,&quot;COLT_BRMPROD_LOYALITY&quot;);
        Inp.SetProperty(&quot;LIC&quot;,sSAMId);
        svc.InvokeMethod(&quot;QueryLOV&quot;,Inp,Out);
        sProdDName = Out.GetProperty(&quot;Desc&quot;);
		IsCreditProd = &quot;Y&quot;;
	}

	if(sDiscAmount &gt; 0 &amp;&amp; IsCreditProd == &quot;Y&quot;)
	{
		sPriceAftGST = sDiscAmount + ToNumber(sDiscAmount * (nGST/100));
		var Inp1 = TheApplication().NewPropertySet();
		Inp1.SetProperty(&quot;Price&quot;, sPriceAftGST);
		Inp1.SetProperty(&quot;Type&quot;, &quot;AMOUNT_ATTR&quot;);
		Inp1.SetProperty(&quot;System&quot;, &quot;&quot;);
		sFormatAmnt = fnFormatDiscountPrice(Inp1);
	}

Outputs.SetProperty(&quot;OfferDisplayName&quot;,sProdDName);
Outputs.SetProperty(&quot;Discount&quot;,ToNumber(sFormatAmnt));
Outputs.SetProperty(&quot;IsCreditProd&quot;,IsCreditProd);
}
	catch(e)
	{
		throw (e);	
	}
	finally
	{
		bcProduct = null;
		boProduct = null;	
	}
}"
