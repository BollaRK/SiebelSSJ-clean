			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fnGetSalesPersonName"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function fnGetSalesPersonName(Inputs,Outputs)
{
try
	{
		var sOrderCreatedBy = Inputs.GetProperty(&quot;OrdCreatedBy&quot;);
		var sContactBO = TheApplication().GetBusObject(&quot;QAS Contact Address&quot;);
		var	sContactBC = sContactBO.GetBusComp(&quot;Contact&quot;);
		var sSalesPersonName = &quot;&quot;; 
		if(sOrderCreatedBy != &quot;&quot; &amp;&amp; sOrderCreatedBy != null)
		{
			with(sContactBC)
			{
				ClearToQuery();   
				SetViewMode(AllView);
				ActivateField(&quot;First Name&quot;);
				SetSearchExpr(&quot;[Id] = &apos;&quot;+sOrderCreatedBy+&quot;&apos;&quot;);
				ExecuteQuery(ForwardOnly);
				var isrec = FirstRecord();
				if(isrec)
				{
					sSalesPersonName = GetFieldValue(&quot;First Name&quot;);
				}
			}
		}
	Outputs.SetProperty(&quot;SalesPersonName&quot;,sSalesPersonName);
	}
	catch(e)
	{
	throw(e);
	}
	finally{
	sContactBC = null;
	sContactBO = null;
	}
}"
