			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetRatePlanAttrValuesFromProduct"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mGetRatePlanAttrValuesFromProduct(Inputs, Outputs)
{
 //Saravanan J : 09-09-2020 : Created for review summary Fallout in August Release.
 //Created for rate plan and extended for all products.
	try
	{
		
		var boProduct = TheApplication().GetBusObject(&quot;Internal Product&quot;);
		var bcProduct = boProduct.GetBusComp(&quot;Internal Product&quot;);
		
		var boClass = TheApplication().GetBusObject(&quot;VHA ISS Attribute Definition&quot;);
		var bcClass = boClass.GetBusComp(&quot;VF ISS Product VOD BusComp&quot;);
		var bcClassAttrib = boClass.GetBusComp(&quot;ISS Prod Attribute VOD&quot;);

		var strClassId = &quot;&quot;,strAttrName = &quot;&quot;;
		var sNBNSpeed = &quot;&quot;, sFinalNBNSpeed = &quot;&quot;,sFinalSBSpeed = &quot;&quot;;
		var sTerm = &quot;&quot;, sFinalTerm = &quot;&quot;;
		var sPeriod = &quot;&quot;, sFinalPeriod = &quot;&quot;;
		var sSharingIndicator = &quot;&quot;;
		var sFBBSpeed = &quot;&quot;, sFinalFBBSpeed = &quot;&quot;;
		//var sToTProdDesc = &quot;&quot;;//MADHUR::30-JAN-23::Added for XS-NSA for postpay refresh//::MADHUR::09-MAY-23::Inactivated for XS-NSA
		
		//var sRatePlanName = Inputs.GetProperty(&quot;RatePlan&quot;);
		var sInpProduct = Inputs.GetProperty(&quot;InpProduct&quot;);		
		
		bcProduct.ClearToQuery();
		bcProduct.ActivateField(&quot;XA Class Id&quot;);
		bcProduct.ActivateField(&quot;VF Share Flag&quot;);
		// bcProduct.ActivateField(&quot;Description&quot;); //MADHUR::30-JAN-23::Added for XS-NSA for postpay refresh//::MADHUR::09-MAY-23::Inactivated for XS-NSA	
		bcProduct.SetViewMode(AllView);
		bcProduct.SetSearchSpec(&quot;Name&quot;,sInpProduct);
		//bcProduct.SetSearchSpec(&quot;Type&quot;, &quot;Billing - Recurring&quot;);
		bcProduct.ExecuteQuery(ForwardOnly);
		
		if (bcProduct.FirstRecord())
		{
			strClassId = bcProduct.GetFieldValue(&quot;XA Class Id&quot;);
			sSharingIndicator = bcProduct.GetFieldValue(&quot;VF Share Flag&quot;);
			// sToTProdDesc = bcProduct.GetFieldValue(&quot;Description&quot;); //MADHUR::30-JAN-23::Added for XS-NSA for postpay refresh//::MADHUR::09-MAY-23::Inactivated for XS-NSA	

			bcClass.ClearToQuery();
			bcClass.SetViewMode(AllView);
			bcClass.ActivateField(&quot;VOD Id&quot;);
			bcClass.ActivateField(&quot;VOD Name&quot;);
			bcClass.SetSearchExpr(&quot;[VOD Id] = &apos;&quot;+strClassId+&quot;&apos; OR [VOD Name] = &apos;&quot;+sInpProduct+&quot;&apos;&quot;);
			bcClass.ExecuteQuery(ForwardOnly);
			var VODRec = bcClass.FirstRecord();
			while (VODRec)
			{
				//Query for the class and product attribute New Term, NBN Speed	and Period			
				bcClassAttrib.ClearToQuery();
				bcClassAttrib.ActivateField(&quot;Default Value&quot;);
				bcClassAttrib.ActivateField(&quot;Name&quot;);
				bcClassAttrib.SetViewMode(AllView);
				bcClassAttrib.SetSearchExpr(&quot;[Name] = &apos;New Term&apos; OR [Name] = &apos;NBN Speed&apos; OR [Name] = &apos;Period&apos; OR [Name] = &apos;FBB Speed&apos; OR [Name] = &apos;Speed&apos;&quot;);
				bcClassAttrib.ExecuteQuery(ForwardOnly);
				var VODAttribRec = bcClassAttrib.FirstRecord();
				while (VODAttribRec)
				{
					strAttrName = bcClassAttrib.GetFieldValue(&quot;Name&quot;);
					
					if (strAttrName == &quot;New Term&quot;)
					{
						sTerm = bcClassAttrib.GetFieldValue(&quot;Default Value&quot;);
						if (sTerm != &quot;&quot; &amp;&amp; sTerm != null)
						{
							sFinalTerm = bcClassAttrib.GetFieldValue(&quot;Default Value&quot;);
						}
					}					
					else if (strAttrName == &quot;NBN Speed&quot;)
					{
						sNBNSpeed = bcClassAttrib.GetFieldValue(&quot;Default Value&quot;);
						if (sNBNSpeed != &quot;&quot; &amp;&amp; sNBNSpeed != null)
						{
							sFinalNBNSpeed = bcClassAttrib.GetFieldValue(&quot;Default Value&quot;);
						}
					}
					else if (strAttrName == &quot;Period&quot;)
					{
						sPeriod = bcClassAttrib.GetFieldValue(&quot;Default Value&quot;);
						if (sPeriod != &quot;&quot; &amp;&amp; sPeriod != null)
						{
							sFinalPeriod = bcClassAttrib.GetFieldValue(&quot;Default Value&quot;);
						}
					}
					else if (strAttrName == &quot;FBB Speed&quot;)
					{
						sFBBSpeed = bcClassAttrib.GetFieldValue(&quot;Default Value&quot;);
						if (sFBBSpeed != &quot;&quot; &amp;&amp; sFBBSpeed != null)
						{
							sFinalFBBSpeed = bcClassAttrib.GetFieldValue(&quot;Default Value&quot;);
						}
					}
					else if (strAttrName == &quot;Speed&quot;)
					{
						if (bcClassAttrib.GetFieldValue(&quot;Default Value&quot;) != &quot;&quot; &amp;&amp; bcClassAttrib.GetFieldValue(&quot;Default Value&quot;) != null)
						{
							sFinalSBSpeed = bcClassAttrib.GetFieldValue(&quot;Default Value&quot;);
						}
					}

					VODAttribRec = bcClassAttrib.NextRecord();					
				}//while (VODAttribRec)

				VODRec = bcClass.NextRecord();
			}//while (VODRec)
		}
		
		Outputs.SetProperty(&quot;NBN Speed&quot;,sFinalNBNSpeed);
		Outputs.SetProperty(&quot;FBB Speed&quot;,sFinalFBBSpeed);
		Outputs.SetProperty(&quot;New Term&quot;,sFinalTerm);
		Outputs.SetProperty(&quot;Period&quot;,sFinalPeriod);
		Outputs.SetProperty(&quot;SharingIndicator&quot;,sSharingIndicator);
		Outputs.SetProperty(&quot;Speed&quot;,sFinalSBSpeed);
		// Outputs.SetProperty(&quot;ToTProdDesc&quot;,sToTProdDesc); //MADHUR::30-JAN-23::Added for XS-NSA for postpay refresh//::MADHUR::09-MAY-23::Inactivated for XS-NSA				
	}
	
	catch(e)
	{
		throw(e);
	}
	finally
	{
		bcClassAttrib = null;
		bcClass = null;
		boClass = null;
		bcProduct = null;
		boProduct = null;
		
	}
}"
			   SEQUENCE="40"
