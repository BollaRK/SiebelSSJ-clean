			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCopyFile"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Component Name        : 	Copy NSA
 * Method Name           : 	CopyFile
 * Component Information : 	This function will copy NSA
 *							from server side to client side
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 17/07/2020	Saravanan J				Initial Version
 */
function mCopyFile(Inputs,Outputs)
{
	try
	{		
		var source = Inputs.GetProperty(&quot;SourceFile&quot;);
		var SystemPrefName = Inputs.GetProperty(&quot;SystemPrefName&quot;);
		var sourcePath = &quot;&quot;;
		var target = &quot;&quot;, targetPath = &quot;&quot;;
		var boSystemPref = TheApplication().GetBusObject(&quot;System Preferences&quot;);  
		var bcSystemPref = boSystemPref.GetBusComp(&quot;System Preferences&quot;);
		
		with (bcSystemPref)
		{
			ActivateField(&quot;Value&quot;);
			ActivateField(&quot;Comments&quot;);
			ClearToQuery();
			SetSearchSpec(&quot;Name&quot;, SystemPrefName);
			ExecuteQuery(ForwardOnly);
			if(FirstRecord())
			{
				sourcePath = GetFieldValue(&quot;Value&quot;);
				targetPath = GetFieldValue(&quot;Comments&quot;);
			}
		}

		if (source != &quot;&quot; &amp;&amp; source != null &amp;&amp; sourcePath != &quot;&quot; &amp;&amp; sourcePath != null &amp;&amp; targetPath != &quot;&quot; &amp;&amp; targetPath != null)
		{
			target = source.replace(sourcePath, targetPath);
			Clib.system(&quot;cp &quot;+source+&quot; &quot;+target+&quot;&quot;);
		}
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		bcSystemPref = null;
		boSystemPref = null;
	}
}"
			   SEQUENCE="33"
