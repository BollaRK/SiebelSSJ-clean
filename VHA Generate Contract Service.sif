			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fnTimeFormat"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function fnTimeFormat(sDateTime)
{
	var sTime = new Date(sDateTime);
	var result = &quot;&quot;;

	if(sTime != &quot;&quot;)
		if(sTime.getMinutes() == &quot;0&quot;)
			result = sTime.getHours()+&quot;:00&quot;;
		else
			result = sTime.getHours()+&quot;:&quot;+sTime.getMinutes();
	
	return result;
}"
			   SEQUENCE="27"
