			   CREATED="12/12/2020 23:30:14"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fnTSUpgradeGetServiceDetails"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="//Saravanan J 21/10/2020 Created for 3 step upgrade.
function fnTSUpgradeGetServiceDetails(HeaderId,sExistingPlanId,sExistingPropId,&amp;sPlan,&amp;sTerm,&amp;PlanValueIncGST,&amp;PlanValueExGST,&amp;PlanSAMId,&amp;nIntMin1,&amp;nIntMin2,&amp;bnGB,&amp;bnKB,&amp;bnB,&amp;sPD,&amp;sPDDisc,&amp;bGB,&amp;bKB,&amp;bB,&amp;sPropId,&amp;sPlanId,GPISearch,&amp;sSharingIndicator,&amp;sPlanValue)//MADHUR::15-05-23::Added for CPVT813-XS-NSA_PlanValue
{
	try
	{
		var oBO = TheApplication().GetBusObject(&quot;VHA 3 Step Upgrade Object&quot;);
		var oBC = oBO.GetBusComp(&quot;VHA TOT Offer Details BC&quot;);
		var sRec = &quot;&quot;;
		
		var psInp = TheApplication().NewPropertySet();
		var psOut = TheApplication().NewPropertySet();		
					
		with(oBC)
		{
			ClearToQuery();
			SetViewMode(AllView);
			ActivateField(&quot;Product Name&quot;);
			ActivateField(&quot;TOTPlanPrice&quot;);
			ActivateField(&quot;TOTPlanPriceExGST&quot;);
			ActivateField(&quot;ProductSamId&quot;);
			ActivateField(&quot;BaseIDDZone1&quot;);
			ActivateField(&quot;BaseIDDZone2&quot;);
			ActivateField(&quot;BundleSavePerc&quot;);
			ActivateField(&quot;BaseDataB&quot;);
			ActivateField(&quot;BaseDataKB&quot;);
			ActivateField(&quot;BaseDataGB&quot;);
			ActivateField(&quot;BonusDataB&quot;);
			ActivateField(&quot;BonusDataGB&quot;)
			ActivateField(&quot;BonusDataKB&quot;);
			ActivateField(&quot;DiscountPrice&quot;);
			ActivateField(&quot;GPI&quot;);
			ActivateField(&quot;PropId&quot;);
			ActivateField(&quot;ProductId&quot;);
			SetSearchSpec(&quot;Par Row Id&quot;, HeaderId);
			SetSearchSpec(&quot;GPI&quot;, GPISearch);
			ExecuteQuery(ForwardOnly);
			sRec = FirstRecord();
			while(sRec)
			{
				if(GetFieldValue(&quot;GPI&quot;) == &quot;NewRatePlan&quot; || GetFieldValue(&quot;GPI&quot;) == &quot;ExistingRatePlan&quot;)
				{
					sPlan = GetFieldValue(&quot;Product Name&quot;);
					PlanValueIncGST = GetFieldValue(&quot;TOTPlanPrice&quot;);
					sPlanValue = GetFieldValue(&quot;TOTPlanPrice&quot;);//MADHUR::15-05-23::Added for CPVT813-XS-NSA_PlanValue
					PlanValueExGST = GetFieldValue(&quot;TOTPlanPriceExGST&quot;);
					PlanSAMId = GetFieldValue(&quot;ProductSamId&quot;);
					nIntMin1 = GetFieldValue(&quot;BaseIDDZone1&quot;);
					nIntMin2 = GetFieldValue(&quot;BaseIDDZone2&quot;);
					bnB = GetFieldValue(&quot;BonusDataB&quot;);
					bnGB = GetFieldValue(&quot;BonusDataGB&quot;)
					bnKB = GetFieldValue(&quot;BonusDataKB&quot;);
					bB = GetFieldValue(&quot;BaseDataB&quot;);
					bGB = GetFieldValue(&quot;BaseDataGB&quot;);
					bKB = GetFieldValue(&quot;BaseDataKB&quot;);
					sPropId = GetFieldValue(&quot;PropId&quot;);
					sPlanId = GetFieldValue(&quot;ProductId&quot;);

					psInp.SetProperty(&quot;InpProduct&quot;, sPlan);
					mGetRatePlanAttrValuesFromProduct(psInp, psOut);
					sSharingIndicator = psOut.GetProperty(&quot;SharingIndicator&quot;);
					// var sToTProdDesc = 	psOut.GetProperty(&quot;ToTProdDesc&quot;); //MADHUR::30-JAN-23::Added for XS-NSA for postpay refresh//::MADHUR::09-MAY-23::Inactivated for XS-NSA
					// sPlan = sToTProdDesc; //MADHUR::30-JAN-23::Added for XS-NSA for postpay refresh//::MADHUR::09-MAY-23::Inactivated for XS-NSA
				
					sTerm = psOut.GetProperty(&quot;New Term&quot;);
					if(sTerm == &quot;&quot;) {
						sTerm = &quot;Month to Month&quot;;
					}					
				}
				if(GetFieldValue(&quot;GPI&quot;) == &quot;BundleSave&quot;)
				{
					sPD = GetFieldValue(&quot;BundleSavePerc&quot;);
					sPDDisc = GetFieldValue(&quot;DiscountPrice&quot;);
				}
				sRec = NextRecord();
			}
		}				
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		oBC = null;
		oBO = null;
		psInp = null;
		psOut = null;
	}
}"
			   SEQUENCE="30"
			   UPDATED="09/03/2025 17:18:14"
			   UPDATED_BY="SUMA"
			   CREATED="12/12/2020 23:30:14"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fnTSUpgradeMapServiceDetails"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="//Saravanan J 21/10/2020 Created for 3 step upgrade.
function fnTSUpgradeMapServiceDetails(Inputs, Outputs)
{
	try
	{
		var sSiebMsg = TheApplication().NewPropertySet();
		var sTempMsg = TheApplication().NewPropertySet();
		var sListService = TheApplication().NewPropertySet();
		var sService = TheApplication().NewPropertySet();
		var sSimpleProd = TheApplication().NewPropertySet();
		var Out = TheApplication().NewPropertySet();
		var psInpProduct = TheApplication().NewPropertySet();
		var psOutProduct = TheApplication().NewPropertySet();

		var sProdBO = TheApplication().GetBusObject(&quot;VHA Internal Product BO&quot;);
		var sProdBC = sProdBO.GetBusComp(&quot;VHA Internal Product Simple&quot;);
		
		var bnGB = &quot;&quot;, bnKB = &quot;&quot;, bnB = &quot;&quot;, nIntMin1=&quot;&quot;, nIntMin2=&quot;&quot;;
		var tGB = &quot;&quot;, tKB = &quot;&quot;, tB = &quot;&quot;;
		var bGB = &quot;&quot;, bKB = &quot;&quot;, bB = &quot;&quot;;
		var PlanSAMId = &quot;&quot;,sBaseData = &quot;&quot;,sBounsData = &quot;&quot;,sTotalData = &quot;&quot;,sAllMSISDN = &quot;&quot;;
		var PlanValueIncGST = &quot;&quot;, PlanValueIncGST = &quot;&quot;;
		var sPlan = &quot;&quot;,sTerm = &quot;&quot;,sSIM = &quot;&quot;,sPlanValue= &quot;&quot;;//MADHUR::15-05-23::Added for CPVT813-XS-NSA_PlanValue
		var sMSISDN = &quot;&quot;,sPriceListId = &quot;&quot;,PlanValueExGST=&quot;&quot;,sPlanId = &quot;&quot;, sPropId = &quot;&quot;;
		var sOrderHeaderNum = &quot;&quot;, sSharingIndicator = &quot;&quot;;		
		var psOutputs=TheApplication().NewPropertySet();
		var sAddon = &quot;&quot;, aAddon = &quot;&quot;, aaAddon = &quot;&quot;, sResDisc = &quot;&quot;, aResDisc = &quot;&quot;, aaResDisc = &quot;&quot;, HeaderId = &quot;&quot;, sPD = &quot;&quot;, sPDDisc = &quot;&quot;;
		var sAccessory = &quot;&quot;, aAccessory = &quot;&quot;, aaAccessory = &quot;&quot;;
		var sDevice = &quot;&quot;, aDevice = &quot;&quot;, aaDevice = &quot;&quot;;
		var GPISearch = &quot;&quot;;

		aAddon = new Array();
		aaAddon = new Array();
		aResDisc = new Array();
		aaResDisc = new Array();
		aAccessory = new Array();
		aaAccessory = new Array();
		aDevice = new Array();
		aaDevice = new Array();
		
		var sFlow = Inputs.GetProperty(&quot;Flow&quot;);
		var sWaiveFlg = &quot;N&quot;;
		HeaderId = Inputs.GetProperty(&quot;HeaderId&quot;);
		sAddon = Inputs.GetProperty(&quot;Addon&quot;);
		sResDisc = Inputs.GetProperty(&quot;RestrictedDiscount&quot;);
		sAccessory = Inputs.GetProperty(&quot;Accessory&quot;);
		sDevice = Inputs.GetProperty(&quot;Device&quot;);
		sMSISDN = Inputs.GetProperty(&quot;MSISDN&quot;);
		var sDevicePayoutFee = Inputs.GetProperty(&quot;DevicePayoutFee&quot;);
		var sEarlyUpgradeFee = Inputs.GetProperty(&quot;EarlyUpgradeFee&quot;);
		var sFulfilmentRef = Inputs.GetProperty(&quot;FulfilmentRef&quot;);
		var sUpgOfferType = Inputs.GetProperty(&quot;UpgradeOfferType&quot;);
		var sPrepaymentAmount = Inputs.GetProperty(&quot;PrepaymentAmount&quot;);;
		var sRollOverName = Inputs.GetProperty(&quot;RollOverName&quot;);
		var sRollOverMonthPay = Inputs.GetProperty(&quot;RollOverMonthPay&quot;);
		var sRollOverTerm = Inputs.GetProperty(&quot;RollOverTerm&quot;);
		var sRollOverTotal = Inputs.GetProperty(&quot;EarlyUpgradeFee&quot;);
		var sDeviceIns = Inputs.GetProperty(&quot;DeviceIns&quot;);
		var sExistingPD = Inputs.GetProperty(&quot;ExistingPD&quot;);
		var sExistingPDDisc = Inputs.GetProperty(&quot;ExistingPDDisc&quot;);
		var sShared = Inputs.GetProperty(&quot;Shared&quot;);
		var sExistingPlanId = Inputs.GetProperty(&quot;ExistingPlanId&quot;);
		var sExistingPropId = Inputs.GetProperty(&quot;ExistingPropId&quot;);
		var sDeviceStockIndicator = Inputs.GetProperty(&quot;DeviceStockIndicator&quot;);

		if(Inputs.GetChildCount() &gt; 0)
		{
			Outputs.AddChild(Inputs.GetChild(0));
			sTempMsg = Inputs;
			
			while(sTempMsg.GetChildCount())
			{
				if(sTempMsg.GetChild(0).GetType() == &quot;VHA Contract Doc Header&quot;)
				{
					sPriceListId = sTempMsg.GetChild(0).GetProperty(&quot;Price List Id&quot;);
					sOrderHeaderNum = sTempMsg.GetChild(0).GetProperty(&quot;Order Num&quot;);
				}
				if(sTempMsg.GetChild(0).GetType() == &quot;ListOfVHA Contract Doc Service&quot;)
				{
					sListService = sTempMsg.GetChild(0);
					break;
				}
				sTempMsg = sTempMsg.GetChild(0);
			}
			
			if(sListService.GetChildCount() &gt; 0) {
				sListService.RemoveChild(0);
			}
			var oBS = TheApplication().GetService(&quot;PRM ANI Utility Service&quot;);
			var psInp = TheApplication().NewPropertySet();
			var psOut = TheApplication().NewPropertySet();
			psInp.SetProperty(&quot;Hierarchy Name&quot;, &quot;VHA Contract Doc Object&quot;);
			oBS.InvokeMethod(&quot;CreateEmptyPropSet&quot;, psInp, psOut);
			sListService.AddChild(psOut.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(0));		
			
			for(var i = 0; i &lt; sListService.GetChildCount(); i++)
			{
				sService = sListService.GetChild(i);
				bGB = 0, bKB = 0, bB = 0;
				bnGB = 0, bnKB = 0, bnB = 0;
				tGB = 0, tKB = 0, tB = 0;
				nIntMin1 = &quot;&quot;, nIntMin2 = &quot;&quot;;
				PlanSAMId=&quot;&quot;,sBaseData = &quot;&quot;, sBounsData = &quot;&quot;, sTotalData = &quot;&quot;;
				sPD = &quot;&quot;,sPDDisc = &quot;&quot;;
				sPlan=&quot;&quot;,sTerm=&quot;&quot;,sSIM=&quot;&quot;,PlanValueIncGST=&quot;&quot;,PlanValueExGST=&quot;&quot;,sPlanValue=&quot;&quot;;//MADHUR::15-05-23::Added for CPVT813-XS-NSA_PlanValue
				sPropId = &quot;&quot;,sPlanId = &quot;&quot;,GPISearch = &quot;&quot;;
				//sExistingPlanId = &quot;&quot;;
				
				if(sUpgOfferType == &quot;Upgrade to New plan&quot;) {GPISearch = &quot;&apos;NewRatePlan&apos; OR &apos;BundleSave&apos;&quot;;}
				else {GPISearch = &quot;&apos;ExistingRatePlan&apos; OR &apos;BundleSave&apos;&quot;;}
				fnTSUpgradeGetServiceDetails(HeaderId,sExistingPlanId,sExistingPropId,sPlan,sTerm,PlanValueIncGST,PlanValueExGST,PlanSAMId,nIntMin1,nIntMin2,bnGB,bnKB,bnB,sPD,sPDDisc,bGB,bKB,bB,sPropId,sPlanId,GPISearch,sSharingIndicator,sPlanValue);//MADHUR::15-05-23::Added for CPVT813-XS-NSA_PlanValue
				sWaiveFlg = fnCheckWaiveOff(sExistingPlanId, PlanSAMId, sUpgOfferType);
				Inputs.SetProperty(&quot;OrderType&quot;, &quot;TOT&quot;);
				Inputs.SetProperty(&quot;MSISDN&quot;, sMSISDN);
				mGetSIMDetailsfromAsset(Inputs, psOutputs);
				sSIM = psOutputs.GetProperty(&quot;SIM&quot;);				
				
				if(sService.GetProperty(&quot;Root Order Item Id&quot;) == &quot;&quot;) {
					sService.SetProperty(&quot;Root Order Item Id&quot;, &quot;NA&quot;);
				}
				if(sService.GetProperty(&quot;Order Num&quot;) == &quot;&quot;) {
					sService.SetProperty(&quot;Order Num&quot;, sOrderHeaderNum);
				}
				sService.SetProperty(&quot;Order Id&quot;, &quot;&quot;);
				sService.SetProperty(&quot;Custom Asset Integration Id&quot;, &quot;&quot;);
				sService.SetProperty(&quot;Device Name&quot;, &quot;&quot;); 
				sService.SetProperty(&quot;Out of Stock Indicator Flag&quot;, &quot;&quot;);					
				sService.SetProperty(&quot;Action Code&quot;, &quot;Add&quot;);
								
				sService.SetProperty(&quot;VHA MSISDN Calc&quot;, sMSISDN);
				sService.SetProperty(&quot;MSISDN&quot;, sMSISDN);
				sService.SetProperty(&quot;Prepayment Amount&quot;, sPrepaymentAmount);
				if(sWaiveFlg != &quot;Y&quot;)
				{
					sService.SetProperty(&quot;RollOverName&quot;, sRollOverName);
					sService.SetProperty(&quot;RollOverMonthPay&quot;, sRollOverMonthPay);
					sService.SetProperty(&quot;RollOverTerm&quot;, sRollOverTerm);
					sService.SetProperty(&quot;RollOverTotal&quot;, sRollOverTotal);
				}
				sService.SetProperty(&quot;Shared&quot;, sShared);				

				if(sAllMSISDN == &quot;&quot;)
					sAllMSISDN = sMSISDN;
				else
					sAllMSISDN = sAllMSISDN+&quot;, &quot;+sMSISDN;

				Outputs.SetProperty(&quot;AllMSISDN&quot;,sAllMSISDN);
				
				sService.SetProperty(&quot;Plan&quot;, sPlan);
				sService.SetProperty(&quot;PlanTerm&quot;, sTerm);
				sService.SetProperty(&quot;PlanVal&quot;, &quot;$&quot;+sPlanValue);//MADHUR::15-05-23::Added for CPVT813-XS-NSA_PlanValue
				sService.SetProperty(&quot;PlanValue&quot;, PlanValueIncGST);
				sService.SetProperty(&quot;PlanValueExGST&quot;, PlanValueExGST);	
				sService.SetProperty(&quot;PlanSAMId&quot;, PlanSAMId);
				sService.SetProperty(&quot;SharingIndicator&quot;, sSharingIndicator);
				
				if (sPropId != &quot;&quot; &amp;&amp; sPropId != null &amp;&amp; sUpgOfferType == &quot;Upgrade to New plan&quot;)
				{
					sProdBC.ClearToQuery();
					sProdBC.ActivateField(&quot;Siebel Product Type&quot;);
					sProdBC.SetViewMode(AllView);
					sProdBC.SetSearchSpec(&quot;Id&quot;,sPropId);
					sProdBC.ExecuteQuery(ForwardOnly);				
					if (sProdBC.FirstRecord())
					{
						sService.SetProperty(&quot;Siebel Product Type&quot;, sProdBC.GetFieldValue(&quot;Siebel Product Type&quot;));
					}
				}
				else if (sExistingPropId != &quot;&quot; &amp;&amp; sExistingPropId != null)
				{
					sProdBC.ClearToQuery();
					sProdBC.ActivateField(&quot;Siebel Product Type&quot;);
					sProdBC.SetViewMode(AllView);
					sProdBC.SetSearchSpec(&quot;Id&quot;,sExistingPropId);
					sProdBC.ExecuteQuery(ForwardOnly);				
					if (sProdBC.FirstRecord())
					{
						sService.SetProperty(&quot;Siebel Product Type&quot;, sProdBC.GetFieldValue(&quot;Siebel Product Type&quot;));
					}
				}

				sService.SetProperty(&quot;SIM&quot;, sSIM);
				if (ToNumber(sDevicePayoutFee) &lt;= 0) sDevicePayoutFee = &quot;NA&quot;;
				sService.SetProperty(&quot;DevicePayoutFee&quot;, sDevicePayoutFee);
				if (ToNumber(sEarlyUpgradeFee) &lt;= 0 || sWaiveFlg == &quot;Y&quot;) sEarlyUpgradeFee = &quot;NA&quot;;
				sService.SetProperty(&quot;EarlyUpgradeFee&quot;, sEarlyUpgradeFee);
				sService.SetProperty(&quot;Fullfillment Order Id&quot;, sFulfilmentRef);
				sService.SetProperty(&quot;NPEYFee&quot;, &quot;NA&quot;);		

				for(var j = 0; j &lt; sService.GetChildCount(); j++)
				{
					sSiebMsg.Reset();
					sSiebMsg = sService.GetChild(j).Copy();
					
					if(sSiebMsg.GetType() == &quot;ListOfVHA Contract Doc Simple Line Items&quot;)
					{
						sSimpleProd = sService.GetChild(j).GetChild(0).Copy();
						sService.GetChild(j).RemoveChild(0);
							
						if (sPlan != &quot;&quot;)
						{
							sSimpleProd.SetType(&quot;VHA Contract Doc Simple Line Items&quot;);
							sSimpleProd.SetProperty(&quot;Action Code&quot;, &quot;Add&quot;);
							sSimpleProd.SetProperty(&quot;Product Name&quot;, sPlan);
							sSimpleProd.SetProperty(&quot;Prod Id&quot;, sPlanId);
							sSimpleProd.SetProperty(&quot;Global Product Identifier&quot;, &quot;&quot;);
							sSimpleProd.SetProperty(&quot;SAM Id&quot;, PlanSAMId);
							sSimpleProd.SetProperty(&quot;Max Price&quot;, PlanValueExGST);
							sSimpleProd.SetProperty(&quot;PeriodOverride&quot;, &quot;&quot;);
							sSimpleProd.SetProperty(&quot;Period&quot;, &quot;&quot;);
							sSimpleProd.SetProperty(&quot;Discount Price&quot;, &quot;&quot;);
							sSimpleProd.SetProperty(&quot;Amount&quot;, PlanValueExGST);
							sSimpleProd.SetProperty(&quot;Charge Price&quot;, PlanValueExGST);
							sService.GetChild(j).AddChild(sSimpleProd.Copy());
						}
						if(sAddon != &quot;&quot;)
						{
							aAddon = sAddon.split(&quot;|&quot;);
							for(var forAddon = 0; forAddon &lt; aAddon.length; forAddon++)
							{
								aaAddon = aAddon[forAddon].split(&quot;;&quot;);
								if(aaAddon.length &gt; 0)
								{
									sSimpleProd.SetType(&quot;VHA Contract Doc Simple Line Items&quot;);
									sSimpleProd.SetProperty(&quot;Action Code&quot;, &quot;Add&quot;);
									sSimpleProd.SetProperty(&quot;Product Name&quot;, aaAddon[0]);
									sSimpleProd.SetProperty(&quot;Global Product Identifier&quot;, aaAddon[1]);
									sSimpleProd.SetProperty(&quot;Prod Id&quot;, aaAddon[2]);
									sSimpleProd.SetProperty(&quot;Max Price&quot;, aaAddon[3]);								
									sSimpleProd.SetProperty(&quot;SAM Id&quot;, aaAddon[4]);								
									sSimpleProd.SetProperty(&quot;PeriodOverride&quot;, &quot;&quot;);
									//Vasavi Added for PKE 
									sSimpleProd.SetProperty(&quot;Period&quot;, aaAddon[5]);
									var addonPeriod = sSimpleProd.GetProperty(&quot;Period&quot;);
									if(addonPeriod == null || addonPeriod == &quot;&quot;)// Vasavi added only if condition for PKE
									{
										psInpProduct.Reset();
										psOutProduct.Reset();
										psInpProduct.SetProperty(&quot;InpProduct&quot;, aaAddon[0]);
										mGetRatePlanAttrValuesFromProduct(psInpProduct, psOutProduct);
		
										sSimpleProd.SetProperty(&quot;Period&quot;, psOutProduct.GetProperty(&quot;Period&quot;));
									}
									sSimpleProd.SetProperty(&quot;Discount Price&quot;, &quot;&quot;);
									sSimpleProd.SetProperty(&quot;Amount&quot;, aaAddon[3]);
									sSimpleProd.SetProperty(&quot;Charge Price&quot;, aaAddon[3]);
									sService.GetChild(j).AddChild(sSimpleProd.Copy());
	
									if(aaAddon[1] == &quot;Bonus Data&quot; || aaAddon[1] == &quot;Bonus IDD&quot;)
									{
										mGetProductEntitlementsData(aaAddon[4],&quot;BonusData&quot;,Out);
										
										bnKB = ToNumber(bnKB) + ToNumber(Out.GetProperty(&quot;KB&quot;));
										bnB = ToNumber(bnB) + ToNumber(Out.GetProperty(&quot;B&quot;));
										bnGB = ToNumber(bnGB) + ToNumber(Out.GetProperty(&quot;GB&quot;));
									}
								}
							}
						}
						if(sResDisc != &quot;&quot;)
						{
							aResDisc = sResDisc.split(&quot;|&quot;);
							for(var forResDisc = 0; forResDisc &lt; aResDisc.length; forResDisc++)
							{
								aaResDisc = aResDisc[forResDisc].split(&quot;;&quot;);
								if(aaResDisc.length &gt; 0)
								{
									sSimpleProd.SetType(&quot;VHA Contract Doc Simple Line Items&quot;);
									sSimpleProd.SetProperty(&quot;Action Code&quot;, &quot;Add&quot;);
									sSimpleProd.SetProperty(&quot;Prod Id&quot;, aaResDisc[0]);
									sSimpleProd.SetProperty(&quot;SAM Id&quot;, aaResDisc[1]);
									sSimpleProd.SetProperty(&quot;Max Price&quot;, aaResDisc[2]);
									sSimpleProd.SetProperty(&quot;Amount&quot;, aaResDisc[2]);
									sSimpleProd.SetProperty(&quot;Charge Price&quot;, aaResDisc[2]);
									sSimpleProd.SetProperty(&quot;Period&quot;, aaResDisc[3]);
									sSimpleProd.SetProperty(&quot;Product Name&quot;, aaResDisc[4]);									
									sSimpleProd.SetProperty(&quot;Global Product Identifier&quot;, aaResDisc[5]);
									sSimpleProd.SetProperty(&quot;Service Price&quot;, aaResDisc[6]);									
									sSimpleProd.SetProperty(&quot;PeriodOverride&quot;, &quot;&quot;);									
									sSimpleProd.SetProperty(&quot;Discount Price&quot;, &quot;&quot;);
									sService.GetChild(j).AddChild(sSimpleProd.Copy());
								}
							}
						}
						fnTSUpgradeGetOfferDetails(HeaderId, &quot;&apos;Credit&apos; OR &apos;Loyalty Discount&apos; OR &apos;Bonus Data&apos; OR &apos;Bonus IDD&apos;&quot;, sService.GetChild(j), sSimpleProd);
					}
					if(sSiebMsg.GetType() == &quot;ListOfVHA Bundle Save Offers BC&quot;)
					{
						
						sSimpleProd = sService.GetChild(j).GetChild(0).Copy();
						sService.GetChild(j).RemoveChild(0);
							
						/* if(sUpgOfferType != &quot;Upgrade to New plan&quot; &amp;&amp; sExistingPD != &quot;&quot;)
						{
							sSimpleProd.SetType(&quot;VHA Bundle Save Offers BC&quot;);
							sSimpleProd.SetProperty(&quot;New PD&quot;, sExistingPD);
							sSimpleProd.SetProperty(&quot;Discount Price&quot;, sExistingPDDisc);
							sService.GetChild(j).AddChild(sSimpleProd.Copy());
						} */
						//else 
						if(sPD != &quot;&quot;)
						{
							sSimpleProd.SetType(&quot;VHA Bundle Save Offers BC&quot;);
							sSimpleProd.SetProperty(&quot;New PD&quot;, sPD);
							sSimpleProd.SetProperty(&quot;Discount Price&quot;, sPDDisc);
							sService.GetChild(j).AddChild(sSimpleProd.Copy());
						}
					}					
					if(sSiebMsg.GetType() == &quot;ListOfVHA Contract Doc Accessory&quot;)
					{
						sSimpleProd = sService.GetChild(j).GetChild(0).Copy();
						sService.GetChild(j).RemoveChild(0);
						if(sAccessory != &quot;&quot;)
						{
							aAccessory = sAccessory.split(&quot;|&quot;);
							for(var forAccessory = 0; forAccessory &lt; aAccessory.length; forAccessory++)
							{
								aaAccessory = aAccessory[forAccessory].split(&quot;;&quot;);
								if(aaAccessory.length &gt; 0)
								{
									sSimpleProd.SetType(&quot;VHA Contract Doc Accessory&quot;);
									sSimpleProd.SetProperty(&quot;Accessory Name&quot;, aaAccessory[0]);
									sSimpleProd.SetProperty(&quot;Out of Stock Indicator Flag&quot;, aaAccessory[1]);
									sSimpleProd.SetProperty(&quot;APP Monthly Repayment Calc&quot;, fnFormatPrice(aaAccessory[2],&quot;&quot;,&quot;&quot;));
									sSimpleProd.SetProperty(&quot;SD Insurance&quot;, aaAccessory[3]);
									sSimpleProd.SetProperty(&quot;APP Contract Amount&quot;, fnFormatPrice(aaAccessory[4],&quot;&quot;,&quot;&quot;));
									sSimpleProd.SetProperty(&quot;IMEI&quot;, aaAccessory[5]);
									sSimpleProd.SetProperty(&quot;Term Num&quot;, aaAccessory[6]);
									sSimpleProd.SetProperty(&quot;Term Override&quot;, aaAccessory[7]);
									sSimpleProd.SetProperty(&quot;Term&quot;, aaAccessory[8]);
									sSimpleProd.SetProperty(&quot;Type&quot;, aaAccessory[9]);
									sSimpleProd.SetProperty(&quot;Category&quot;, aaAccessory[10]);
									var AccMonthPay = &quot;&quot;
									if (aaAccessory[10] != &quot;Secondary Device&quot;)
									{
										if (ToNumber(aaAccessory[8]) == 0)
											AccMonthPay = &quot;0.00&quot;;
										else {
											AccMonthPay = ToNumber(aaAccessory[12]) / aaAccessory[8];
											AccMonthPay = fnFormatPrice(AccMonthPay, &quot;ACC_MONTH&quot;, &quot;&quot;);
										}
									}
									sSimpleProd.SetProperty(&quot;MonthlyRepayment&quot;, AccMonthPay);
									sSimpleProd.SetProperty(&quot;Price&quot;, fnFormatPrice(aaAccessory[12],&quot;&quot;,&quot;&quot;));
									
									if(sSimpleProd.GetProperty(&quot;Out of Stock Indicator Flag&quot;) == &quot;Y&quot;)
										sService.SetProperty(&quot;Deferred Service&quot;, &quot;Y&quot;);
									
									sService.GetChild(j).AddChild(sSimpleProd.Copy());
								}
							}
						}							
					}						
					if(sSiebMsg.GetType() == &quot;ListOfVHA Contract Doc Device&quot;)
					{
						sSimpleProd = sService.GetChild(j).GetChild(0).Copy();
						sService.GetChild(j).RemoveChild(0);
						if(sDevice != &quot;&quot;)
						{	
							aDevice = sDevice.split(&quot;|&quot;);
							for(var forDevice = 0; forDevice &lt; aDevice.length; forDevice++)
							{
								aaDevice = aDevice[forDevice].split(&quot;;&quot;);
								if(aaDevice.length &gt; 0)
								{
									sSimpleProd.SetType(&quot;VHA Contract Doc Device&quot;);
									sSimpleProd.SetProperty(&quot;Action Code&quot;, &quot;Add&quot;);
									sSimpleProd.SetProperty(&quot;Item Name&quot;, aaDevice[0]);
									sSimpleProd.SetProperty(&quot;Out of Stock Indicator Flag&quot;, sDeviceStockIndicator);
									sSimpleProd.SetProperty(&quot;Monthly Repayment Calc&quot;, fnFormatPrice(aaDevice[2],&quot;&quot;,&quot;&quot;));
									sSimpleProd.SetProperty(&quot;Insurance&quot;, sDeviceIns);
									sSimpleProd.SetProperty(&quot;Contract Amount Calc&quot;, fnFormatPrice(aaDevice[4],&quot;&quot;,&quot;&quot;));
									sSimpleProd.SetProperty(&quot;IMEI&quot;, aaDevice[5]);
									sSimpleProd.SetProperty(&quot;Term Num&quot;, aaDevice[6]);
									sSimpleProd.SetProperty(&quot;Term Override&quot;, aaDevice[7]);
									sSimpleProd.SetProperty(&quot;Term&quot;, aaDevice[8]);

									if(sSimpleProd.GetProperty(&quot;Out of Stock Indicator Flag&quot;) == &quot;Y&quot;)
										sService.SetProperty(&quot;Deferred Service&quot;, &quot;Y&quot;);

									sService.GetChild(j).AddChild(sSimpleProd.Copy());
								}
							}
						}
					}
					if(sSiebMsg.GetType() == &quot;ListOfVF One Off Charges&quot;)
						sService.GetChild(j).RemoveChild(0);
					if(sSiebMsg.GetType() == &quot;ListOfVF Available Offer&quot;)
						sService.GetChild(j).RemoveChild(0);
					if(sSiebMsg.GetType() == &quot;ListOfVF Allocate IMEI&quot;)
						sService.GetChild(j).RemoveChild(0);
					if(sSiebMsg.GetType() == &quot;ListOfVHA NBN Appointment&quot;)
						sService.GetChild(j).RemoveChild(0);
					if(sSiebMsg.GetType() == &quot;ListOfVHA NBN Order Details&quot;)
						sService.GetChild(j).RemoveChild(0);
				}
				
				tGB = ToNumber(bnGB) + ToNumber(bGB);
				tKB = ToNumber(bnKB) + ToNumber(bKB);
				tB = ToNumber(bnB) + ToNumber(bB);
				
				if(ToString(tGB).indexOf(&quot;.&quot;) &gt; 0)
					tGB = ToNumber(tGB).toFixed(2);
				if(ToString(bnGB).indexOf(&quot;.&quot;) &gt; 0)
					bnGB = ToNumber(bnGB).toFixed(2);
				if(ToString(bGB).indexOf(&quot;.&quot;) &gt; 0)
					bGB = ToNumber(bGB).toFixed(2);
				
				if(bGB &gt; 0 &amp;&amp; bKB &gt; 0 &amp;&amp; bB &gt; 0)
					sBaseData = bGB+&quot;GB&quot;+&quot; + &quot;+bKB+&quot;KB&quot;+&quot; + &quot;+bB+&quot;B&quot;;
				else if(bGB &gt; 0 &amp;&amp; bKB &gt; 0)
					sBaseData = bGB+&quot;GB&quot;+&quot; + &quot;+bKB+&quot;KB&quot;;
				else if(bGB &gt; 0)
					sBaseData = bGB+&quot;GB&quot;;
					
				if(bnGB &gt; 0 &amp;&amp; bnKB &gt; 0 &amp;&amp; bnB &gt; 0)
					sBounsData = bnGB+&quot;GB&quot;+&quot; + &quot;+bnKB+&quot;KB&quot;+&quot; + &quot;+bnB+&quot;B&quot;;
				else if(bnGB &gt; 0 &amp;&amp; bnKB &gt; 0)
					sBounsData = bnGB+&quot;GB&quot;+&quot; + &quot;+bnKB+&quot;KB&quot;;
				else if(bnGB &gt; 0)
					sBounsData = bnGB+&quot;GB&quot;;
					
				if(tGB &gt; 0 &amp;&amp; tKB &gt; 0 &amp;&amp; tB &gt; 0)
					sTotalData = tGB+&quot;GB&quot;+&quot; + &quot;+tKB+&quot;KB&quot;+&quot; + &quot;+tB+&quot;B&quot;;
				else if(tGB &gt; 0 &amp;&amp; tKB &gt; 0)
					sTotalData = tGB+&quot;GB&quot;+&quot; + &quot;+tKB+&quot;KB&quot;;
				else if(tGB &gt; 0)
					sTotalData = tGB+&quot;GB&quot;;
					
				sService.SetProperty(&quot;BaseData&quot;,sBaseData);
				sService.SetProperty(&quot;BonusData&quot;,sBounsData);
				sService.SetProperty(&quot;TotalData&quot;,sTotalData);
				if(nIntMin1 != &apos;0&apos;) sService.SetProperty(&quot;IntZone1&quot;,nIntMin1);	
				if(nIntMin2 != &apos;0&apos;) sService.SetProperty(&quot;IntZone2&quot;,nIntMin2);

			} // service: End
		}		
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		sProdBO = null;
		sProdBC = null;
		psInpProduct = null;
		psOutProduct = null;
	}
}"
