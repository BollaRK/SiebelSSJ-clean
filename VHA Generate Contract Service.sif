			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fnTSUpgradeGenerateNSAContract"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/* 
 * Component Name        : 	NSA Contract Generation
 * Method Name           : 	GenerateNSAContractForUpgrade
 * Component Information : 	This function will generate the NSA
 *							contract and will return Siebel Message
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 21/10/2020	Saravanan J				Initial Version
 */
function fnTSUpgradeGenerateNSAContract(Inputs,Outputs)
{
	try
	{	
		var svc = TheApplication().GetService(&quot;Workflow Process Manager&quot;);
		var Input = TheApplication().NewPropertySet();
		var Output = TheApplication().NewPropertySet();
		var ListOfOrderItem = TheApplication().NewPropertySet();
		var ListOfPrepaymentInfo = TheApplication().NewPropertySet();
		var ListOfAttr = TheApplication().NewPropertySet();		
		var sFinalOrderId = &quot;&quot;, sMSISDN = &quot;&quot;;
		var sTransType = &quot;&quot;;
		var sFlow = &quot;3StepUpgrade&quot;;
		var sTSBO = TheApplication().GetBusObject(&quot;VHA 3 Step Upgrade Object&quot;);
		var sTSBC = sTSBO.GetBusComp(&quot;VHA 3 Step Upgrade Header&quot;);
		var sData = &quot;&quot;, sIDD = &quot;&quot;, sResDisc = &quot;&quot;, sAccessory = &quot;&quot;, sAPP = &quot;&quot;, sDevice = &quot;&quot;, sAddon = &quot;&quot;, sSDIns=&quot;&quot;;
		var sPrepaymentAmount = &quot;&quot;, sDeviceIns = &quot;&quot;;
		var sRollOverName = &quot;&quot;, sRollOverMonthPay = &quot;&quot;, sRollOverTerm = &quot;&quot;, sRollOverTotal = &quot;&quot;;
		var sVFDealCode = &quot;&quot;, sVFDealGroup = &quot;&quot;, sVFLoginName = &quot;&quot;, sVFEmpNo = &quot;&quot;, sVFFirstName = &quot;&quot;;
		var sExistingPD = &quot;&quot;, sExistingPDDisc = &quot;&quot;, sExistingPlanId = &quot;&quot;, sExistingPropId = &quot;&quot;;
		var sDeviceStockIndicator = &quot;&quot;;	
		
		var sHeaderId = Inputs.GetChild(0).GetChild(0).GetChild(0).GetProperty(&quot;HeaderId&quot;);
		var sVFSalesChannelDescription = Inputs.GetChild(0).GetChild(0).GetChild(0).GetProperty(&quot;VFSalesChannelDescription&quot;);
		var sVFSalesBranchDescription = Inputs.GetChild(0).GetChild(0).GetChild(0).GetProperty(&quot;VFSalesBranchDescription&quot;);
		var sVFDealerRowId = Inputs.GetChild(0).GetChild(0).GetChild(0).GetProperty(&quot;VFDealerRowId&quot;);
		var sGPPCharge = Inputs.GetChild(0).GetChild(0).GetChild(0).GetProperty(&quot;GPPCharge&quot;);
		var sETC = Inputs.GetChild(0).GetChild(0).GetChild(0).GetProperty(&quot;ETC&quot;);
		var sUpgradeOfferType = Inputs.GetChild(0).GetChild(0).GetChild(0).GetProperty(&quot;UpgradeOfferType&quot;);
		var sShared = Inputs.GetChild(0).GetChild(0).GetChild(0).GetProperty(&quot;Shared&quot;);

		if (Inputs.GetChild(0).GetChild(0).GetChild(0).GetChildCount() &gt; 0)
		{
			for (var child = 0; child &lt; Inputs.GetChild(0).GetChild(0).GetChild(0).GetChildCount(); child++)
			{
				if (Inputs.GetChild(0).GetChild(0).GetChild(0).GetChild(child).GetType() == &quot;ListOfOrderItem&quot;)
				{
					ListOfOrderItem = Inputs.GetChild(0).GetChild(0).GetChild(0).GetChild(child);
				}
				else if (Inputs.GetChild(0).GetChild(0).GetChild(0).GetChild(child).GetType() == &quot;ListOfPrepaymentInfo&quot;)
				{
					ListOfPrepaymentInfo = Inputs.GetChild(0).GetChild(0).GetChild(0).GetChild(child);
				}				
			}
		}//if (Inputs.GetChild(0).GetChild(0).GetChild(0).GetChildCount() &gt; 0)
		
		var sPrepaymentCnt = ListOfPrepaymentInfo.GetChildCount();
		for (var Pre = 0; Pre &lt; sPrepaymentCnt; Pre++)
		{
			sPrepaymentAmount = ListOfPrepaymentInfo.GetChild(Pre).GetProperty(&quot;TotalPrepaymentAmount&quot;);
		}

		var sOrderItemCnt = ListOfOrderItem.GetChildCount();
		for (var Ord = 0; Ord &lt; sOrderItemCnt; Ord++)
		{
			var sName = &quot;&quot;, sStock = &quot;&quot;, sAction = &quot;&quot;, sGroupId = &quot;&quot;, sGroupIdField = &quot;&quot;, sPType = &quot;&quot;, sServicePri = &quot;&quot;;
			var sGPPItemName = &quot;&quot;, sOutofStock = &quot;&quot;, sGPPMonthRepay = &quot;&quot;, sGPPConAmt = &quot;&quot;, sGPPIMEI = &quot;&quot;, sGPPTerm = &quot;&quot;, sGPPIns = &quot;&quot;;
			var sAccName = &quot;&quot;, sAccRRP = &quot;&quot;, sAccCat = &quot;&quot;, sAccPPAmt = &quot;&quot;;
			var sAPPMonthRepay = &quot;&quot;, sAPPCat = &quot;&quot;, sAPPConAmt = &quot;&quot;, sAPPIMEI = &quot;&quot;, sAPPTerm = &quot;&quot;, sAPPIns = &quot;&quot;, sSDAPPIns = &quot;&quot;;
			var sProdId = &quot;&quot;, sGPI = &quot;&quot;, sPSAMId = &quot;&quot;, sMaxPri = &quot;&quot;;
			var sAmount = &quot;&quot;, sPeriod = &quot;&quot;, sIntId = &quot;&quot;;			

			sName = ListOfOrderItem.GetChild(Ord).GetProperty(&quot;Name&quot;);
			sStock = ListOfOrderItem.GetChild(Ord).GetProperty(&quot;StockIndicator&quot;);
			sAction = ListOfOrderItem.GetChild(Ord).GetProperty(&quot;Action&quot;);
			sGroupIdField = ListOfOrderItem.GetChild(Ord).GetProperty(&quot;Field Name&quot;);
			// sGroupId = ListOfOrderItem.GetChild(Ord).GetProperty(&quot;Field Value&quot;);
			sGroupId = ListOfOrderItem.GetChild(Ord).GetProperty(&quot;VHA SD Group Id&quot;);
			sPType = ListOfOrderItem.GetChild(Ord).GetProperty(&quot;Type&quot;);	
			sIntId = ListOfOrderItem.GetChild(Ord).GetProperty(&quot;Prod Integration Id&quot;);		
			if (sStock == &quot;Out of Stock&quot;)
			{
				sOutofStock = &quot;Y&quot;;
			}
			if (sName == &quot;Device&quot; &amp;&amp; sAction == &quot;Add&quot;)
			{
				sDeviceStockIndicator = sOutofStock;
			}
			if (sName == &quot;GPP Device Contract&quot; &amp;&amp; sAction == &quot;Add&quot;)
			{	
				ListOfAttr = ListOfOrderItem.GetChild(Ord).GetChild(0);
				for (var Attr = 0; Attr &lt; ListOfAttr.GetChildCount(); Attr++)
				{
					if (ListOfAttr.GetChild(Attr).GetProperty(&quot;Name&quot;) == &quot;Item Name&quot;)
						sGPPItemName = ListOfAttr.GetChild(Attr).GetProperty(&quot;Value&quot;);
					else if (ListOfAttr.GetChild(Attr).GetProperty(&quot;Name&quot;) == &quot;Monthly Repayment&quot;)
						sGPPMonthRepay = ListOfAttr.GetChild(Attr).GetProperty(&quot;Value&quot;);
					else if (ListOfAttr.GetChild(Attr).GetProperty(&quot;Name&quot;) == &quot;Contract Amount&quot;)
						sGPPConAmt = ListOfAttr.GetChild(Attr).GetProperty(&quot;Value&quot;);
					else if (ListOfAttr.GetChild(Attr).GetProperty(&quot;Name&quot;) == &quot;IMEI/Serial Number&quot;)
						sGPPIMEI = ListOfAttr.GetChild(Attr).GetProperty(&quot;Value&quot;);
					else if (ListOfAttr.GetChild(Attr).GetProperty(&quot;Name&quot;) == &quot;Term&quot;)
						sGPPTerm = ListOfAttr.GetChild(Attr).GetProperty(&quot;Value&quot;);
				}
				sDevice = sGPPItemName + &quot;;&quot; + sOutofStock + &quot;;&quot; + sGPPMonthRepay + &quot;;&quot; + sGPPIns + &quot;;&quot; + sGPPConAmt + &quot;;&quot; + sGPPIMEI + &quot;;&quot; + sGPPTerm + &quot;;&quot; + &quot;_;&quot; + sGPPTerm;
			}//if (sName == &quot;GPP Device Contract&quot; &amp;&amp; sAction == &quot;Add&quot;)
			if (sName == &quot;Accessory&quot; &amp;&amp; sAction == &quot;Add&quot;)
			{
				ListOfAttr = ListOfOrderItem.GetChild(Ord).GetChild(0);
				for (var Attr = 0; Attr &lt; ListOfAttr.GetChildCount(); Attr++)
				{
					if (ListOfAttr.GetChild(Attr).GetProperty(&quot;Name&quot;) == &quot;Accessory Name&quot;)
						sAccName = ListOfAttr.GetChild(Attr).GetProperty(&quot;Value&quot;);
					else if (ListOfAttr.GetChild(Attr).GetProperty(&quot;Name&quot;) == &quot;Accessory RRP Inc GST&quot;)
						sAccRRP = ListOfAttr.GetChild(Attr).GetProperty(&quot;Value&quot;);
					else if (ListOfAttr.GetChild(Attr).GetProperty(&quot;Name&quot;) == &quot;Category&quot;)
					{
						sAccCat = ListOfAttr.GetChild(Attr).GetProperty(&quot;Value&quot;);
						if (sAccCat != &quot;Secondary Device&quot;) sAccCat = &quot;Accessory&quot;;
					}
					else if (ListOfAttr.GetChild(Attr).GetProperty(&quot;Name&quot;) == &quot;Prepayment Amount&quot;)
						sAccPPAmt = ListOfAttr.GetChild(Attr).GetProperty(&quot;Value&quot;);
				}
				if (sAccessory  == &quot;&quot;) {
					sAccessory = sGroupId + &quot;;&quot; + sAccName + &quot;;&quot; + sOutofStock + &quot;;&quot; + sAccRRP + &quot;;&quot; + sAccCat + &quot;;&quot; + &quot;Accessory&quot; + &quot;;&quot; + sAccPPAmt;
				}
				else {
					sAccessory = sAccessory + &quot;|&quot; + sGroupId + &quot;;&quot; + sAccName + &quot;;&quot; + sOutofStock + &quot;;&quot; + sAccRRP + &quot;;&quot; + sAccCat + &quot;;&quot; + &quot;Accessory&quot; + &quot;;&quot; + sAccPPAmt;
				}
			}//if (sName == &quot;Accessory&quot; &amp;&amp; sAction == &quot;Add&quot;)
			if (sName == &quot;APP Contract&quot; &amp;&amp; sAction == &quot;Add&quot;)
			{
				ListOfAttr = ListOfOrderItem.GetChild(Ord).GetChild(0);
				for (var Attr = 0; Attr &lt; ListOfAttr.GetChildCount(); Attr++)
				{
					if (ListOfAttr.GetChild(Attr).GetProperty(&quot;Name&quot;) == &quot;Monthly Repayment&quot;)
						sAPPMonthRepay = ListOfAttr.GetChild(Attr).GetProperty(&quot;Value&quot;);
					else if (ListOfAttr.GetChild(Attr).GetProperty(&quot;Name&quot;) == &quot;Contract Amount&quot;)
						sAPPConAmt = ListOfAttr.GetChild(Attr).GetProperty(&quot;Value&quot;);
					else if (ListOfAttr.GetChild(Attr).GetProperty(&quot;Name&quot;) == &quot;Category&quot;)
					{
						sAPPCat = ListOfAttr.GetChild(Attr).GetProperty(&quot;Value&quot;);
						if (sAPPCat != &quot;Secondary Device&quot;) sAPPCat = &quot;Accessory&quot;;
					}
					else if (ListOfAttr.GetChild(Attr).GetProperty(&quot;Name&quot;) == &quot;IMEI&quot;)
						sAPPIMEI = ListOfAttr.GetChild(Attr).GetProperty(&quot;Value&quot;);
					else if (ListOfAttr.GetChild(Attr).GetProperty(&quot;Name&quot;) == &quot;Term&quot;)
						sAPPTerm = ListOfAttr.GetChild(Attr).GetProperty(&quot;Value&quot;);
					/*else if (ListOfAttr.GetChild(Attr).GetProperty(&quot;Name&quot;) == &quot;Insurance Type&quot;){//BalajiM added for 3SUG Insurance - 10/01/2022
						sAPPIns = ListOfAttr.GetChild(Attr).GetProperty(&quot;Value&quot;);
						if(sAPPIns==&quot;SD Insurance&quot;){
							sAPPIns = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_NSA_INS&quot;, &quot;AUV0468&quot;);
						}
					}*/
				}
				if (sAPP  == &quot;&quot;) {
					sAPP = sGroupId + &quot;;&quot; + sAPPMonthRepay + &quot;;&quot; + sAPPIns + &quot;;&quot; + sAPPConAmt + &quot;;&quot; + sAPPIMEI + &quot;;&quot; + sAPPTerm + &quot;;&quot; + &quot;_;&quot; + sAPPTerm + &quot;;&quot; + sAPPCat + &quot;;&quot; + &quot;Accessory&quot;;
				}
				else {
					sAPP = sAPP + &quot;|&quot; + sGroupId + &quot;;&quot; + sAPPMonthRepay + &quot;;&quot; + sAPPIns + &quot;;&quot; + sAPPConAmt + &quot;;&quot; + sAPPIMEI + &quot;;&quot; + sAPPTerm + &quot;;&quot; + &quot;_;&quot; + sAPPTerm + &quot;;&quot; + sAPPCat + &quot;;&quot; + &quot;Accessory&quot;;
				}
			}//if (sName == &quot;APP Contract&quot; &amp;&amp; sAction == &quot;Add&quot;)
			//BalajiM added for 3SUG Insurance - 18/01/2022
		//	if (sName == &quot;Vodafone Swap &amp; Go - Wearables&quot; &amp;&amp; sAction == &quot;Add&quot;)
			//Ravindra: 01/Dec/2023: Commented the above line and add below below line for Device Care Wearable instead of Swap &amp; Go - Wearables
			var v3SUSwapnGoDCW = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_3SU_SWAPNGO&quot;,&quot;3SU_SWAPNGOW&quot;);	
			if (sName == v3SUSwapnGoDCW &amp;&amp; sAction == &quot;Add&quot;)
			{
				sSDAPPIns = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_NSA_SD_INS&quot;, &quot;AUV0468&quot;);
				if (sSDIns  == &quot;&quot;) {
					sSDIns = sGroupId + &quot;;&quot; + sSDAPPIns;
				}
				else {
					sSDIns = sSDIns + &quot;|&quot; + sGroupId + &quot;;&quot; + sSDAPPIns;
				}
			}//if (sName == &quot;Vodafone Swap &amp; Go - Wearables&quot; &amp;&amp; sAction == &quot;Add&quot;) 

			if (sPType == &quot;Addon&quot; &amp;&amp; sAction == &quot;Add&quot;)
			{
				sGPI = ListOfOrderItem.GetChild(Ord).GetProperty(&quot;GPI&quot;);
				sProdId = ListOfOrderItem.GetChild(Ord).GetProperty(&quot;ProductId&quot;);
				sMaxPri = ListOfOrderItem.GetChild(Ord).GetProperty(&quot;MaxPrice&quot;);
				sPSAMId = ListOfOrderItem.GetChild(Ord).GetProperty(&quot;SAMId&quot;);
				if (ListOfOrderItem.GetChild(Ord).GetChildCount() &gt; 0)//Vasavi Added for PKE
				{
					ListOfAttr = ListOfOrderItem.GetChild(Ord).GetChild(0);
					for (var Attr = 0; Attr &lt; ListOfAttr.GetChildCount(); Attr++)
					{
						if (ListOfAttr.GetChild(Attr).GetProperty(&quot;Name&quot;) == &quot;Period&quot;)
							sPeriod = ListOfAttr.GetChild(Attr).GetProperty(&quot;Value&quot;);
					}
				}// end if
				if(sAddon == &quot;&quot;) {
					sAddon = sName + &quot;;&quot; + sGPI + &quot;;&quot; + sProdId + &quot;;&quot; + sMaxPri + &quot;;&quot; + sPSAMId + &quot;;&quot; + sPeriod;
				}
				else {
					sAddon = sAddon + &quot;|&quot; + sName + &quot;;&quot; + sGPI + &quot;;&quot; + sProdId + &quot;;&quot; + sMaxPri + &quot;;&quot; + sPSAMId + &quot;;&quot; + sPeriod;
				}
			}//if (sPType == &quot;Addon&quot; &amp;&amp; sAction == &quot;Add&quot;)
			if (sPType == &quot;Recurring Discount&quot; &amp;&amp; sAction == &quot;Add&quot;)
			{
				sGPI = ListOfOrderItem.GetChild(Ord).GetProperty(&quot;GPI&quot;);
				sProdId = ListOfOrderItem.GetChild(Ord).GetProperty(&quot;ProductId&quot;);
				sMaxPri = ListOfOrderItem.GetChild(Ord).GetProperty(&quot;MaxPrice&quot;);
				sPSAMId = ListOfOrderItem.GetChild(Ord).GetProperty(&quot;SAMId&quot;);
				sServicePri = ListOfOrderItem.GetChild(Ord).GetProperty(&quot;ServicePrice&quot;);
				if (ListOfOrderItem.GetChild(Ord).GetChildCount() &gt; 0)
				{
					ListOfAttr = ListOfOrderItem.GetChild(Ord).GetChild(0);
					for (var Attr = 0; Attr &lt; ListOfAttr.GetChildCount(); Attr++)
					{
						if (ListOfAttr.GetChild(Attr).GetProperty(&quot;Name&quot;) == &quot;Amount&quot;)
							sAmount = ListOfAttr.GetChild(Attr).GetProperty(&quot;Value&quot;);
						else if (ListOfAttr.GetChild(Attr).GetProperty(&quot;Name&quot;) == &quot;Period&quot;)
							sPeriod = ListOfAttr.GetChild(Attr).GetProperty(&quot;Value&quot;);
					}
				}
				if(sResDisc == &quot;&quot;) {
					sResDisc = sProdId + &quot;;&quot; + sPSAMId + &quot;;&quot; + sAmount + &quot;;&quot; + sPeriod + &quot;;&quot; + sName + &quot;;&quot; + sGPI + &quot;;&quot; + sServicePri;
				}
				else {
					sResDisc = sResDisc + &quot;|&quot; + sProdId + &quot;;&quot; + sPSAMId + &quot;;&quot; + sAmount + &quot;;&quot; + sPeriod + &quot;;&quot; + sName + &quot;;&quot; + sGPI + &quot;;&quot; + sServicePri;
				}
			}//if (sPType == &quot;Recurring Discount&quot; &amp;&amp; sAction == &quot;Add&quot;)
			if (sPType == &quot;Early Upgrade Fee Rollover&quot; &amp;&amp; sAction == &quot;Add&quot; &amp;&amp; ToNumber(sETC) &gt; 0)
			{
				sRollOverName = sPType;
				sRollOverTerm = ListOfOrderItem.GetChild(Ord).GetProperty(&quot;EEFPeriod&quot;);
				var moncharge = ToNumber(sETC)/sRollOverTerm;
				moncharge = parseFloat(moncharge);
				moncharge = moncharge*100;
				moncharge = Math.round(moncharge);
				var sEEFCharge = moncharge/100;				
				//sRollOverMonthPay = ToNumber(sEEFCharge) + (ToNumber(sEEFCharge) * nGST)/100;
				//sRollOverMonthPay = fnFormatPrice(sRollOverMonthPay, &quot;ROLLOVER_PAY&quot;, &quot;&quot;);
				sRollOverMonthPay = fnFormatPrice(ToNumber(sEEFCharge), &quot;ROLLOVER_PAY&quot;, &quot;&quot;);
			}//if (sPType == &quot;Early Upgrade Fee Rollover&quot; &amp;&amp; sAction == &quot;Add&quot; &amp;&amp; ToNumber(sETC) &gt; 0)
			if (sPType == &quot;Insurance&quot; &amp;&amp; sAction == &quot;Add&quot; &amp;&amp; sIntId == &quot;&quot;)
			{
				//if (sName == &quot;$15 - One Month Free Phone Insurance&quot; || sName == &quot;Phone Insurance&quot;) // BalajiM : 3SUG insurance project
					sDeviceIns = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_NSA_INS&quot;, &quot;AUV0467&quot;);
				//else sDeviceIns = &quot;$10 Insurance&quot;;
			}//if (sPType == &quot;Insurance&quot; &amp;&amp; sAction == &quot;Add&quot;)
			/*if (sPType == &quot;SD Insurance&quot; &amp;&amp; sAction == &quot;Add&quot; &amp;&amp; sIntId == &quot;&quot;)
			{
				//if (sName == &quot;$15 - One Month Free Phone Insurance&quot; || sName == &quot;Phone Insurance&quot;)
					sDeviceIns = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_NSA_INS&quot;, &quot;AUV0468&quot;);
			//	else sDeviceIns = &quot;$10 Insurance&quot;;
			}//if (sPType == &quot;Insurance&quot; &amp;&amp; sAction == &quot;Add&quot;)*/

		}//for (var Ord = 0; Ord &lt; sOrderItemCnt; Ord++)

		var aAccessory = new Array();
		var aaAccessory = new Array();
		var sFinalAccessory = &quot;&quot;;
		var sFinalGroupId = &quot;&quot;;
		var aAPP = new Array();
		var aaAPP = new Array();
		var aSDIns = new Array();
		var aaSDIns = new Array();

		if (sAccessory != &quot;&quot;)
		{
			aAccessory = sAccessory.split(&quot;|&quot;);
			for(var acc = 0; acc &lt; aAccessory.length; acc++)
			{
				aaAccessory = aAccessory[acc].split(&quot;;&quot;);
				if(aaAccessory.length &gt; 0)
				{
					sFinalGroupId = aaAccessory[0];
					if (sAPP != &quot;&quot;)
					{
						aAPP = sAPP.split(&quot;|&quot;);
						for(var accAPP = 0; accAPP &lt; aAPP.length; accAPP++)
						{
							aaAPP = aAPP[accAPP].split(&quot;;&quot;);
							if(aaAPP.length &gt; 0)
							{
								if (sFinalGroupId == aaAPP[0])
								{
									//check for SD Ins - //BalajiM added for 3SUG Insurance - 18/01/2022
									var sFinalSDIns=&quot;&quot;;
									if(sSDIns != &quot;&quot;){
										aSDIns = sSDIns.split(&quot;|&quot;);
										for(var accIns = 0; accIns &lt; aSDIns.length; accIns++){
											aaSDIns = aSDIns[accIns].split(&quot;;&quot;);
											if(aaSDIns.length &gt; 0){
												if (sFinalGroupId == aaSDIns[0]){
													sFinalSDIns = aaSDIns[1];
												}
											}
										}
									}
	
									if (aaAccessory[4] == &quot;Accessory&quot; &amp;&amp; ToNumber(aaAccessory[6]) &gt; 0 &amp;&amp; aaAccessory[6] != null &amp;&amp; aaAccessory[6] != &quot;&quot;)
										aaAccessory[3] = ToNumber(aaAccessory[3]) - ToNumber(aaAccessory[6]);										
									if (sFinalAccessory == &quot;&quot;)
										sFinalAccessory = aaAccessory[1] + &quot;;&quot; + aaAccessory[2] + &quot;;&quot; + aaAPP[1] + &quot;;&quot; + sFinalSDIns + &quot;;&quot; + aaAPP[3] + &quot;;&quot; + aaAPP[4] + &quot;;&quot; + aaAPP[5] + &quot;;&quot; + aaAPP[6] + &quot;;&quot; + aaAPP[7] + &quot;;&quot; + aaAPP[9] + &quot;;&quot; + aaAPP[8] + &quot;;&quot; + &quot;;&quot; + aaAccessory[3];
									else
										sFinalAccessory = sFinalAccessory + &quot;|&quot; + aaAccessory[1] + &quot;;&quot; + aaAccessory[2] + &quot;;&quot; + aaAPP[1] + &quot;;&quot; + sFinalSDIns + &quot;;&quot; + aaAPP[3] + &quot;;&quot; + aaAPP[4] + &quot;;&quot; + aaAPP[5] + &quot;;&quot; + aaAPP[6] + &quot;;&quot; + aaAPP[7] + &quot;;&quot; + aaAPP[9] + &quot;;&quot; + aaAPP[8] + &quot;;&quot; + &quot;;&quot; + aaAccessory[3];
									break;
								}
							}//if(aaAPP.length &gt; 0)
						}//for(var accAPP = 0; accAPP &lt; aAPP.length; accAPP++)
					}//if (sAPP != &quot;&quot;)
				}//if(aaAccessory.length &gt; 0)
			}//for(var acc = 0; acc &lt; aAccessory.length; acc++)
		}//if (sAccessory != &quot;&quot;)
		
		if (sHeaderId != null &amp;&amp; sHeaderId != &quot;&quot;)
		{	
			with(sTSBC)
			{
				ActivateField(&quot;Order Id&quot;);
				ActivateField(&quot;MSISDN&quot;);
				ActivateField(&quot;ExistingPD&quot;);
				ActivateField(&quot;ExistingPDDisc&quot;);
				ActivateField(&quot;Plan Id&quot;);
				ActivateField(&quot;Prop Id&quot;);				
				SetViewMode(AllView);
				ClearToQuery();
				SetSearchSpec(&quot;Id&quot;, sHeaderId);
				ExecuteQuery(ForwardOnly);
				if(FirstRecord())
				{
					sFinalOrderId = GetFieldValue(&quot;Order Id&quot;);
					sMSISDN = GetFieldValue(&quot;MSISDN&quot;);
					sExistingPD = GetFieldValue(&quot;ExistingPD&quot;);
					sExistingPDDisc = GetFieldValue(&quot;ExistingPDDisc&quot;);
					sExistingPlanId = GetFieldValue(&quot;Plan Id&quot;);
					sExistingPropId = GetFieldValue(&quot;Prop Id&quot;);
				}
			}

			if (sVFDealerRowId != &quot;&quot;)
			{
				var boEmp = TheApplication().GetBusObject(&quot;Employee&quot;);
				var bcEmp = boEmp.GetBusComp(&quot;Employee&quot;);
				with (bcEmp)
				{
					SetViewMode(AllView);
					ActivateField(&quot;VF Dealer Code&quot;);
					ActivateField(&quot;VF Dealer Group&quot;);
					ActivateField(&quot;VF Sales Branch Description&quot;);
					ActivateField(&quot;VF Sales Channel Description&quot;);
					ActivateField(&quot;Login Name&quot;);
					ActivateField(&quot;Emp #&quot;);
					ActivateField(&quot;First Name&quot;);
					ClearToQuery();					
					SetSearchSpec(&quot;Id&quot;, sVFDealerRowId);
					ExecuteQuery(ForwardOnly);
					if (FirstRecord())
					{
						sVFDealCode = GetFieldValue(&quot;VF Dealer Code&quot;);
						sVFDealGroup = GetFieldValue(&quot;VF Dealer Group&quot;);
						sVFSalesBranchDescription = GetFieldValue(&quot;VF Sales Branch Description&quot;); 
						sVFSalesChannelDescription = GetFieldValue(&quot;VF Sales Channel Description&quot;);
						sVFLoginName = GetFieldValue(&quot;Login Name&quot;);
						sVFEmpNo = GetFieldValue(&quot;Emp #&quot;);
						sVFFirstName = GetFieldValue(&quot;First Name&quot;);
					}
				}
			}

			if (sFinalOrderId != null &amp;&amp; sFinalOrderId != &quot;&quot;)
			{
				Input.SetProperty(&quot;ProcessName&quot;, &quot;VHA Generate Contract Wrapper Workflow&quot;);
				Input.SetProperty(&quot;Object Id&quot;, sFinalOrderId);
				Input.SetProperty(&quot;HeaderId&quot;, sHeaderId);
				Input.SetProperty(&quot;TransactionType&quot;, sTransType);
				Input.SetProperty(&quot;MSISDN&quot;, sMSISDN);
				Input.SetProperty(&quot;Flow&quot;, sFlow);
				Input.SetProperty(&quot;Addon&quot;, sAddon);				
				Input.SetProperty(&quot;RestrictedDiscount&quot;, sResDisc);
				Input.SetProperty(&quot;Accessory&quot;, sFinalAccessory);
				Input.SetProperty(&quot;Device&quot;, sDevice);
				Input.SetProperty(&quot;DeviceStockIndicator&quot;, sDeviceStockIndicator);
				if (sGPPCharge != &quot;&quot;) Input.SetProperty(&quot;DevicePayoutFee&quot;, fnFormatPrice(sGPPCharge,&quot;&quot;,&quot;&quot;));
				if (sETC != &quot;&quot;) 
				{
					//sRollOverTotal = ToNumber(sETC) + (ToNumber(sETC) * nGST)/100;
					sRollOverTotal = ToNumber(sETC);
					sRollOverTotal = fnFormatPrice(sRollOverTotal, &quot;ROLLOVER_TOTAL&quot;, &quot;BRM&quot;);
					Input.SetProperty(&quot;EarlyUpgradeFee&quot;, sRollOverTotal);
				}
				if (sRollOverMonthPay != &quot;&quot;) {
					Input.SetProperty(&quot;RollOverMonthPay&quot;, sRollOverMonthPay);
					Input.SetProperty(&quot;RollOverName&quot;, sRollOverName);
					Input.SetProperty(&quot;RollOverTerm&quot;, sRollOverTerm + &quot; Months&quot;);
				}
				if (sPrepaymentAmount != &quot;&quot;) Input.SetProperty(&quot;PrepaymentAmount&quot;, fnFormatPrice(sPrepaymentAmount,&quot;&quot;,&quot;&quot;));
				Input.SetProperty(&quot;UpgradeOfferType&quot;, sUpgradeOfferType);
				Input.SetProperty(&quot;VFSalesChannelDescription&quot;, sVFSalesChannelDescription);
				Input.SetProperty(&quot;VFSalesBranchDescription&quot;, sVFSalesBranchDescription);
				Input.SetProperty(&quot;VFDealCode&quot;, sVFDealCode);
				Input.SetProperty(&quot;VFDealGroup&quot;, sVFDealGroup);
				Input.SetProperty(&quot;VFLoginName&quot;, sVFLoginName);
				Input.SetProperty(&quot;VFEmpNo&quot;, sVFEmpNo);
				Input.SetProperty(&quot;VFFirstName&quot;, sVFFirstName);
				Input.SetProperty(&quot;DeviceIns&quot;, sDeviceIns);
				Input.SetProperty(&quot;ExistingPD&quot;, sExistingPD);
				Input.SetProperty(&quot;ExistingPDDisc&quot;, sExistingPDDisc);
				Input.SetProperty(&quot;Shared&quot;, sShared);
				Input.SetProperty(&quot;ExistingPlanId&quot;, sExistingPlanId);
				Input.SetProperty(&quot;ExistingPropId&quot;, sExistingPropId);				
				
				//throw(&quot;sFinalOrderId:&quot; + sFinalOrderId + &quot;------sHeaderId:&quot;+ sHeaderId + &quot;------sTransType:&quot;+ sTransType + &quot;------sMSISDN:&quot;+ sMSISDN + &quot;------sFlow:&quot;+ sFlow + &quot;------sAddon:&quot;+ sAddon + &quot;-------sResDisc:&quot; + sResDisc + &quot;sFinalAccessory:&quot; + sFinalAccessory + &quot;-------sDevice:&quot; + sDevice + &quot;-------sGPPCharge:&quot; + sGPPCharge + &quot;-------sRollOverTotal:&quot; + sRollOverTotal + &quot;-------sRollOverMonthPay:&quot; + sRollOverMonthPay + &quot;-------sRollOverName:&quot; + sRollOverName + &quot;-------sRollOverTerm:&quot; + sRollOverTerm + &quot;-------sPrepaymentAmount:&quot; + sPrepaymentAmount + &quot;-------sUpgradeOfferType:&quot; + sUpgradeOfferType + &quot;-------sVFSalesChannelDescription:&quot; + sVFSalesChannelDescription + &quot;------sVFSalesBranchDescription:&quot;+ sVFSalesBranchDescription + &quot;------sVFDealCode:&quot;+ sVFDealCode + &quot;------sVFDealGroup:&quot;+ sVFDealGroup + &quot;------sVFLoginName:&quot;+ sVFLoginName + &quot;------sVFEmpNo:&quot;+ sVFEmpNo + &quot;------sVFFirstName:&quot;+ sVFFirstName + &quot;-------sDeviceIns:&quot; + sDeviceIns + &quot;------sExistingPD:&quot;+ sExistingPD + &quot;------sExistingPDDisc:&quot;+ sExistingPDDisc + &quot;------sShared:&quot;+ sShared);

				svc.InvokeMethod(&quot;RunProcess&quot;, Input, Output);

				Output.GetChild(0).GetChild(0).GetChild(0).SetProperty(&quot;BAN&quot;, Output.GetProperty(&quot;BillingAccountId&quot;));
				Output.GetChild(0).GetChild(0).GetChild(0).SetProperty(&quot;ConnectionType&quot;, Output.GetProperty(&quot;ConnectionType&quot;));
				Output.GetChild(0).GetChild(0).GetChild(0).SetProperty(&quot;CANameNoTitle&quot;, Output.GetProperty(&quot;CANameNoTitle&quot;));
				
				var sDealerCd = &quot;&quot;;
				if (Output.GetProperty(&quot;VFDealCode&quot;) != &quot;&quot;) sDealerCd = Output.GetProperty(&quot;VFDealCode&quot;);
				else sDealerCd = Output.GetProperty(&quot;SalesDealerCode&quot;);
				Output.GetChild(0).GetChild(0).GetChild(0).SetProperty(&quot;DealerCd&quot;, sDealerCd);
				
				var sVodRepName = &quot;&quot;;
				if (Output.GetProperty(&quot;VFEmpNo&quot;) != &quot;&quot; &amp;&amp; Output.GetProperty(&quot;VFFirstName&quot;) != &quot;&quot;) sVodRepName = Output.GetProperty(&quot;VFFirstName&quot;);
				else sVodRepName = Output.GetProperty(&quot;SalesPersonFirstName&quot;);
				Output.GetChild(0).GetChild(0).GetChild(0).SetProperty(&quot;VodRepName&quot;, sVodRepName);
								
				Outputs.AddChild(Output.GetChild(0));
			}//if (sFinalOrderId != null &amp;&amp; sFinalOrderId != &quot;&quot;)
		}//if (sOrderId != null &amp;&amp; sOrderId != &quot;&quot;)
	}//try
	catch(e)
	{
		throw(e);
	}
	finally
	{		
		svc = null;
		Input = null;
		Output = null;
		sTSBC = null;
		sTSBO = null;
	}
}"
			   SEQUENCE="28"
