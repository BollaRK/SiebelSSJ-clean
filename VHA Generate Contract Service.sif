			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetNSAEmailInputs"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/* 
 * Component Name        : 	NSA Contract Email Details
 * Method Name           : 	GetNSAEmailInputs
 * Component Information : 	This function will fetch the NSA
 *							contract email inputs to call workflow
 *							VHA Send NSA Email WF
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 17/07/2020	Saravanan J				Initial Version
 */
function mGetNSAEmailInputs(Inputs,Outputs)
{
	try
	{
		var sBO = TheApplication().GetBusObject(&quot;VHA Contract Doc Object&quot;);
		var sBCHeader = sBO.GetBusComp(&quot;VHA Contract Doc Header&quot;);
		var sBCAttr = sBO.GetBusComp(&quot;Order Entry Attachment (Simple)&quot;);
		var svc = TheApplication().GetService(&quot;Workflow Process Manager&quot;);
		var Input = TheApplication().NewPropertySet();
		var Output = TheApplication().NewPropertySet();
		var sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
		var prConId = &quot;&quot;, emailPdfId = &quot;&quot;, sOrderFileName = &quot;&quot;;
		var sFinalOrderId = &quot;&quot;;
		var sTOTBO = TheApplication().GetBusObject(&quot;VHA TOT Generic BO&quot;);
		var sTOTBC = sTOTBO.GetBusComp(&quot;VHA TOT Generic BC&quot;);
		Outputs.SetProperty(&quot;EmailNotify&quot;, &quot;&quot;);
		
		if (sOrderId != null &amp;&amp; sOrderId != &quot;&quot;)
		{	
			with(sTOTBC)
			{
				ActivateField(&quot;Order Id&quot;);
				SetViewMode(AllView);
				ClearToQuery();
				SetSearchSpec(&quot;Id&quot;, sOrderId);
				ExecuteQuery(ForwardOnly);
				if(FirstRecord())
				{
					sFinalOrderId = GetFieldValue(&quot;Order Id&quot;);					
				}
			}
			if (sFinalOrderId != null &amp;&amp; sFinalOrderId != &quot;&quot;)
			{
				with(sBCHeader)
				{
					ActivateField(&quot;Primary Contact Id&quot;);
					SetViewMode(AllView);
					ClearToQuery();
					SetSearchSpec(&quot;Id&quot;, sFinalOrderId);
					ExecuteQuery(ForwardOnly);
					if(FirstRecord())
					{
						prConId = GetFieldValue(&quot;Primary Contact Id&quot;);
						with(sBCAttr)
						{					
							ActivateField(&quot;Order Id&quot;);
							ActivateField(&quot;VF Line Item Id&quot;);
							ActivateField(&quot;OrderFileName&quot;);
							SetViewMode(AllView);
							ClearToQuery();
							SetSearchSpec(&quot;Order Id&quot;, sFinalOrderId);
							ExecuteQuery(ForwardBackward);
							var iRec = FirstRecord();					
							while(iRec)
							{
								emailPdfId = GetFieldValue(&quot;VF Line Item Id&quot;);
								if (emailPdfId.indexOf(&quot;EMAIL.pdf&quot;) &gt;=1)
								{
									emailPdfId = GetFieldValue(&quot;Id&quot;);
									sOrderFileName = GetFieldValue(&quot;OrderFileName&quot;);
									Input.SetProperty(&quot;ProcessName&quot;, &quot;VHA Send NSA Email WF&quot;);
									Input.SetProperty(&quot;PrimaryContactId&quot;, prConId);
									Input.SetProperty(&quot;Object Id&quot;, sFinalOrderId);
									Input.SetProperty(&quot;EmailPdfId&quot;, emailPdfId);
									Input.SetProperty(&quot;AttachNameTNC&quot;, sOrderFileName);
									Input.SetProperty(&quot;OrderComments&quot;, &quot;Y&quot;);
									Input.SetProperty(&quot;MaxRetryCount&quot;, TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_CR_ENABLE_FLAG&quot;, &quot;RetryNSAEmailCount&quot;));
									svc.InvokeMethod(&quot;RunProcess&quot;, Input, Output);
									Outputs.SetProperty(&quot;EmailNotify&quot;, Output.GetProperty(&quot;VHAEmailAdd&quot;));
									break;
								}
								iRec = NextRecord();
							}
						}//with(sBCAttr)
					}
				}//with(sBCHeader)
			}//if (sFinalOrderId != null &amp;&amp; sFinalOrderId != &quot;&quot;)
		}//if (sOrderId != null &amp;&amp; sOrderId != &quot;&quot;)
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		sBCAttr = null;
		sBCHeader = null;
		sBO = null;
		svc = null;
		Input = null;
		Output = null;
		sTOTBC = null;
		sTOTBO = null;
	}
}"
