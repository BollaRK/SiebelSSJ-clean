			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fnFormatDiscountPrice"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/* 
 * Component Name        : 	Round off
 * Method Name           : 	Round off / Truncate
 * Component Information : 	This function does Round off / Truncate
 *							based on type and system
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 28/04/2020	Saravanan J				Initial Version
 */
function fnFormatDiscountPrice (dsInput)
{
	try
	{
		var sPrice = dsInput.GetProperty(&quot;Price&quot;);
		var Type = dsInput.GetProperty(&quot;Type&quot;);
		var System = dsInput.GetProperty(&quot;System&quot;);
		var sSkipThreeDigit = dsInput.GetProperty(&quot;SkipThreeDigit&quot;);
		var sLast2digit = &quot;&quot;;
		var sCalcMeth = &quot;&quot;;
		var arrNum = new Array();
		sPrice = ToString(sPrice);
		
		if(Type != &quot;&quot;)
			sCalcMeth = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_NSA_PRICE_CALC&quot;, Type);
		else
			sCalcMeth = &quot;TRUNCATE&quot;;
		
		if(sCalcMeth != &quot;&quot;)
		{
			switch(sCalcMeth)
			{
				case &quot;TRUNCATE&quot;:
					sPrice = ToString(sPrice);
					if(sPrice.indexOf(&quot;.&quot;) &gt; 0) 
						sPrice = sPrice.substring(0, sPrice.indexOf(&quot;.&quot;)+3);
					else if(sPrice != &quot;&quot;)
						sPrice = sPrice+&quot;.00&quot;;
				break;
				
				case &quot;ROUNDOFF&quot;:
					if(System == &quot;BRM&quot;)
					{
						if(sPrice.indexOf(&quot;.&quot;) &gt; 0)
						{
							sLast2digit = sPrice.substring(sPrice.indexOf(&quot;.&quot;)+1, sPrice.indexOf(&quot;.&quot;)+3); 
							if(sLast2digit == &quot;99&quot;)
								sPrice = sPrice.substring(0, sPrice.indexOf(&quot;.&quot;)+3);
							else
							{
								sPrice = ToNumber(sPrice);	
								sPrice = sPrice.toFixed(2);
							}
						}
						else
						{
							sPrice = ToNumber(sPrice);	
							sPrice = sPrice.toFixed(2);
						}
					}
					else
					{
						sPrice = ToNumber(sPrice);	
						sPrice = sPrice.toFixed(2);
					}
				break;

				default:
				break;				
			}//switch(sCalcMeth)
		}//if(sCalcMeth != &quot;&quot;)
				
		sPrice = ToString(sPrice);
		arrNum = sPrice.split(&quot;.&quot;);
		
		if(arrNum.length &gt; 1)
			sLast2digit = arrNum[1];
		
		if(sLast2digit.length == 1 &amp;&amp; ToNumber(sLast2digit) &lt; 10 &amp;&amp; ToNumber(sLast2digit) != 0)
			sPrice = ToString(sPrice)+&quot;0&quot;;
		
		if (sSkipThreeDigit != &quot;Y&quot;) {
			sPrice = sPrice.replace(/(\d)(?=(\d\d\d)+(?!\d))/g, &quot;$1,&quot;); //add comma between three numbers
		}

		if(ToNumber(sPrice) == 0)
			return &quot;0.00&quot;
		else
			return sPrice;
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		arrNum = null;
	}
}"
			   SEQUENCE="7"
			   UPDATED="12/12/2020 23:30:10"
			   UPDATED_BY="SADMIN"
			   CREATED="06/10/2020 16:27:50"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fnFormatPrice"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function fnFormatPrice(sPrice, Type, System)
{
	try
	{
		var sLast2digit =&quot;&quot;;
		var sCalcMeth = &quot;&quot;;
		var arrNum = new Array();
		sPrice = ToString(sPrice);
		if(Type != &quot;&quot;)
			sCalcMeth = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_NSA_PRICE_CALC&quot;, Type);
		else
			sCalcMeth = &quot;TRUNCATE&quot;;
		
		if(sCalcMeth != &quot;&quot;)
		{
			switch(sCalcMeth)
			{
				case &quot;TRUNCATE&quot;:
					sPrice = ToString(sPrice);
					if(sPrice.indexOf(&quot;.&quot;) &gt; 0) 
						sPrice = sPrice.substring(0, sPrice.indexOf(&quot;.&quot;)+3);
					else if(sPrice != &quot;&quot;)
						sPrice = sPrice+&quot;.00&quot;;
				break;
				
				case &quot;ROUNDOFF&quot;:
					if(System == &quot;BRM&quot;)
					{
						if(sPrice.indexOf(&quot;.&quot;) &gt; 0)
						{
							sLast2digit = sPrice.substring(sPrice.indexOf(&quot;.&quot;)+1, sPrice.indexOf(&quot;.&quot;)+3); 
							if(sLast2digit == &quot;99&quot;)
								sPrice = sPrice.substring(0, sPrice.indexOf(&quot;.&quot;)+3);
							else
							{
								sPrice = ToNumber(sPrice);	
								sPrice = sPrice.toFixed(2);
							}
						}
						else
						{
							sPrice = ToNumber(sPrice);	
							sPrice = sPrice.toFixed(2);
						}
					}
					else
					{
						sPrice = ToNumber(sPrice);	
						sPrice = sPrice.toFixed(2);
					}
				break;
				
			}
		}		
		sPrice = ToString(sPrice);
		arrNum = sPrice.split(&quot;.&quot;);
		
		if(arrNum.length &gt; 1)
			sLast2digit = arrNum[1];
		
		if(sLast2digit.length == 1 &amp;&amp; ToNumber(sLast2digit) &lt; 10 &amp;&amp; ToNumber(sLast2digit) != 0)
			sPrice = ToString(sPrice)+&quot;0&quot;;
		
		sPrice = sPrice.replace(/(\d)(?=(\d\d\d)+(?!\d))/g, &quot;$1,&quot;); //add comma between three numbers
		
		if(ToNumber(sPrice) == 0)
			return &quot;0.00&quot;
		else
			return sPrice;
	}
	catch(e)
	{
		throw e;
	}
	finally
	{
	}
}"
			   SEQUENCE="8"
			   UPDATED="12/12/2020 23:30:09"
			   UPDATED_BY="SADMIN"
			   CREATED="11/06/2019 14:56:32"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fnGetDiscountPrice"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/* 
 * Component Name        : 	Discount Dollar Value
 * Method Name           : 	GetDiscountPrice
 * Component Information : 	This function calculates the dollar discount
 *							value of Credit, Loyalty Discount, Bonus and
 *							Recurring Discount
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 28/04/2020	Saravanan J				Initial Version
 */
function fnGetDiscountPrice(Inputs,Outputs)
{	

try	{
	//Variable declaration
	var sTempMsg = TheApplication().NewPropertySet();
	var sListService = TheApplication().NewPropertySet();
	var sService = TheApplication().NewPropertySet();
	var sSiebMsg = TheApplication().NewPropertySet();
	var sListSimpleProd = TheApplication().NewPropertySet();
	var sSimpleProd = TheApplication().NewPropertySet();
	var sListSiebMsg = TheApplication().NewPropertySet();
	var sOfferSiebMsg = TheApplication().NewPropertySet();
	var sRewdSiebMsg = TheApplication().NewPropertySet();
	var dsInput = TheApplication().NewPropertySet();
	var dsInp = TheApplication().NewPropertySet();
	
	var MaxPrice = &quot;&quot;, sActionCD = &quot;&quot;,sGlobalProdId = &quot;&quot;,sSplSiebType = &quot;&quot;,sGlobalProd = &quot;&quot;,sSplRatType = &quot;&quot;,MaxPriceIncGST = &quot;&quot;,sGSTRate = &quot;&quot;,sBundleDis = &quot;&quot;;
	var pSAMId = &quot;&quot;, dSAMId = &quot;&quot;, pMaxPrice = &quot;&quot;;
	var sSiebProdType = &quot;&quot;, sPlanSAMId = &quot;&quot;;
	var pCount = &quot;&quot;, dCount = &quot;&quot;, sSAMId = &quot;&quot;, sSerPrice = &quot;&quot;, updK = &quot;&quot;, updN = &quot;&quot;, updP = &quot;&quot;, x = 0;
	var sAmount=&quot;&quot;;
	var sExist=&quot;&quot;;
	var sProdDname=&quot;&quot;;
	var sAmountAfterGST=&quot;&quot;;


	
	if(Inputs.GetChildCount() &gt; 0)//Checks Siebel Message
	{
		Outputs.AddChild(Inputs.GetChild(0));
		sTempMsg = Inputs.GetChild(0);
		
		while(sTempMsg.GetChildCount())
		{
			if(sTempMsg.GetType() == &quot;ListOfVHA Contract Doc Service&quot;)
			{
				sListService = sTempMsg;
				break;
			}
			sTempMsg = sTempMsg.GetChild(0);
		}//while(sTempMsg.GetChildCount())
		
		for(var i = 0; i &lt; sListService.GetChildCount(); i++)
		{
			sService = sListService.GetChild(i);
							
			sSiebProdType = sService.GetProperty(&quot;Siebel Product Type&quot;);
			sPlanSAMId = sService.GetProperty(&quot;PlanSAMId&quot;);	
		
			pSAMId = new Array();		
			pMaxPrice = new Array();
			pCount = 0;				
			
			for(var j = 0; j &lt; sService.GetChildCount(); j++)
			{
				sSiebMsg.Reset();
				sSiebMsg = sService.GetChild(j).Copy();				
	
				if(sSiebMsg.GetType() == &quot;ListOfVHA Contract Doc Simple Line Items&quot;)
				{
					sListSimpleProd.Reset();
					sListSimpleProd = sSiebMsg.Copy();					
				
					dSAMId = new Array();
					dCount = 0;
					dsInp.Reset();
				
					for(var k = 0; k &lt; sListSimpleProd.GetChildCount(); k++)
					{
						sSimpleProd.Reset();
						sSimpleProd = sListSimpleProd.GetChild(k).Copy();
						
						sActionCD = sSimpleProd.GetProperty(&quot;Action Code&quot;);
						sGlobalProdId = sSimpleProd.GetProperty(&quot;Global Product Identifier&quot;);
						sSplSiebType = sSimpleProd.GetProperty(&quot;Special Rating Type&quot;);						
						sSAMId = sSimpleProd.GetProperty(&quot;SAM Id&quot;);
						
						if (sSAMId != &quot;&quot; &amp;&amp; sSAMId != null &amp;&amp; sActionCD != &quot;Delete&quot;)
						{
							pSAMId[pCount] = &quot;&apos;&quot;+sSAMId+&quot;&apos;&quot;;
							pMaxPrice[pCount] = sSimpleProd.GetProperty(&quot;Charge Price&quot;);						
							pCount++;
						}
						
						if(sActionCD == &quot;Add&quot; &amp;&amp; (sGlobalProdId == &quot;Credit&quot; || sSplSiebType == &quot;Loyalty Discount&quot;))
						{
							MaxPrice = Math.abs(sSimpleProd.GetProperty(&quot;Charge Price&quot;));
							sSAMId = sSimpleProd.GetProperty(&quot;SAM Id&quot;);
							sSerPrice = sSimpleProd.GetProperty(&quot;Service Price&quot;);
							sAmount = Math.abs(sSimpleProd.GetProperty(&quot;Amount&quot;));
							//GJENA_02032025 Added for Imagine March Rel
							sExist = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;COLT_BRMPROD_LOYALITY&quot;,sSAMId);
							if(sExist == &quot;Y&quot;)
							 {
							var svcBrm=TheApplication().GetService(&quot;VF Network Settings BS&quot;);
                            var Inputa = TheApplication().NewPropertySet();
                            var Outputa = TheApplication().NewPropertySet();
                            Inputa.SetProperty(&quot;Type&quot;,&quot;COLT_BRMPROD_LOYALITY&quot;);
                            Inputa.SetProperty(&quot;LIC&quot;,sSAMId);
                            svcBrm.InvokeMethod(&quot;QueryLOV&quot;,Inputa,Outputa);
                            sProdDname=Outputa.GetProperty(&quot;Desc&quot;);
							 }
							if(MaxPrice != &quot;&quot; &amp;&amp; MaxPrice != null)
							{
								dsInput.Reset();
								dsInput.SetProperty(&quot;Price&quot;, MaxPrice);
								dsInput.SetProperty(&quot;Type&quot;, &quot;&quot;);
								dsInput.SetProperty(&quot;System&quot;, &quot;&quot;);
								MaxPrice = fnFormatDiscountPrice(dsInput);
								sService.GetChild(j).GetChild(k).SetProperty(&quot;Discount Price&quot;, MaxPrice);
							}							
							else if (sSAMId != &quot;&quot; &amp;&amp; sSAMId != null &amp;&amp; sSerPrice != &quot;&quot; &amp;&amp; sSerPrice != null)
							{
								dSAMId[dCount] = &quot;&apos;&quot;+sSAMId+&quot;&apos;&quot;;								
								sService.GetChild(j).GetChild(k).SetProperty(&quot;k&quot;, k);
								dsInp.AddChild(sService.GetChild(j).GetChild(k));
								dCount++;								
							}
							else if(sAmount != &quot;&quot; &amp;&amp; sAmount != null &amp;&amp; sGlobalProdId == &quot;Credit&quot; &amp;&amp; sExist == &quot;Y&quot;)
							{
								sGSTRate = sAmount * (nGST/100);
								sAmountAfterGST = sAmount + ToNumber(sGSTRate);
                                dsInput.Reset();
								dsInput.SetProperty(&quot;Price&quot;, sAmountAfterGST);
								dsInput.SetProperty(&quot;Type&quot;, &quot;AMOUNT_ATTR&quot;);
								dsInput.SetProperty(&quot;System&quot;, &quot;&quot;);
								sAmount = fnFormatDiscountPrice(dsInput);
								sService.GetChild(j).GetChild(k).SetProperty(&quot;Product Name&quot;, sProdDname);
								sService.GetChild(j).GetChild(k).SetProperty(&quot;Discount Price&quot;, sAmount);
							}
							else if(sAmount != &quot;&quot; &amp;&amp; sAmount != null &amp;&amp; sGlobalProdId == &quot;Credit&quot;)
							{
								dsInput.Reset();
								dsInput.SetProperty(&quot;Price&quot;, sAmount);
								dsInput.SetProperty(&quot;Type&quot;, &quot;&quot;);
								dsInput.SetProperty(&quot;System&quot;, &quot;&quot;);
								sAmount = fnFormatDiscountPrice(dsInput);
								sService.GetChild(j).GetChild(k).SetProperty(&quot;Discount Price&quot;, sAmount);
							}
						}//if(sActionCD == &quot;Add&quot; &amp;&amp; (sGlobalProdId == &quot;Credit&quot; || sSplSiebType == &quot;Loyalty Discount&quot;))
					
						if(sActionCD == &quot;Add&quot; &amp;&amp; sGlobalProdId == &quot;Recurring Discount&quot;)
						{
							MaxPrice = Math.abs(sSimpleProd.GetProperty(&quot;Amount&quot;));
							sSAMId = sSimpleProd.GetProperty(&quot;SAM Id&quot;);
							sSerPrice = sSimpleProd.GetProperty(&quot;Service Price&quot;);
							
							if(MaxPrice != &quot;&quot; &amp;&amp; MaxPrice != null)
							{
								sGSTRate = MaxPrice * (nGST/100);
								dsInput.Reset();
								dsInput.SetProperty(&quot;Price&quot;, sGSTRate);
								dsInput.SetProperty(&quot;Type&quot;, &quot;AMOUNT_ATTR&quot;);
								dsInput.SetProperty(&quot;System&quot;, &quot;BRM&quot;);
								dsInput.SetProperty(&quot;SkipThreeDigit&quot;, &quot;Y&quot;);
								sGSTRate = fnFormatDiscountPrice(dsInput);
								
								MaxPriceIncGST = MaxPrice + ToNumber(sGSTRate);
								dsInput.Reset();
								dsInput.SetProperty(&quot;Price&quot;, MaxPriceIncGST);
								dsInput.SetProperty(&quot;Type&quot;, &quot;AMOUNT_ATTR&quot;);
								dsInput.SetProperty(&quot;System&quot;, &quot;BRM&quot;);	
								MaxPriceIncGST	= fnFormatDiscountPrice(dsInput);
								
								sService.GetChild(j).GetChild(k).SetProperty(&quot;Discount Price&quot;, MaxPriceIncGST);	
							}
							else if (sSAMId != &quot;&quot; &amp;&amp; sSAMId != null &amp;&amp; sSerPrice != &quot;&quot; &amp;&amp; sSerPrice != null)
							{
								dSAMId[dCount] = &quot;&apos;&quot;+sSAMId+&quot;&apos;&quot;;								
								sService.GetChild(j).GetChild(k).SetProperty(&quot;k&quot;, k);
								dsInp.AddChild(sService.GetChild(j).GetChild(k));
								dCount++;
							}
						}//if(sActionCD == &quot;Add&quot; &amp;&amp; sGlobalProdId == &quot;Recurring Discount&quot;)
					}//for(var k = 0; k &lt; sListSimpleProd.GetChildCount(); k++)	
										
					if (dsInp.GetChildCount() &gt; 0) {
						fnPercentageDisCalc(pSAMId, pMaxPrice, dSAMId, sSiebProdType, sPlanSAMId, dsInp);
					}
					
					for (x = 0; x &lt; dsInp.GetChildCount(); x++)
					{
						updK = dsInp.GetChild(x).GetProperty(&quot;k&quot;);
						sService.GetChild(j).GetChild(updK).SetProperty(&quot;Discount Price&quot;, dsInp.GetChild(x).GetProperty(&quot;Discount Price&quot;));
					}
				}//if(sSiebMsg.GetType() == &quot;ListOfVHA Contract Doc Simple Line Items&quot;)
				
				if(sSiebMsg.GetType() == &quot;ListOfVF Available Offer&quot;)
				{
					if(sSiebMsg.GetChildCount() &gt; 0)
					{
						sListSiebMsg.Reset();
						sListSiebMsg = sSiebMsg.Copy();
						
						dSAMId = new Array();
						dCount = 0;
						dsInp.Reset();
						
						for(var n = 0; n &lt; sListSiebMsg.GetChildCount(); n++)
						{
							sOfferSiebMsg = sListSiebMsg.GetChild(n).Copy();
							
							if(sOfferSiebMsg.GetProperty(&quot;Status&quot;) == &quot;Pending&quot;)
							{
								if(sOfferSiebMsg.GetChildCount() &gt; 0)
								{								
									for(var p = 0; p &lt; sOfferSiebMsg.GetChild(0).GetChildCount(); p++)
									{
										sRewdSiebMsg = sOfferSiebMsg.GetChild(0).GetChild(p);
										sGlobalProd = sRewdSiebMsg.GetProperty(&quot;Global Product Identifier&quot;);
										sSplRatType = sRewdSiebMsg.GetProperty(&quot;Special Rating Type&quot;);
										if(sGlobalProd == &quot;Credit&quot; || sSplRatType == &quot;Loyalty Discount&quot;)
										{
											MaxPrice = Math.abs(sRewdSiebMsg.GetProperty(&quot;Charge Price&quot;));
											sSAMId = sRewdSiebMsg.GetProperty(&quot;SAM Id&quot;);
											sSerPrice = sRewdSiebMsg.GetProperty(&quot;Service Price&quot;);
							
											if(MaxPrice != &quot;&quot; &amp;&amp; MaxPrice != null)
											{
												dsInput.Reset();
												dsInput.SetProperty(&quot;Price&quot;, MaxPrice);
												dsInput.SetProperty(&quot;Type&quot;, &quot;&quot;);
												dsInput.SetProperty(&quot;System&quot;, &quot;&quot;);
												MaxPrice = fnFormatDiscountPrice(dsInput);
												sService.GetChild(j).GetChild(n).GetChild(0).GetChild(p).SetProperty(&quot;Discount Price&quot;, MaxPrice);
											}
											else if (sSAMId != &quot;&quot; &amp;&amp; sSAMId != null &amp;&amp; sSerPrice != &quot;&quot; &amp;&amp; sSerPrice != null)
											{
												dSAMId[dCount] = &quot;&apos;&quot;+sSAMId+&quot;&apos;&quot;;								
												sService.GetChild(j).GetChild(n).GetChild(0).GetChild(p).SetProperty(&quot;p&quot;, p);
												sService.GetChild(j).GetChild(n).GetChild(0).GetChild(p).SetProperty(&quot;n&quot;, n);
												dsInp.AddChild(sService.GetChild(j).GetChild(n).GetChild(0).GetChild(p));
												dCount++;								
											}
										}			
									}//for(var p = 0; p &lt; sOfferSiebMsg.GetChild(0).GetChildCount(); p++)
								}//if(sOfferSiebMsg.GetChildCount() &gt; 0)
							}//if(sOfferSiebMsg.GetProperty(&quot;Status&quot;) == &quot;Pending&quot;)
						}//for(var n = 0; n &lt; sListSiebMsg.GetChildCount(); n++)
												
						if (dsInp.GetChildCount() &gt; 0) {
							fnPercentageDisCalc(pSAMId, pMaxPrice, dSAMId, sSiebProdType, sPlanSAMId, dsInp);
						}
						
						for (x = 0; x &lt; dsInp.GetChildCount(); x++)
						{
							updN = dsInp.GetChild(x).GetProperty(&quot;n&quot;);
							updP = dsInp.GetChild(x).GetProperty(&quot;p&quot;);							
							sService.GetChild(j).GetChild(updN).GetChild(0).GetChild(updP).SetProperty(&quot;Discount Price&quot;, dsInp.GetChild(x).GetProperty(&quot;Discount Price&quot;));
						}	
					}//if(sSiebMsg.GetChildCount() &gt; 0)			
				}//if(sSiebMsg.GetType() == &quot;ListOfVF Available Offer&quot;)

				if(sSiebMsg.GetType() == &quot;ListOfVHA Bundle Save Offers BC&quot;)
				{
					if(sSiebMsg.GetChildCount() &gt; 0)
					{
						for(var t=0; t &lt; sService.GetChild(j).GetChildCount(); t++)
						{
							if(sService.GetChild(j).GetChild(t).GetProperty(&quot;Status&quot;) == &quot;Active&quot;)
							{
								sBundleDis = Math.abs(sService.GetChild(j).GetChild(t).GetProperty(&quot;New PD Discount IncGST&quot;));
								if(sBundleDis != &quot;&quot; &amp;&amp; sBundleDis != null)
								{
									dsInput.Reset();
									dsInput.SetProperty(&quot;Price&quot;, sBundleDis);
									dsInput.SetProperty(&quot;Type&quot;, &quot;BUNDLE_SAVE&quot;);
									dsInput.SetProperty(&quot;System&quot;, &quot;BRM&quot;);
									sBundleDis = fnFormatDiscountPrice(dsInput);
									sService.GetChild(j).GetChild(t).SetProperty(&quot;Discount Price&quot;, sBundleDis);
								}
							}
						}//for(var t=0; t &lt; sService.GetChild(j).GetChildCount(); t++)
					}//if(sSiebMsg.GetChildCount() &gt; 0)
				}//if(sSiebMsg.GetType() == &quot;ListOfVHA Bundle Save Offers BC&quot;)
			}//for(var j = 0; j &lt; sService.GetChildCount(); j++)
		}//for(var i = 0; i &lt; sListService.GetChildCount(); i++)
	}//if(Inputs.GetChildCount() &gt; 0)
}//try
catch(e) {
	throw(e);
}
finally {
	
}		
}"
			   SEQUENCE="9"
			   UPDATED="04/30/2026 18:18:08"
			   UPDATED_BY="SADMIN"
			   CREATED="06/10/2020 16:27:50"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fnGetGroupName"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function fnGetGroupName(mSAM_ID)
{
	try
	{
		var boGroupMTX = TheApplication().GetBusObject(&quot;VF Plan Group Matrix&quot;);
		var bcGroupMTX = boGroupMTX.GetBusComp(&quot;VF Plan Group Matrix&quot;);
		var fGroupName = &quot;&quot;;
		
		with(bcGroupMTX)
		{  
			ClearToQuery;
			SetViewMode(AllView);
			ActivateField(&quot;Rate Plan SAM Id&quot;);
			ActivateField(&quot;Group Name&quot;);
			SetSearchSpec(&quot;Rate Plan SAM Id&quot;, &quot;&apos;&quot; + mSAM_ID + &quot;&apos;&quot;);     
			ExecuteQuery(ForwardOnly);
			if (FirstRecord())
			{   
				fGroupName = GetFieldValue(&quot;Group Name&quot;);
			}
		}
		return fGroupName;
	}
	catch(e)
	{
		throw e;
	}
	finally
	{
		bcGroupMTX = &quot;&quot;;
		boGroupMTX = &quot;&quot;;
	}
}"
			   SEQUENCE="10"
			   UPDATED="12/12/2020 23:30:14"
			   UPDATED_BY="SADMIN"
			   CREATED="12/12/2020 23:30:14"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fnGetNSAEmailDetails"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/* 
 * Component Name        : 	NSA Email Details
 * Method Name           : 	GetNSAEmailDetails
 * Component Information : 	This function calls the workflow to send
 *							email with NSA Form
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 27/04/2020	Saravanan J				Initial Version
 */
function fnGetNSAEmailDetails(Inputs,Outputs)
{
	try
	{
		var sRowId = Inputs.GetProperty(&quot;RowId&quot;);

		var sParentBO = TheApplication().GetBusObject(&quot;Order Entry Attachment Simple&quot;);
		var	sAttachmentBC = sParentBO.GetBusComp(&quot;Order Entry Attachment (Simple)&quot;);

		var sAttachName = &quot;&quot;, sEmailTempName = &quot;&quot;, sAttachFile = &quot;&quot;, sAbsoluteFilePath = &quot;&quot;;
		
		with(sAttachmentBC)
		{
			ClearToQuery();   
			SetViewMode(AllView);
			ActivateField(&quot;OrderFileName&quot;);
			SetSearchSpec(&quot;Id&quot;, sRowId);
			SetSortSpec(&quot;Created (DESC)&quot;);
			ExecuteQuery(ForwardOnly);
			var isrec = FirstRecord();
			if(isrec)
			{
				sAttachName = GetFieldValue(&quot;OrderFileName&quot;);
				
				if (sAttachName.indexOf(&quot;NSA_FORM&quot;) &gt;= 1 || sAttachName.indexOf(&quot;Fixed_NSA&quot;) &gt;= 1)
				{
					sEmailTempName = &quot;VHA NSA Voice MBB NBN Request&quot;;
				}
				else if (sAttachName.indexOf(&quot;ANYTIME_APP&quot;) &gt;= 1)
				{
					sEmailTempName = &quot;VHA NSA APP Request&quot;;
				}
				else if (sAttachName.indexOf(&quot;Prepay_FORM&quot;) &gt;= 1)
				{
					sEmailTempName = &quot;VHA Prepay Summary Request&quot;;
				}

				sAttachFile = InvokeMethod(&quot;GetFile&quot;, &quot;OrderFileName&quot;);
				sAbsoluteFilePath = sAttachFile.substring(sAttachFile.indexOf(&quot;,&quot;) + 1);
			}
		}
		Outputs.SetProperty(&quot;EmailTemplateName&quot;, sEmailTempName);
		Outputs.SetProperty(&quot;AttachFileList&quot;, sAbsoluteFilePath);
		Outputs.SetProperty(&quot;AttachNameList&quot;, sAttachName + &quot;.pdf&quot;);
	}
	catch(e)
	{
		throw(e);
	}
	finally	{
		sAttachmentBC = null;
		sParentBO = null;
	}
}"
