			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fnGetServiceDetails"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function fnGetServiceDetails(Inputs, Outputs)
{
	try
	{
		var sSiebMsg = TheApplication().NewPropertySet();
		var sTempMsg = TheApplication().NewPropertySet();
		var sDeviceMsg = TheApplication().NewPropertySet();
		var sListService = TheApplication().NewPropertySet();
		var sOfferSiebMsg = TheApplication().NewPropertySet();
		var sRewdSiebMsg = TheApplication().NewPropertySet();
		var sService = TheApplication().NewPropertySet();
		var sListSimpleProd = TheApplication().NewPropertySet();
		var sListSiebMsg = TheApplication().NewPropertySet();
		var sSimpleProd = TheApplication().NewPropertySet();
		var Out = TheApplication().NewPropertySet();
		var dsInput = TheApplication().NewPropertySet();
		
		var sCustAccntId = Inputs.GetProperty(&quot;CustomerAccountId&quot;);
		var bnGB, bnKB, bnB, nIntMin1=0, nIntMin2=0;
		var tGB, tKB, tB,d=0;
		var bGB, bKB, bB;
		var PlanSAMId,sBaseData,sBounsData,sIntl1,sIntl2,sTotalData,IDDMetric1,IDDMetric2,sAccAPPPrice,sGloUId,sAllMSISDN=&quot;&quot;;
		var sStockIndicator,sSerDeviceName,sAllocatedDevice,sAllocatedIMEI,sDeviceName,sSimpProdName,sDesc,sInsurance,sInsId,NBNSpeedTier,NBNPlanValue;
		var sSAMId,sOrderItemId,sOrderId,sCusAssetId,sPlan,sPlanValue,sTerm,sSIM,sActionCD,sEarlyUpdFee,sNPEYFee,sNBNFee,sDevicePayFee,sProdType;//MADHUR::09-MAY-23::Added var sPlanValue for XS-NSA 
		var sAccMonthRepay,sRollOverName,sRollOverMonthPay,sRollOverTerm,sRollOverTotal,sNetAmount,sEEFCharge,sInsCnt;
		var sNBNAppt=&quot;&quot;,sNBNAddress=&quot;&quot;,sNBNTime=&quot;&quot;,sDevContractPresent,sExistCarrier,sMSISDN,sPrice=&quot;&quot;,sPriceListId=&quot;&quot;,PlanValueExGST=&quot;&quot;;
		var sFinalNBNNet = 0;
		var sFlow = Inputs.GetProperty(&quot;Flow&quot;);
	//	var sVHAProdDesc = Inputs.GetProperty(&quot;VHAProdDesc&quot;);//MADHUR::27-JAN-23::Added for XS-NSA for postpay refresh//::MADHUR::09-MAY-23::Inactivated for XS-NSA
		var sIgnoreOffer = new Array();
		var sIgnoreOfferCnt = 0;
		var sSharingIndicator = &quot;&quot;;

		if(Inputs.GetChildCount() &gt; 0)
		{
			Outputs.AddChild(Inputs.GetChild(0));
			sTempMsg = Inputs.GetChild(0);
			
			while(sTempMsg.GetChildCount())
			{
				if(sTempMsg.GetType() == &quot;VHA Contract Doc Header&quot;)
					sPriceListId = sTempMsg.GetProperty(&quot;Price List Id&quot;);
				if(sTempMsg.GetType() == &quot;ListOfVHA Contract Doc Service&quot;)
				{
					sListService = sTempMsg;
					break;
				}
				sTempMsg = sTempMsg.GetChild(0);
			}
			
			for(var i = 0; i &lt; sListService.GetChildCount(); i++)
			{
				sService = sListService.GetChild(i);
				sInsurance= new Array();
				sInsId= new Array();
				bGB = 0, bKB = 0, bB = 0;
				bnGB = 0, bnKB = 0, bnB = 0;
				tGB = 0, tKB = 0, tB = 0;
				nIntMin1=0, nIntMin2=0, IDDMetric1 = &quot;&quot;, IDDMetric2 =&quot;&quot;;
				PlanSAMId=&quot;&quot;,sBaseData = &quot;&quot;, sBounsData = &quot;&quot;, sIntl1 = &quot;&quot;, sIntl2 = &quot;&quot;, sTotalData = &quot;&quot;, sGloUId=&quot;&quot;;
				sEarlyUpdFee = &quot;NA&quot;, sNPEYFee = &quot;NA&quot;, sNBNFee = &quot;NA&quot;, sDevicePayFee = &quot;&quot;;
				sRollOverName=&quot;&quot;,sRollOverMonthPay=&quot;&quot;,sRollOverTerm=&quot;&quot;,sRollOverTotal=&quot;&quot;,sNetAmount=0,sEEFCharge=0,sInsCnt=0;
				sAccMonthRepay=&quot;&quot;,sPlan=&quot;&quot;,sPlanValue=&quot;&quot;,sTerm=&quot;&quot;,sSIM=&quot;&quot;,sActionCD=&quot;&quot;,sAccAPPPrice=&quot;&quot;,NBNSpeedTier=&quot;&quot;,NBNPlanValue=&quot;&quot;;//MADHUR::09-MAY-23::Added var sPlanValue for XS-NSA 
				sStockIndicator=&quot;&quot;,sDevContractPresent=&quot;N&quot;,sSerDeviceName=&quot;&quot;,sAllocatedDevice=&quot;&quot;,sAllocatedIMEI=&quot;&quot;;
				sSAMId=&quot;&quot;,sDeviceName=&quot;&quot;,sSimpProdName=&quot;&quot;,sDesc=&quot;&quot;,sExistCarrier=&quot;&quot;,sMSISDN=&quot;&quot;,PlanValueExGST=&quot;&quot;;
				sSharingIndicator = &quot;&quot;;
				sDeviceMsg = TheApplication().NewPropertySet();
				sOrderItemId = sService.GetProperty(&quot;Root Order Item Id&quot;);
				sOrderId = sService.GetProperty(&quot;Order Id&quot;);
				sCusAssetId = sService.GetProperty(&quot;Custom Asset Integration Id&quot;);
				sSerDeviceName = sService.GetProperty(&quot;Device Name&quot;); 
				sStockIndicator = sService.GetProperty(&quot;Out of Stock Indicator Flag&quot;);
				sMSISDN = sService.GetProperty(&quot;VHA MSISDN Calc&quot;);
				
				if(sAllMSISDN == &quot;&quot;)
					sAllMSISDN = sMSISDN;
				else
					sAllMSISDN = sAllMSISDN+&quot;, &quot;+sMSISDN;

				Outputs.SetProperty(&quot;AllMSISDN&quot;,sAllMSISDN);				

				sExistCarrier = mGetTransferNumberDetails(sCustAccntId,sMSISDN,sOrderId);
				if(sExistCarrier != &quot;&quot;)
				{
					d++;
					Outputs.SetProperty(&quot;MSISDN&quot;+d,d+&quot;. &quot;+sMSISDN);
					Outputs.SetProperty(&quot;ExistingCarrierInfo&quot;+d,sExistCarrier);
				}
			
				Inputs.SetProperty(&quot;CustAssetIntId&quot;, sCusAssetId);
				Inputs.SetProperty(&quot;OrderItemId&quot;, sOrderItemId);
				sSIM = mGetSIMDetails(Inputs,Outputs);
				sService.SetProperty(&quot;SIM&quot;, sSIM);
				
				mGetRatePlanAttr(sOrderItemId,sOrderId,sPlan,sTerm,NBNSpeedTier,NBNPlanValue,PlanValueExGST,PlanSAMId,sSharingIndicator,sPlanValue);//MADHUR::09-MAY-23::Added var sPlanValue for XS-NSA 
			//	mGetRatePlanAttr(sOrderItemId,sOrderId,sPlan,sTerm,NBNSpeedTier,NBNPlanValue,PlanValueExGST,PlanSAMId,sSharingIndicator,sVHAProdDesc);//MADHUR::27-JAN-23::Created for XS-NSA for postpay refresh//::MADHUR::09-MAY-23::Inactivated for XS-NSA	
				sService.SetProperty(&quot;Plan&quot;, sPlan);
				sService.SetProperty(&quot;PlanVal&quot;, &quot;$&quot;+sPlanValue);//MADHUR::09-MAY-23::Added var sPlanValue for XS-NSA 
				sService.SetProperty(&quot;PlanTerm&quot;, sTerm);
				sService.SetProperty(&quot;PlanValue&quot;, NBNPlanValue);
				sService.SetProperty(&quot;PlanValueExGST&quot;, PlanValueExGST);	
				sService.SetProperty(&quot;PlanSAMId&quot;, PlanSAMId);
				sService.SetProperty(&quot;SharingIndicator&quot;, sSharingIndicator);		
				
				for(var j = 0; j &lt; sService.GetChildCount(); j++)
				{
					sSiebMsg.Reset();
					sSiebMsg = sService.GetChild(j).Copy();
					
					if(sSiebMsg.GetType() == &quot;ListOfVHA Contract Doc Simple Line Items&quot;)
					{
						sListSimpleProd.Reset();
						sListSimpleProd = sSiebMsg.Copy();
						for(var k = 0; k &lt; sListSimpleProd.GetChildCount(); k++)
						{
							sSimpleProd.Reset();
							sSimpleProd = sListSimpleProd.GetChild(k).Copy();
							
							fnGetPricefromPriceList(sPriceListId, sSimpleProd.GetProperty(&quot;Prod Id&quot;),sService.GetChild(j).GetChild(k));
							
							sActionCD = sSimpleProd.GetProperty(&quot;Action Code&quot;);
							if(sActionCD != &quot;Delete&quot;)
							{
								sSimpProdName = sSimpleProd.GetProperty(&quot;Product Name&quot;);
								sSAMId = sSimpleProd.GetProperty(&quot;SAM Id&quot;);
								sGloUId = sSimpleProd.GetProperty(&quot;Global Product Identifier&quot;);
								if(sSimpleProd.GetProperty(&quot;Siebel Product Type&quot;) == &quot;EEF Rollover&quot; &amp;&amp; sActionCD == &quot;Add&quot;)
									sRollOverTerm = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_NSA_EEF_TERM&quot;, sSAMId);
								
								if(sSimpleProd.GetProperty(&quot;Siebel Product Type&quot;) == &quot;Insurance&quot;)
								{
									if(sActionCD == &quot;Add&quot;)
									{
										sInsurance[sInsCnt] = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_NSA_INS&quot;, sSAMId);
										sInsId[sInsCnt] = sSimpleProd.GetProperty(&quot;Related Asset Integration Id&quot;);
										sInsCnt = ToNumber(sInsCnt) + 1;
									}
								}
								
								
								if(sSimpleProd.GetProperty(&quot;Product Type&quot;) == &quot;Hardware&quot; &amp;&amp; (sSimpProdName == &quot;Device&quot; || sSimpProdName == &quot;Device-Siebel Only&quot;) &amp;&amp; sActionCD == &quot;Add&quot;)
									sDeviceName = sSimpleProd.GetProperty(&quot;Device Name&quot;);
								
								if(sGloUId == &quot;Base Allowance&quot;)
								{
									mGetProductEntitlementsData(sSAMId,&quot;BaseData&quot;,Out);
									
									bKB = bKB + ToNumber(Out.GetProperty(&quot;KB&quot;));
									bB = bB + ToNumber(Out.GetProperty(&quot;B&quot;));
									bGB = bGB + ToNumber(Out.GetProperty(&quot;GB&quot;));
									
									Out.Reset();
									mGetProductEntitlementsData(sSAMId,&quot;IDDZone1&quot;,Out);
									nIntMin1 = nIntMin1 + ToNumber(Out.GetProperty(&quot;IDDZone&quot;));
									if(Out.GetProperty(&quot;IDDZone&quot;) &gt; 0)
										IDDMetric1 = Out.GetProperty(&quot;IDDMetric&quot;);
									
									Out.Reset();
									mGetProductEntitlementsData(sSAMId,&quot;IDDZone2&quot;,Out);
									nIntMin2 = nIntMin2 + ToNumber(Out.GetProperty(&quot;IDDZone&quot;));
									if(Out.GetProperty(&quot;IDDZone&quot;) &gt; 0)
										IDDMetric2 = Out.GetProperty(&quot;IDDMetric&quot;);
								}
								
								if(sGloUId == &quot;Bonus Data&quot; || sGloUId ==&quot;Bonus IDD&quot;)
								{
									mGetProductEntitlementsData(sSAMId,&quot;BonusData&quot;,Out);
									
									bnKB = bnKB + ToNumber(Out.GetProperty(&quot;KB&quot;));
									bnB = bnB + ToNumber(Out.GetProperty(&quot;B&quot;));
									bnGB = bnGB + ToNumber(Out.GetProperty(&quot;GB&quot;));
								}
							}
						}
					}
					if(sSiebMsg.GetType() == &quot;ListOfVF Available Offer&quot;)
					{
						if(sSiebMsg.GetChildCount() &gt; 0)
						{
							sListSiebMsg.Reset();
							sListSiebMsg = sSiebMsg.Copy();
							for(var n = 0; n &lt; sListSiebMsg.GetChildCount(); n++)
							{
								sOfferSiebMsg = sListSiebMsg.GetChild(n).Copy();
								
								if(sOfferSiebMsg.GetProperty(&quot;Status&quot;) == &quot;Pending&quot;)
								{
									if(sOfferSiebMsg.GetChildCount() &gt; 0)
									{
										for(var p = 0; p &lt; sOfferSiebMsg.GetChild(0).GetChildCount(); p++)
										{
											sRewdSiebMsg = sOfferSiebMsg.GetChild(0).GetChild(p);
											sGloUId = sRewdSiebMsg.GetProperty(&quot;Global Product Identifier&quot;);
											if(sGloUId == &quot;Bonus Data&quot; || sGloUId == &quot;Bonus IDD&quot;)
											{
												mGetProductEntitlementsData(sRewdSiebMsg.GetProperty(&quot;SAM Id&quot;),&quot;BonusData&quot;,Out);
												
												bnKB = bnKB + ToNumber(Out.GetProperty(&quot;KB&quot;));
												bnB = bnB + ToNumber(Out.GetProperty(&quot;B&quot;));
												bnGB = bnGB + ToNumber(Out.GetProperty(&quot;GB&quot;));
											}
											fnGetPricefromPriceList(sPriceListId, sRewdSiebMsg.GetProperty(&quot;Prod Id&quot;),sService.GetChild(j).GetChild(n).GetChild(0).GetChild(p));
										}
									}
								}
								if(sOfferSiebMsg.GetProperty(&quot;Invalidated Offer Flag&quot;) == &quot;Y&quot;)
								{
									if (sFlow == &quot;TOT&quot;)//JS:24082020 Added for digital TOT
									{
										sIgnoreOffer[sIgnoreOfferCnt] = sOfferSiebMsg.GetProperty(&quot;Row Id&quot;);
										sIgnoreOfferCnt++;
									}
									if(sOfferSiebMsg.GetChildCount() &gt; 0)
									{
										for(var g = 0; g &lt; sOfferSiebMsg.GetChild(0).GetChildCount(); g++)
										{
											sRewdSiebMsg = sOfferSiebMsg.GetChild(0).GetChild(g);
											sSAMId = sRewdSiebMsg.GetProperty(&quot;SAM Id&quot;);
											
											if(fnProdSearch(sService, sSAMId, sFlow) == &quot;Y&quot;)
											{
												mGetProductEntitlementsData(sRewdSiebMsg.GetProperty(&quot;SAM Id&quot;),&quot;BonusData&quot;,Out);
												
												bnKB = bnKB - ToNumber(Out.GetProperty(&quot;KB&quot;));
												bnB = bnB - ToNumber(Out.GetProperty(&quot;B&quot;));
												bnGB = bnGB - ToNumber(Out.GetProperty(&quot;GB&quot;));
											}
										}
									}
								}
							}
						}
					}
					if(sSiebMsg.GetType() == &quot;ListOfVF Allocate IMEI&quot;)
					{
						if(sSiebMsg.GetChildCount() &gt; 0)
						{
							sAllocatedDevice = sSiebMsg.GetChild(0).GetProperty(&quot;Device Name&quot;);
							sAllocatedIMEI = sSiebMsg.GetChild(0).GetProperty(&quot;IMEI&quot;);
						}
					}
					if(sSiebMsg.GetType() == &quot;ListOfVHA Contract Doc Device&quot;)
					{
						if(sSiebMsg.GetChildCount() &gt; 0)
						{
							for(var s = 0; s &lt; sService.GetChild(j).GetChildCount(); s++)
							{
								if(sService.GetChild(j).GetChild(s).GetProperty(&quot;Action Code&quot;) == &quot;Add&quot;)
								{
									sDeviceMsg = sService.GetChild(j).GetChild(s);
									sDevContractPresent = &quot;Y&quot;;
								}
							}
						}
						else if(sDevContractPresent == &quot;N&quot;)
						{
							sDeviceMsg.SetType(&quot;VHA Contract Doc Device&quot;);
							sDeviceMsg.SetProperty(&quot;Item Name&quot;, &quot;&quot;);
							sDeviceMsg.SetProperty(&quot;IMEI&quot;, &quot;&quot;);
							sDeviceMsg.SetProperty(&quot;Insurance&quot;, &quot;&quot;);
							sDeviceMsg.SetProperty(&quot;Term Num&quot;, &quot;&quot;);
							sDeviceMsg.SetProperty(&quot;Contract Amount Calc&quot;, &quot;&quot;);
							sDeviceMsg.SetProperty(&quot;Action Code&quot;, &quot;Add&quot;);
							sDeviceMsg.SetProperty(&quot;Out of Stock Indicator Flag&quot;, sStockIndicator);
							sService.GetChild(j).AddChild(sDeviceMsg);
						}
					}

					if(sSiebMsg.GetType() == &quot;ListOfVHA NBN Order Details&quot;)
					{
						if(sSiebMsg.GetChildCount() &gt; 0)
						{
							sListSiebMsg.Reset();
							sListSiebMsg = sSiebMsg.Copy();
							for(var t = 0; t &lt; sListSiebMsg.GetChildCount(); t++)
							{
								sNBNAddress = sListSiebMsg.GetChild(t).GetProperty(&quot;NBN Address Calc&quot;);
							}
						}
					}
					if(sSiebMsg.GetType() == &quot;ListOfVHA NBN Appointment&quot;)
					{
						if(sSiebMsg.GetChildCount() &gt; 0)
						{
							sListSiebMsg.Reset();
							sListSiebMsg = sSiebMsg.Copy();
							for(var b = 0; b &lt; sListSiebMsg.GetChildCount(); b++) 
							{
								sNBNAppt = sListSiebMsg.GetChild(b).GetProperty(&quot;Appointment Start Date&quot;);
								sNBNTime = fnTimeFormat (sNBNAppt);
								sNBNAppt = fnDateFormat (sNBNAppt);
							}
						}
					}				
					if(sSiebMsg.GetType() == &quot;ListOfVF One Off Charges&quot;)
					{
						if(sSiebMsg.GetChildCount() &gt; 0)
						{
							sListSiebMsg.Reset();
							sListSiebMsg = sSiebMsg.Copy();
							sFinalNBNNet = 0;
							for(var m = 0; m &lt; sListSiebMsg.GetChildCount(); m++)
							{
								sDesc = sListSiebMsg.GetChild(m).GetProperty(&quot;Description&quot;);
								sProdType = sListSiebMsg.GetChild(m).GetProperty(&quot;Product Type&quot;);
								sNetAmount = sListSiebMsg.GetChild(m).GetProperty(&quot;Net Amount&quot;);
								sEEFCharge = sListSiebMsg.GetChild(m).GetProperty(&quot;VHA EEF/EUF monthly charge Calc&quot;)
								
								if(sDesc == &quot;Early Upgrade Fee&quot; || sDesc == &quot;Early Resign Fee&quot;)
								{
									sEarlyUpdFee = ToNumber(sNetAmount) + (ToNumber(sNetAmount) * nGST)/100;
									sEarlyUpdFee = fnFormatPrice(sEarlyUpdFee, &quot;EARLY_UPD_FEE&quot;, &quot;BRM&quot;);
								}
								
								if(sDesc == &quot;Upgrade Every Year Claim Fee&quot;)
								{
									sNPEYFee = ToNumber(sNetAmount) + (ToNumber(sNetAmount) * nGST)/100;
									sNPEYFee = fnFormatPrice(sNPEYFee, &quot;NPEY_FEE&quot;, &quot;BRM&quot;);
								}
								
								if(sDesc == &quot;NBN New Development Charge&quot; || sDesc == &quot;nbn Additional Line&quot; || sDesc == &quot;Opticomm New Development Charge&quot; || sDesc == &quot;Vision New Development Charge&quot;) // JS 04052020 Modified for NSA dollar breakdown//ADUTTA:Modified for NDC

								{
									sNBNFee = ToNumber(sNetAmount) + (ToNumber(sNetAmount) * nGST)/100;
									dsInput.Reset();
									dsInput.SetProperty(&quot;Price&quot;, sNBNFee);
									dsInput.SetProperty(&quot;Type&quot;, &quot;NBN_FEE&quot;);
									dsInput.SetProperty(&quot;System&quot;, &quot;BRM&quot;);
									dsInput.SetProperty(&quot;SkipThreeDigit&quot;, &quot;Y&quot;);
									sFinalNBNNet = ToNumber(sFinalNBNNet) + ToNumber(fnFormatDiscountPrice(dsInput));
								}
								
								if(sProdType == &quot;One-off GPP Charge Siebel&quot;)
								{
									sDevicePayFee = ToNumber(sDevicePayFee) + ToNumber(sNetAmount);
								}
								if(sProdType == &quot;One-off Charge Siebel&quot;)
								{
									if(ToNumber(sNetAmount) &gt; 0 &amp;&amp; ToNumber(sEEFCharge) &gt; 0)
									{
										sRollOverName = &quot;Early Upgrade Fee Rollover&quot;;
										
										sRollOverMonthPay = ToNumber(sEEFCharge) + (ToNumber(sEEFCharge) * nGST)/100;
										sRollOverMonthPay = fnFormatPrice(sRollOverMonthPay, &quot;ROLLOVER_PAY&quot;, &quot;&quot;);
		
										sRollOverTotal = ToNumber(sNetAmount) + (ToNumber(sNetAmount) * nGST)/100;
										sRollOverTotal = fnFormatPrice(sRollOverTotal, &quot;ROLLOVER_TOTAL&quot;, &quot;BRM&quot;);
									}
								}
							}
						}
					}
				}
				tGB = bnGB + bGB;
				tKB = bnKB + bKB;
				tB = bnB + bB;
				
				if(ToString(tGB).indexOf(&quot;.&quot;) &gt; 0)
					tGB = tGB.toFixed(2);
				if(ToString(bnGB).indexOf(&quot;.&quot;) &gt; 0)
					bnGB = bnGB.toFixed(2);
				if(ToString(bGB).indexOf(&quot;.&quot;) &gt; 0)
					bGB = bGB.toFixed(2);
				
				if(bGB &gt; 0 &amp;&amp; bKB &gt; 0 &amp;&amp; bB &gt; 0)
					sBaseData = bGB+&quot;GB&quot;+&quot; + &quot;+bKB+&quot;KB&quot;+&quot; + &quot;+bB+&quot;B&quot;;
				else if(bGB &gt; 0 &amp;&amp; bKB &gt; 0)
					sBaseData = bGB+&quot;GB&quot;+&quot; + &quot;+bKB+&quot;KB&quot;;
				else if(bGB &gt; 0)
					sBaseData = bGB+&quot;GB&quot;;
					
				if(bnGB &gt; 0 &amp;&amp; bnKB &gt; 0 &amp;&amp; bnB &gt; 0)
					sBounsData = bnGB+&quot;GB&quot;+&quot; + &quot;+bnKB+&quot;KB&quot;+&quot; + &quot;+bnB+&quot;B&quot;;
				else if(bnGB &gt; 0 &amp;&amp; bnKB &gt; 0)
					sBounsData = bnGB+&quot;GB&quot;+&quot; + &quot;+bnKB+&quot;KB&quot;;
				else if(bnGB &gt; 0)
					sBounsData = bnGB+&quot;GB&quot;;
					
				if(tGB &gt; 0 &amp;&amp; tKB &gt; 0 &amp;&amp; tB &gt; 0)
					sTotalData = tGB+&quot;GB&quot;+&quot; + &quot;+tKB+&quot;KB&quot;+&quot; + &quot;+tB+&quot;B&quot;;
				else if(tGB &gt; 0 &amp;&amp; tKB &gt; 0)
					sTotalData = tGB+&quot;GB&quot;+&quot; + &quot;+tKB+&quot;KB&quot;;
				else if(tGB &gt; 0)
					sTotalData = tGB+&quot;GB&quot;;
					
				sService.SetProperty(&quot;BaseData&quot;,sBaseData);
				sService.SetProperty(&quot;BonusData&quot;,sBounsData);
				sService.SetProperty(&quot;TotalData&quot;,sTotalData);
				
				if(nIntMin1 &gt; 0)
					sService.SetProperty(&quot;IntZone1&quot;,ToString(nIntMin1)+&quot; &quot;+IDDMetric1);					

				if(nIntMin2 &gt; 0)
					sService.SetProperty(&quot;IntZone2&quot;,ToString(nIntMin2)+&quot; &quot;+IDDMetric2);

				if(sDeviceMsg.GetProperty(&quot;Item Name&quot;) == &quot;&quot;)
				{
					if(sAllocatedDevice != &quot;&quot;)
						sDeviceMsg.SetProperty(&quot;Item Name&quot;, sAllocatedDevice);
					else
						sDeviceMsg.SetProperty(&quot;Item Name&quot;, sDeviceName);
				}
				for(var ins=0;ins &lt; sInsCnt;ins++)
				{			
					if(sDeviceMsg.GetProperty(&quot;Related Asset Integration Id&quot;) == sInsId[ins])
						sDeviceMsg.SetProperty(&quot;Insurance&quot;, sInsurance[ins]);
				}
						
				if(sDeviceMsg.GetProperty(&quot;IMEI&quot;) == &quot;&quot;)
				{
					if(sAllocatedIMEI != &quot;&quot;)
						sDeviceMsg.SetProperty(&quot;IMEI&quot;, sAllocatedIMEI);
				}
				sService.SetProperty(&quot;RollOverName&quot;, sRollOverName);
				sService.SetProperty(&quot;RollOverMonthPay&quot;, sRollOverMonthPay);
				sService.SetProperty(&quot;RollOverTerm&quot;, sRollOverTerm);
				sService.SetProperty(&quot;RollOverTotal&quot;, sRollOverTotal);
				
				sService.SetProperty(&quot;EarlyUpgradeFee&quot;, sEarlyUpdFee);
				if(sDevicePayFee != &quot;&quot;)
					sService.SetProperty(&quot;DevicePayoutFee&quot;, ToString(sDevicePayFee).replace(/(\d)(?=(\d\d\d)+(?!\d))/g, &quot;$1,&quot;));
				else
					sService.SetProperty(&quot;DevicePayoutFee&quot;, &quot;NA&quot;);
				sService.SetProperty(&quot;NPEYFee&quot;, sNPEYFee);
				
				if(sService.GetProperty(&quot;Siebel Product Type&quot;) == &quot;NBN Only&quot; || sService.GetProperty(&quot;Siebel Product Type&quot;) == &quot;NBN with MBB&quot;)
				{
					if(sNBNFee != &quot;NA&quot;) // JS 04052020 Modified for NSA dollar breakdown
					{
						dsInput.Reset();
						dsInput.SetProperty(&quot;Price&quot;, sFinalNBNNet);
						dsInput.SetProperty(&quot;Type&quot;, &quot;NBN_FEE&quot;);
						dsInput.SetProperty(&quot;System&quot;, &quot;BRM&quot;);
						sFinalNBNNet = fnFormatDiscountPrice(dsInput);
						Outputs.SetProperty(&quot;NBNDevFee&quot;, &quot;$&quot;+sFinalNBNNet+&quot; Incl. GST&quot;);
					}	
					else
						Outputs.SetProperty(&quot;NBNDevFee&quot;, sNBNFee);
					Outputs.SetProperty(&quot;NBNSpeedTier&quot;, NBNSpeedTier);
					Outputs.SetProperty(&quot;NBNPlanValue&quot;, &quot;$&quot;+NBNPlanValue);
					Outputs.SetProperty(&quot;NBNAddress&quot;, sNBNAddress);
					Outputs.SetProperty(&quot;NBNAppt&quot;, sNBNAppt);	
					Outputs.SetProperty(&quot;NBNTime&quot;, sNBNTime);
					
					if(sDeviceMsg.GetProperty(&quot;Item Name&quot;) == &quot;&quot;)
					{
						if(sSerDeviceName != &quot;&quot;)
							sDeviceMsg.SetProperty(&quot;Item Name&quot;, sSerDeviceName);
					}
				}
				fnGetServiceDetailsExt(sService,sIgnoreOffer,sFlow);
			} // service: End
		}		
	}
	catch(e)
	{
		throw e;
	}
	finally
	{
	}
}"
			   SEQUENCE="17"
			   UPDATED="12/23/2024 21:29:59"
			   UPDATED_BY="ANGANAD"
			   CREATED="11/06/2019 14:56:32"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fnGetServiceDetailsExt"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function fnGetServiceDetailsExt(sService,sIgnoreOffer,sFlow)
{
	try
	{
		var sSiebMsg = TheApplication().NewPropertySet();
		var sListSimpleProd = TheApplication().NewPropertySet();
		var sSimpleProd = TheApplication().NewPropertySet();
				
		var sSAMId = &quot;&quot;, sActionCD = &quot;&quot;, sProdType = &quot;&quot;, sSimpProdName = &quot;&quot;,sAccAPPPrice=&quot;&quot;,sPrice=&quot;&quot;,sAccMonthRepay=&quot;&quot;, sInsSAMId =&quot;&quot;;
		var ar=0,arr=0,aSerIndex=new Array(),aSDIndex=new Array(),aSDId=new Array(),aSDInsId=new Array(),aSDIns=new Array();
		var sServOutofStock=&quot;N&quot;, nSerPrepay = 0;
		
		if(sService.GetProperty(&quot;Out of Stock Indicator Flag&quot;) == &quot;Y&quot;)
			sServOutofStock = &quot;Y&quot;;
		
		sInsSAMId = sService.GetProperty(&quot;Insurance SAM Id&quot;);
		
		//JS:25082020 Added for digital TOT Starts
		var sCOIBO = &quot;&quot;, sCOIBC = &quot;&quot;, sCOIIntId = &quot;&quot;;
		var sCOIProp = TheApplication().NewPropertySet();
		if(sFlow == &quot;TOT&quot;)
		{
			sCOIBO = TheApplication().GetBusObject(&quot;VHA Offer Report Processing BO&quot;);
			sCOIBC = sCOIBO.GetBusComp(&quot;VHA Offer Report Processing BC&quot;);
			var sIgnoreOfferCnt = sIgnoreOffer.length;
			var siCOISearchExpr = &quot;&quot;;
			var iCOI = 0;
			
			for(iCOI = 0; iCOI &lt; sIgnoreOfferCnt; iCOI++)
			{
				if(siCOISearchExpr == &quot;&quot;)
					siCOISearchExpr = &quot;[Status Cd] = &apos;Active&apos; AND [Offer Hst Id] = &apos;&quot;+sIgnoreOffer[iCOI]+&quot;&apos;&quot;;
				else
					siCOISearchExpr = siCOISearchExpr + &quot; OR [Offer Hst Id] = &apos;&quot;+sIgnoreOffer[iCOI]+&quot;&apos;&quot;;
			}

			if(siCOISearchExpr != &quot;&quot;)
			{
				with(sCOIBC)
				{
					ClearToQuery();   
					SetViewMode(AllView);
					ActivateField(&quot;Offer Hst Id&quot;);
					ActivateField(&quot;Asset Integ Id&quot;);
					ActivateField(&quot;Status Cd&quot;);
					SetSearchExpr(siCOISearchExpr);
					ExecuteQuery(ForwardOnly);
					var iCOIrec = FirstRecord();
					while(iCOIrec)
					{
						var offhstIntAID = GetFieldValue(&quot;Asset Integ Id&quot;);
						if (offhstIntAID != &quot;&quot; &amp;&amp; offhstIntAID != null) {
							sCOIProp.SetProperty(offhstIntAID, offhstIntAID);
						}
						iCOIrec = NextRecord();
					}
				}
			}//if (siCOISearchExpr != &quot;&quot;)			
		}//if (sFlow == &quot;TOT&quot;)
		//JS:25082020 Added for digital TOT Ends
		
		for(var j = 0; j &lt; sService.GetChildCount(); j++)
		{
			sSiebMsg.Reset();
			sSiebMsg = sService.GetChild(j).Copy();
			
			if(sSiebMsg.GetType() == &quot;ListOfVHA Contract Doc Accessory&quot;)
			{
				sListSimpleProd.Reset();
				sListSimpleProd = sSiebMsg.Copy();
				for(var x = 0; x &lt; sListSimpleProd.GetChildCount(); x++)
				{
					sSimpleProd.Reset();
					sSimpleProd = sListSimpleProd.GetChild(x).Copy();
					
					if (TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_NSA_ACTION_CD&quot;, sSimpleProd.GetProperty(&quot;Action Code&quot;)) == &quot;Y&quot;)
					{
						if(sSimpleProd.GetProperty(&quot;Out of Stock Indicator Flag&quot;) == &quot;Y&quot;)
							sServOutofStock = &quot;Y&quot;;
						
						nSerPrepay = ToNumber(nSerPrepay) + ToNumber(sSimpleProd.GetProperty(&quot;Prepayment Amount Num&quot;));
						
						if(sSimpleProd.GetProperty(&quot;Category&quot;) == &quot;Secondary Device&quot;)
						{
							aSerIndex[arr] = j;
							aSDIndex[arr] = x;
							aSDId[arr] = sSimpleProd.GetProperty(&quot;Related Asset Integration Id&quot;);
							arr++;
						}
						if(sSimpleProd.GetProperty(&quot;Category&quot;) != &quot;Secondary Device&quot;)
							sAccAPPPrice = sSimpleProd.GetProperty(&quot;Total APP Amount&quot;);
								
						sAccMonthRepay = fnFormatPrice(sSimpleProd.GetProperty(&quot;MonthlyRepayment&quot;), &quot;ACC_MONTH&quot;, &quot;&quot;);
						sPrice = fnFormatPrice(sSimpleProd.GetProperty(&quot;Price Calc&quot;),&quot;&quot;,&quot;&quot;);
						sService.GetChild(j).GetChild(x).SetProperty(&quot;MonthlyRepayment&quot;, sAccMonthRepay);
						sService.GetChild(j).GetChild(x).SetProperty(&quot;Price&quot;, sPrice);
								
						sService.GetChild(j).GetChild(x).SetProperty(&quot;APP Monthly Repayment Calc&quot;, fnFormatPrice(sSimpleProd.GetProperty(&quot;APP Monthly Repayment Num&quot;),&quot;&quot;,&quot;&quot;));
						sService.GetChild(j).GetChild(x).SetProperty(&quot;APP Contract Amount&quot;, fnFormatPrice(sSimpleProd.GetProperty(&quot;Total APP Amount&quot;),&quot;&quot;,&quot;&quot;));
						
						sService.SetProperty(&quot;APP Total Contract Amount&quot;, fnFormatPrice(sAccAPPPrice,&quot;&quot;,&quot;&quot;));
					}
				}
			}
			
			if(sSiebMsg.GetType() == &quot;ListOfVHA Contract Doc Device&quot;)
			{
				sListSimpleProd.Reset();
				sListSimpleProd = sSiebMsg.Copy();
				for(var y = 0; y &lt; sListSimpleProd.GetChildCount(); y++)
				{
					sSimpleProd.Reset();
					sSimpleProd = sListSimpleProd.GetChild(y).Copy();
					
					if (TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_NSA_ACTION_CD&quot;, sSimpleProd.GetProperty(&quot;Action Code&quot;)) == &quot;Y&quot;)
					{
						nSerPrepay = ToNumber(nSerPrepay) + ToNumber(sSimpleProd.GetProperty(&quot;Prepayment Amount&quot;));
	
						sService.GetChild(j).GetChild(y).SetProperty(&quot;Monthly Repayment Calc&quot;, fnFormatPrice(sSimpleProd.GetProperty(&quot;Monthly Repayment Num&quot;),&quot;&quot;,&quot;&quot;));
						sService.GetChild(j).GetChild(y).SetProperty(&quot;Contract Amount Calc&quot;, fnFormatPrice(sSimpleProd.GetProperty(&quot;Contract Amount Num&quot;),&quot;&quot;,&quot;&quot;));
						
						if(sSimpleProd.GetProperty(&quot;Insurance SAM Id&quot;) == &quot;&quot; &amp;&amp; sInsSAMId != &quot;&quot;)
						{
							sService.GetChild(j).GetChild(y).SetProperty(&quot;Insurance SAM Id&quot;, sInsSAMId);
							sService.GetChild(j).GetChild(y).SetProperty(&quot;Insurance&quot;, TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_NSA_INS&quot;, sInsSAMId));
						}
					}
				}
			}
			
			if(sSiebMsg.GetType() == &quot;ListOfVHA Contract Doc Simple Line Items&quot;)
			{
				sListSimpleProd.Reset();
				sListSimpleProd = sSiebMsg.Copy();
				for(var k = 0; k &lt; sListSimpleProd.GetChildCount(); k++)
				{
					sSimpleProd.Reset();
					sSimpleProd = sListSimpleProd.GetChild(k).Copy();
					
					sActionCD = sSimpleProd.GetProperty(&quot;Action Code&quot;);
					if(sActionCD != &quot;Delete&quot;)
					{
						sSimpProdName = sSimpleProd.GetProperty(&quot;Product Name&quot;);
						sSAMId = sSimpleProd.GetProperty(&quot;SAM Id&quot;);					
						if(sSimpleProd.GetProperty(&quot;Siebel Product Type&quot;) == &quot;SD Insurance&quot;)
						{
							if(sActionCD == &quot;Add&quot;)
							{
								aSDIns[ar] = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_NSA_SD_INS&quot;, sSAMId);
								aSDInsId[ar]=sSimpleProd.GetProperty(&quot;Related Asset Integration Id&quot;);
								ar++;
							}
						}
						
						//JS:25082020 Added for digital TOT Starts
						if(sFlow == &quot;TOT&quot;)
						{
							sCOIIntId = sSimpleProd.GetProperty(&quot;Integration Id&quot;);
							if (sCOIProp.GetProperty(sCOIIntId) == sCOIIntId &amp;&amp; sCOIIntId != &quot;&quot; &amp;&amp; sCOIIntId != null)
							{
								sService.GetChild(j).GetChild(k).SetProperty(&quot;NSA Flow&quot;, &quot;ExcludeForTOT&quot;);
							}
						}
						//JS:25082020 Added for digital TOT Ends
					}
				}
			}
		}
		sService.SetProperty(&quot;Deferred Service&quot;, sServOutofStock);
		sService.SetProperty(&quot;Prepayment Amount&quot;, nSerPrepay);
		fnGetSDInsurance(sService, aSerIndex, aSDIndex, aSDId, aSDInsId, aSDIns);
	}
	catch(e)
	{
		throw e;
	}
	finally
	{
		sCOIBC = null;
		sCOIBO = null;
	}
}"
			   SEQUENCE="18"
			   UPDATED="06/28/2024 18:49:22"
			   UPDATED_BY="SADMIN"
			   CREATED="11/06/2019 14:56:32"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fnGetTOTServiceDetails"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function fnGetTOTServiceDetails(TOTHeaderId,&amp;sPlan,&amp;sTerm,&amp;NBNSpeedTier,&amp;NBNPlanValue,&amp;PlanValueExGST,&amp;PlanSAMId,&amp;nIntMin1,&amp;nIntMin2,&amp;bnGB,&amp;bnKB,&amp;bnB,&amp;sPD,&amp;sPDDisc,&amp;bGB,&amp;bKB,&amp;bB,&amp;sSharingIndicator,&amp;sPlanValue)//MADHUR::15-05-23::Added for CPVT813-XS-NSA PlanValue
//function fnGetTOTServiceDetails(TOTHeaderId,&amp;sPlan,&amp;sTerm,&amp;NBNSpeedTier,&amp;NBNPlanValue,&amp;PlanValueExGST,&amp;PlanSAMId,&amp;nIntMin1,&amp;nIntMin2,&amp;bnGB,&amp;bnKB,&amp;bnB,&amp;sPD,&amp;sPDDisc,&amp;bGB,&amp;bKB,&amp;bB,&amp;sSharingIndicator,&amp;sToTProdDesc)//MADHUR::30-JAN-23::Modified for XS-NSA for postpay refresh//::MADHUR::09-MAY-23::Inactivated for XS-NSA
{
	try
	{
		var oBO = TheApplication().GetBusObject(&quot;VHA TOT Generic BO&quot;);
		var oBC = oBO.GetBusComp(&quot;VHA TOT Offer Details BC&quot;);
		var sRec = &quot;&quot;;
		
		var psInp = TheApplication().NewPropertySet();
		var psOut = TheApplication().NewPropertySet();		
					
		with(oBC)
		{
			ClearToQuery();
			SetViewMode(AllView);
			ActivateField(&quot;Product Name&quot;);
			ActivateField(&quot;TOTPlanPrice&quot;);
			ActivateField(&quot;TOTPlanPriceExGST&quot;);
			ActivateField(&quot;ProductSamId&quot;);
			ActivateField(&quot;BaseIDDZone1&quot;);
			ActivateField(&quot;BaseIDDZone2&quot;);
			ActivateField(&quot;BundleSavePerc&quot;);
			ActivateField(&quot;BaseDataB&quot;);
			ActivateField(&quot;BaseDataKB&quot;);
			ActivateField(&quot;BaseDataGB&quot;);
			ActivateField(&quot;BonusDataB&quot;);
			ActivateField(&quot;BonusDataGB&quot;)
			ActivateField(&quot;BonusDataKB&quot;);
			ActivateField(&quot;DiscountPrice&quot;);
			ActivateField(&quot;GPI&quot;);
			SetSearchSpec(&quot;Par Row Id&quot;, TOTHeaderId);
			SetSearchSpec(&quot;GPI&quot;, &quot;&apos;RatePlan&apos; OR &apos;BundleSave&apos;&quot;);
			ExecuteQuery(ForwardOnly);
			sRec = FirstRecord();
			while(sRec)
			{
				if(GetFieldValue(&quot;GPI&quot;) == &quot;RatePlan&quot;)
				{
					sPlan = GetFieldValue(&quot;Product Name&quot;);
					NBNPlanValue = GetFieldValue(&quot;TOTPlanPrice&quot;);
					sPlanValue = GetFieldValue(&quot;TOTPlanPrice&quot;);//MADHUR::15-05-23::Added for CPVT813-XS-NSA PlanValue
					PlanValueExGST = GetFieldValue(&quot;TOTPlanPriceExGST&quot;);
					PlanSAMId = GetFieldValue(&quot;ProductSamId&quot;);
					nIntMin1 = GetFieldValue(&quot;BaseIDDZone1&quot;);
					nIntMin2 = GetFieldValue(&quot;BaseIDDZone2&quot;);
					bnB = GetFieldValue(&quot;BonusDataB&quot;);
					bnGB = GetFieldValue(&quot;BonusDataGB&quot;)
					bnKB = GetFieldValue(&quot;BonusDataKB&quot;);
					bB = GetFieldValue(&quot;BaseDataB&quot;);
					bGB = GetFieldValue(&quot;BaseDataGB&quot;);
					bKB = GetFieldValue(&quot;BaseDataKB&quot;);

					psInp.SetProperty(&quot;InpProduct&quot;, sPlan);
					mGetRatePlanAttrValuesFromProduct(psInp, psOut);
					sSharingIndicator = psOut.GetProperty(&quot;SharingIndicator&quot;);
					//sToTProdDesc = 	psOut.GetProperty(&quot;ToTProdDesc&quot;); //MADHUR::30-JAN-23::Added for XS-NSA for postpay refresh//::MADHUR::09-MAY-23::Inactivated for XS-NSA
					//sPlan = sToTProdDesc; //MADHUR::30-JAN-23::Added for XS-NSA for postpay refresh//::MADHUR::09-MAY-23::Inactivated for XS-NSA
					sTerm = psOut.GetProperty(&quot;New Term&quot;);
					if(sTerm == &quot;&quot;) {
						sTerm = &quot;Month to Month&quot;;
					}
					NBNSpeedTier = psOut.GetProperty(&quot;NBN Speed&quot;);

				}
				if(GetFieldValue(&quot;GPI&quot;) == &quot;BundleSave&quot;)
				{
					sPD = GetFieldValue(&quot;BundleSavePerc&quot;);
					sPDDisc = GetFieldValue(&quot;DiscountPrice&quot;);
				}
				sRec = NextRecord();
			}
		}
	}
	catch(e)
	{
		throw e;
	}
	finally
	{
		oBC = null;
		oBO = null;
		psInp = null;
		psOut = null;
	}
}"
			   SEQUENCE="21"
			   UPDATED="09/03/2025 17:18:13"
			   UPDATED_BY="SUMA"
			   CREATED="09/18/2020 14:22:35"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fnGetTotalMonthlyCost"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function fnGetTotalMonthlyCost(Inputs,Outputs)
{
	try
	{
		var sTempMsg = TheApplication().NewPropertySet();
		var sListService = TheApplication().NewPropertySet();
		var sService = TheApplication().NewPropertySet();
		var sSiebMsg = TheApplication().NewPropertySet();
		var sListSimpleProd = TheApplication().NewPropertySet();
		var sSimpleProd = TheApplication().NewPropertySet();
		var sListSiebMsg = TheApplication().NewPropertySet();
		var sOfferSiebMsg = TheApplication().NewPropertySet();
		var sRewdSiebMsg = TheApplication().NewPropertySet();
		
		var nPlanDisAmt, sPlanSAMId, sSAMId = &quot;&quot;, nParaDisAmt = 0, nSeqDisAmt = 0, a = 0, nTotalPrice = 0, nChrgPrice=0, nAddChrgPrice=0, nSubChrgPrice=0, sActionCD = &quot;&quot;, sProdName = &quot;&quot;, sPlanValue = 0, sSerPrice=0, sBundleDis = 0, nDisAmt=0, sSiebProdType = &quot;&quot;;
		var nTotalTaxAmt = 0, nTotalGST = 0;
		var aSAMId = new Array();
		var aMaxPrice = new Array();
		var aServPrice = new Array();
		var aDisPrice = new Array();
		var sFlow = &quot;&quot;;
		
		if(Inputs.GetChildCount() &gt; 0)
		{
			Outputs.AddChild(Inputs.GetChild(0));
			sTempMsg = Inputs.GetChild(0);
			
			while(sTempMsg.GetChildCount())
			{
				if(sTempMsg.GetType() == &quot;ListOfVHA Contract Doc Service&quot;)
				{
					sListService = sTempMsg;
					break;
				}
				sTempMsg = sTempMsg.GetChild(0);
			}
			
			for(var i = 0; i &lt; sListService.GetChildCount(); i++)
			{
				sService = sListService.GetChild(i);
				nPlanDisAmt = 0,sPlanSAMId = &quot;&quot;, sSAMId = &quot;&quot;, nParaDisAmt = 0, nSeqDisAmt = 0,	sSiebProdType = &quot;&quot;, nTotalPrice = 0, nChrgPrice=0, nAddChrgPrice=0, nSubChrgPrice=0, sActionCD = &quot;&quot;, sProdName = &quot;&quot;, sPlanValue = 0, sSerPrice=0, sBundleDis = 0, nDisAmt=0;
				nTotalTaxAmt = 0, nTotalGST = 0;
				
				aSAMId = new Array();
				aMaxPrice = new Array();
				aServPrice = new Array();
				aDisPrice = new Array();
				a = 0;
				
				if(sService.GetProperty(&quot;RollOverMonthPay&quot;) != &quot;&quot;)
					nAddChrgPrice = ToNumber(sService.GetProperty(&quot;RollOverMonthPay&quot;));
					
				if(sService.GetProperty(&quot;PlanValueExGST&quot;) != &quot;&quot;)
					sPlanValue = ToNumber(sService.GetProperty(&quot;PlanValueExGST&quot;));
				
				sSiebProdType = sService.GetProperty(&quot;Siebel Product Type&quot;);
				sPlanSAMId = sService.GetProperty(&quot;PlanSAMId&quot;);
				
				for(var j = 0; j &lt; sService.GetChildCount(); j++)
				{
					sSiebMsg.Reset();
					sSiebMsg = sService.GetChild(j).Copy();
					
					if(sSiebMsg.GetType() == &quot;ListOfVHA Contract Doc Simple Line Items&quot;)
					{
						sListSimpleProd.Reset();
						sListSimpleProd = sSiebMsg.Copy();
						for(var k = 0; k &lt; sListSimpleProd.GetChildCount(); k++)
						{
							sSimpleProd.Reset();
							sSimpleProd = sListSimpleProd.GetChild(k).Copy();
							
							sActionCD = sSimpleProd.GetProperty(&quot;Action Code&quot;);
							sProdName = sSimpleProd.GetProperty(&quot;Product Name&quot;);
							if(sActionCD != &quot;Delete&quot;)
							{
								nChrgPrice = sSimpleProd.GetProperty(&quot;Charge Price&quot;);
								sSAMId = sSimpleProd.GetProperty(&quot;SAM Id&quot;);
								nTotalTaxAmt = nTotalTaxAmt + ToNumber(sSimpleProd.GetProperty(&quot;Taxable Price&quot;));
								if(sSAMId != &quot;&quot;)
								{
									aSAMId[a] = &quot;&apos;&quot;+sSAMId+&quot;&apos;&quot;;
									aMaxPrice[a] = sSimpleProd.GetProperty(&quot;Charge Price&quot;);
									aDisPrice[a] = 0;
									aServPrice[a] = sSimpleProd.GetProperty(&quot;Service Price&quot;);
									a++;
								}
								
								if(ToNumber(nChrgPrice) &gt;= 0)
									nAddChrgPrice = nAddChrgPrice + ToNumber(nChrgPrice);
								else if(ToNumber(nChrgPrice) &lt; 0)
									nSubChrgPrice = nSubChrgPrice + ToNumber(Math.abs(nChrgPrice));
									
								if(TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_NSA_AMT_ATTR_PROD&quot;, sSAMId) == &quot;Y&quot;)
								{
									nChrgPrice = ToNumber(sSimpleProd.GetProperty(&quot;Amount&quot;));
									
									nChrgPrice = fnFormatPrice(nChrgPrice, &quot;AMOUNT_ATTR&quot;,&quot;&quot;);
									nSubChrgPrice = nSubChrgPrice + ToNumber(Math.abs(nChrgPrice));
									nTotalTaxAmt = nTotalTaxAmt - ToNumber(nChrgPrice);
								}
								
								if(TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_NSA_RAT_PLAN_DIS&quot;,sSAMId) == &quot;Y&quot;)
								{
									sSerPrice = Math.abs(sSimpleProd.GetProperty(&quot;Service Price&quot;));
									if(nDisAmt != sPlanValue)
									{
										if((ToNumber(nDisAmt) + (sSerPrice * sPlanValue/100)) &gt; sPlanValue)
											nDisAmt = sPlanValue;
										else
											nDisAmt = ToNumber(nDisAmt) + (sSerPrice * sPlanValue/100);
									}								
								}
							}
						}
					}
					
					if(sSiebMsg.GetType() == &quot;ListOfVF Available Offer&quot;)
					{
						if(sSiebMsg.GetChildCount() &gt; 0)
						{
							sListSiebMsg.Reset();
							sListSiebMsg = sSiebMsg.Copy();
							for(var n = 0; n &lt; sListSiebMsg.GetChildCount(); n++)
							{
								sOfferSiebMsg = sListSiebMsg.GetChild(n).Copy();
								
								if(sOfferSiebMsg.GetProperty(&quot;Status&quot;) == &quot;Pending&quot;)
								{
									if(sOfferSiebMsg.GetChildCount() &gt; 0)
									{
										for(var p = 0; p &lt; sOfferSiebMsg.GetChild(0).GetChildCount(); p++)
										{
											sRewdSiebMsg = sOfferSiebMsg.GetChild(0).GetChild(p);
											
											nChrgPrice = sRewdSiebMsg.GetProperty(&quot;Charge Price&quot;);
											nTotalTaxAmt = nTotalTaxAmt + ToNumber(sRewdSiebMsg.GetProperty(&quot;Taxable Price&quot;));
								
											if(ToNumber(nChrgPrice) &gt;= 0)
												nAddChrgPrice = nAddChrgPrice + ToNumber(nChrgPrice);
											else if(ToNumber(nChrgPrice) &lt; 0)
												nSubChrgPrice = nSubChrgPrice + ToNumber(Math.abs(nChrgPrice));
												
											if(sRewdSiebMsg.GetProperty(&quot;SAM Id&quot;) != &quot;&quot;)
											{
												aSAMId[a] = &quot;&apos;&quot;+sRewdSiebMsg.GetProperty(&quot;SAM Id&quot;)+&quot;&apos;&quot;;
												aMaxPrice[a] = sRewdSiebMsg.GetProperty(&quot;Charge Price&quot;);
												aDisPrice[a] = 0;
												aServPrice[a] = sRewdSiebMsg.GetProperty(&quot;Service Price&quot;);
												a++;
											}	
										}
									}
								}
								if(sOfferSiebMsg.GetProperty(&quot;Invalidated Offer Flag&quot;) == &quot;Y&quot;)
								{
									if(sOfferSiebMsg.GetChildCount() &gt; 0)
									{
										for(var g = 0; g &lt; sOfferSiebMsg.GetChild(0).GetChildCount(); g++)
										{
											sRewdSiebMsg = sOfferSiebMsg.GetChild(0).GetChild(g);
											sSAMId = sRewdSiebMsg.GetProperty(&quot;SAM Id&quot;);
											
											if(fnProdSearch(sService.Copy(), sSAMId, sFlow) == &quot;Y&quot;)
											{
												nChrgPrice = sRewdSiebMsg.GetProperty(&quot;Charge Price&quot;);
												
												if(ToNumber(nChrgPrice) &gt;= 0)
													nAddChrgPrice = nAddChrgPrice - ToNumber(nChrgPrice);
												else if(ToNumber(nChrgPrice) &lt; 0)
													nSubChrgPrice = nSubChrgPrice - ToNumber(Math.abs(nChrgPrice));
												
												nTotalTaxAmt = nTotalTaxAmt - ToNumber(sRewdSiebMsg.GetProperty(&quot;Taxable Price&quot;));
											}
										}
									}
								}
							}
						}
					}
					
					if(sSiebMsg.GetType() == &quot;ListOfVHA Contract Doc Accessory&quot;)
					{
						sListSimpleProd.Reset();
						sListSimpleProd = sSiebMsg.Copy();
						
						for(var q = 0; q &lt; sListSimpleProd.GetChildCount(); q++)
						{	
							sSimpleProd.Reset();
							sSimpleProd = sListSimpleProd.GetChild(q).Copy();
							
							sActionCD = sSimpleProd.GetProperty(&quot;Action Code&quot;);
							if(sActionCD != &quot;Delete&quot;)
							{
								nChrgPrice = sSimpleProd.GetProperty(&quot;MonthlyRepayment&quot;);
								
								if(ToNumber(nChrgPrice) &gt;= 0)
									nAddChrgPrice = nAddChrgPrice + ToNumber(nChrgPrice);
								else if(ToNumber(nChrgPrice) &lt; 0)
									nSubChrgPrice = nSubChrgPrice + ToNumber(Math.abs(nChrgPrice));
							}
						}
					}
					
					if(sSiebMsg.GetType() == &quot;ListOfVHA Contract Doc Device&quot;)
					{
						if(sSiebMsg.GetChildCount() &gt; 0)
						{
							for(var s = 0; s &lt; sService.GetChild(j).GetChildCount(); s++)
							{
								if(sService.GetChild(j).GetChild(s).GetProperty(&quot;Action Code&quot;) != &quot;Delete&quot;)
								{
									if(sService.GetChild(j).GetChild(s).GetProperty(&quot;Type&quot;) == &quot;Billing - GPP&quot;)
									{
										nChrgPrice = sService.GetChild(j).GetChild(s).GetProperty(&quot;Monthly Repayment&quot;);
								
										if(ToNumber(nChrgPrice) &gt;= 0)
											nAddChrgPrice = nAddChrgPrice + ToNumber(nChrgPrice);
										else if(ToNumber(nChrgPrice) &lt; 0)
											nSubChrgPrice = nSubChrgPrice + ToNumber(Math.abs(nChrgPrice));
									}
									else if(sService.GetChild(j).GetChild(s).GetProperty(&quot;Type&quot;) == &quot;Billing - MPP&quot;)
									{
										nChrgPrice = sService.GetChild(j).GetChild(s).GetProperty(&quot;Estimated Monthly Repayment&quot;);
								
										if(ToNumber(nChrgPrice) &gt;= 0)
											nAddChrgPrice = nAddChrgPrice + ToNumber(nChrgPrice);
										else if(ToNumber(nChrgPrice) &lt; 0)
											nSubChrgPrice = nSubChrgPrice + ToNumber(Math.abs(nChrgPrice));
									}
								}
							}
						}
					}
					if(sSiebMsg.GetType() == &quot;ListOfVHA Bundle Save Offers BC&quot;)
					{
						if(sSiebMsg.GetChildCount() &gt; 0)
						{
							for(var t = 0; t &lt; sService.GetChild(j).GetChildCount(); t++)
							{
								if(sService.GetChild(j).GetChild(t).GetProperty(&quot;Status&quot;) == &quot;Active&quot;)
								{
									sBundleDis = Math.abs(sService.GetChild(j).GetChild(t).GetProperty(&quot;New PD&quot;));
									
									if(nDisAmt != sPlanValue)
									{
										if((ToNumber(nDisAmt) + (sBundleDis * sPlanValue/100)) &gt; sPlanValue)
											nDisAmt = sPlanValue;
										else
											nDisAmt = ToNumber(nDisAmt) + (sBundleDis * sPlanValue/100);
									}									
								}
							}
						}
					}
				}
				nPlanDisAmt = nDisAmt;
		//		nDisAmt = fnFormatPrice(nDisAmt, &quot;BUNDLE_SAVE&quot;,&quot;&quot;);
				nTotalTaxAmt = nTotalTaxAmt - ToNumber(nDisAmt);
				
				nParaDisAmt = fnParaSeqDisCalc(aSAMId, aMaxPrice, aServPrice, &quot;Parallel&quot;, sSiebProdType, sPlanValue, aDisPrice, sPlanSAMId, nPlanDisAmt);
		//		nParaDisAmt = fnFormatPrice(nParaDisAmt, &quot;PARA_DISCOUNT&quot;,&quot;&quot;);
				nTotalTaxAmt = nTotalTaxAmt - ToNumber(nParaDisAmt);
				
				nSeqDisAmt = fnParaSeqDisCalc(aSAMId, aMaxPrice, aServPrice, &quot;Sequential&quot;, sSiebProdType, sPlanValue, aDisPrice, sPlanSAMId, nPlanDisAmt);
		//		nSeqDisAmt = fnFormatPrice(nSeqDisAmt, &quot;SEQ_DISCOUNT&quot;,&quot;&quot;);
				nTotalTaxAmt = nTotalTaxAmt - ToNumber(nSeqDisAmt);
				
				nTotalGST = ToNumber(nTotalTaxAmt) * ToNumber(nGST)/100;
				nTotalGST = fnFormatPrice(nTotalGST, &quot;TOTAL_GST&quot;, &quot;BRM&quot;);
				
				nTotalPrice = ToNumber(nAddChrgPrice) - ToNumber(nDisAmt) - ToNumber(nParaDisAmt) - ToNumber(nSeqDisAmt) - ToNumber(nSubChrgPrice);
				nTotalPrice = ToNumber(nTotalPrice) + ToNumber(nTotalGST);
				nTotalPrice = fnFormatPrice(nTotalPrice, &quot;TOTAL_COST&quot;,&quot;&quot;);
				
				sService.SetProperty(&quot;TotalMonthlyCost&quot;, nTotalPrice);
			}
		}
	}
	catch(e)
	{
		throw e;
	}
	finally
	{
	}
}"
			   SEQUENCE="20"
			   UPDATED="09/03/2025 17:18:13"
			   UPDATED_BY="SUMA"
			   CREATED="11/06/2019 14:56:32"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fnParaSeqDisCalc"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function fnParaSeqDisCalc(aSAMId, aMaxPrice, aServPrice, sType, sPropType, sPlanValue, &amp;aDisPrice, sPlanSAMId, &amp;nPlanDisAmt)
{
	try
	{
		var oBO = TheApplication().GetBusObject(&quot;VF Price Matrix&quot;); 
		var oBC = oBO.GetBusComp(&quot;VHA Parallel Sequential Discounts&quot;);
		var sDisProd = &quot;&quot;, sApplProd = &quot;&quot;, sDisAmt = 0, nMaxPrice = 0, nDisPer = 0, sRec = &quot;&quot;, sApplType =&quot;&quot;, nDisAmtCheck =0;
		
		if(aSAMId.length &gt; 0)
		{
			with(oBC)
			{ 
				ClearToQuery();
				SetViewMode(AllView);
				ActivateField(&quot;Applicable SAM Id&quot;);
				ActivateField(&quot;Discount SAM Id&quot;);
				ActivateField(&quot;Applicable Product&quot;);
				SetSearchSpec(&quot;Applicable SAM Id&quot;, aSAMId.join(&quot; OR &quot;)+&quot; OR IS NULL&quot;);
				SetSearchSpec(&quot;Discount SAM Id&quot;, aSAMId.join(&quot; OR &quot;));
				SetSearchSpec(&quot;Discount Mode&quot;, sType);
				ExecuteQuery(ForwardOnly);
				sRec = FirstRecord();
				while(sRec)
				{
					nMaxPrice = 0, nDisPer = 0, nDisAmtCheck= 0;
					sDisProd = &quot;&apos;&quot;+GetFieldValue(&quot;Discount SAM Id&quot;)+&quot;&apos;&quot;;
					sApplProd = GetFieldValue(&quot;Applicable SAM Id&quot;);						
					
					if(sApplProd == &quot;&quot;)
					{
						sApplProd = &quot;&apos;&quot;+sPlanSAMId+&quot;&apos;&quot;;
						sApplType = GetFieldValue(&quot;Applicable Product&quot;);
						if(sPropType == sApplType)
						{
							nMaxPrice = Math.abs(aMaxPrice[fnSearchArray(aSAMId, sApplProd)]);
							nDisAmtCheck = nPlanDisAmt;
						}
						else
							nMaxPrice = 0;
					}
					else
					{
						sApplProd = &quot;&apos;&quot;+sApplProd+&quot;&apos;&quot;;
						nMaxPrice = Math.abs(aMaxPrice[fnSearchArray(aSAMId, sApplProd)]);
						nDisAmtCheck = Math.abs(aDisPrice[fnSearchArray(aSAMId, sApplProd)]);
					}
					if(nMaxPrice &gt; 0)
					{
						nDisPer = Math.abs(aServPrice[fnSearchArray(aSAMId, sDisProd)]);
						nDisAmtCheck = ToNumber(nDisAmtCheck);
						if(nDisAmtCheck != nMaxPrice)
						{
							if((nDisAmtCheck + (ToNumber(nMaxPrice) * ToNumber(nDisPer) / 100)) &gt;= nMaxPrice)
							{
								sDisAmt = nMaxPrice - nDisAmtCheck;
								nDisAmtCheck = nMaxPrice - nDisAmtCheck;
							}
							else
							{
								sDisAmt = sDisAmt + (ToNumber(nMaxPrice) * ToNumber(nDisPer) / 100);
								nDisAmtCheck = nDisAmtCheck + (ToNumber(nMaxPrice) * ToNumber(nDisPer) / 100);
							}
							aDisPrice[fnSearchArray(aSAMId, sApplProd)] = nDisAmtCheck;
							
							if(sPropType == sApplType)
								nPlanDisAmt = nDisAmtCheck;
						}
					}
					sRec = NextRecord();
				}
			}
		}
		return ToNumber(sDisAmt);
	}
	catch(e)
	{
		throw e;
	}
	finally
	{
	}
}"
			   SEQUENCE="22"
			   UPDATED="09/03/2025 17:18:13"
			   UPDATED_BY="SUMA"
			   CREATED="11/06/2019 14:56:32"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fnPercentageDisCalc"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/* 
 * Component Name        : 	Percentage Discount Dollar Value
 * Method Name           : 	GetDiscountPrice
 * Component Information : 	This function calculates the dollar discount
 *							value of Credit, Loyalty Discount, Bonus and
 *							Recurring Discount in case of percentage discounts
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 04/05/2020	Saravanan J				Initial Version
 */
function fnPercentageDisCalc(pSAMId, pMaxPrice, dSAMId, sSiebProdType, sPlanSAMId, dsInp)
{
	try
	{
		var oBO = TheApplication().GetBusObject(&quot;VF Price Matrix&quot;); 
		var oBC = oBO.GetBusComp(&quot;VHA Parallel Sequential Discounts&quot;);
		var dsInput = TheApplication().NewPropertySet();
		var sDisProd = &quot;&quot;, sApplProd = &quot;&quot;, nMaxPrice = 0, nDisPer = 0, sRec = &quot;&quot;, sApplType =&quot;&quot;;
		var sExGSTRate = &quot;&quot;, sGSTRate = &quot;&quot;, sDiscountPrice = &quot;&quot;;
			
		if(pSAMId.length &gt; 0 &amp;&amp; dSAMId.length &gt; 0)
		{			
			with(oBC)
			{ 
				ClearToQuery();
				SetViewMode(AllView);
				ActivateField(&quot;Applicable SAM Id&quot;);
				ActivateField(&quot;Discount SAM Id&quot;);
				ActivateField(&quot;Applicable Product&quot;);
				SetSearchSpec(&quot;Applicable SAM Id&quot;, pSAMId.join(&quot; OR &quot;)+&quot; OR IS NULL&quot;);
				SetSearchSpec(&quot;Discount SAM Id&quot;, dSAMId.join(&quot; OR &quot;));
				ExecuteQuery(ForwardOnly);
				sRec = FirstRecord();
				while(sRec)
				{				
					sDisProd = GetFieldValue(&quot;Discount SAM Id&quot;);
					sApplProd = GetFieldValue(&quot;Applicable SAM Id&quot;);						
					
					if(sApplProd == &quot;&quot;)
					{					
						sApplProd = &quot;&apos;&quot;+sPlanSAMId+&quot;&apos;&quot;;
						sApplType = GetFieldValue(&quot;Applicable Product&quot;);
						if(sSiebProdType == sApplType)
						{
							nMaxPrice = Math.abs(pMaxPrice[fnSearchArray(pSAMId, sApplProd)]);
																						
							if (nMaxPrice != &quot;&quot; &amp;&amp; nMaxPrice != null)
							{
								for (var x = 0; x &lt; dsInp.GetChildCount(); x++)
								{						
									if (dsInp.GetChild(x).GetProperty(&quot;SAM Id&quot;) == sDisProd) {								
										nDisPer = Math.abs(dsInp.GetChild(x).GetProperty(&quot;Service Price&quot;));
																			
										if (nDisPer != &quot;&quot; &amp;&amp; nDisPer != null)
										{
											sExGSTRate = nMaxPrice * (nDisPer/100);																			
											dsInput.Reset();
											dsInput.SetProperty(&quot;Price&quot;, sExGSTRate);
											dsInput.SetProperty(&quot;Type&quot;, &quot;PERCENT_DISC&quot;);
											dsInput.SetProperty(&quot;System&quot;, &quot;BRM&quot;);
											dsInput.SetProperty(&quot;sSkipThreeDigit&quot;, &quot;Y&quot;);
											sExGSTRate = fnFormatDiscountPrice(dsInput);
											
											sGSTRate = ToNumber(sExGSTRate) * (nGST/100);											
											dsInput.Reset();
											dsInput.SetProperty(&quot;Price&quot;, sGSTRate);
											dsInput.SetProperty(&quot;Type&quot;, &quot;PERCENT_DISC&quot;);
											dsInput.SetProperty(&quot;System&quot;, &quot;BRM&quot;);
											dsInput.SetProperty(&quot;sSkipThreeDigit&quot;, &quot;Y&quot;);
											sGSTRate = fnFormatDiscountPrice(dsInput);										
											
											sDiscountPrice = ToNumber(sExGSTRate) + ToNumber(sGSTRate);											
											dsInput.Reset();
											dsInput.SetProperty(&quot;Price&quot;, sDiscountPrice);
											dsInput.SetProperty(&quot;Type&quot;, &quot;PERCENT_DISC&quot;);
											dsInput.SetProperty(&quot;System&quot;, &quot;BRM&quot;);
											sDiscountPrice = fnFormatDiscountPrice(dsInput);
																						
											dsInp.GetChild(x).SetProperty(&quot;Discount Price&quot;, sDiscountPrice);
										}//if (nDisPer != &quot;&quot; &amp;&amp; nDisPer != null)
									}//if (dsInp.GetChild(x).GetProperty(&quot;SAM Id&quot;) == sDisProd)							
								}//for (var x = 0; x &lt; dsInp.GetChildCount(); x++)
							}//if (nMaxPrice != &quot;&quot; &amp;&amp; nMaxPrice != null)							
						}//if(sSiebProdType == sApplType)
					}//if(sApplProd == &quot;&quot;)
					else
					{
						sApplProd = &quot;&apos;&quot;+sApplProd+&quot;&apos;&quot;;
						nMaxPrice = Math.abs(pMaxPrice[fnSearchArray(pSAMId, sApplProd)]);
						
						if (nMaxPrice != &quot;&quot; &amp;&amp; nMaxPrice != null)
						{
							for (var x = 0; x &lt; dsInp.GetChildCount(); x++)
							{
								if (dsInp.GetChild(x).GetProperty(&quot;SAM Id&quot;) == sDisProd) {
									nDisPer = Math.abs(dsInp.GetChild(x).GetProperty(&quot;Service Price&quot;));
									
									if (nDisPer != &quot;&quot; &amp;&amp; nDisPer != null)
									{
										sExGSTRate = nMaxPrice * (nDisPer/100);
										dsInput.Reset();
										dsInput.SetProperty(&quot;Price&quot;, sExGSTRate);
										dsInput.SetProperty(&quot;Type&quot;, &quot;PERCENT_DISC&quot;);
										dsInput.SetProperty(&quot;System&quot;, &quot;BRM&quot;);
										dsInput.SetProperty(&quot;sSkipThreeDigit&quot;, &quot;Y&quot;);
										sExGSTRate = fnFormatDiscountPrice(dsInput);
										
										sGSTRate = ToNumber(sExGSTRate) * (nGST/100);
										dsInput.Reset();
										dsInput.SetProperty(&quot;Price&quot;, sGSTRate);
										dsInput.SetProperty(&quot;Type&quot;, &quot;PERCENT_DISC&quot;);
										dsInput.SetProperty(&quot;System&quot;, &quot;BRM&quot;);
										dsInput.SetProperty(&quot;sSkipThreeDigit&quot;, &quot;Y&quot;);
										sGSTRate = fnFormatDiscountPrice(dsInput);
										
										sDiscountPrice = ToNumber(sExGSTRate) + ToNumber(sGSTRate); 
										dsInput.Reset();
										dsInput.SetProperty(&quot;Price&quot;, sDiscountPrice);
										dsInput.SetProperty(&quot;Type&quot;, &quot;PERCENT_DISC&quot;);
										dsInput.SetProperty(&quot;System&quot;, &quot;BRM&quot;);
										sDiscountPrice = fnFormatDiscountPrice(dsInput);
											
										dsInp.GetChild(x).SetProperty(&quot;Discount Price&quot;, sDiscountPrice);
									}//if (nDisPer != &quot;&quot; &amp;&amp; nDisPer != null)
								}//if (dsInp.GetChild(x).GetProperty(&quot;SAM Id&quot;) == sDisProd)							
							}//for (var x = 0; x &lt; dsInp.GetChildCount(); x++)
						}//if (nMaxPrice != &quot;&quot; &amp;&amp; nMaxPrice != null)						
					}
					sRec = NextRecord();
				}//while(sRec)
			}//with(oBC)
		}//if(pSAMId.length &gt; 0 &amp;&amp; dSAMId.length &gt; 0)		
	}//try
	catch(e)
	{
		throw(e);
	}
	finally
	{
		oBC = null;
		oBO = null;
		dsInput = null;
	}
}"
