			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fnGetOfferDetails"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function fnGetOfferDetails(TOTHeaderId, GPI, &amp;sService, &amp;sSimpleProd)
{
	try
	{
		var oBO = TheApplication().GetBusObject(&quot;VHA TOT Generic BO&quot;);
		var oBC = oBO.GetBusComp(&quot;VHA TOT Offer Details BC&quot;);
		var sRec = &quot;&quot;;
		var Out = TheApplication().NewPropertySet();

		with(oBC)
		{
			ClearToQuery();
			SetViewMode(AllView);
			ActivateField(&quot;Product Name&quot;);
			ActivateField(&quot;GPI&quot;);
			ActivateField(&quot;Term&quot;);
			ActivateField(&quot;MonthlyRepayment&quot;);
			ActivateField(&quot;DiscountPrice&quot;);
			ActivateField(&quot;ProductSamId&quot;);
			ActivateField(&quot;ProductId&quot;);
			SetSearchSpec(&quot;Par Row Id&quot;, TOTHeaderId);
			SetSearchSpec(&quot;GPI&quot;, GPI);
			ExecuteQuery(ForwardOnly);
			sRec = FirstRecord();

			while(sRec)
			{
				sSimpleProd.SetType(&quot;VHA Contract Doc Simple Line Items&quot;);
				sSimpleProd.SetProperty(&quot;Action Code&quot;, &quot;Add&quot;);
				sSimpleProd.SetProperty(&quot;Product Name&quot;, GetFieldValue(&quot;Product Name&quot;));
				sSimpleProd.SetProperty(&quot;Prod Id&quot;, GetFieldValue(&quot;ProductId&quot;));
				if(GetFieldValue(&quot;GPI&quot;) == &quot;Loyalty Discount&quot;)
				{
					sSimpleProd.SetProperty(&quot;Special Rating Type&quot;, GetFieldValue(&quot;GPI&quot;));
					sSimpleProd.SetProperty(&quot;Global Product Identifier&quot;, &quot;&quot;);
				}
				else
					sSimpleProd.SetProperty(&quot;Global Product Identifier&quot;, GetFieldValue(&quot;GPI&quot;));
				sSimpleProd.SetProperty(&quot;SAM Id&quot;, GetFieldValue(&quot;ProductSamId&quot;));
				sSimpleProd.SetProperty(&quot;Max Price&quot;, GetFieldValue(&quot;MonthlyRepayment&quot;));
				sSimpleProd.SetProperty(&quot;PeriodOverride&quot;, &quot;&quot;);
				sSimpleProd.SetProperty(&quot;Period&quot;, GetFieldValue(&quot;Term&quot;));
				sSimpleProd.SetProperty(&quot;Discount Price&quot;, GetFieldValue(&quot;DiscountPrice&quot;));
				sSimpleProd.SetProperty(&quot;Amount&quot;, GetFieldValue(&quot;MonthlyRepayment&quot;));
				sSimpleProd.SetProperty(&quot;Charge Price&quot;, GetFieldValue(&quot;MonthlyRepayment&quot;));
				sService.AddChild(sSimpleProd.Copy());

				sRec = NextRecord();
			}
		}
	}
	catch(e)
	{
		throw e;
	}
	finally
	{
	}
}"
