			   SCRIPT="function fnSearchArray(arrSearch, sMatch)
{
	try
	{
		for(var i=0;i&lt;=arrSearch.length;i++) 
		{
			if(arrSearch[i] == sMatch)
				return i;
		}
	}
	catch(e)
	{
		throw e;
	}
	finally
	{
	}
}"
