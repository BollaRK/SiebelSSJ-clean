			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetSIM"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/* 
 * Component Name        : 	NSA Contract Generation
 * Method Name           : 	GetSIM
 * Component Information : 	This function will get SIM Number of Prepay
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 10/08/2020	Saravanan J				Initial Version
 */
function mGetSIM(Inputs,Outputs)
{
	try
	{		
		var sOrderBO = TheApplication().GetBusObject(&quot;VHA eSIM Simplification BO&quot;);
		var sOLIBC = sOrderBO.GetBusComp(&quot;Order Entry - Line Items (Simple)&quot;);
		var sSIMBC = sOrderBO.GetBusComp(&quot;VF Order Entry - SIM - IMSI&quot;);
		var sFinalOrderId = Inputs.GetProperty(&quot;FinalOrderId&quot;);

		if (sFinalOrderId != &quot;&quot; &amp;&amp; sFinalOrderId != null)
		{
			with(sOLIBC)
			{
				ActivateField(&quot;Order Header Id&quot;);
				ActivateField(&quot;Parent Order Item Id&quot;);
				SetViewMode(AllView);
				ClearToQuery();
				SetSearchSpec(&quot;Order Header Id&quot;, sFinalOrderId);
				SetSearchSpec(&quot;Parent Order Item Id&quot;, &quot;IS NULL&quot;);
				ExecuteQuery(ForwardOnly);
				if(FirstRecord())
				{
					with(sSIMBC)
					{
						ActivateField(&quot;Asset Number&quot;);
						ActivateField(&quot;Product Type&quot;);
						var iSIMRec = FirstRecord();
						while(iSIMRec)
						{																	
							if(GetFieldValue(&quot;Product Type&quot;) == &quot;SIM&quot;)
							{										
								Outputs.SetProperty(&quot;PrepaySIM&quot;, GetFieldValue(&quot;Asset Number&quot;));
								break;
							}
							iSIMRec = NextRecord();
						}
					}//with(sSIMBC)
				}
			}//with(sOLIBC)
		}

	}//try
	catch(e)
	{
		throw(e);
	}
	finally
	{		
		sSIMBC = null;
		sOLIBC = null;
		sOrderBO = null;
	}
}"
			   SEQUENCE="41"
			   UPDATED="09/03/2025 17:18:13"
			   UPDATED_BY="SUMA"
			   CREATED="08/28/2020 16:53:54"
			   CREATED_BY="SADMIN">
