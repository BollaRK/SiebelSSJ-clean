			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGenerateNSAContract"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/* 
 * Component Name        : 	NSA Contract Generation
 * Method Name           : 	GenerateNSAContract
 * Component Information : 	This function will generate the NSA
 *							contract and will return Siebel Message
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 17/07/2020	Saravanan J				Initial Version
 */
function mGenerateNSAContract(Inputs,Outputs)
{
	try
	{		
		var svc = TheApplication().GetService(&quot;Workflow Process Manager&quot;);
		var Input = TheApplication().NewPropertySet();
		var Output = TheApplication().NewPropertySet();
		var sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
		var sFinalOrderId = &quot;&quot;, sMSISDN = &quot;&quot;, sPlanOption = &quot;&quot;, sPlanId = &quot;&quot;, sPropId = &quot;&quot;;
		var sTransType = Inputs.GetProperty(&quot;TransType&quot;);
		var sFlow = Inputs.GetProperty(&quot;Flow&quot;);
		var sTOTBO = TheApplication().GetBusObject(&quot;VHA TOT Generic BO&quot;);
		var sTOTBC = sTOTBO.GetBusComp(&quot;VHA TOT Generic BC&quot;);
		var sOrderBO = TheApplication().GetBusObject(&quot;VHA eSIM Simplification BO&quot;);
		var sData = Inputs.GetProperty(&quot;Data&quot;);
		var sIDD = Inputs.GetProperty(&quot;IDD&quot;);
		var sResDisc = Inputs.GetProperty(&quot;RestrictedDiscount&quot;);

		if (sOrderId != null &amp;&amp; sOrderId != &quot;&quot;)
		{	
			with(sTOTBC)
			{
				ActivateField(&quot;Order Id&quot;);
				ActivateField(&quot;Transferring Mobile Number&quot;);
				ActivateField(&quot;Plan Option&quot;);
				ActivateField(&quot;Plan Id&quot;);
				ActivateField(&quot;Prop Id&quot;);
				SetViewMode(AllView);
				ClearToQuery();
				SetSearchSpec(&quot;Id&quot;, sOrderId);
				ExecuteQuery(ForwardOnly);
				if(FirstRecord())
				{
					sFinalOrderId = GetFieldValue(&quot;Order Id&quot;);
					sMSISDN = GetFieldValue(&quot;Transferring Mobile Number&quot;);
					sPlanOption = GetFieldValue(&quot;Plan Option&quot;);
					sPlanId = GetFieldValue(&quot;Plan Id&quot;);
					sPropId = GetFieldValue(&quot;Prop Id&quot;);
				}
			}
			if (sFinalOrderId != null &amp;&amp; sFinalOrderId != &quot;&quot;)
			{
				Input.SetProperty(&quot;ProcessName&quot;, &quot;VHA Generate Contract Wrapper Workflow&quot;);
				Input.SetProperty(&quot;Object Id&quot;, sFinalOrderId);
				Input.SetProperty(&quot;TransactionType&quot;, sTransType);
				Input.SetProperty(&quot;MSISDN&quot;, sMSISDN);
				Input.SetProperty(&quot;PlanOption&quot;, sPlanOption);
				Input.SetProperty(&quot;PlanId&quot;, sPlanId);
				Input.SetProperty(&quot;PropId&quot;, sPropId);
				Input.SetProperty(&quot;Flow&quot;, sFlow);
				Input.SetProperty(&quot;Data&quot;, sData);
				Input.SetProperty(&quot;IDD&quot;, sIDD);
				Input.SetProperty(&quot;TOTHeaderId&quot;, sOrderId);
				Input.SetProperty(&quot;RestrictedDiscount&quot;, sResDisc);
				Input.SetProperty(&quot;ShipAddress&quot;, &quot;NA&quot;);
				svc.InvokeMethod(&quot;RunProcess&quot;, Input, Output);

				if (sTransType == &quot;Prepay&quot;)
				{
					Outputs.SetProperty(&quot;PrepayCANameWithTitle&quot;, Output.GetProperty(&quot;Title&quot;) + &quot; &quot; + Output.GetProperty(&quot;CustomerName&quot;));
					Outputs.SetProperty(&quot;PrepayRegisteredCompany&quot;, Output.GetProperty(&quot;RegisteredCompany&quot;));
					Outputs.SetProperty(&quot;PrepayABNACN&quot;, Output.GetProperty(&quot;ABNACN&quot;));
					
					if (Output.GetProperty(&quot;ABNACN&quot;) != &quot;&quot; &amp;&amp; Output.GetProperty(&quot;ABNACN&quot;) != null)
					{
						Outputs.SetProperty(&quot;PrepayABNACN&quot;, &quot;ABN/ACN &quot; + Output.GetProperty(&quot;ABNACN&quot;));
					}
					
					Outputs.SetProperty(&quot;PrepayDate&quot;, Output.GetProperty(&quot;Date&quot;));
					Outputs.SetProperty(&quot;PrepayConnectionType&quot;, Output.GetProperty(&quot;ConnectionType&quot;));
					Outputs.SetProperty(&quot;PrepayMSISDN&quot;, Output.GetProperty(&quot;MSISDN&quot;));
					if (Output.GetProperty(&quot;BillingRowId&quot;) == Output.GetProperty(&quot;BillingAccountId&quot;)) {
						Outputs.SetProperty(&quot;PrepayBAN&quot;, &quot;To be Allocated&quot;);		
					}
					else Outputs.SetProperty(&quot;PrepayBAN&quot;, Output.GetProperty(&quot;BillingAccountId&quot;));
					Outputs.SetProperty(&quot;PrepayOrderRef&quot;, Output.GetProperty(&quot;OrderRef&quot;));
					
					if (Output.GetProperty(&quot;Plan&quot;) != &quot;&quot; &amp;&amp; Output.GetProperty(&quot;Plan&quot;) != null)
					{
						Outputs.SetProperty(&quot;PrepayPlan&quot;, Output.GetProperty(&quot;Plan&quot;));
					} else Outputs.SetProperty(&quot;PrepayPlan&quot;, &quot;NA&quot;);				
					
					Outputs.SetProperty(&quot;PrepayPlanTerm&quot;, Output.GetProperty(&quot;PlanTerm&quot;));
					
					if (Output.GetProperty(&quot;SIM&quot;) != &quot;&quot; &amp;&amp; Output.GetProperty(&quot;SIM&quot;) != null)
					{
						Outputs.SetProperty(&quot;PrepaySIM&quot;, Output.GetProperty(&quot;SIM&quot;));
					} else Outputs.SetProperty(&quot;PrepaySIM&quot;, &quot;NA&quot;);				
				}//if (sTransType == &quot;Prepay&quot;)
				else {
					if (sTransType == &quot;ConnectNBN&quot;)
					{
						Output.GetChild(0).GetChild(0).GetChild(0).SetProperty(&quot;CustomerName&quot;, Output.GetProperty(&quot;CustomerName&quot;));
						Output.GetChild(0).GetChild(0).GetChild(0).SetProperty(&quot;RegisteredCompany&quot;, Output.GetProperty(&quot;RegisteredCompany&quot;));
						Output.GetChild(0).GetChild(0).GetChild(0).SetProperty(&quot;ABNACN&quot;, Output.GetProperty(&quot;ABNACN&quot;));
						Output.GetChild(0).GetChild(0).GetChild(0).SetProperty(&quot;Date&quot;, Output.GetProperty(&quot;Date&quot;));
						Output.GetChild(0).GetChild(0).GetChild(0).SetProperty(&quot;DOM&quot;, Output.GetProperty(&quot;DOM&quot;));
						
						Output.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(0).SetProperty(&quot;NBNSpeedTier&quot;, Output.GetProperty(&quot;NBNSpeedTier&quot;));
						Output.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(0).SetProperty(&quot;FulfilmentRef&quot;, Output.GetProperty(&quot;FulfilmentRef&quot;));
						Output.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(0).SetProperty(&quot;NBNDeliveryAddress&quot;, Output.GetProperty(&quot;NBNDeliveryAddress&quot;));		
						Output.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(0).SetProperty(&quot;NBNAddress&quot;, Output.GetProperty(&quot;NBNAddress&quot;));	
						Output.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(0).SetProperty(&quot;NBNApptDate&quot;, Output.GetProperty(&quot;NBNApptDate&quot;));
						Output.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(0).SetProperty(&quot;NBNApptTime&quot;, Output.GetProperty(&quot;NBNApptTime&quot;));
						Output.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(0).SetProperty(&quot;MSISDN&quot;, Output.GetProperty(&quot;MSISDN&quot;));
						Output.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(0).SetProperty(&quot;OrderRef&quot;, Output.GetProperty(&quot;OrderRef&quot;));
						Output.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(0).SetProperty(&quot;ServiceOrderID&quot;, Output.GetProperty(&quot;ServiceOrderID&quot;));
						Output.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(0).SetProperty(&quot;SIM&quot;, Output.GetProperty(&quot;SIM&quot;));
						Output.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(0).SetProperty(&quot;NBNDevFee&quot;, Output.GetProperty(&quot;NBNDevFee&quot;));
						Output.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(0).SetProperty(&quot;Plan&quot;, Output.GetProperty(&quot;Plan&quot;));
						Output.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(0).SetProperty(&quot;NBNPlanValue&quot;, Output.GetProperty(&quot;PlanValue&quot;));
						Output.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(0).SetProperty(&quot;PlanTerm&quot;, Output.GetProperty(&quot;PlanTerm&quot;));
					}
					if (Output.GetProperty(&quot;BillingRowId&quot;) == Output.GetProperty(&quot;BillingAccountId&quot;)) {
						Output.GetChild(0).GetChild(0).GetChild(0).SetProperty(&quot;BAN&quot;, &quot;To be Allocated&quot;);		
					}
					else Output.GetChild(0).GetChild(0).GetChild(0).SetProperty(&quot;BAN&quot;, Output.GetProperty(&quot;BillingAccountId&quot;));
					Output.GetChild(0).GetChild(0).GetChild(0).SetProperty(&quot;ConnectionType&quot;, Output.GetProperty(&quot;ConnectionType&quot;));
					Outputs.AddChild(Output.GetChild(0));
				}//else
			}//if (sFinalOrderId != null &amp;&amp; sFinalOrderId != &quot;&quot;)
		}//if (sOrderId != null &amp;&amp; sOrderId != &quot;&quot;)
	}//try
	catch(e)
	{
		throw(e);
	}
	finally
	{		
		svc = null;
		Input = null;
		Output = null;
		sTOTBC = null;
		sTOTBO = null;
	}
}"
