			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mNetworkProvider"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mNetworkProvider(sOrderItemId,sOrderId)
{
try
{
            var sOrdBO = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
		    var sOrdBOBC = sOrdBO.GetBusComp(&quot;VHA NBN Order Details&quot;);
            sOrdBOBC.SetViewMode(AllView);
			sOrdBOBC.ClearToQuery();
			
			sOrdBOBC.ActivateField(&quot;Order Header Id&quot;);
			sOrdBOBC.ActivateField(&quot;Service Order Id&quot;);
			sOrdBOBC.ActivateField(&quot;Network Provider&quot;);
			sOrdBOBC.SetSearchSpec(&quot;Order Header Id&quot;,sOrderId);
			sOrdBOBC.SetSearchSpec(&quot;Service Order Id&quot;,sOrderItemId);
			sOrdBOBC.ExecuteQuery(ForwardOnly);
			if(sOrdBOBC.FirstRecord())
			{
			var sProvider = sOrdBOBC.GetFieldValue(&quot;Network Provider&quot;);
			}
			return(sProvider);

			TheApplication().SetProfileAttr(&quot;Test2&quot;,sOrderId + sProvider + sOrderItemId);
}//try
catch(e)
	{
	throw e;
	}
	finally
	{
		
	}
}"
