			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fnGetPricefromPriceList"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function fnGetPricefromPriceList(PriceListId, ProdId, &amp;PropSet) 
{
	try
	{
		var oBO = TheApplication().GetBusObject(&quot;Admin Price List&quot;);
		var oBC = oBO.GetBusComp(&quot;Price List Item&quot;);
		var sPrice = &quot;&quot;, sServicePrice = &quot;&quot;, sTaxFlag = &quot;&quot;, sTaxPrice = 0, sChrgAmt=0;
		
		if(PriceListId != &quot;&quot; &amp;&amp; ProdId != &quot;&quot;)
		{
			with(oBC)
			{
				ClearToQuery();
				SetViewMode(AllView);
				ActivateField(&quot;Max Sale Price&quot;);
				ActivateField(&quot;Service Price Percent&quot;);
				ActivateField(&quot;Tax Subcomponent Flag&quot;)
				SetSearchSpec(&quot;Price List Id&quot;, PriceListId);
				SetSearchSpec(&quot;Product Id&quot;, ProdId);
				ExecuteQuery(ForwardOnly);
				
				if(FirstRecord())
				{
					sServicePrice = ToNumber(GetFieldValue(&quot;Service Price Percent&quot;));
					sChrgAmt = ToNumber(GetFieldValue(&quot;Max Sale Price&quot;));
					sTaxFlag = GetFieldValue(&quot;Tax Subcomponent Flag&quot;);
					
					if(sTaxFlag == &quot;Y&quot;)
						sPrice = sChrgAmt;
					else
					{
						sTaxPrice = sChrgAmt;
						sPrice = (sChrgAmt + (sChrgAmt * nGST)/100);
					}
						
					sPrice = fnFormatPrice(sPrice, &quot;&quot;, &quot;&quot;);
				}
			}
		}
		if(PropSet != &quot;&quot; &amp;&amp; PropSet != &quot;undefined&quot;)
		{
			PropSet.SetProperty(&quot;Max Price&quot;, sPrice);
			PropSet.SetProperty(&quot;Charge Price&quot;, sChrgAmt);
			PropSet.SetProperty(&quot;Taxable Price&quot;, sTaxPrice);
			PropSet.SetProperty(&quot;Service Price&quot;, sServicePrice);
		}
		return sChrgAmt;
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		oBC = null;
		oBO = null;
	}
}"
