			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="RemoveDeviceSiebelOnlyProducts"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function RemoveDeviceSiebelOnlyProducts()
{
	try
{
var sDeviceProductId = GetProductIdFromName(&quot;Device-Siebel Only&quot;);
var boOrder = TheApplication().GetBusObject(&quot;VHA Order Entry Thin BO&quot;);
var	bcOrderBC = boOrder.GetBusComp(&quot;VF Order Entry - Orders Thin BC&quot;);
var	bcOrderLI = boOrder.GetBusComp(&quot;VF Order Line Items - Thin BC&quot;);
var bRec;


if(sOrderId != &quot;&quot;)
{
	with(bcOrderBC)
	{
	ClearToQuery();
	SetViewMode(AllView);
	SetSearchSpec(&quot;Id&quot;, sOrderId);
	ExecuteQuery(ForwardBackward);
		if(FirstRecord())
		{
			with(bcOrderLI)
			{
			ClearToQuery();
			SetViewMode(AllView);
			bcOrderLI.SetSearchExpr(&quot;[Order Header Id] = &apos;&quot;+sOrderId+&quot;&apos; AND  [Product Id] = &apos;&quot;+sDeviceProductId+&quot;&apos;AND [Action Code] = &apos;Add&apos;&quot;);
			ExecuteQuery(ForwardBackward);
				if(FirstRecord())
				{
				bRec = bcOrderLI.FirstRecord();
					while(bRec)
					{
					DeleteRecord();
					bRec = FirstRecord();
					}
				}
			}
		}
	}
}
}
catch(e)
{
throw e;
}
finally
{
bcOrderLI = null;
bcOrderBC = null;
boOrder = null;
}
}"
