			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mMPPBCUpsert"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mMPPBCUpsert (childInputs, Inputs, sOutIO, sMap)
{
	/*
	* Component Name        : 	mMPPBCUpsert
	* Method Name           : 	
	* Component Information : 	
	*
	* Modification History  :
	* Date			Author		Config #	Description
	* ============ ===========	===========	================================
	* 07/09/2014	Balaji					Initial version
	*/
	
	try
	{ 		
		
		Inputs.GetChild(0).RemoveChild(0);
		Inputs.GetChild(0).AddChild(childInputs);	
		
		var bsService = TheApplication().GetService(&quot;EAI Data Transformation Engine&quot;);
		var psInputs = TheApplication().NewPropertySet();
		var psOutputs = TheApplication().NewPropertySet();
		
		//Map the data
		Inputs.SetProperty(&quot;OutputIntObjectName&quot;, sOutIO);
		Inputs.SetProperty(&quot;MapName&quot;,sMap);
		bsService.InvokeMethod(&quot;Execute&quot;, Inputs, psOutputs);
		bsService = null;
		
		//Upsert the data
		bsService = TheApplication().GetService(&quot;EAI Siebel Adapter&quot;);
		bsService.InvokeMethod(&quot;Upsert&quot;, psOutputs, psInputs);
	}
	catch (e)
	{
		throw e;
	}
	finally
	{
		psInputs = null;
		psOutputs = null;
		bsService = null;
	}
}"
			   SEQUENCE="88"
			   UPDATED="01/09/2026 15:43:19"
			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 15:43:19"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mMPPCheckResponsibility"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mMPPCheckResponsibility(strResponsibility) 
{
	/*
	* Component Name        : 	mMPPCheckResponsibility
	* Method Name           : 	
	* Component Information : 	
	*
	* Modification History  :
	* Date			Author		Config #	Description
	* ============ ===========	===========	================================
	* 07/09/2014	Balaji					Initial version
	*/
	
	var bsRespCheck;
	var psInputs;
	var psOutputs;
	var sExists = &quot;N&quot;;
	var strError = &quot;&quot;;

	try {
		

		if (strResponsibility != &quot;&quot;) {
			bsRespCheck = TheApplication().GetService(&quot;VF Check Responsibilities&quot;);

			psInputs = TheApplication().NewPropertySet();
			psOutputs = TheApplication().NewPropertySet();

			psInputs.SetProperty(&quot;Responsibility&quot;, strResponsibility);

			bsRespCheck.InvokeMethod(&quot;Check Responsibilities&quot;, psInputs, psOutputs);

			sExists = psOutputs.GetProperty(&quot;Exists&quot;);

		} else {
			sExists = &quot;Y&quot;;
		}

		return (sExists);

	} catch (e) {
		if (defined(e.errText)) {
			strError = arguments.callee + e.errText + &quot;\r\n&quot; + ToString(e);
		} else {
			strError = arguments.callee + ToString(e);
		}
		throw(strError);
	}
	finally {
		psInputs = null;
		psOutputs = null;
		bsRespCheck = null;

		
	}
}"
			   SEQUENCE="89"
			   UPDATED="01/09/2026 15:43:19"
			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 15:43:19"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mMPPContractExistsNewConnect"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mMPPContractExistsNewConnect (sLineItemId, &amp;psOut)
{
	/*
	* Component Name        : 	mMPPContractExistsNewConnect
	* Method Name           : 	
	* Component Information : 	
	*
	* Modification History  :
	* Date			Author		Config #	Description
	* ============ ===========	===========	================================
	* 04/09/2014	Balaji					Initial version
	*/
	
	try
	{
		//var strLineItemId = Inputs.GetProperty(&quot;LineItemId&quot;);	
		
		var boOrder = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
		var bcOrder = boOrder.GetBusComp(&quot;Order Entry - Orders&quot;);
		var bcOrderLI = boOrder.GetBusComp(&quot;Order Entry - Line Items&quot;);
		var bcOrderItemXA = boOrder.GetBusComp(&quot;Order Item XA&quot;);
		var vMPPExists = &quot;N&quot;;
		var vActionCode = &quot;&quot;;
		var strProduct = &quot;&quot;;
		var strServiceType = &quot;&quot;;
		var strPrevMPPAmt = &quot;0&quot;;
		var strContractStartDate=&quot;&quot;;
		var strRootAssetIntId;
		var strMPPContractId = &quot;&quot;;
		bcOrderLI.ActivateField(&quot;Product Type&quot;);
		bcOrderLI.ActivateField(&quot;Root Order Item Id&quot;);
		bcOrder.SetViewMode(AllView);
		bcOrder.ClearToQuery();
		bcOrder.SetSearchSpec(&quot;Id&quot;, sOrderId);
		bcOrder.ExecuteQuery(ForwardOnly);
		if (bcOrder.FirstRecord())
		{
			strServiceType = bcOrderLI.GetFieldValue(&quot;Service Type&quot;);
			strRootAssetIntId = bcOrderLI.GetFieldValue(&quot;Root Asset Integration Id&quot;);
			bcOrderLI.ClearToQuery();
			bcOrderLI.ActivateField(&quot;Product&quot;);
			bcOrderLI.ActivateField(&quot;Action Code&quot;);
			bcOrderLI.ActivateField(&quot;Root Order Line Item&quot;);
			bcOrderLI.SetSearchSpec(&quot;Product Type&quot;, &quot;Billing - MPP&quot;);
			bcOrderLI.SetSearchSpec(&quot;Action Code&quot;, &quot;Add&quot;);
			bcOrderLI.SetSearchSpec(&quot;Root Order Item Id&quot;, sLineItemId);
			bcOrderLI.ExecuteQuery(ForwardOnly);
			if(bcOrderLI.FirstRecord())
			{
				
				vMPPExists = &quot;Y&quot;;
				vActionCode =  bcOrderLI.GetFieldValue(&quot;Action Code&quot;);
				strProduct = bcOrderLI.GetFieldValue(&quot;Product&quot;);
				strMPPContractId =  bcOrderLI.GetFieldValue(&quot;Id&quot;);
				
				bcOrderItemXA.SetViewMode(AllView);
				bcOrderItemXA.ClearToQuery();
				bcOrderItemXA.ActivateField(&quot;Action Code&quot;);
				bcOrderItemXA.ActivateField(&quot;Text Value&quot;);
				bcOrderItemXA.SetSearchSpec(&quot;Object Id&quot;, strMPPContractId);
				bcOrderItemXA.SetSearchSpec(&quot;Name&quot;, &quot;Contract Amount&quot;);
				bcOrderItemXA.ExecuteQuery(ForwardOnly);			
				if(bcOrderItemXA.FirstRecord())
				{		
					strPrevMPPAmt = bcOrderItemXA.GetFieldValue(&quot;Text Value&quot;);
				}
				bcOrderItemXA.SetSearchSpec(&quot;Object Id&quot;, strMPPContractId);
				bcOrderItemXA.SetSearchSpec(&quot;Name&quot;, &quot;Contract Start Date&quot;);
				bcOrderItemXA.ExecuteQuery(ForwardOnly);
				if(bcOrderItemXA.FirstRecord())
				{		
					strContractStartDate = bcOrderItemXA.GetFieldValue(&quot;Text Value&quot;);
				}
			}
		}
		psOut.SetProperty(&quot;MPPContractExists&quot;, vMPPExists);
		psOut.SetProperty(&quot;Action&quot;, vActionCode);
		psOut.SetProperty(&quot;MPPContractId&quot;, strMPPContractId);
		psOut.SetProperty(&quot;PrevMPPAmt&quot;, strPrevMPPAmt);
		psOut.SetProperty(&quot;ProductName&quot;, strProduct);
		psOut.SetProperty(&quot;MPPContractStartDate&quot;, strContractStartDate);
		
	}
	catch(e)
	{
	     throw(e);
	}
	finally
	{
			 bcOrderItemXA = null;  /* This variable is nullified by Sharukh on 18/03/2019*/
	         bcOrderLI = null;
	         bcOrder = null;
	         boOrder = null;
			

	}
}"
			   SEQUENCE="90"
			   UPDATED="01/09/2026 15:43:19"
			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 15:43:19"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mMPPEachLineItem"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mMPPEachLineItem(LineIn, &amp;psCopyInputs)
{
	/*
	* Component Name        : 	mMPPEachLineItem
	* Method Name           : 	
	* Component Information : 	
	*
	* Modification History  :
	* Date			Author		Config #	Description
	* ============ ===========	===========	================================
	* 07/09/2014	Balaji					Initial version
	*/
try
	{
	
	var strMSISDN = LineIn.GetProperty(&quot;MSISDN&quot;);
	var sLineItemId = LineIn.GetProperty(&quot;LineItemId&quot;);
	var i = LineIn.GetProperty(&quot;Cursor&quot;);
	var psIns = TheApplication().NewPropertySet();
	var psOut = TheApplication().NewPropertySet();
	var strProduct = &quot;&quot;, strTerm = &quot;&quot;, strContactId = &quot;&quot;, strServiceType = &quot;&quot;, strRootAssetIntId = &quot;&quot;, strAccType = &quot;&quot;, strCustAccId = &quot;&quot;, strDueDate = &quot;&quot;, strOrderFunctionPlan = &quot;&quot;;
	var strMandateTerm = &quot;&quot;,strMandateAmount=&quot;&quot;, strMandate=&quot;&quot;, strIMEI=&quot;&quot;, strDeviceType=&quot;&quot;, strRCC=&quot;&quot;, strProductCode=&quot;&quot;, strVFFlag=&quot;&quot;, strIsUpgradeIMEI=&quot;&quot;, sStockIndicator=&quot;&quot;;
	var vMPPExists=&quot;&quot;, strMPPActionCode=&quot;&quot;, strMPPContractId=&quot;&quot;, strPrevMPPAmt=&quot;&quot;, strProductName=&quot;&quot;;
	var strNewMPPCount = 0, strRemBal = &quot;0&quot;, sSmartScrtAction = &quot;&quot;, strAction = &quot;&quot;;
    var strGPPProductname = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_GPP_DEVICE_CONTRACT&quot;,&quot;GPP Device Contract&quot;); // added by balajiM 21/5/2019 for Rel19.3
	if((sOrderId != &quot;&quot; || sOrderId!= null)  &amp;&amp; (sLineItemId != &quot;&quot; || sLineItemId != null))
		{
		// Get Order Details
		//mMPPGetOrderDetails(sLineItemId, psOut); // TARIQ-24NOV2014-Commented this function and added the below one
		mMPPGetPlanDetails(sLineItemId, psOut);
		
		strProduct = psOut.GetProperty(&quot;Plan&quot;);
		strTerm = psOut.GetProperty(&quot;Term&quot;);
		strDueDate = psOut.GetProperty(&quot;DueDate&quot;);
		//TARIQ-24NOV2014-PT-Changes Start
		/*strAccType = psOut.GetProperty(&quot;AccType&quot;);
		strCustAccId = psOut.GetProperty(&quot;AccId&quot;);
		strContactId = psOut.GetProperty(&quot;ContactId&quot;);
		strOrderFunctionPlan = psOut.GetProperty(&quot;OrderFunctionPlan&quot;);
		strServiceType = psOut.GetProperty(&quot;ServiceType&quot;);
		strRootAssetIntId = psOut.GetProperty(&quot;RootAssetIntId&quot;);*/
		strAccType = LineIn.GetProperty(&quot;AccType&quot;);
		strCustAccId = LineIn.GetProperty(&quot;AccId&quot;);
		strContactId = LineIn.GetProperty(&quot;ContactId&quot;);
		strOrderFunctionPlan = LineIn.GetProperty(&quot;OrderFunctionPlan&quot;);
		strServiceType = LineIn.GetProperty(&quot;ServiceType&quot;);
		strRootAssetIntId = LineIn.GetProperty(&quot;RootAssetIntId&quot;);
		//TARIQ-24NOV2014-PT-Changes End

	
		psIns.Reset();
	
		// Get IMEI Details
		psIns.SetProperty(&quot;OrderFunctionPlan&quot;, strOrderFunctionPlan);
		psIns.SetProperty(&quot;Term&quot;, strTerm);
		psIns.SetProperty(&quot;LineItemId&quot;, sLineItemId);
		psIns.SetProperty(&quot;VF Stock Indicator TBUI&quot;, LineIn.GetProperty(&quot;VF Stock Indicator TBUI&quot;));//TARIQ-25NOV2014-PT-Added
		psIns.SetProperty(&quot;StoreDevice&quot;, LineIn.GetProperty(&quot;StoreDevice&quot;));
		psIns.SetProperty(&quot;ReservationId&quot;,LineIn.GetProperty(&quot;ReservationId&quot;));	
		psIns.SetProperty(&quot;Plan&quot;,strProduct);
		//mMPPGetOrderIMEIDetails(psIns, psOut); // Get IMEI Details function// TARIQ-24NOV2014-Commented this function and added the below one
		mMPPGetDeviceDetails(psIns, psOut);
		
		strMandateTerm = psOut.GetProperty(&quot;MandateTerm&quot;);
		strMandateAmount = psOut.GetProperty(&quot;MandateAmount&quot;);
		strMandate = psOut.GetProperty(&quot;Mandate&quot;);
		strIMEI = psOut.GetProperty(&quot;IMEI&quot;);
		strDeviceType = psOut.GetProperty(&quot;DeviceType&quot;);
		strRCC = psOut.GetProperty(&quot;RCC&quot;);
		strProductCode = psOut.GetProperty(&quot;ProductCode&quot;);
		strVFFlag = psOut.GetProperty(&quot;VFFlag&quot;);
		strIsUpgradeIMEI = psOut.GetProperty(&quot;IsUpgradeIMEI&quot;);
		sStockIndicator = psOut.GetProperty(&quot;StockIndicator&quot;);
		
		psIns.Reset();
		TheApplication().SetProfileAttr(&quot;RCC1&quot;,strRCC + strProductCode);
		
		//Check if MPP Exists
		//TARIQ-25NOV2014-PT-Changes Start
		/*mMPPContractExistsNewConnect(sLineItemId, psOut); //MPP Exist function
		
		vMPPExists = psOut.GetProperty(&quot;MPPContractExists&quot;);
		strMPPActionCode = psOut.GetProperty(&quot;Action&quot;);
		strMPPContractId = psOut.GetProperty(&quot;MPPContractId&quot;);
		strPrevMPPAmt = psOut.GetProperty(&quot;PrevMPPAmt&quot;);
		strProductName = psOut.GetProperty(&quot;ProductName&quot;);*/
		strMPPContractId = LineIn.GetProperty(&quot;MPPContractId&quot;);
		if (strMPPContractId != &quot;&quot; &amp;&amp; strMPPContractId != null)
		{
			vMPPExists = &quot;Y&quot;;
			strMPPActionCode = &quot;Add&quot;;
			strPrevMPPAmt = &quot;0&quot;;
		}
		else
		{
			vMPPExists = &quot;N&quot;;
			strMPPActionCode = &quot;&quot;;
			strPrevMPPAmt = &quot;0&quot;;
		}
		//TARIQ-25NOV2014-PT-Changes End
		
		if (vMPPExists == &quot;Y&quot;) 
			{
			strAction = &quot;ADD&quot;;
			sSmartScrtAction = &quot;EXIST&quot;;
			}
		else
			{
			sSmartScrtAction = &quot;N/A&quot;;
			strAction = &quot;N/A&quot;;
			}
		
		if(strServiceType == &quot;SUBSCRIPTION&quot;) // changed by balajiM 21/5/2019 for Rel19.3
			{
			//strProductName = &quot;MPP Contract&quot;;
            strProductName = strGPPProductname;
			}
		else
			{
			strProductName = &quot;MPP Account Product&quot;;			
			}	
		
		psIns.Reset();
		
		if (strMandate == &quot;Y&quot;) 
			{
			mMPPMandatory(strMandateTerm, strMandateAmount, psOut, LineIn.GetProperty(&quot;MandateMPPRespExists&quot;));
			strMandate = psOut.GetProperty(&quot;Mandate&quot;);
			}
		
		psCopyInputs.GetChild(i).SetProperty(&quot;MPP Active&quot;, &quot;Y&quot;);
		psCopyInputs.GetChild(i).SetProperty(&quot;MPP Name&quot;, &quot;SIEBELV8&quot;);
		psCopyInputs.GetChild(i).SetProperty(&quot;MPP User Action Scenario&quot;, &quot;0&quot;);
		psCopyInputs.GetChild(i).SetProperty(&quot;MPP User Action&quot;, &quot;N/A&quot;);
		psCopyInputs.GetChild(i).SetProperty(&quot;MPP Order Item Id&quot;, sLineItemId);
		psCopyInputs.GetChild(i).SetProperty(&quot;MPP Type&quot;, &quot;TBUI MPP Script&quot;);
		psCopyInputs.GetChild(i).SetProperty(&quot;MPP Contract Months TBUI&quot;, strTerm);
		//psCopyInputs.GetChild(i).SetProperty(&quot;MPP MSISDN for Connection&quot;, &quot;&quot;);
		psCopyInputs.GetChild(i).SetProperty(&quot;MPP IMEI for Connection&quot;, strIMEI);
		psCopyInputs.GetChild(i).SetProperty(&quot;MPP Device Description&quot;, strDeviceType);
		psCopyInputs.GetChild(i).SetProperty(&quot;MPP Dealer Code&quot;, strDealerCode);
		psCopyInputs.GetChild(i).SetProperty(&quot;MPP Credit Check Accept Code&quot;, strAcceptCode);
		psCopyInputs.GetChild(i).SetProperty(&quot;MPP Approved Credit Limit&quot;, strApprovedCLA);
		psCopyInputs.GetChild(i).SetProperty(&quot;MPP Plan&quot;, strProduct);
		psCopyInputs.GetChild(i).SetProperty(&quot;MPP Proposition Code&quot;, strProductCode);
		psCopyInputs.GetChild(i).SetProperty(&quot;MPP RCC F&quot;, strRCC);
		psCopyInputs.GetChild(i).SetProperty(&quot;MPP Remaining Balance F&quot;, &quot;0&quot;);
		psCopyInputs.GetChild(i).SetProperty(&quot;MPP Smartscript Action&quot;, sSmartScrtAction);
		psCopyInputs.GetChild(i).SetProperty(&quot;MPP Contract Amount&quot;, strCAmt);
		psCopyInputs.GetChild(i).SetProperty(&quot;MPP IMEI Flag&quot;, strVFFlag);
		psCopyInputs.GetChild(i).SetProperty(&quot;MPP Contract Id&quot;, strMPPContractId);
		//psCopyInputs.GetChild(i).SetProperty(&quot;MPP Id&quot;, );
		psCopyInputs.GetChild(i).SetProperty(&quot;MPP Order Item Action&quot;, strAction);
		psCopyInputs.GetChild(i).SetProperty(&quot;MPP Product Name&quot;, strProductName);
		psCopyInputs.GetChild(i).SetProperty(&quot;MPP Previous MPPAmount&quot;, strPrevMPPAmt);
		psCopyInputs.GetChild(i).SetProperty(&quot;VF MPP Altered&quot;, &quot;0&quot;);
		
		if (sStockIndicator == &quot;Out of Stock - Connect Later&quot; || sStockIndicator == &quot;Out of Stock - Connect Now&quot;)
			{
			psCopyInputs.GetChild(i).SetProperty(&quot;MPP Mandatory Amount F&quot;, strRCC);
			psCopyInputs.GetChild(i).SetProperty(&quot;MPP Forced F&quot;, &quot;Y&quot;);
			}
		else
			{
			psCopyInputs.GetChild(i).SetProperty(&quot;MPP Mandatory Amount F&quot;, strMandateAmount);
			psCopyInputs.GetChild(i).SetProperty(&quot;MPP Forced F&quot;, strMandate);
			}
		}	
		
		
	}
catch (e)
	{
		throw e;
	}
finally
	{

	/*Below variables are nullified by Sharukh on 18/03/2019*/
	psIns = null;
	psOut = null;
	
	}
}"
			   SEQUENCE="91"
			   UPDATED="01/09/2026 15:43:19"
			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 15:43:19"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mMPPEvaluate"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mMPPEvaluate(psOutputs, &amp;Outputs)
{
	/*
	* Component Name        : 	mMPPEvaluate
	* Method Name           : 	
	* Component Information : psOutputs has group of line item. This function will loop in all
	*						  line item to evaluate it	
	*
	* Modification History  :
	* Date			Author		Config #	Description
	* ============ ===========	===========	================================
	* 04/09/2014	Balaji					Initial version
	*/
try
	{
	
	var iNoOfServices = 0;
	var sLineItemId, sConnectType =&quot;&quot;;	
	var LineIn = TheApplication().NewPropertySet();
	var LineOut = TheApplication().NewPropertySet();
	var psCopyInputs = TheApplication().NewPropertySet();
	var strAcceptCode=&quot;&quot;, strCCExpDate=&quot;&quot;, strApprovedCLA=&quot;&quot;, strCAmt=&quot;&quot;, strDealerCode=&quot;&quot;, MPPExists=&quot;&quot;, sMppContId=&quot;&quot;;
	var strContactId = &quot;&quot;, strCustAccId = &quot;&quot;, strAccType = &quot;&quot;, strOrderFunctionPlan = &quot;&quot;;
	var sResId =&quot;&quot;, SDevCode=&quot;&quot;;
	var sConnType = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_SERVICE_STOCK_TBUI&quot;,&quot;Plan and Device&quot;);	
	var sConnectLater = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_ORDER_STOCK_INDICATOR&quot;,&quot;Out of Stock - Connect Later&quot;);	//Balaji : 11 02 2015:Added for SPS
	var sStockInd = &quot;&quot;;	//Balaji : 11 02 2015:Added for SPS
	var SiebelProdType = &quot;&quot;; //Rinu - 23/05/2017 - Added for PIPE
	var sHandsetItemId,sHandsetTerm;
	psCopyInputs = psOutputs.GetChild(0).GetChild(0).Copy();	
	iNoOfServices = psCopyInputs.GetChildCount();
	
	Outputs.SetProperty(&quot;GotoMPPView&quot;, &quot;&quot;);
	Outputs.SetProperty(&quot;GotoShipView&quot;,&quot;&quot;);//Balaji : 11 02 2015:Added for SPS
	// Get Finacial Prifile info for CA	
	mMPPFinacialProfile();

	//TARIQ-24NOV2014-PT-Get Order Header Details
	mMPPGetOrderFields(strContactId, strCustAccId, strAccType, strOrderFunctionPlan);
	//Check Mandatory MPP Resp	
	//MANI
	var bsRespName;
	var RespName;
	var psInputs1;
	var psOutputs1;
	bsRespName = TheApplication().GetService(&quot;VF Get LIC Name&quot;);
	psInputs1 = TheApplication().NewPropertySet();
	psOutputs1 = TheApplication().NewPropertySet();
	psInputs1.SetProperty(&quot;LOVType&quot;, &quot;VHA_FUNCTION_ACCESS_RESP&quot;);
	psInputs1.SetProperty(&quot;DisplayValue&quot;,&quot;Resp|AccessMPPOveride&quot;);
	bsRespName.InvokeMethod(&quot;getLICName&quot;, psInputs1, psOutputs1);
	RespName = psOutputs1.GetProperty(&quot;LICName&quot;);

	var strResponsibility = RespName;
	var strMandateMPPRespExists = mMPPCheckResponsibility(strResponsibility);
	TheApplication().SetProfileAttr(&quot;usrMandateMPPRespExists&quot;, strMandateMPPRespExists);
	//TARIQ-24NOV2014-PT-Chanes End
	
	if (iNoOfServices &lt; 1)
		{
		TheApplication().RaiseErrorText(&quot;No Line Item added for this Order&quot;);
		}	
	//Loop Line Item to Evaluate MPP
	for (var i=0; i &lt; iNoOfServices; i++)
		{
		// Evaluate MPP starts here
		
		sLineItemId = psCopyInputs.GetChild(i).GetProperty(&quot;Order Item Id&quot;); 
		sConnectType = psCopyInputs.GetChild(i).GetProperty(&quot;VF ConnectionType&quot;); 
		sStockInd = psCopyInputs.GetChild(i).GetProperty(&quot;VF Stock Indicator TBUI&quot;);//Balaji : 11 02 2015:Added for SPS
		SiebelProdType = psCopyInputs.GetChild(i).GetProperty(&quot;VF Siebel Product Type&quot;); //Rinu - 23/05/2017 - Added for PIPE
		LineIn.SetProperty(&quot;MSISDN&quot;, psCopyInputs.GetChild(i).GetProperty(&quot;VF MSISDN TBUI&quot;));
		LineIn.SetProperty(&quot;LineItemId&quot;, sLineItemId);
		LineIn.SetProperty(&quot;Cursor&quot;, i);
		
		//TARIQ-24NOV2014-PT-Add Order Header Details-Changes Start
		LineIn.SetProperty(&quot;AccType&quot;, strAccType);
		LineIn.SetProperty(&quot;AccId&quot;, strCustAccId);
		LineIn.SetProperty(&quot;ContactId&quot;, strContactId);
		LineIn.SetProperty(&quot;OrderFunctionPlan&quot;, strOrderFunctionPlan);
		LineIn.SetProperty(&quot;MandateMPPRespExists&quot;, strMandateMPPRespExists);
		LineIn.SetProperty(&quot;ServiceType&quot;, psCopyInputs.GetChild(i).GetProperty(&quot;Service Type&quot;));
		LineIn.SetProperty(&quot;RootAssetIntId&quot;, psCopyInputs.GetChild(i).GetProperty(&quot;Asset Integration Id&quot;));
		LineIn.SetProperty(&quot;VF Stock Indicator TBUI&quot;, psCopyInputs.GetChild(i).GetProperty(&quot;VF Stock Indicator TBUI&quot;));
		LineIn.SetProperty(&quot;StoreDevice&quot;,psCopyInputs.GetChild(i).GetProperty(&quot;Device Code&quot;));
		LineIn.SetProperty(&quot;ReservationId&quot;,psCopyInputs.GetChild(i).GetProperty(&quot;Reservation Id&quot;));
		//TARIQ-24NOV2014-PT-Changes End	
		mMPPEachLineItem(LineIn, psCopyInputs);	
		FindMPPContractTerm(LineIn, psCopyInputs);//TULASIY:05Feb2024::Mapping GPP Quote Term to Order Term
		FindMPPContract(sLineItemId);//TARIQ-20JAN2015-Added		
	
		//Aruna:31125:Added for Ignite R2
		var sLineBC1 = TheApplication().GetBusObject(&quot;VF Order Entry Thin BO&quot;).GetBusComp(&quot;VF Order Line Items - Thin BC&quot;);
		var pegaBC1 = TheApplication().GetBusObject(&quot;VHA Pega Recommendation TBUI BO&quot;).GetBusComp(&quot;VHA Pega Accepted Recommendation TBUI Details&quot;);
		with(sLineBC1)
		{
			ClearToQuery();
			SetViewMode(AllView);
			ActivateField(&quot;VF Sales Calc Quote Item Id&quot;);
            SetSearchExpr(&quot;[Order Id] = &apos;&quot;+sOrderId+&quot;&apos; AND [Id] = &apos;&quot;+sLineItemId+&quot;&apos; AND [Parent Order Item Id] IS NULL AND [Action Code] &lt;&gt; &apos;Delete&apos;&quot;);
			ExecuteQuery(ForwardBackward);
			if(FirstRecord())
			{		
				sHandsetItemId = GetFieldValue(&quot;VF Sales Calc Quote Item Id&quot;);
			}
			
		}
		if(sHandsetItemId != null &amp;&amp; sHandsetItemId != &quot;&quot;)
		{
		 with(pegaBC1)
			{
				ClearToQuery();									
				ActivateField(&quot;ValidMPPTerm&quot;);	
		
				SetViewMode(AllView);
				//SetSearchSpec(&quot;Quote Id&quot;, sQuoteId);
				SetSearchSpec(&quot;Id&quot;, sHandsetItemId);
			
				ExecuteQuery(ForwardOnly);			
				if (FirstRecord())
				{	
				 sHandsetTerm = GetFieldValue(&quot;ValidMPPTerm&quot;);					
				}
			}
		psCopyInputs.GetChild(i).SetProperty(&quot;MPP Contract Months TBUI&quot;, sHandsetTerm);		
		}

		// Used in task to bypass the MPP view when all line item are sim only
			var sRCC = psCopyInputs.GetChild(i).GetProperty(&quot;MPP RCC F&quot;);
			var sMPPFlag = psCopyInputs.GetChild(i).GetProperty(&quot;MPP IMEI Flag&quot;);//TARIQ-22JAN2015-Added
			
		//Rinu - 23/05/2017 - Added for PIPE - START	
		if(SiebelProdType == TheApplication().InvokeMethod(&quot;LookUpValue&quot;,&quot;VF_PROD_TYPE&quot;,&quot;NBN with MBB&quot;) || SiebelProdType == TheApplication().InvokeMethod(&quot;LookUpValue&quot;,&quot;VF_PROD_TYPE&quot;,&quot;NBN Only&quot;))
		{
			sRCC = 0;
			sMPPFlag=&quot;&quot;;
			psCopyInputs.GetChild(i).SetProperty(&quot;MPP Active&quot;, &quot;N&quot;);
			psCopyInputs.GetChild(i).SetProperty(&quot;MPP RCC F&quot;,&quot;0&quot;);
				
		}			
		//Rinu - 23/05/2017 - Added for PIPE - END
		TheApplication().SetProfileAttr(&quot;RCC2&quot;,sRCC + sMPPFlag);	
		//if(sConnectType == sConnType)
		if(ToNumber(sRCC) &gt; 0) 
			{
			Outputs.SetProperty(&quot;GotoMPPView&quot;, &quot;Y&quot;);			
			}
		else if (sMPPFlag == &quot;N&quot;)//TARIQ-22JAN2015-Added the else if
			{
			Outputs.SetProperty(&quot;GotoMPPView&quot;, &quot;Y&quot;);
			}
		else
			{
			psCopyInputs.GetChild(i).SetProperty(&quot;MPP Active&quot;, &quot;N&quot;);
			}			
			
		if(sStockInd == sConnectLater) // Balaji Added for SPS 18/12/2014
		{
			Outputs.SetProperty(&quot;GotoShipView&quot;, &quot;Y&quot;);
		}
		//This will work in previous scenario (MPP view --&gt; Select Prop view) (ie)...
		//when user changes the plan or IMEI or connection type...
		
		
		var sRCC = psCopyInputs.GetChild(i).GetProperty(&quot;MPP RCC F&quot;);
		
		// This will work when user come back and change from &quot;plan and device&quot; to &quot;sim only&quot;..
		// And when rcc &lt;0 and Mpp Contract exist then remove the mpp contract and make the MPP active field to N in staging BC
		/*if(sRCC &gt; 0)
			{//skip
			}
		else *///TARIQ-20JAN2015-Commented the if
		/*if (sMppContId != &quot;&quot; &amp;&amp; sMppContId != null)
			{
			//Remove MPP Line Item. 
			var bsService = TheApplication().GetService(&quot;VF Generic Product Manipulation Service&quot;);
			var bsInputs = TheApplication().NewPropertySet();
			var bsOutputs = TheApplication().NewPropertySet();			
			bsInputs.SetProperty(&quot;Order Item Id&quot;, sMppContId);
			bsInputs.SetProperty(&quot;Order Id&quot;, sOrderId);
			bsService.InvokeMethod(&quot;Delete MPP Contract&quot;, bsInputs, bsOutputs);
			psCopyInputs.GetChild(i).SetProperty(&quot;MPP Active&quot;, &quot;N&quot;);
			}*/
		/*else 
			{//skip
			}*/
		}	

		//Call MPP Smartscript BC update *##*
		var sOutIO = &quot;VF MPP Order Task Support&quot;;
		var sMap = &quot;VF MPP Order Task Support&quot;;
		mMPPBCUpsert(psCopyInputs, psOutputs, sOutIO, sMap);
		
		//Call Task Validation Update BC *##*
		mInsertInValidationBC(psCopyInputs, psOutputs);		
	}
catch (e)
	{
		throw e;
	}
finally
	{
   /*Below variables are nullified by Sharukh on 18/03/2019*/
	LineIn = null;
	LineOut = null;
	psCopyInputs = null;

		
	}
}"
			   SEQUENCE="92"
			   UPDATED="01/09/2026 15:43:19"
			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 15:43:19"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mMPPFinacialProfile"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mMPPFinacialProfile()
{
	/*
	* Component Name        : 	mMPPFinacialProfile
	* Method Name           : 	
	* Component Information : 	
	*
	* Modification History  :
	* Date			Author		Config #	Description
	* ============ ===========	===========	================================
	* 04/09/2014	Balaji					Initial version
	*/
try
	{
	var oFinProfBo = TheApplication().GetBusObject(&quot;VF Com Financial Profile BO&quot;);
	var oFinProfBc = oFinProfBo.GetBusComp(&quot;VF Com Financial Profile&quot;);
	
	with (oFinProfBc) 
		{
		ActivateField(&quot;VF Accept Code&quot;);
		ActivateField(&quot;VF MPP Contract Approved Amount&quot;);
		ActivateField(&quot;VF MPP Contract Amount&quot;);
		ActivateField(&quot;VF Credit Check Expiry Date&quot;);
		ActivateField(&quot;Account Id&quot;);
		ActivateField(&quot;Dealer Code&quot;);
		ActivateField(&quot;VHA Remaining Equipment Limit&quot;);//KAMALI: 25/10/2015 - Added for R16.1 EL
		ClearToQuery();
		SetViewMode(AllView);
		SetSearchSpec(&quot;Account Id&quot;, sCustAccountId);
		ExecuteQuery(ForwardOnly);
		if (FirstRecord()) 
			{
			strAcceptCode = GetFieldValue(&quot;VF Accept Code&quot;);
			strCCExpDate = GetFieldValue(&quot;VF Credit Check Expiry Date&quot;);
			strApprovedCLA = GetFieldValue(&quot;VF MPP Contract Approved Amount&quot;);
			strCAmt = GetFieldValue(&quot;VF MPP Contract Amount&quot;);
			strDealerCode = GetFieldValue(&quot;Dealer Code&quot;);
			strRemainingEqLimit = ToNumber(GetFieldValue(&quot;VHA Remaining Equipment Limit&quot;));//KAMALI: 25/10/2015 - Added for R16.1 EL
			} 
		else 
		    //[Nagesh][Account Structure Shared fins]
			{
				var pInputs = TheApplication().NewPropertySet();
				var pOutputs = TheApplication().NewPropertySet();
				var svc = TheApplication().GetService(&quot;VHA SharedFP EL Calc BS&quot;);
		        pInputs.SetProperty(&quot;AccountId&quot;, sCustAccountId);
				svc.InvokeMethod(&quot;CalculateEL&quot;, pInputs, pOutputs);
				strAcceptCode = pOutputs.GetProperty(&quot;AcceptCode&quot;);
				strCCExpDate = pOutputs.GetProperty(&quot;CCExpDate&quot;);
				strApprovedCLA = pOutputs.GetProperty(&quot;ApprovedCLA&quot;);
				strCAmt = pOutputs.GetProperty(&quot;ContractAmt&quot;);
				strDealerCode = pOutputs.GetProperty(&quot;DealerCode&quot;);
				strRemainingEqLimit = ToNumber(pOutputs.GetProperty(&quot;RemainingEqLimit&quot;));
				if(strCCExpDate == &quot;&quot; || strCCExpDate == null)
				{
				 strCCExpDate = &quot;NA&quot;;
				}
				if(strApprovedCLA == &quot;&quot; || strApprovedCLA == null)
				{
				 strApprovedCLA = &quot;0&quot;;
				}
			}//[Nagesh][Account Structure Shared fins]
		/*Outputs.SetProperty(&quot;FPAcceptCode&quot;, strAcceptCode);
		Outputs.SetProperty(&quot;FPCCExpDate&quot;, strCCExpDate);
		Outputs.SetProperty(&quot;FPApprovedCLA&quot;, strApprovedCLA);
		Outputs.SetProperty(&quot;FPCAmt&quot;, strCAmt);
		Outputs.SetProperty(&quot;FPDealerCode&quot;, strDealerCode);*/
		}
	}

catch(e)
	{
		throw(e);
	}
finally
	{
	//Kailash - Modified BO,BC nullification
	oFinProfBc=null;
	oFinProfBo=null;
	
	}
}"
