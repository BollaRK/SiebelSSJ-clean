			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="FindMPPContract"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function FindMPPContract(sLineItemId)
{

	try
	{
		var sLineBC = TheApplication().GetBusObject(&quot;Order Entry - Thin MSO&quot;).GetBusComp(&quot;VF Order Line Items - Thin&quot;);
        var isrec;
		with (sLineBC)
		{
			ClearToQuery();
			SetViewMode(AllView);
			//SetSearchSpec(&quot;Order Id&quot;, sOrderId);
			//SetSearchSpec(&quot;Root Order Item Id&quot;, sLineItemId);
		    //SetSearchSpec(&quot;Product Type&quot;, &quot;Billing - GPP&quot;);
            //SetSearchSpec(&quot;Product Type&quot;,&quot;&quot;);
			//SetSearchSpec(&quot;Action Code&quot;, &quot;Add&quot;);
            SetSearchExpr(&quot;[Order Id] = &apos;&quot;+sOrderId+&quot;&apos; AND  [Root Order Item Id] = &apos;&quot;+sLineItemId+&quot;&apos; AND ([Product Type] = &apos;Billing - MPP&apos; OR ([Product Type] = &apos;Billing - GPP&apos; AND [Siebel Product Type] = &apos;Device&apos;) OR ([Siebel Product Type] = &apos;Insurance&apos; OR [Siebel Product Type] = &apos;Free Insurance&apos;)) AND [Action Code] = &apos;Add&apos;&quot;);
			ExecuteQuery(ForwardBackward);
			/*if (FirstRecord())
			{
				//return(GetFieldValue(&quot;Id&quot;));
				
				DeleteRecord();
			}*/
            //isrec = FirstRecord();
            while(FirstRecord())
			{		
			   DeleteRecord();
			}
			
		}
	}
	catch (e)
	{
		throw e;
	}
	finally
	{
		sLineBC = null;
	}
}"
