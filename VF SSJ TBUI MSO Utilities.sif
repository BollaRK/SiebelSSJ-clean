			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCallAsyncFlow"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCallAsyncFlow(psInputs, psOutputs)
{
	try
	{
	  //Call Async WF to Create Line Items/Allocate SIM/submit Order
	  var sFulfilmentId =  psInputs.GetProperty(&quot;FulfilmentOrderId&quot;);
	  var sParentOrderId =  psInputs.GetProperty(&quot;ParentOrderId&quot;);
	  var sOrderChannel = psInputs.GetProperty(&quot;OrderChannel&quot;);
	  var sFulfilmentOrderStatus = psInputs.GetProperty(&quot;FulfilmentOrderStatus&quot;);
	  var sExternalId = psInputs.GetProperty(&quot;ExternalId&quot;);
	  var psWFInput = TheApplication().NewPropertySet();
	  var psChild = TheApplication().NewPropertySet();
	  var psWFOutput = TheApplication().NewPropertySet();
	  var bsASR = TheApplication().GetService(&quot;Server Requests&quot;);
	  psWFInput.SetProperty(&quot;Component&quot;, &quot;VFOrders&quot;);
      psWFInput.SetProperty(&quot;ComponentJob&quot;, &quot;VFOrders&quot;);
      psWFInput.SetProperty(&quot;DelAmount&quot;, &quot;0&quot;);
      psWFInput.SetProperty(&quot;DelUnits&quot;, &quot;ASAP&quot;);
      psWFInput.SetProperty(&quot;Mode&quot;, &quot;DirectDb&quot;);
	  if (sFulfilmentOrderStatus == &quot;Pending&quot;) // JS: Added for MSOD SIT # 246
	  {    
	      if ((sOrderChannel != &quot;VHA Online Store&quot;)  || (sOrderChannel == &quot;VHA Online Store&quot; &amp;&amp; sExternalId==&quot;UPEX&quot;))// JS: Added for MSOD SIT # 246
	      {
		      psChild.SetProperty(&quot;ProcessName&quot;, &quot;VHA OM Submit Order Framework&quot;);
		      psChild.SetProperty(&quot;Object Id&quot;, sFulfilmentId);
		      psChild.SetProperty(&quot;Parent Order Id&quot;, sParentOrderId);
		      psChild.SetProperty(&quot;OrderValidate Flag&quot;, &quot;Y&quot;);
		      psChild.SetProperty(&quot;PostValidate Flag&quot;, &quot;N&quot;);
		      psChild.SetProperty(&quot;PreSubmit Flag&quot;, &quot;Y&quot;);
		      psChild.SetProperty(&quot;PreValidate Flag&quot;, &quot;Y&quot;);
		      psChild.SetProperty(&quot;Process Flow&quot;,&quot;TBUI Upgrade&quot;);    
			  psChild.SetProperty(&quot;OrderValidate Flag&quot;,&quot;Y&quot;);
		  }
		  else // JS: Added for MSOD SIT # 246
		  {
		  	  psChild.SetProperty(&quot;ProcessName&quot;, &quot;VHA OM Submit Order Framework&quot;); // Modified to New Submit Order Framework by Latha Yethadka for OS Ph2
		      psChild.SetProperty(&quot;Object Id&quot;, sFulfilmentId);
		      psChild.SetProperty(&quot;CallIntegration&quot;, &quot;Y&quot;); // Modified to New Submit Order Framework by Latha Yethadka for OS Ph2
		  }
	  }
	  psWFInput.AddChild(psChild);
      bsASR.InvokeMethod(&quot;SubmitRequest&quot;, psWFInput, psWFOutput);	   
	 
  } //try
  catch(e)
  {
	 throw(e);
  }
  finally
  {
	 psWFInput   = null;
	 psChild   = null;
	 psWFOutput   = null;
	 bsASR   = null;  /* This variable is nullified by Sharukh on 18/03/2019*/

  }
}"
