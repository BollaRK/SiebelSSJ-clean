			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="CancelExistingFulfilOrder"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function CancelExistingFulfilOrder(FulOrderId)
{
	try
	{
		var bcOrder = TheApplication().GetBusObject(&quot;MACD Performance Order&quot;).GetBusComp(&quot;MACD Order Entry - Orders&quot;);
		with (bcOrder)
		{
			ClearToQuery();
			SetSearchSpec(&quot;Id&quot;, FulOrderId);
			ExecuteQuery();
			if (FirstRecord())
			{
				SetFieldValue(&quot;Active&quot;, &quot;N&quot;);
				SetFieldValue(&quot;Status&quot;, &quot;Cancelled&quot;);
				WriteRecord();
				//DeleteRecord();
			}
		}
	}
	catch(e)
	{
		throw e;
	}
	finally
	{
		bcOrder = null;
	}
}"
