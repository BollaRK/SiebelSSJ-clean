			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="UpdateFulfilmentOrder"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function UpdateFulfilmentOrder(bsOutputs)
{
	//Updating Fulfilment Order to Set Correct Out of Stock Indicator and Sales Channel
	//To ensure that SIM gets Added properly on Submit Order
	//NEEL 18.01.2015
	try
	{
		var strFulfilId = bsOutputs.GetProperty(&quot;FulfilmentOrderId&quot;);
		var strOOSType = bsOutputs.GetProperty(&quot;FulfilmentType&quot;);
		//02/04/2019: Christy :Modified for unified application
		//var sAppName = TheApplication().GetProfileAttr(&quot;ApplicationName&quot;);
		var sAppName = TheApplication().GetProfileAttr(&quot;VHA User Type&quot;);
		var strChannel=&quot;&quot;;
		
		var boOrder = TheApplication().GetBusObject(&quot;VF Orders Thin&quot;);
		var bcOrder = boOrder.GetBusComp(&quot;VF Order Header&quot;);
		bcOrder.ActivateField(&quot;VF Order Channel&quot;);
		bcOrder.ActivateField(&quot;VF External Reference Id&quot;);
		bcOrder.ActivateField(&quot;VF Out of Stock Indicator&quot;);
		bcOrder.SetViewMode(AllView);
		bcOrder.ClearToQuery();
		bcOrder.SetSearchSpec(&quot;Id&quot;, strFulfilId);
		bcOrder.ExecuteQuery(ForwardBackward);
	    if (bcOrder.FirstRecord())
		{
			//02/04/2019: Christy :Modified for unified application
			//if(sAppName == &quot;Siebel Power Communications&quot;)
			if(sAppName == TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_USER_TYPE&quot;, &quot;Care&quot;))
			{
				bcOrder.SetFieldValue(&quot;VF External Reference Id&quot;,bcOrder.GetFieldValue(&quot;Order Number&quot;));
				bcOrder.SetFieldValue(&quot;VF Out of Stock Indicator&quot;,&quot;In Stock&quot;);
			}
			else
			{
				if(strOOSType == &quot;Out of Stock - Connect Now&quot;)
					bcOrder.SetFieldValue(&quot;VF Order Channel&quot;,&quot;instoreDF&quot;);
				else
					bcOrder.SetFieldValue(&quot;VF Order Channel&quot;,&quot;CLinstore&quot;);
					
				bcOrder.SetFieldValue(&quot;VF Out of Stock Indicator&quot;,strOOSType);
			}
			
			bcOrder.WriteRecord();
		}	
	}
	catch(e)
	{
		throw e;
	}
	finally
	{
		bcOrder = null;
		boOrder = null;
	}
}"
