			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCheckSharingIndicator"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCheckSharingIndicator(sProductId,sRootOrderId)
{
	try
	{
		var sSharingIndicator;
		var sPlanId;
		var boOrder = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
		var bcOrder = boOrder.GetBusComp(&quot;VF Order Entry - Line Items - Primary Product - TBUI&quot;);
		with (bcOrder)
		{
			SetViewMode(AllView);
			ActivateField(&quot;Product Id&quot;);
			ActivateField(&quot;Root Order Item Id&quot;);
			ActivateField(&quot;VF Sharing Indicator&quot;);
			ClearToQuery();
			SetSearchSpec(&quot;Root Order Item Id&quot;, sRootOrderId);
			ExecuteQuery(ForwardOnly);	
			var isRecord = FirstRecord(); 
			if(isRecord) 
			{
				sPlanId = GetFieldValue(&quot;Product Id&quot;);
				sSharingIndicator = GetFieldValue(&quot;VF Sharing Indicator&quot;);	
			}
		}
			return(sSharingIndicator);
	}
	catch(e)
	{
		throw e;
	}
	finally
	{
		bcOrder = null;
		boOrder = null;
	}
}"
