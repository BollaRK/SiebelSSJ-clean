			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="AllocateMSISDN"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function AllocateMSISDN()
{
	try
	{
		var bsEAIService = TheApplication().GetService(&quot;EAI Siebel Adapter&quot;);
		var psInputs = TheApplication().NewPropertySet();
		var psOutputs = TheApplication().NewPropertySet();
		var bulkOutputs = TheApplication().NewPropertySet();
		//var bsInvokeBS = TheApplication().GetService(&quot;VF Bulk Processing Service&quot;);
		var bsInvokeBS = TheApplication().GetService(&quot;VF Allocate MSISDN TBUI&quot;);
		var iNoOfServices=0, sLineNum = &quot;&quot;, sIndErrMsg = &quot;&quot;, sErrMsg = &quot;&quot;, i = 0, sNewMSISDN = &quot;&quot;, sRootOrderItemId = &quot;&quot;, sTBUIMSISDN = &quot;&quot;;
		var sPortin = &quot;&quot;;
		var sSiebelProdType = &quot;&quot;;
		//psInputs.SetProperty(&quot;SearchSpec&quot;,&quot;[VF Order Item Task Simple.Order Header Id] = &apos;&quot; + sOrderId + &quot;&apos;&quot;);
		psInputs.SetProperty(&quot;SearchSpec&quot;,&quot;[VF Order Item Task Simple.Order Header Id] = &apos;&quot; + sOrderId + &quot;&apos; AND [VF Order Item Task Simple.Product Type] &lt;&gt; &apos;Promotion&apos;&quot;);
		psInputs.SetProperty(&quot;OutputIntObjectName&quot;, &quot;VF Order Item Task Simple&quot;);
		bsEAIService.InvokeMethod(&quot;Query&quot;, psInputs, psOutputs);
		
		iNoOfServices = psOutputs.GetChild(0).GetChild(0).GetChildCount();
		if (iNoOfServices &lt; 1)
		{
			TheApplication().RaiseErrorText(&quot;Please add atleast one service to proceed with this order&quot;);
		}
		
		//Allocate MSISDN
		for (i=0;i &lt; iNoOfServices; i++)
		{
			sLineNum = psOutputs.GetChild(0).GetChild(0).GetChild(i).GetProperty(&quot;VF Line Number&quot;);
			sNewMSISDN = psOutputs.GetChild(0).GetChild(0).GetChild(i).GetProperty(&quot;New MSISDN&quot;);
			sRootOrderItemId = psOutputs.GetChild(0).GetChild(0).GetChild(i).GetProperty(&quot;Order Item Id&quot;);
			sTBUIMSISDN = psOutputs.GetChild(0).GetChild(0).GetChild(i).GetProperty(&quot;VF MSISDN TBUI&quot;);
			sPortin = psOutputs.GetChild(0).GetChild(0).GetChild(i).GetProperty(&quot;VF Port In TBUI&quot;);
			sSiebelProdType = psOutputs.GetChild(0).GetChild(0).GetChild(i).GetProperty(&quot;VF Siebel Product Type&quot;);
			
			if (sPortin == &quot;No&quot; &amp;&amp; (sNewMSISDN == &quot;&quot; || sNewMSISDN == null))
			{
				if (sTBUIMSISDN != &quot;&quot; &amp;&amp; sTBUIMSISDN != null)
				{
					psInputs.Reset();
					bulkOutputs.Reset();
					psInputs.SetProperty(&quot;Order Id&quot;, sOrderId);
					psInputs.SetProperty(&quot;MSISDN&quot;, sTBUIMSISDN);
					if(sSiebelProdType == TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_FBB_PROPOSITION_TYPE&quot;,&quot;FBB with MBB&quot;) || sSiebelProdType == TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_FBB_PROPOSITION_TYPE&quot;,&quot;FBB Only&quot;))
					psInputs.SetProperty(&quot;Product Group&quot;, &quot;FBB&quot;);
					else
					psInputs.SetProperty(&quot;Product Group&quot;, &quot;General&quot;);
					
					psInputs.SetProperty(&quot;Root Line Item Id&quot;, sRootOrderItemId);
					bsInvokeBS.InvokeMethod(&quot;Allocate MSISDN&quot;, psInputs, bulkOutputs);
					sLineNum = &quot;&quot;, sNewMSISDN = &quot;&quot;, sRootOrderItemId = &quot;&quot;, sTBUIMSISDN = &quot;&quot;, sPortin = &quot;&quot;;
				}
			}
		}
	}
	catch(e)
	{
		TheApplication().RaiseErrorText(ToString(e));
	}
	finally
	{
		bsEAIService = null;
		psInputs = null;
		psOutputs = null;
		bsInvokeBS = null;
		bulkOutputs = null;
	}
}"
