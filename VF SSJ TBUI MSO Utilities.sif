		var sSPIDType = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;PRODUCT_TYPE&quot;, &quot;Device Content Subscription&quot;);
		with(sBCOrder)
		{
			ClearToQuery();
			SetViewMode(AllView);
			SetSearchSpec(&quot;Id&quot;,sOrderId);
			ExecuteQuery(ForwardOnly);
			if(FirstRecord())
			{
				with(bcOrderLineIt)
				{
					ClearToQuery();
					SetViewMode(AllView);
					SetSearchExpr(&quot;[Order Header Id] = &apos;&quot;+ sOrderId+&quot;&apos; AND [Action Code] = &apos;Add&apos; AND ([Product] = &apos;Accessory&apos; OR [Product Type] = &apos;Billing - APP&apos; OR [Product Type] = &apos;&quot;+sSPIDType+&quot;&apos; OR [VF Siebel Product Type] = &apos;&quot;+sIncType+&quot;&apos;)&quot;); 
					ExecuteQuery(ForwardOnly);
					while(FirstRecord())
					{		
						DeleteRecord();
					}
				}//end of with(bcOrderLineIt)
			}//end of if(FirstRecord())
		}// end of with(sBCOrder)
	}//end of try
	catch(e)
	{
		throw(e);
	}
	finally
	{
		sOrderId = null;
		bcOrderLineIt = null;
		sBCOrder = null;
		boOrder = null;
	}
}
