			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mDeleteRecord"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mDeleteRecord(&amp;oBC,sSearchStr)
{
	with (oBC)
	{
		ClearToQuery();
		SetViewMode(AllView);
		SetSearchExpr(sSearchStr);
		ExecuteQuery(ForwardOnly);
		while(FirstRecord())
		{
					
			DeleteRecord();
		}
	}
}"
