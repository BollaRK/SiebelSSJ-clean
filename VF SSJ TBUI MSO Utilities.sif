			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mValidateRRP"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mValidateRRP(Inputs, Outputs)
{
	try
	{
		var EQUIP_LIMIT = &quot;99108&quot;;
		var OrderId = Inputs.GetProperty(&quot;OrderId&quot;);
		var OrdNum =&quot;&quot;;
		var sDiff =&quot;&quot;;
		sCustAccountId = Inputs.GetProperty(&quot;AccountId&quot;);
		var AccountType = Inputs.GetProperty(&quot;Account Type&quot;);
		var sEGWBusSubType = Inputs.GetProperty(&quot;EGWSubType&quot;);
		var sEGWSwitch = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_EGW_INVOKE_LOGIC&quot;,&quot;EGWEquipCheck&quot;);
		var psOut = TheApplication().NewPropertySet();
		var RRPOut = TheApplication().NewPropertySet();
		var iSIMOCount=0,sTotalAPP=0,sTotalRRP=0;
		var sPrepayInput = TheApplication().NewPropertySet(); //balaji
		var sPrepayOutput = TheApplication().NewPropertySet(); //balaji
        var PPAmountpaidupfront = 0, TotalAccessoryUpfront= 0, TotalDeviceAmountPaidUpfront = 0;
        var sActView = TheApplication().ActiveViewName();
        var PrepaymentOption;
        var sInvoluntary = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_PREPAYMENT_OPTION&quot;, &quot;Involuntary&quot;);
        var sOrderType = Inputs.GetProperty(&quot;OrderType&quot;);//Vinodhini-06/08/2019-Added for SIT Defect Fix 625
		if( AccountType == &quot;Person&quot; || AccountType == &quot;Sole Trader&quot; || (sEGWBusSubType == &quot;First&quot; &amp;&amp; sEGWSwitch ==&quot;EGWEquipCheck_Y&quot;))//[Nagesh][Account Structure Shared fins]
		{
			if(sOrderType != &quot;Modify&quot;)//Vinodhini-06/08/2019-Added condition for Defect Fix 625
			{
			//Kamali: 29/04/2016 - Added for AoA2
			mValidateAPP(Inputs,psOut);
			sTotalRRP+=ToNumber(psOut.GetProperty(&quot;TotalAPP&quot;));
			}
			
			mMPPFinacialProfile();
			Inputs.SetProperty(&quot;Step&quot;,&quot;Validate&quot;);
			psOut.Reset();
  			 sTotalRRP+=mCalculateRRP(Inputs,psOut);

			//Monit Dua 08 October 2025 added for Credit Check Enhancement Digital Shop 3.0
			var boAccount = TheApplication().GetBusObject(&quot;Account&quot;);
			var bcOrder = boAccount.GetBusComp(&quot;Order Entry - Orders&quot;);
			with(bcOrder)
			{
				ClearToQuery();
				ActivateField(&quot;Account Id&quot;);
				ActivateField(&quot;VF Order Channel&quot;);
				ActivateField(&quot;Order Sub Type&quot;);
				SetSearchSpec(&quot;Id&quot;, OrderId);
				SetSearchSpec(&quot;VF Order Channel&quot;, &quot;VHA Online Store&quot;);
				SetSearchSpec(&quot;Order Sub Type&quot;, &quot;Fulfilment&quot;);
				ExecuteQuery();
				if(FirstRecord())
				{
					var sAccountId = GetFieldValue(&quot;Account Id&quot;);
					with(bcOrder)
					{
						ClearToQuery();
						ActivateField(&quot;Order Sub Type&quot;);
						ActivateField(&quot;VF Sales Person&quot;);
						ActivateField(&quot;Account Id&quot;);
						SetSearchSpec(&quot;Account Id&quot;, sAccountId);
						SetSearchSpec(&quot;Order Sub Type&quot;, &quot;Connect&quot;);
						SetSearchSpec(&quot;VF Sales Person&quot;, &quot;OLS-NEW&quot;);
						ExecuteQuery();
						if(FirstRecord())
						{
							OrderId = GetFieldValue(&quot;Id&quot;);
						}
					}
				}
		  	}
            //balajiM added for 19.3 4JUNE2019
  			mGetPrepayAmt(OrderId, sPrepayOutput); 
            PPAmountpaidupfront = sPrepayOutput.GetProperty(&quot;PPAmountpaidupfront&quot;);
            TotalAccessoryUpfront = sPrepayOutput.GetProperty(&quot;TotalAccessoryUpfront&quot;);
            TotalDeviceAmountPaidUpfront = sPrepayOutput.GetProperty(&quot;TotalDeviceAmountPaidUpfront&quot;);
            PrepaymentOption = sPrepayOutput.GetProperty(&quot;PrepaymentOption&quot;);
           //balajiM added for 19.3 4JUNE2019 END
			iSIMOCount=mCalcSIMOCount(Inputs);
			if(iSIMOCount&gt;0)
				strRemainingEqLimit=strRemainingEqLimit-(iSIMOCount*ToNumber(TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_EQUIPMENT_NOTIONAL_VALUE&quot;,&quot;Equipment Value&quot;)));
				
    			//sDiff = ToNumber(strRemainingEqLimit)-ToNumber(sTotalRRP)+ToNumber(PPAmountpaidupfront); //balajiM modified for 19.3 4JUNE2019
    		
    			
			//if(sTotalRRP &gt; (strRemainingEqLimit + ToNumber(PPAmountpaidupfront))) //balajiM modified for 19.3 4JUNE2019
			sTotalRRP = ToNumber(sTotalRRP).toFixed(2);
			strRemainingEqLimit = ToNumber(strRemainingEqLimit).toFixed(2);
			PPAmountpaidupfront = ToNumber(PPAmountpaidupfront).toFixed(2);			
			sDiff = ToNumber(strRemainingEqLimit)-ToNumber(sTotalRRP);
				TheApplication().SetProfileAttr(&quot;ApplefraudNew&quot;,sTotalRRP + strRemainingEqLimit + PPAmountpaidupfront);
				if(ToNumber(sTotalRRP) &gt; (ToNumber(strRemainingEqLimit) + ToNumber(PPAmountpaidupfront)))
				{
					sDiff = ToNumber(sTotalRRP)-ToNumber(strRemainingEqLimit)-ToNumber(PPAmountpaidupfront); //balajiM modified for 19.3 4JUNE2019
					sDiff = ToNumber(sDiff).toFixed(2);	
					sTotalRRP = ToNumber(sTotalRRP).toFixed(2);
					strRemainingEqLimit = ToNumber(strRemainingEqLimit).toFixed(2);			
					TheApplication().RaiseErrorText(&quot;VFErrorCode#&quot;+EQUIP_LIMIT+ &quot; &quot; + TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;99108&quot;,sTotalRRP,strRemainingEqLimit,sDiff ));
				}
	
			
			if(sIfPrepayment == &quot;Y&quot;)
			{
				sDiff = ToNumber(sDiff) + ToNumber(PPAmountpaidupfront);
			}
			strRemainingEqLimit = ToNumber(strRemainingEqLimit).toFixed(2);
			sDiff = ToNumber(sDiff).toFixed(2);
			RRPOut.SetProperty(&quot;TotalRRP&quot;,strRemainingEqLimit);
			RRPOut.SetProperty(&quot;RemEL&quot;,sDiff);
									
				
		 }
	return(RRPOut);
	}

	catch(e)
	{
		throw e;
	}
	finally
	{
	/*Below variables are nullified by Sharukh on 20/03/2019*/
	psOut = null;
	RRPOut = null;
	}

}"
			   SEQUENCE="120"
			   UPDATED="01/09/2026 15:43:20"
			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 15:43:20"
