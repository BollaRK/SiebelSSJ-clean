			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetOrderItemAttr"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mGetOrderItemAttr(oLineXA,sSearchExpr)
{
	try
	{	
		var strReturnVal = &quot;&quot;;
		var oBCLitemItemXA;		
		
		oBCLitemItemXA = oLineXA.GetBusComp(&quot;Order Item XA (Simple)&quot;);
		
		with(oBCLitemItemXA)
		{
			ClearToQuery();
			SetViewMode(AllView);
			ActivateField(&quot;Text Value&quot;);
			ActivateField(&quot;Name&quot;);
			SetSearchExpr(sSearchExpr);
			ExecuteQuery(ForwardOnly);
			
			if (FirstRecord())
				strReturnVal = GetFieldValue(&quot;Text Value&quot;);
		}	
	return (strReturnVal);	
	}
	catch(e)
	{	
		throw(e);	
	}
	finally
	{
		oBCLitemItemXA = null;
	}
}"
