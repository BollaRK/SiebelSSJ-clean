			for (var i=0;i &lt; iNoOfServices; i++)
			{
				psInputs.GetChild(i).SetProperty(&quot;Fulfilment Id&quot;, sFulfilOrderId);
			}
			sInserntInOrder == &quot;Y&quot;
			sIndErrMsg = AddDeviceSiebelOnlyProducts();//Add Device-Siebel Only products to Connect order
		/*	if (sIndErrMsg != &quot;&quot;) //Roseline:23/12/2015 - Moved this script outside the loop for R16.1 MSOD
