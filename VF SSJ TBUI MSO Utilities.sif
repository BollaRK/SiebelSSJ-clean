			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mAddWeekDaysToCurrentDate"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Component Name        : 	VF TBUI MSO Utilities
 * Method Name           : 	mGetSystemPreferences
 * Component Information : 	This function accepts sys pref name and return sys
 *							 pref val to calling function.
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 07/09/2016	Subramanian K			Copied from Product Modelling Service
*/
function mAddWeekDaysToCurrentDate(nNumberOfWeekDays,sFirstSubmitDt)
{
	try
	{	
		// Trace Statement
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;START:VF MPP Toolkit.mAddWeekDaysToCurrentDay&quot;);
		}

		var MONDAY = 0;
		var TUESDAY = 1;
		var WEDNESDAY = 2;
		var THURSDAY = 3;
		var FRIDAY = 4;
		var SATURDAY = 5;
		var SUNDAY = 6;
		var nSecondsInADay = 24*60*60;

		//	Get the Current Date	
		var dCurrentDate = new Date(sFirstSubmitDt);
		var dCreatedSystem = (dCurrentDate.toSystem() - (dCurrentDate.toSystem() % nSecondsInADay)); //(round to the nearest day)
		
		var daysCreatedSystem = dCreatedSystem / nSecondsInADay;
		//TheApplication().RaiseErrorText(daysCreatedSystem);
		
		var dReferenceDate = new Date(&quot;2001&quot;,&quot;0&quot;,&quot;1&quot;,&quot;12&quot;,&quot;0&quot;,&quot;0&quot;); // Monday 1st Jan 2001
		var dReferenceSystem = (dReferenceDate.toSystem() -  (dReferenceDate.toSystem() % nSecondsInADay)); //(round to the nearest day);
		var daysReferenceSystem = dReferenceSystem / nSecondsInADay;
		//TheApplication().RaiseErrorText(daysReferenceSystem);
		
		var nCurrentDayOfWeek = (daysCreatedSystem - daysReferenceSystem) % 7;
		
		//TheApplication().RaiseErrorText(&quot;Current Day of week: &quot; + nCurrentDayOfWeek);
		
		// We need to start on a Monday
		switch (nCurrentDayOfWeek)
		{
			case SATURDAY:
			var daysStartDateSystem = daysCreatedSystem + 1; // need to move to first day before the next weekday.
			nCurrentDayOfWeek = nCurrentDayOfWeek + 1;
			break;
			case SUNDAY:
			var daysStartDateSystem = daysCreatedSystem; // Do nothing
			break;
			default:
			var daysStartDateSystem = daysCreatedSystem; // Do nothing
		}
		
		var daysInterimDateSystem = daysStartDateSystem + ((nNumberOfWeekDays - (nNumberOfWeekDays % 5))/5) * 7;
		
		// If the remaining days crosses a weekend we beed to add 2 days

		if (nCurrentDayOfWeek == SUNDAY)
			var Addondays = 0;
//		else if ((daysInterimDateSystem % 7) == SATURDAY)
//			var Addondays = 1;		
		else if ( (nCurrentDayOfWeek + (nNumberOfWeekDays %5)) &gt;= SATURDAY  )
		{
			var Addondays = 2;
		}
		else
		{
			var Addondays = 0;
		}

		var daysFinalDateSystem = daysInterimDateSystem + (nNumberOfWeekDays %5) + Addondays;
		var dFinalDate = Date.fromSystem(daysFinalDateSystem * nSecondsInADay);
		var debugresult = dFinalDate.getDate() + &quot;/&quot; + (dFinalDate.getMonth() + 1)
		return(dFinalDate);
	}
	catch(e)
	{
		if (defined(e.errText))
		{
			var gErrorMessage = &apos; &apos; + e.errText + &quot;\r\n&quot; + e.toString(); 
		}
		else
		{
			var gErrorMessage = &apos; &apos; + e.toString(); 
		}
		throw(e);
	}
	finally
	{		
		
		// Trace Statement
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;END:VF MPP Toolkit.mAddWeekDaysToCurrentDay&quot;);
		}								
	}
}"
