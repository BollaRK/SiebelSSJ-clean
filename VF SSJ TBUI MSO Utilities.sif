			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetSystemPreferences"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Component Name        : 	VF TBUI MSO Utilities
 * Method Name           : 	mGetSystemPreferences
 * Component Information : 	This function accepts sys pref name and return sys
 *							 pref val to calling function.
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 07/09/2016	Subramanian K			Copied from Product Modelling Service
*/

function mGetSystemPreferences(sSysprefname)
{
	
	try
	{
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;START:mGetSystemPreferences&quot;);
		}
		var boSyspref;
		var bcSyspref;
		var sSysprefVal =&quot;&quot;;
		
		boSyspref = TheApplication().GetBusObject(&quot;System Preferences&quot;);
		bcSyspref = boSyspref.GetBusComp(&quot;System Preferences&quot;);
		
		bcSyspref.ClearToQuery();
		bcSyspref.SetViewMode(AllView);
		bcSyspref.ActivateField(&quot;Name&quot;);
		bcSyspref.ActivateField(&quot;Value&quot;);
		bcSyspref.SetSearchSpec(&quot;Name&quot;, sSysprefname);
		bcSyspref.ExecuteQuery(&quot;ForwardOnly&quot;);
		
		if (!bcSyspref.FirstRecord())
		{
			throw(&quot;VFErrorCode#99505-Pay for service Workflow could not found System Preferences :&quot; + sSysprefname );
		}
		sSysprefVal = bcSyspref.GetFieldValue(&quot;Value&quot;);

		return(sSysprefVal);
		

	}
	catch(e)
	 {
			if(!defined(e.errText))
			{
				gErrorMessage = e.toString();
			}
			else
			{
				gErrorMessage = e.errText+ &quot;\r\n&quot; + e.toString();
				var a = gErrorMessage;
			}

			if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
			{
				TheApplication().Trace(&quot;ERROR:VF bulk adjustment.mGetSystemPreferences &quot; + gErrorMessage);
			}
			throw(gErrorMessage);
	}	
	finally
	{
		bcSyspref = null;
		boSyspref = null;
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;START:mGetSystemPreferences&quot;);
		}
	}

}"
