			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fnProcessEquipment"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function fnProcessEquipment(Inputs, Outputs)
{
	try
	{
	
		var boOrder = TheApplication().GetBusObject(&quot;Order Entry&quot;);
		var bcOrder = boOrder.GetBusComp(&quot;Order Entry - Orders&quot;);
		var bcOrderItem = boOrder.GetBusComp(&quot;Order Entry - Line Items&quot;);
		var sOrderId = Inputs.GetProperty(&quot;Order Id&quot;);
		var sEAIFlg = Inputs.GetProperty(&quot;EAI Flag&quot;);
		var sAppleVoucher = Inputs.GetProperty(&quot;AppleVoucher&quot;);//ADUTTA:Apple fraud Offer Project
		var sTwoWaySMSFlag = Inputs.GetProperty(&quot;TwoWaySMSFlag&quot;);  //23-12-2020 - Added By Sachi for Defect# 1271 3 Step UPG
		var sTWSMSOverrideFlag = Inputs.GetProperty(&quot;TWSMSOverrideFlag&quot;);  //23-12-2020 - Added By Sachi for Defect# 1271 3 Step UPG
		var sEGWSwitch = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_EGW_INVOKE_LOGIC&quot;,&quot;EGWEquipCheck&quot;);

		var psIn = TheApplication().NewPropertySet();
		var psOut = TheApplication().NewPropertySet();
		var sErrorMessage = &quot;&quot;;
		var sSearchStr = &quot;&quot;;

		if(sOrderId != &quot;&quot;)
		{
			bcOrder.SetViewMode(AllView);
			bcOrder.ClearToQuery();
			
			bcOrder.ActivateField(&quot;Bill Payment Method&quot;);
			bcOrder.ActivateField(&quot;Order Sub Type&quot;);
			bcOrder.ActivateField(&quot;VF Order Function&quot;);
			bcOrder.ActivateField(&quot;VF Fulfilment Order Number&quot;);
			bcOrder.ActivateField(&quot;VF Order Channel&quot;);
			bcOrder.ActivateField(&quot;VF Order Type TBUI&quot;);
			
			bcOrder.SetSearchSpec(&quot;Id&quot;, sOrderId);
			bcOrder.ExecuteQuery(ForwardOnly);

			if (bcOrder.FirstRecord()) 
			{
				var sPaymentMethod = bcOrder.GetFieldValue(&quot;Bill Payment Method&quot;); // Sathish: Added for PKE15908
				var sOrderType = bcOrder.GetFieldValue(&quot;Order Sub Type&quot;); // Sathish: Added for PKE15908
				var sFulfilmentOrderNo = bcOrder.GetFieldValue(&quot;VF Fulfilment Order Number&quot;); //Chitra Added for E&amp;DL
				var sOrderFn = bcOrder.GetFieldValue(&quot;VF Order Function&quot;);
				var sOrderChannel = bcOrder.GetFieldValue(&quot;VF Order Channel&quot;);
				var sOrderAPPSubType = bcOrder.GetFieldValue(&quot;VF Order Type TBUI&quot;);

				if (sPaymentMethod == &quot;Postpay&quot;) 
				{					
					bcOrderItem.ActivateField(&quot;Owner Account Type&quot;);
					bcOrderItem.ActivateField(&quot;Owner Account Id&quot;);
					bcOrderItem.ActivateField(&quot;Root Asset Id&quot;);
					bcOrderItem.ActivateField(&quot;Asset Integration Id&quot;);
					bcOrderItem.ActivateField(&quot;VF EGW Business Sub Type&quot;);//MONISHAJ:Added for EMS2560
					bcOrderItem.ActivateField(&quot;VHA Accessory Line Items For EL Calc&quot;);//MADHUR::13-MAR-23::Created for AppleWearables Equipment Limit Issue
					bcOrderItem.ClearToQuery();
					bcOrderItem.SetSearchExpr(&quot;[Order Header Id]=&apos;&quot; +sOrderId+&quot;&apos; AND [Root Order Item Id]=[Id]&quot;);
					//bcOrderItem.SetSearchSpec(&quot;Order Header Id&quot;, sOrderId );
					//bcOrderItem.SetSearchSpec(&quot;Root Order Item Id&quot;, &quot;Row Id&quot;);
					bcOrderItem.ExecuteQuery();
					
					if(bcOrderItem.FirstRecord()) 
					{
						var sAccType = bcOrderItem.GetFieldValue(&quot;Owner Account Type&quot;);
						var sAccId = bcOrderItem.GetFieldValue(&quot;Owner Account Id&quot;);
						var sAssetId = bcOrderItem.GetFieldValue(&quot;Root Asset Id&quot;);
						var sAssetIntegId = bcOrderItem.GetFieldValue(&quot;Asset Integration Id&quot;);
						var sEGWBusSubType = bcOrderItem.GetFieldValue(&quot;VF EGW Business Sub Type&quot;);//MONISHAJ:Added for EMS2560
						var sAccLineCalc = bcOrderItem.GetFieldValue(&quot;VHA Accessory Line Items For EL Calc&quot;);//MADHUR::13-MAR-23::Created for AppleWearables Equipment Limit Issue
						//var sUpgType = bcOrderItem.GetFieldValue(&quot;MPP Scenario&quot;);
						
						//if(sAccType == &quot;Person&quot;) //[Nagesh][Account Structure Shared fins]
						if(sAccType == &quot;Person&quot; || sAccType == &quot;Sole Trader&quot; || (sEGWBusSubType == &quot;First&quot; &amp;&amp; sEGWSwitch ==&quot;EGWEquipCheck_Y&quot;)) 
						{
							
							if(sOrderType == &quot;Modify&quot; &amp;&amp; (sOrderAPPSubType == &quot;New APP&quot; || sOrderAPPSubType == &quot;Cancel APP&quot; || sOrderAPPSubType == &quot;Modify APP&quot; || sOrderAPPSubType == &quot;Refund APP&quot;))
							{
								mDeleteEqRecord(sAccId, sOrderId);
								var oBS = TheApplication().GetService(&quot;VHA Manage APP BS&quot;);
								psIn.SetProperty(&quot;AccountId&quot;,sAccId);
								psIn.SetProperty(&quot;Account Id&quot;,sAccId);
								psIn.SetProperty(&quot;OrderId&quot;,sOrderId);
								psIn.SetProperty(&quot;Account Type&quot;, sAccType);						
								psIn.SetProperty(&quot;AssetId&quot;, sAssetId);
								psIn.SetProperty(&quot;AssetIntegrationId&quot;,sAssetIntegId);
								psIn.SetProperty(&quot;OrderAPPSubType&quot;,sOrderAPPSubType);	// VHA Suresh: Added for R19.3 Prepayments
								if(sOrderAPPSubType == &quot;Cancel APP&quot;)
								{
									oBS.InvokeMethod(&quot;DeleteAccessoryLimit&quot;,psIn,psOut);
								}
								else if(sOrderAPPSubType == &quot;Modify APP&quot;)
								{
									oBS.InvokeMethod(&quot;DeleteAccessoryLimit&quot;,psIn,psOut);
									oBS.InvokeMethod(&quot;InsertAccessoryLimit&quot;,psIn,psOut);
								}
								else if(sOrderAPPSubType == &quot;New APP&quot;)
								{
									oBS.InvokeMethod(&quot;ValidateAccessoryLimit&quot;, psIn, psOut);
									oBS.InvokeMethod(&quot;InsertAccessoryLimit&quot;,psIn,psOut);
								}
								else if(sOrderAPPSubType == &quot;Refund APP&quot;)
								{
									oBS.InvokeMethod(&quot;DeleteAccessoryLimit&quot;,psIn,psOut);
									oBS.InvokeMethod(&quot;InsertAccessoryLimit&quot;,psIn,psOut);
								}
							}
							//Starts MADHUR::13-MAR-23::Created for AppleWearables Equipment Limit Issue
							else if(sOrderType == &quot;Connect&quot; &amp;&amp; (sFulfilmentOrderNo != &quot;&quot; &amp;&amp; sFulfilmentOrderNo != null) &amp;&amp; sOrderChannel==&quot;VHA Online Store&quot; &amp;&amp; sAccLineCalc &gt; 0)
							{
								//mDeleteEqRecord(sAccId, sOrderId);
								var oBS = TheApplication().GetService(&quot;VHA Manage APP BS&quot;);
								psIn.SetProperty(&quot;AccountId&quot;,sAccId);
								psIn.SetProperty(&quot;Account Id&quot;,sAccId);
								psIn.SetProperty(&quot;OrderId&quot;,sOrderId);
								psIn.SetProperty(&quot;Account Type&quot;, sAccType);						
								psIn.SetProperty(&quot;AssetId&quot;, sAssetId);
								psIn.SetProperty(&quot;AssetIntegrationId&quot;,sAssetIntegId);
								psIn.SetProperty(&quot;OrderAPPSubType&quot;,sOrderAPPSubType);	
								//oBS.InvokeMethod(&quot;DeleteAccessoryLimit&quot;,psIn,psOut);
								oBS.InvokeMethod(&quot;ValidateAccessoryLimit&quot;, psIn, psOut);
								oBS.InvokeMethod(&quot;InsertAccessoryLimit&quot;,psIn,psOut);
							
							}//Ends MADHUR::13-MAR-23::Created for AppleWearables Equipment Limit Issue
							else if((sOrderType == &quot;Change Proposition&quot; || sOrderType == &quot;Modify&quot;) &amp;&amp; (sOrderFn ==&quot;UPGRADE&quot; || sOrderFn == &quot;Upgrade&quot;))
							{
								mDeleteEqRecord(sAccId, sOrderId);
								var oBS = TheApplication().GetService(&quot;VF Upgrade Postpaid BS TBUI&quot;);
								psIn.SetProperty(&quot;AccountId&quot;,sAccId);
								psIn.SetProperty(&quot;OrderId&quot;,sOrderId);
								psIn.SetProperty(&quot;Account Type&quot;, sAccType);						
								//psIn.SetProperty(&quot;Upgrade Type&quot;, sUpgType);
								psIn.SetProperty(&quot;AssetId&quot;, sAssetId);
								psIn.SetProperty(&quot;TwoWaySMSFlag&quot;, sTwoWaySMSFlag);  //23-12-2020 - Added By Sachi for Defect# 1271 3 Step UPG
								psIn.SetProperty(&quot;TWSMSOverrideFlag&quot;, sTWSMSOverrideFlag);  //23-12-2020 - Added By Sachi for Defect# 1271 3 Step UPG
								/*if(sOrderChannel!=&quot;VHA Online Store&quot;)
									oBS.InvokeMethod(&quot;ValidateEL&quot;, psIn, psOut);*/
								oBS.InvokeMethod(&quot;InsertEquipment&quot;,psIn,psOut);	
								psIn.SetProperty(&quot;OrderType&quot;, sOrderType);//ADUTTA:Apple Fraud
								psIn.SetProperty(&quot;AppleFraud&quot;,sAppleVoucher);//ADUTTA:Apple Fraud
								mInsertEquipment(psIn);//ADUTTA:Apple Fraud Offer
							}
							else if((sOrderType == &quot;Connect&quot; &amp;&amp; sFulfilmentOrderNo == &quot;&quot;) || sOrderType == &quot;Reactivate&quot; || sOrderType == &quot;Change Ownership Connect&quot; || (sOrderType == &quot;Modify&quot; &amp;&amp; Inputs.GetProperty(&quot;IsBulkOrder&quot;) == &quot;True&quot; &amp;&amp; (Inputs.GetProperty(&quot;Batch Type&quot;)==&quot;MPP&quot; || Inputs.GetProperty(&quot;Batch Type&quot;)==&quot;GPP&quot;)) || (sOrderType == &quot;Modify&quot; &amp;&amp; (sOrderFn == &quot;&quot; || sOrderFn == null )))//vinodhini-11/07/2019 -added condition for MHI
							{
								mDeleteEqRecord(sAccId, sOrderId);
								var psIn = TheApplication().NewPropertySet();
								var psOut = TheApplication().NewPropertySet();
								psIn.SetProperty(&quot;AccountId&quot;,sAccId);
								psIn.SetProperty(&quot;OrderId&quot;,sOrderId);
								psIn.SetProperty(&quot;Account Type&quot;, sAccType);
								psIn.SetProperty(&quot;OrderType&quot;, sOrderType);
								psIn.SetProperty(&quot;AppleFraud&quot;,sAppleVoucher);//ADUTTA:Apple Fraud
								//if(Inputs.GetProperty(&quot;IsBulkOrder&quot;))
								psIn.SetProperty(&quot;EGWSubType&quot;, sEGWBusSubType);
								mValidateRRP(psIn, psOut);
								mInsertEquipment(psIn);
									
								if((ssApprovalId!=null &amp;&amp; ssApprovalId!=&quot;&quot;) &amp;&amp; (sOrderType == &quot;Connect&quot; &amp;&amp; sFulfilmentOrderNo == &quot;&quot;))
								{
									var pOut = TheApplication().NewPropertySet();
									mInsertVoucher(psIn,pOut);
								}				
							}							
							else if(sOrderType == &quot;Fulfilment&quot; &amp;&amp; sOrderFn == &quot;Acquisition&quot;)
							{
								//mDeleteEqRecord(sAccId, sOrderId);								
								sSearchStr = mGetParentOrderId(sAccId, sOrderId);
									psIn.SetProperty(&quot;AccountId&quot;,sAccId);
									psIn.SetProperty(&quot;OrderId&quot;, sOrderId);
									psIn.SetProperty(&quot;Account Type&quot;, sAccType);
									psIn.SetProperty(&quot;SearchStr&quot;, sSearchStr);
									psIn.SetProperty(&quot;OrderFn&quot;, sOrderFn);
									psIn.SetProperty(&quot;OrderType&quot;, sOrderType);
									psIn.SetProperty(&quot;EGWSubType&quot;, sEGWBusSubType);
									//if((sEAIFlg!=&quot;Y&quot; &amp;&amp; sOrderChannel==&quot;VHA Online Store&quot;) || sOrderChannel!=&quot;VHA Online Store&quot;)
									if((TheApplication().GetProfileAttr(&quot;ApplicationName&quot;) != &quot;Siebel Sales Enterprise&quot; &amp;&amp; sOrderChannel==&quot;VHA Online Store&quot;) || sOrderChannel!=&quot;VHA Online Store&quot;)
										mValidateRRP(psIn, psOut);
									
									mInsertEquipment(psIn);	
									if((ssApprovalId!=null &amp;&amp; ssApprovalId!=&quot;&quot;))
									{
										var pOut = TheApplication().NewPropertySet();
										mInsertVoucher(psIn,pOut);
									}
												
							}
								else if(sOrderType == &quot;Change Proposition&quot; &amp;&amp; (sOrderFn == &quot;&quot; || sOrderFn == null ))
								{
								mDeleteEqRecord(sAccId, sOrderId);
								var psIn = TheApplication().NewPropertySet();
								var psOut = TheApplication().NewPropertySet();
								psIn.SetProperty(&quot;AccountId&quot;,sAccId);
								psIn.SetProperty(&quot;OrderId&quot;,sOrderId);
								psIn.SetProperty(&quot;Account Type&quot;, sAccType);
								psIn.SetProperty(&quot;OrderType&quot;, sOrderType);
								psIn.SetProperty(&quot;EGWSubType&quot;, sEGWBusSubType);
								psIn.SetProperty(&quot;AppleFraud&quot;,sAppleVoucher);//ADUTTA:Apple Fraud
								//if(Inputs.GetProperty(&quot;IsBulkOrder&quot;))
								//mValidateRRP(psIn, psOut);
								mInsertEquipment(psIn);
								}
						}
					}//bcorderitem
				}//sPaymentMethod == &quot;Postpay&quot;
			}//bcOrder
		}
	}
	catch (e)
	{
		if(!defined(e.errText)) {
			sErrorMessage = e.toString();
		}
		else {
			sErrorMessage = e.errText;
		}
		TheApplication().RaiseErrorText(sErrorMessage);
	}
	finally
	{
		bcOrderItem = null;
		bcOrder = null;
		boOrder = null;
		/*Below variables are nullified by Sharukh on 18/03/2019*/
		psIn = null;
		psOut = null;
		oBS = null;
		

	}
}"
