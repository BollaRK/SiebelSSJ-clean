			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCalcActualRemainMonth"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCalcActualRemainMonth(Inputs)
{
 try
 { 	
	var dtToday;
	var dtContractStDt;
	var iYearDifference;
	var iMonthDifference;
	var strScenario = &quot;&quot;;
	var iMonthsRemainingInContract = 0;	//ini value to 0
	var strStDate = Inputs.GetProperty(&quot;ContractStDate&quot;);
	var Term = Inputs.GetProperty(&quot;Term&quot;);
	
	dtToday = new Date();
	dtContractStDt = new Date(strStDate);
	
	if (dtContractStDt != &quot;&quot;)
	{
	
		//get number of years and months difference
		iYearDifference =  dtToday.getFullYear() - dtContractStDt.getFullYear();
		iMonthDifference = dtToday.getMonth() - dtContractStDt.getMonth();
					
		//for we&apos;re rounding down make an alteration to the month difference depending on the day
		if (dtToday.getDate() &gt; dtContractStDt.getDate())
		{
			iMonthDifference = iMonthDifference + 1;
		}
					
		//years + months always gives correct figure, even if iRoundedMonthDifference is negative
		//eg if start date = 18/8/04 and today = 31/3/05
		//year difference = 1, month difference = -5
		iMonthsRemainingInContract = Term - ((iYearDifference * 12) + iMonthDifference);
		
		if(iMonthsRemainingInContract &lt; 0)
			iMonthsRemainingInContract = 0;				
	}
	 return(iMonthsRemainingInContract);
	
 }
 catch(e)
 {
 	if(!defined(e.errText))
		var strError = &quot;calcRemainMonth: &quot; + e.toString();
	else
		var strError = &quot;calcRemainMonth: &quot; + e.errText;	
	throw(strError);
 }
 finally
 {  
 }
}"
			   SEQUENCE="38"
			   UPDATED="01/09/2026 15:43:17"
			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 15:43:17"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCalcRemainMonth"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCalcRemainMonth(Inputs)
{
 try
 { 	
	var dtToday;
	var dtContractStDt;
	var iYearDifference;
	var iMonthDifference;
	var strScenario = &quot;&quot;;
	var iMonthsRemainingInContract = 0;	//ini value to 0
	var strStDate = Inputs.GetProperty(&quot;ContractStDate&quot;);
	var Term = Inputs.GetProperty(&quot;Term&quot;);
	var sAssetId = Inputs.GetProperty(&quot;AssetId&quot;);
	var sAccountId = Inputs.GetProperty(&quot;AccountId&quot;);
	var sId = Inputs.GetProperty(&quot;EqId&quot;);
	var UpgAssetId,UpgAssetIntId,UpgDeviceCode;
	
	dtToday = new Date();
	dtContractStDt = new Date(strStDate);
	
	if (dtContractStDt != &quot;&quot;)
	{
	
		//get number of years and months difference
		iYearDifference =  dtToday.getFullYear() - dtContractStDt.getFullYear();
		iMonthDifference = dtToday.getMonth() - dtContractStDt.getMonth();
					
		//for we&apos;re rounding down make an alteration to the month difference depending on the day
		if (dtToday.getDate() &gt; dtContractStDt.getDate())
		{
			iMonthDifference = iMonthDifference + 1;
		}
					
		//years + months always gives correct figure, even if iRoundedMonthDifference is negative
		//eg if start date = 18/8/04 and today = 31/3/05
		//year difference = 1, month difference = -5
		iMonthsRemainingInContract = Term - ((iYearDifference * 12) + iMonthDifference);
		if(TheApplication().GetProfileAttr(&quot;UpgOrderId&quot;) != &quot;&quot;)
		{
			var oBO1= TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
			var oBC1=oBO1.GetBusComp(&quot;VF Upgrade Offer&quot;);
			oBC1.SetViewMode(AllView);
			oBC1.ActivateField(&quot;Order Id&quot;);
			oBC1.ActivateField(&quot;Account Id&quot;);
			oBC1.ActivateField(&quot;Root Asset Id&quot;);
			oBC1.ActivateField(&quot;Device Code&quot;);
			oBC1.ActivateField(&quot;Asset Integration Id&quot;);
			oBC1.ClearToQuery();
			oBC1.SetSearchSpec(&quot;Account Id&quot;,sAccountId);
			oBC1.SetSearchSpec(&quot;Order Id&quot;,TheApplication().GetProfileAttr(&quot;UpgOrderId&quot;));
			oBC1.ExecuteQuery();
			var isRec =oBC1.FirstRecord();
			while(isRec)
			{
				UpgAssetId=oBC1.GetFieldValue(&quot;Root Asset Id&quot;);
				UpgDeviceCode=oBC1.GetFieldValue(&quot;Device Code&quot;);
				UpgAssetIntId=oBC1.GetFieldValue(&quot;Asset Integration Id&quot;);
			
			if(sAssetId != &quot;&quot; &amp;&amp; UpgAssetId==sAssetId)
			{
				var oBS =TheApplication().GetService(&quot;VF Generic Product Manipulation Service&quot;);
				var oPSIn = TheApplication().NewPropertySet();
				var oPSOut = TheApplication().NewPropertySet();
				oPSIn.SetProperty(&quot;Order Id&quot;,TheApplication().GetProfileAttr(&quot;UpgOrderId&quot;));
				oPSIn.SetProperty(&quot;AccountId&quot;,sAccountId);
				oPSIn.SetProperty(&quot;DeviceCode&quot;,UpgDeviceCode);
				oPSIn.SetProperty(&quot;Asset Int Id&quot;,UpgAssetIntId);
	
				oBS.InvokeMethod(&quot;CheckMPPScenario&quot;,oPSIn,oPSOut);
				strScenario = oPSOut.GetProperty(&quot;Scenario&quot;);
			}//if
			isRec=oBC1.NextRecord();
			}//while
		}
		if(iMonthsRemainingInContract &lt; 0 || strScenario == &quot;Waive&quot;)
			iMonthsRemainingInContract = 0;				
	}
	return(iMonthsRemainingInContract);
	
 }
 catch(e)
 {
 	if(!defined(e.errText))
		var strError = &quot;calcRemainMonth: &quot; + e.toString();
	else
		var strError = &quot;calcRemainMonth: &quot; + e.errText;	
	throw(strError);
 }
 finally
 {  
 
 /*Below variables are nullified by Sharukh on 18/03/2019*/
	/*oBC1 = null;
	oBO1 = null;
	oBS = null;*/
	oPSIn = null;
	oPSOut = null;

/*Below variables are nullified by GURUPRASAD on 03/10/2019*/
		if(defined(oBC1)) { oBC1 = null; }
		if(defined(oBO1)) { oBO1 = null; }
		if(defined(oBS)) { oBS = null; }

}
}"
