			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="CheckAccessory"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function CheckAccessory(AccList, AccLineNums)
{
	try
	{
		var bsEAIService = TheApplication().GetService(&quot;EAI Siebel Adapter&quot;);
		var psInputs = TheApplication().NewPropertySet();
		var psOutputs = TheApplication().NewPropertySet();
		var iNoOfServices=0, i, noOfAcc = AccList.length, j = AccList.length;
		psInputs.SetProperty(&quot;SearchSpec&quot;,&quot;[VF Task Fulfilment Items.Order Id] = &apos;&quot; + sOrderId + &quot;&apos; AND [VF Task Fulfilment Items.VF TBUI Fulfilment Item] IS NULL AND [VF Task Fulfilment Items.Item Type] = &apos;Accessory&apos;&quot;);
		psInputs.SetProperty(&quot;OutputIntObjectName&quot;, &quot;VF Task Fulfilment Items&quot;);
		bsEAIService.InvokeMethod(&quot;Query&quot;, psInputs, psOutputs);

		iNoOfServices = psOutputs.GetChild(0).GetChild(0).GetChildCount();
		
		for (;j &gt; 0;)
		{
			j--;
			for (i=0;i &lt; iNoOfServices; i++)
			{
				if (AccList[j] == psOutputs.GetChild(0).GetChild(0).GetChild(i).GetProperty(&quot;VF Line Item Id&quot;))
				{
					AccLineNums.splice(j, 1);//Remove the matching items
					break;
				}
			}
		}
		
		if (AccLineNums.length &gt; 0)//There are line items which dont have fulfilment items
		{
			AccLineNums.sort();
			return(&quot;Line(s): - &quot; + AccLineNums + &quot; Accessory needs to be selected before proceeding&quot;);
		}
		else//All the line items have fulfilment items
		{
			return(&quot;&quot;);
		}
	}
	catch(e)
	{
		throw e;
	}
	finally
	{
		bsEAIService = null;
		psInputs = null;
		psOutputs = null;
	}
}"
			   SEQUENCE="8"
			   UPDATED="01/09/2026 15:43:16"
			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 15:43:16"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="CheckFulfilmentItems"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function CheckFulfilmentItems()
{
	try
	{
		var bcFulfilItems = TheApplication().GetBusObject(&quot;VF Task Fulfilment Items&quot;).GetBusComp(&quot;VF Task Fulfilment Items&quot;);
		var iCount = 0, CreateFulfilOrder = &quot;N&quot;;
		with (bcFulfilItems)
		{
			ClearToQuery();
			SetViewMode(AllView);
			SetSearchSpec(&quot;Order Id&quot;, sOrderId);
			ExecuteQuery();
			iCount = CountRecords();
			if (iCount &gt; 0)
			{
				CreateFulfilOrder = &quot;Y&quot;;
			}
		}
		return(CreateFulfilOrder);
	}
	catch(e)
	{
		throw e;
	}
	finally
	{
		bcFulfilItems = null;
	}
}"
