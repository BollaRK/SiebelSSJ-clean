			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetAppleVoucherAmount"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mGetAppleVoucherAmount(Inputs)
{
  try
  {
	var sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);	

	var oOrderBO=TheApplication().GetBusObject(&quot;Order Item&quot;);
	var oOrderBC=TheApplication().GetBusObject(&quot;Order Entry&quot;).GetBusComp(&quot;Order Entry - Orders&quot;);
	var oVoucherBC=TheApplication().GetBusObject(&quot;Order Entry&quot;).GetBusComp(&quot;VF Voucher Details&quot;);	
	var oLineBC = oOrderBO.GetBusComp(&quot;Order Entry - Line Items (Simple)&quot;);
	var oLineXA = oOrderBO.GetBusComp(&quot;Order Item XA (Simple)&quot;);
		
	var oProductBO;
	var oInternalproduct;
	var oPrimaryProduct;									
									
	
	var sRootProductId;
	var irecord;
       var isRecord;
	var sProductId;
	var ssmproditemId;
	var sMSISDN = &quot;&quot;;
	var sNewMSISDN = &quot;&quot;;
	var ratePlansamId = &quot;&quot;;
	var sSAMLOV = &quot;&quot;;
	//var ssNewTerm;
var VoucherAmount = &quot;&quot;;
//var sAppVcherLOV = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CR_ENABLE_FLAG&quot;,&quot;Apple Plan&quot;);
	
	var ssearchexpr=&quot;&quot;;
	
	
		
			
			
		
				with (oLineBC)
				{
					ClearToQuery();
					ActivateField(&quot;Order Header Id&quot;);
					ActivateField(&quot;Action Code&quot;);
					ActivateField(&quot;SAM Product Id&quot;);
					ActivateField(&quot;Primary Product Flag&quot;);
					SetViewMode(AllView);
					SetSearchSpec(&quot;Order Header Id&quot;, sOrderId);													
					SetSearchSpec(&quot;Action Code&quot;, &quot;Add&quot;);
					SetSearchSpec(&quot;Primary Product Flag&quot;, &quot;Y&quot;);
					SetSearchSpec(&quot;Product Type&quot;, &quot;Billing - Recurring&quot;);
					ExecuteQuery();				
				    isRecord = FirstRecord();
                  if(isRecord)
					{   
						
						
						ratePlansamId = GetFieldValue(&quot;SAM Product Id&quot;);
						var sSAMLOV = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_APPLE_VOUCR_PLN_ID&quot;,ratePlansamId);
						
			               if(sSAMLOV == &quot;Y&quot;)
				           {
			               VoucherAmount = ToNumber(TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_APPLE_VOUCHER_AMOUNT&quot;,ratePlansamId));
				           
						  
				         }
								
								
					}
                                 
			}
                    
		
	
	
  
	TheApplication().SetProfileAttr(&quot;VoucherAmount&quot;,ssVoucherAmount + ratePlansamId);
      return(VoucherAmount);
	return (CancelOperation);

	
}
catch (e)
	{
		throw e;
	}
	finally
	{	
		oVoucherBC = null;		
		oLineXA = null;
		oLineBC = null;
		oOrderBC = null;
		oOrderBO = null;
	}
}"
