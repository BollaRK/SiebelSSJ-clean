			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetParentOrderId"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mGetParentOrderId(sAccId, sOrderId)
{

try {
	var j=0;
	
	var boFulOrder = TheApplication().GetBusObject(&quot;VHA Fulfilment TBUI Order&quot;);
	var bcFulOrder = boFulOrder.GetBusComp(&quot;VHA MACD Order Entry - Orders&quot;);
	var bcFulOrderItem = boFulOrder.GetBusComp(&quot;VHA MACD Order Entry - Line Items (Header)&quot;);	
	var	boOrderItem 	= TheApplication().GetBusObject(&quot;VF Order Entry - Line Items Thin&quot;);
	var	bcOrderItem 	= boOrderItem.GetBusComp(&quot;VF Order Entry - Line Items Thin&quot;);
	var sSearchStrPre = &quot;[VF Order Item Task Simple.Order Header Id] = &apos;&quot;;			
	var sSearchStrSuf = &quot; OR &quot;;			
	var isRec=0;			
	var sRelServiceId=&quot;&quot;,sChannel=&quot;&quot;;			
	var sSearchStr=&quot;&quot;;	
		
	with(bcFulOrder)			
	{					
		SetViewMode(AllView);				
		ActivateField(&quot;VF Order Channel&quot;);				
		ClearToQuery();				
		SetSearchSpec(&quot;Id&quot;, sOrderId);				
		ExecuteQuery(ForwardOnly);						
		if(FirstRecord())				
		{				
			sChannel = GetFieldValue(&quot;VF Order Channel&quot;);				
			bcFulOrderItem.ClearToQuery();				
			bcFulOrderItem.ActivateField(&quot;Related Service order Id&quot;);	
			bcFulOrderItem.SetSearchExpr(&quot;[Parent Order Item Id] IS NULL&quot;);		
			bcFulOrderItem.ExecuteQuery(ForwardOnly);				
			isRec = bcFulOrderItem.FirstRecord();				
			while (isRec)				
			{	
				sRelServiceId = bcFulOrderItem.GetFieldValue(&quot;Related Service order Id&quot;);
				if (sRelServiceId != &quot;&quot;)				
				{					
					with(bcOrderItem)					
					{						
						SetViewMode(AllView);						
						ActivateField(&quot;Order Header Id&quot;);						
						ClearToQuery();						
						SetSearchSpec(&quot;Id&quot;, sRelServiceId);						
						ExecuteQuery(ForwardOnly);						
						if (FirstRecord())			
						{							
							sRelOrdIdPP = GetFieldValue(&quot;Order Header Id&quot;);							
							if(j&gt;0)								
								{
									sSearchStr = sSearchStr + sSearchStrSuf;
								}												
							sSearchStr =  sSearchStr + sSearchStrPre + GetFieldValue(&quot;Order Header Id&quot;) + &quot;&apos;&quot;;							
							j=j+1;			
							mDeleteEqRecord(sAccId, GetFieldValue(&quot;Order Header Id&quot;));						
						}					
					}					
				}//if			
				if(sChannel ==&quot;VHA Online Store&quot;)	{				
					isRec=bcFulOrderItem.NextRecord();	
					}
				else					
					isRec = false;				
			}//while			
		}			
	}
	return(sSearchStr);

	}

	catch (e)
	{
	throw e;
	}
	finally
	{
	/*Below variables are nullified by Sharukh on 20/03/2019*/
	bcFulOrder = null;
	bcFulOrderItem = null;
	bcOrderItem = null;
	boFulOrder = null;
	boOrderItem = null;
	
}
}"
