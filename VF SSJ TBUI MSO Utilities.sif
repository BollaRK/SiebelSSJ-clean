		var sOut = TheApplication().NewPropertySet();
		sInp.SetProperty(&quot;FileName&quot;,&quot;D:\\SIEBEL_TARIQAK\\DEV01\\log\\PS1.xml&quot;);
		sInp.AddChild(Inputs);
		sService.InvokeMethod(&quot;WritePropSet&quot;, sInp, sOut);*/
		
		Inputs.GetChild(0).RemoveChild(0);
		Inputs.GetChild(0).AddChild(childInputs);
		
		
		var bsService = TheApplication().GetService(&quot;EAI Data Transformation Engine&quot;);
		var psInputs = TheApplication().NewPropertySet();
		var psOutputs = TheApplication().NewPropertySet();
		
		//Map the data
		Inputs.SetProperty(&quot;OutputIntObjectName&quot;,&quot;VF Order Item Task Insert&quot;);
