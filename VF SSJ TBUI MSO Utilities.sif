			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="SetFulFilmentId"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function SetFulFilmentId(Inputs, FulfilmentId)
{
	for (var i=0;i &lt; NoOfServices; i++)
	{
		Inputs.GetChild(i).SetProperty(&quot;Fulfilment Id&quot;, FulfilmentId);
	}
}"
			   SEQUENCE="127"
