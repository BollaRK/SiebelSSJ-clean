			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mValidateAPP"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mValidateAPP(Inputs,Outputs)
{
  try{
	sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
	var oOrderBO=TheApplication().GetBusObject(&quot;Order Item&quot;);
	var oOrderBC=TheApplication().GetBusObject(&quot;Order Entry&quot;).GetBusComp(&quot;Order Entry - Orders&quot;);
	var oLineBC = oOrderBO.GetBusComp(&quot;Order Entry - Line Items (Simple)&quot;);
	var oLineXA = oOrderBO.GetBusComp(&quot;Order Item XA (Simple)&quot;);
	var bsEAIService = TheApplication().GetService(&quot;EAI Siebel Adapter&quot;);
	var psInputs = TheApplication().NewPropertySet();
	var psOutputs = TheApplication().NewPropertySet();
	var sSearchStr = Inputs.GetProperty(&quot;SearchStr&quot;);
	var sOrderType = Inputs.GetProperty(&quot;OrderFn&quot;);
	var strErrMsg= &quot;&quot;,sChannel=&quot;&quot;;//strAPPError=&quot;&quot;;
	var psSysPrefInp = TheApplication().NewPropertySet();
	var psPrefOut = TheApplication().NewPropertySet();
	var iNoOfServices=0,strRootId,sTotalRRP=0,iRRP=0,isRec=0,iMinAPPAmt = 0;
	var iSdRRP = 0, CountSD=0, iAccRRP=0;	// VHA Suresh : Added for ATOM:	14/07/2017
	var sdMinRRP = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_SD_RRP&quot;,&quot;Min RRP Inc GST&quot;);
	var EQUIP_MIN_AMOUNT = &quot;95104&quot;;
	with(oOrderBC)
	{
		ClearToQuery();
		ActivateField(&quot;VF Order Channel&quot;);
		SetSearchSpec(&quot;Id&quot;, sOrderId);
		ExecuteQuery();
		if(FirstRecord())
			sChannel=GetFieldValue(&quot;VF Order Channel&quot;);
	}
//	if(sChannel!=&quot;VHA Online Store&quot;) //MADHUR::17MAR25::Inactivated for PKE000000124798_online order for ls customer
//	{
		psInputs.SetProperty(&quot;OutputIntObjectName&quot;, &quot;VF Order Item Task Simple&quot;);
		if(sOrderType==&quot;Acquisition&quot;)
			psInputs.SetProperty(&quot;SearchSpec&quot;,sSearchStr);
		else
			psInputs.SetProperty(&quot;SearchSpec&quot;,&quot;[VF Order Item Task Simple.Order Header Id] = &apos;&quot; + sOrderId + &quot;&apos;&quot;);
		
		
		iMinAPPAmt = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_APP_MIN_AMOUNT&quot;,&quot;Min Amount&quot;);
		
		/*psSysPrefInp.Reset();
		psPrefOut.Reset();
		psSysPrefInp.SetProperty(&quot;System Preference Name&quot;,&quot;VHA APP Error Min Amount&quot;);
		TheApplication().GetService(&quot;VF Get System Preference&quot;).InvokeMethod(&quot;Get System Preference&quot;, psSysPrefInp, psPrefOut);
		strAPPError = psPrefOut.GetProperty(&quot;System Preference Value&quot;);*/
	
		bsEAIService.InvokeMethod(&quot;Query&quot;, psInputs, psOutputs);
		psInputs.Reset();
		psInputs = psOutputs.GetChild(0).GetChild(0).Copy();
		iNoOfServices = psInputs.GetChildCount();
	
		for (var i=0;i &lt; iNoOfServices; i++)
		{
			isRec=0;
			iRRP=0;
			strRootId = psInputs.GetChild(i).GetProperty(&quot;Id&quot;);
			with (oLineBC)
			{
				 ClearToQuery();
				 SetViewMode(AllView);
				 SetSearchSpec(&quot;Root Order Item Id&quot;, strRootId);
				 SetSearchSpec(&quot;Product Type&quot;, &quot;Billing - APP&quot;);
				 SetSearchSpec(&quot;Action Code&quot;, &quot;&lt;&gt;Delete&quot;);
				 ExecuteQuery(ForwardBackward);
				 var irec = FirstRecord();
				 if (FirstRecord())
				 {
					 while(irec)
					 {
						if(mGetOrderItemAttr(oOrderBO,&quot;[Name]=&apos;Category&apos;&quot;) == &quot;Secondary Device&quot;)		// Indumathi:	Added for ATOM
						{
							iRRP =  mGetOrderItemAttr(oOrderBO,&quot;[Name]=&apos;Total Accessories RRP Inc GST&apos;&quot;);
							
							if(iRRP&lt;ToNumber(sdMinRRP))	// VHA Suresh: Added for ATOM:	14/07/2017
								TheApplication().RaiseErrorText (&quot;VFErrorCode#97033 Line Number: &quot; + psInputs.GetChild(i).GetProperty(&quot;Line Number&quot;) + &quot; - &quot;+ TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;97033&quot;));
		
							iSdRRP += ToNumber(iRRP);
							CountSD++;
						}
						else
						{
							iRRP = mGetOrderItemAttr(oOrderBO,&quot;[Name]=&apos;Total Accessories RRP Inc GST&apos;&quot;);
							iAccRRP +=ToNumber(iRRP);
							isRec=1;
						}
						if(iRRP != &quot;&quot;)
							sTotalRRP+=ToNumber(iRRP);
						
					irec = NextRecord();
					}
				}
				else
				{
					psPrefOut.Reset();
					mAPPGetAccessoryDetails(strRootId, psPrefOut);
					sTotalRRP+=ToNumber(psPrefOut.GetProperty(&quot;TotalRRP&quot;));
					iAccRRP=ToNumber(psPrefOut.GetProperty(&quot;AccRRPTotal&quot;));	
					isRec = psPrefOut.GetProperty(&quot;TotalNumofAccessories&quot;);
					iSdRRP = psPrefOut.GetProperty(&quot;SDRRPTotal&quot;);
					CountSD = psPrefOut.GetProperty(&quot;NumOfSD&quot;);
				}
			}

			if(ToNumber(iAccRRP)&lt;ToNumber(iMinAPPAmt) &amp;&amp; ToNumber(isRec)&gt;0 &amp;&amp; ToNumber(iAccRRP)&gt;0)//SureshG - Added condition iAccRRP&gt;0 for 19.3 Prepayments
			TheApplication().RaiseErrorText (&quot;VFErrorCode#&quot; + EQUIP_MIN_AMOUNT + &quot; Line Number: &quot; + psInputs.GetChild(i).GetProperty(&quot;Line Number&quot;) + &quot; - &quot;+ TheApplication().LookupMessage(&quot;User Defined Errors&quot;, EQUIP_MIN_AMOUNT));
				//strErrMsg = strErrMsg+strAPPError + &quot;. Please check Line &quot;+psInputs.GetChild(i).GetProperty(&quot;Line Number&quot;)+&quot;\n&quot;;
		}
		/*if(strErrMsg)
		TheApplication().RaiseErrorText (&quot;VFErrorCode# &quot; + EQUIP_MIN_AMOUNT + &quot; &quot; + TheApplication().LookupMessage(&quot;User Defined Errors&quot;, EQUIP_MIN_AMOUNT));*/
	//		TheApplication().RaiseErrorText(strErrMsg);
//	}	//MADHUR::17MAR25::Inactivated for PKE000000124798_online order for ls customer
	Outputs.SetProperty(&quot;TotalAPP&quot;,sTotalRRP);	

	}

	catch (e)
	{
	throw e;
	}
	finally
	{
	/*Below variables are nullified by Sharukh on 18/03/2019*/
	oOrderBC = null;
	oLineBC = null;
	oLineXA = null;
	oOrderBO = null;
	bsEAIService = null;
	psInputs = null;
	psOutputs = null;
	psSysPrefInp = null;
	psPrefOut = null;
	//psOut = null;
	//RRPOut = null;
}
}"
			   SEQUENCE="115"
			   UPDATED="01/09/2026 15:43:20"
			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 15:43:20"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mValidateContractMonths"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mValidateContractMonths()
{
	try
	{
		var sTBUIBO = TheApplication().GetBusObject(&quot;VF MPP Order Task Support&quot;);
		var sTBUIBC = sTBUIBO.GetBusComp(&quot;VF MPP Order Smartscript Support - TBUI&quot;);
		var sErr = &quot;&quot;;
		var sLineNum = &quot;&quot;;
		sTBUIBC.SetViewMode(AllView); 
		sTBUIBC.ClearToQuery();
		sTBUIBC.ActivateField(&quot;MPP Contract Months&quot;);
		sTBUIBC.ActivateField(&quot;VF Line Number&quot;);
		sTBUIBC.SetSearchSpec(&quot;Order Id&quot;,sOrderId);
		sTBUIBC.SetSortSpec(&quot;VF Line Number(ASCENDING)&quot;);
		sTBUIBC.ExecuteQuery(ForwardOnly);
		var sRecord = sTBUIBC.FirstRecord();
		while(sRecord)     
		{	 
			if(sTBUIBC.GetFieldValue(&quot;MPP RCC F&quot;) &gt; 0)
			{
				if(sTBUIBC.GetFieldValue(&quot;MPP Contract Months&quot;) == &quot;&quot; || sTBUIBC.GetFieldValue(&quot;MPP Contract Months&quot;) == null )
				{
					//VHA Muthushankari - 20/5/2019 - Changed the error message as part of R19.3 MHI project
					//sErr = &quot;Please enter Contract Months for Line Item Number#&quot;+sTBUIBC.GetFieldValue(&quot;VF Line Number&quot;);
					sErr = TheApplication().LookupMessage(&quot;User Defined Errors&quot;,&quot;VHA_GPP_001&quot;,sTBUIBC.GetFieldValue(&quot;VF Line Number&quot;));
					break;
				}
			}
			sRecord  = sTBUIBC.NextRecord();        
		}
		return(sErr);
	}
	
	catch(e)
	{
	if (defined(e.errText))
		{
			strError = e.errText; 
		}
		else
		{
			strError = ToString(e); 
		}
		
		throw (strError);
	}
	finally
	{
		//Kailash - Modified BO,BC nullification		
		sTBUIBC = null;
		sRecord = null;
		sTBUIBO = null;
	}
}"
			   SEQUENCE="116"
			   UPDATED="01/09/2026 15:43:20"
			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 15:43:20"
			   CREATED_BY="SADMIN">
