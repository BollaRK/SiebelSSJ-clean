			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mInsertVoucher"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mInsertVoucher(Inputs,Outputs)
{
	try
	{		
		var sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);		
		var sCustAccountId = Inputs.GetProperty(&quot;AccountId&quot;);
		var AccountType = Inputs.GetProperty(&quot;Account Type&quot;);
	/*	var pssOut = TheApplication().NewPropertySet();
		mCheckVoucherAmount(Inputs,pssOut);							
		var sItemName = pssOut.GetProperty(&quot;ssItemName&quot;);							
		var sTerm = pssOut.GetProperty(&quot;ssTerm&quot;);						
		var sServiceitemId = pssOut.GetProperty(&quot;ssServiceitemId&quot;);							
		var sVoucherAmount = pssOut.GetProperty(&quot;ssVoucherAmount&quot;);						
		var sAssetIntegrationId = pssOut.GetProperty(&quot;ssAssetIntegrationId&quot;);*/	
		var oEqAccntBO = TheApplication().GetBusObject(&quot;VHA Equipment Account&quot;);
		var oEqAccntBC = oEqAccntBO.GetBusComp(&quot;VHA Equipment Account&quot;);					
	
		var sArray =  ssNewTerm.split(&quot; &quot;);
		if( AccountType == &quot;Person&quot;)
		{
			with (oEqAccntBC)
			{
				ActivateField(&quot;Term&quot;);
				ActivateField(&quot;Account Id&quot;);
				ActivateField(&quot;Service Order Id&quot;);
				ActivateField(&quot;Order Id&quot;);
				ActivateField(&quot;RRP&quot;);
				ActivateField(&quot;Type&quot;);
				ActivateField(&quot;Asset Integeration Id&quot;);
				ActivateField(&quot;Prepayment Amount&quot;);
				ActivateField(&quot;Contract Start Date&quot;);
				ClearToQuery();
				SetViewMode(AllView);
				SetSearchSpec(&quot;Account Id&quot;, sCustAccountId);
				SetSearchSpec(&quot;Order Id&quot;,sOrderId);
				SetSearchSpec(&quot;Service Order Id&quot;,ssServiceitemId);
				SetSearchSpec(&quot;Type&quot;, &quot;Plan Equipment Limit&quot;); 
				SetSearchSpec(&quot;Asset Integeration Id&quot;, ssAssetIntegrationId);								
				ExecuteQuery();
				if(!FirstRecord())
				{ 
					NewRecord(NewAfter);
					SetFieldValue(&quot;Type&quot;, &quot;Plan Equipment Limit&quot;);													
					SetFieldValue(&quot;Term&quot;,sArray[0]);
					SetFieldValue(&quot;Account Id&quot;, sCustAccountId);
					SetFieldValue(&quot;Order Id&quot;,sOrderId);
					SetFieldValue(&quot;Service Order Id&quot;,ssServiceitemId);
					SetFieldValue(&quot;RRP&quot;,ssVoucherAmount);									
					SetFieldValue(&quot;Asset Integeration Id&quot;,ssAssetIntegrationId);
					SetFieldValue(&quot;Prepayment Amount&quot;,0);
					SetFieldValue(&quot;Item Name&quot;,ssItemName);
					//SetFieldValue(&quot;Contract Start Date&quot;,scontr);									
					//SetFieldValue(&quot;Asset Id&quot;,sAssetId);			
				
					WriteRecord();
				}
			}
		}
	}
	catch(e)
	{
	throw e;
	}
	finally
	{
		oEqAccntBC = null;
		oEqAccntBO = null;
	}
							
	}"
