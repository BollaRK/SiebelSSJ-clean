			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="Service_PreInvokeMethod"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function Service_PreInvokeMethod (MethodName, Inputs, Outputs)
{
  try{
	//TheApplication().TraceOn(&quot;../log/traceMPP.txt&quot;, &quot;Allocation&quot;, &quot;Al&quot;);
	switch (MethodName)
	{
		case &quot;InvokePostConfiguration&quot;:
			mInvokePostConfiguration(Inputs, Outputs);
			return(CancelOperation);
			break;
			
		case &quot;AllocateMSISDN&quot;:
			sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
			AllocateMSISDN();
			return(CancelOperation);
			break;
			
		case &quot;AddDeviceSiebelOnlyProducts&quot;:
			sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
			AddDeviceSiebelOnlyProducts();
			return(CancelOperation);
			break;
			
		case &quot;RemoveDeviceSiebelOnlyProducts&quot;:
			sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
			RemoveDeviceSiebelOnlyProducts();
			return(CancelOperation);
			break;
			
		case &quot;UpdateLineItems&quot;:
			sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
			UpdateLineItems(&quot;No&quot;);
			return(CancelOperation);
			break;

		case &quot;AddMPP&quot;:
			sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
			mMPPAdd(Inputs);
			return(CancelOperation);
			break;
			
		case &quot;AddAPP&quot;://KAMALI: 04/06/2016 - Added for AoA2 Project
			sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
			mAPPAdd(Inputs);
			return(CancelOperation);
			break;
			
		case &quot;AddAccessory&quot;://KAMALI: 04/06/2016 - Added for AoA2 Project
			sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
			mAddAccessory(Inputs,Outputs);
			return(CancelOperation);
			break;

		case &quot;ValidateMPP&quot;:
			sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
			mMPPValidation(Outputs);
			return(CancelOperation);
			break;
			
		case &quot;ValidateOrder&quot;:
			mValidateOrder (Inputs, Outputs);
			return(CancelOperation);
			break;
			
		case &quot;ValidateOrderMSO&quot;:
			sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
			sReservationId = Inputs.GetProperty(&quot;ReservationId&quot;);
			Outputs.SetProperty(&quot;ErrorMessage&quot;, ValidateOrderMSO());
			return(CancelOperation);
			break;
			
		case &quot;SubmitOrder&quot;:
			mSubmitOrder (Inputs, Outputs);
			return(CancelOperation);
			break;

		case &quot;CallSubmitOrder&quot;:
			mCallSubmitOrder (Inputs, Outputs);
			return(CancelOperation);
			break;
			
		case &quot;CallSubmitOrderPrepayments&quot;:
			mCallSubmitOrderPrepayments (Inputs, Outputs);//19.3  Added for Prepayments - SureshG
			return(CancelOperation);
			break;
		
		case &quot;CheckLineNumber&quot;:
			CheckLineNumber(Inputs, Outputs);
			return(CancelOperation);
			break;
	
		case &quot;CalculateRRP&quot;://KAMALI: 20/10/2015 - Added for R16.1 EL
			var psOut = TheApplication().NewPropertySet();
			var rrp = mCalculateRRP(Inputs,psOut);
			Outputs.SetProperty(&quot;TotalRRP&quot;,rrp);
			Outputs.SetProperty(&quot;sbl&quot;,psOut);
			return(CancelOperation);
			break;	
		
		case &quot;InsertEquipment&quot;://KAMALI: 25/10/2015 - Added for R16.1 EL
			mInsertEquipment(Inputs);
			return(CancelOperation);
			break;
			
		case &quot;UpdateEquipment&quot;://KAMALI: 03/11/2015 - Added for R16.1 EL
			mUpdateEquipment(Inputs);
			return(CancelOperation);
			break;
			
		case &quot;DeleteEquipment&quot;://KAMALI: 25/10/2015 - Added for R16.1 EL
			mDeleteEquipment(Inputs);
			return(CancelOperation);
			break;
			
  		case &quot;ValidateRRP&quot;://KAMALI: 20/10/2015 - Added for R16.1 EL
   			var RRPDetails = mValidateRRP(Inputs);
   			Outputs.SetProperty(&quot;TotalRRP&quot;,RRPDetails.GetProperty(&quot;TotalRRP&quot;));
   			Outputs.SetProperty(&quot;RemEL&quot;,RRPDetails.GetProperty(&quot;RemEL&quot;));
   			return(CancelOperation);
   			break;
		
		case &quot;CalcRemainMonth&quot;://KAMALI: 03/11/2015 - Added for R16.1 EL
			var iRemainMonths = mCalcRemainMonth(Inputs);
			Outputs.SetProperty(&quot;RemainMonths&quot;, iRemainMonths);
			return(CancelOperation);
			break;
			
		case &quot;CalcActualRemainMonth&quot;://KAMALI: 03/11/2015 - Added for R16.1 EL
			var iRemainMonths = mCalcActualRemainMonth(Inputs);
			Outputs.SetProperty(&quot;RemainMonths&quot;, iRemainMonths);
			return(CancelOperation);
			break;
	
		case &quot;CreateFOAttribs&quot;:
			var sFlow = Inputs.GetProperty(&quot;Flow&quot;);	
			if (sFlow == &quot;TBUI Connect&quot;)				
				mCreateConnectFOAttribs(Inputs,Outputs);
			else if (sFlow == &quot;TBUI Upgrade&quot;)
				mCreateUpgradeFOAttribs(Inputs,Outputs);
			return(CancelOperation);
			break;
		case &quot;ProcessMsg&quot;: //Kamali: 22/04/2016 - Added for AoA2
			mProcessMsg(Inputs,Outputs);
			return(CancelOperation);
			break;
	
		case &quot;UpdateFulfilmentStartDate&quot;:	//Roseline: 15/10/2015 - Added for R16.1 MSOD
			mUpdateFulfilmentStartDate(Inputs, Outputs);
			return (CancelOperation);
		
		case &quot;ValidateUpgradeShippingAddress&quot;://Roseline: 15/10/2015 - Added for R16.1 MSOD
			mValidateUpgradeShippingAddress(Inputs, Outputs);
			return (CancelOperation);
			
		case &quot;UpdateOrderLineItems&quot;: //Roseline: 03/11/2015 - Added for R16.1 MSOD
			mUpdateOrderLineItems(Inputs, Outputs);
			return (CancelOperation);
			
		case &quot;UpsertShipment&quot;: //Roseline: 03/11/2015 - Added for R16.1 MSOD
			mUpsertShipment(Inputs, Outputs);
			return (CancelOperation);
			
		case &quot;CallAsyncFlow&quot;: //Roseline: 03/11/2015 - Added for R16.1 MSOD
			mCallAsyncFlow(Inputs, Outputs);
			return (CancelOperation);
		
		case &quot;UpdateConnectLineItems&quot;: //Roseline: 22/12/2015 - Added for R16.1 MSOD Defect#140
			mUpdateConnectLineItems(Inputs, Outputs);
			return (CancelOperation);
			
		case &quot;DeleteFulfilmentLineItems&quot;: //Roseline: 22/02/2016 - Added for R16.1 MSOD Defect#711
			mDeleteFulfilmentLineItems(Inputs, Outputs);
			return (CancelOperation);
		case &quot;CheckAPPTerm&quot;:
			mCheckAPPTerm(Inputs, Outputs);
			return (CancelOperation);
									
		case &quot;CheckStockIndicator&quot;:
		mCheckStockIndicator(Inputs, Outputs);
		return (CancelOperation);
		
		case &quot;ProcessEquipment&quot;:
		fnProcessEquipment(Inputs, Outputs);
		return (CancelOperation);
						
		//SK 7.9.16: Rel 16.4 - Added as part of MPP Misalignment Adjustment TIR. 
		//Code Start
		case &quot;UpdateMPPContractAttribute&quot;: //NIRMAL 9/1/2017 Changed method name as part of PKE000000041878
		mUpdateMPPContractAttribute(Inputs, Outputs);
		return (CancelOperation);
		//Code End
		
		//SK 29.8.17 - Release 17.4 B - Payment Options GT - Added generic code to get multiple profile attributes in one go
		//Code Start
		case &quot;GetProfileAttribute&quot;: //NIRMAL 9/1/2017 Changed method name as part of PKE000000041878
		fnGetProfileAttribute(Inputs, Outputs);
		return (CancelOperation);
		//Code End
		
		//SK 19.1.B - Added to query lov and perform lookup name and check if resp exists
		case &quot;QueryLOV&quot;:
		fnQueryLOVCheckResp(Inputs,Outputs);
		return (CancelOperation);
		
		case &quot;CheckSIMAdded&quot;: //VHA SBLUPG/PKE/NIRMAL/02FEB2020/Added for PKE000000079039
		mCheckSIMAdded(Inputs, Outputs)
		return (CancelOperation);

		case &quot;CheckVoucherAmount&quot;:
		mCheckVoucherAmount(Inputs,Outputs);
		return (CancelOperation);

		case &quot;InsertFulFilVoucher&quot;:
		mInsertFulFilVoucher(Inputs,Outputs);
		return (CancelOperation);

		case &quot;CheckDeleteVoucher&quot;:
		mCheckDeleteVoucher(Inputs,Outputs);
		return (CancelOperation);
		
		case &quot;DeleteAccessoryItems&quot;: //VHA Balamurugan 25/04/2020 - Added for PKE000000079582
			sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
			mDeleteAccessoryItems(Inputs);
			return(CancelOperation);
			break;

		case &quot;SubmitOrder_LinkageId&quot;:  //TRISHAG: 01/30/2025 - Added for R1.2 Imagine; R2.0 27/05/2025
			var iLinkId = mSubmitOrder_LinkageId(Inputs);
			Outputs.SetProperty(&quot;LinkageId&quot;, iLinkId);
			return(CancelOperation);
			break;

		case &quot;SyncAccount_LinkageId&quot;:  //TRISHAG: 01/30/2025 - Added for R1.2 Imagine; R2.0 27/05/2025
			var iLinkId = mSyncAccount_LinkageId(Inputs);
			Outputs.SetProperty(&quot;LinkageId&quot;, iLinkId);
			return(CancelOperation);
			break;	

			

		default:
			return (ContinueOperation);
	}
	
	
	}
	catch (e)
	{
		throw e;
	}

	finally
	{
	psOut = null;  /* This variable is nullified by Sharukh on 20/03/2019*/
	}

}
"
