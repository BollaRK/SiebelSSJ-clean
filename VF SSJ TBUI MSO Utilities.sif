			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="CheckLineNumber"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function CheckLineNumber(Inputs, Outputs)
{
	try
	{
		var strOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
		var boOrder = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
		var bcOrder = boOrder.GetBusComp(&quot;Order Entry - Orders&quot;);
		var bcFulfilItems = boOrder.GetBusComp(&quot;VF Fulfilment Items&quot;);
		var isRecord = false;
		with (bcOrder)
		{
			ClearToQuery();
			SetViewMode(AllView);
			SetSearchSpec(&quot;Id&quot;, strOrderId);
			ExecuteQuery(ForwardOnly);
			if (FirstRecord())
			{
				with (bcFulfilItems)
				{
					ClearToQuery();
					ActivateField(&quot;VF Line Item Id&quot;);
					SetViewMode(AllView);
					SetSearchExpr(&quot;[VF Line Item Id] is null AND [Item Type] = &apos;Accessory&apos;&quot;);
					ExecuteQuery();
					isRecord = FirstRecord();
					if(isRecord)
					{
						Outputs.SetProperty(&quot;VFErrorMsg&quot;,&quot;Please choose a line number for every accessory&quot;);
					}
					else
					{
						Outputs.SetProperty(&quot;VFErrorMsg&quot;,&quot;&quot;);
					}
				}
			}
		}
	}
	catch(e)
	{
		TheApplication().RaiseErrorText(errorMessage(e));
	}
	finally
	{
		bcFulfilItems = null;
		bcOrder = null;
		boOrder = null;
	}
}"
			   SEQUENCE="10"
