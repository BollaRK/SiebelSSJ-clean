			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 15:43:18"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mDeleteFulfilmentLineItems"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mDeleteFulfilmentLineItems(Inputs, Outputs)
{
/*
 * Component Name        : 	VF TBUI MSO Utilities
 * Function Name         : 	mDeleteFulfilmentLineItems
 * Component Information : 	Deletes the Fulfilment Line Items and shipment record from fulfilment order
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 22/02/2016	Roseline	R16.1 MSOD	Initial Version - Defect #711									
 */
	try
	{	
		var sOrderId =Inputs.GetProperty(&quot;Order Id&quot;);
		var	boOrder = TheApplication().GetBusObject(&quot;VF Order Entry Thin BO&quot;);
		var	bcOrder = boOrder.GetBusComp(&quot;VF Order Entry - Orders Thin BC&quot;);
		var	bcOrderLI = boOrder.GetBusComp(&quot;VF Order Line Items - Thin BC&quot;);
		var bcShipment = boOrder.GetBusComp(&quot;FS Shipment&quot;);
		with (bcOrder)
		{
			bcOrder.SetViewMode(AllView);
			bcOrder.ClearToQuery();
			bcOrder.SetSearchSpec(&quot;Id&quot;, sOrderId);
			bcOrder.ExecuteQuery();
			if (bcOrder.FirstRecord())
			{
				with(bcOrderLI)
				{
					bcOrderLI.SetViewMode(AllView);
					bcOrderLI.ActivateField(&quot;Order Header Id&quot;);
					bcOrderLI.ActivateField(&quot;Parent Order Item Id&quot;);
					bcOrderLI.ActivateField(&quot;Action Code&quot;);
					bcOrderLI.ClearToQuery();
					var searchst = &quot;[Order Header Id] = &apos;&quot; + sOrderId + &quot;&apos; AND [Parent Order Item Id] IS NULL AND [Action Code] &lt;&gt; &apos;Delete&apos;&quot;;
					bcOrderLI.SetSearchExpr(searchst);
					bcOrderLI.ExecuteQuery(ForwardOnly);
					var isRec = bcOrderLI.FirstRecord();
					var sCount = bcOrderLI.CountRecords();
					if(sCount &gt; 0)
					{
						with(bcShipment)
						{
							bcShipment.SetViewMode(AllView);
							bcShipment.ActivateField(&quot;Primary Order Id&quot;);
							bcShipment.ClearToQuery();
							var searchst = &quot;[Primary Order Id] = &apos;&quot; + sOrderId + &quot;&apos;&quot;;
							bcShipment.SetSearchExpr(searchst);
							bcShipment.ExecuteQuery(ForwardOnly);
							var isRecFound = bcShipment.FirstRecord();
							while(isRecFound)
							{
								bcShipment.DeleteRecord();
								isRecFound = bcShipment.FirstRecord();	
							}  
						}//with(bcShipment)
						while(isRec)
						{
							bcOrderLI.DeleteRecord();
							isRec = bcOrderLI.FirstRecord();	
						} 
					}  //	if(sCount &gt; 0)
				}//with(bcOrderLI)
			}	//if (boOrder.FirstRecord())
		}//		with (boOrder)	
		return(CancelOperation);
	}//try
	catch(e)
	{
		throw(e);
	}
	finally
	{
		bcShipment = null;
		bcOrderLI = null;
		bcOrder = null;
		boOrder = null;
	}
}"
			   SEQUENCE="62"
			   UPDATED="01/09/2026 15:43:18"
			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 15:43:18"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mDeleteMPPLineItem"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mDeleteMPPLineItem(Inputs)
{
		try
		{

			var sOrderId = Inputs.GetProperty(&quot;Order Id&quot;);
			var sDiscountId;
			var iRecord;
			var boOrder = TheApplication().GetBusObject(&quot;Order Entry - Simple&quot;);
			var sBCOrder = boOrder.GetBusComp(&quot;Order Entry - Orders&quot;);
			var bcOrderLineIt = boOrder.GetBusComp(&quot;Order Entry - Line Items (Simple)&quot;);
			
			var sMPPLineItemId = Inputs.GetProperty(&quot;Order Item Id&quot;);
			
			with(sBCOrder)
			{
				ClearToQuery();
				SetViewMode(AllView);
				SetSearchSpec(&quot;Id&quot;,sOrderId);
				ExecuteQuery(ForwardOnly);
				if(FirstRecord())
				{
				
					with(bcOrderLineIt)
					{
						ActivateField(&quot;Order Header Id&quot;);
						ActivateField(&quot;Product Id&quot;);
						ActivateField(&quot;Parent Order Item Id&quot;);
						ActivateField(&quot;Custom Asset Integration Id&quot;);
						ActivateField(&quot;Asset Integration Id&quot;);
						ActivateField(&quot;Product Type&quot;);   
						ActivateField(&quot;Action Code&quot;);       
						ClearToQuery();
						SetViewMode(AllView);
						SetSearchExpr(&quot;[Order Header Id] = &apos;&quot;+ sOrderId+&quot;&apos; AND [Id] = &apos;&quot;+ sMPPLineItemId+&quot;&apos;&quot;);
						ExecuteQuery(ForwardOnly);
						if(FirstRecord())
						{		
							DeleteRecord();
						}//end of if(FirstRecord())
					}//end of with(bcOrderLineIt)
				}//end of if(FirstRecord())
			}// end of with(sBCOrder)
		}//end of try
		catch(e)
		{
			throw(e);
		}
		finally
		{
			sOrderId = null;
			sDiscountId = null;
			//sMPPProductId  = null;
			sBCOrder = null;  /* This variable is nullified by Sharukh on 18/03/2019*/
			bcOrderLineIt = null;
			boOrder = null;
			

		}
}"
