			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mPropositionNext"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mPropositionNext(psOutputs, bsOutputs)
{
/*
 * Component Name        : 	VF TBUI MSO Utilities
 * Function Name         : 	mPropositionNext
 * Component Information : 	Fulfilment Order creation and validation
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
