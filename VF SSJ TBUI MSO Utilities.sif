			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetMPPContId"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mGetMPPContId(sLineItemId)
{

try{
	var boOrder = TheApplication().GetBusObject(&quot;VF Task Validation&quot;);
	var bcOrder = boOrder.GetBusComp(&quot;VF Task Validation&quot;);
	var sMPPContractId = &quot;&quot;;
	var sMPPDeviceName = &quot;&quot;,sMPPId = &quot;&quot;,sMPPProdCode = &quot;&quot;, sMPPTerm = &quot;&quot;,sMPPContAmt = &quot;&quot; ;
	
	
	
	with (bcOrder)
	{
		InvokeMethod(&quot;SetAdminMode&quot;,&quot;TRUE&quot;);
		bcOrder.ActivateField(&quot;MPP Contract Id&quot;);
		ActivateField(&quot;MPP Device Name&quot;);
		ActivateField(&quot;MPP Id&quot;);
		ActivateField(&quot;MPP Product Name&quot;);
		ActivateField(&quot;MPP Term&quot;);
		ActivateField(&quot;Handset&quot;);
		
		ClearToQuery();
		SetViewMode(AllView);
		SetSearchSpec(&quot;Order Item Id&quot;, sLineItemId);
		ExecuteQuery();
		
		if(FirstRecord())
		{
			sMPPContractId = bcOrder.GetFieldValue(&quot;MPP Contract Id&quot;);
			sMPPDeviceName = GetFieldValue(&quot;MPP Device Name&quot;);
			sMPPId = GetFieldValue(&quot;MPP Id&quot;);
			sMPPProdCode = GetFieldValue(&quot;MPP Product Name&quot;);
			sMPPTerm = GetFieldValue(&quot;MPP Term&quot;);
			sMPPContAmt =GetFieldValue(&quot;Handset&quot;);
			
			
			
		}
		InvokeMethod(&quot;SetAdminMode&quot;,&quot;FALSE&quot;);
	}
	return(sMPPContractId);

	}

	catch (e)
	{
		throw e;
	}

	finally
	{
	/*Below variables are nullified by Sharukh on 20/03/2019*/
	bcOrder = null;
	boOrder = null;
	
	}
				

}"
