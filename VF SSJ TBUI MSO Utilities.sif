			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCheckTOT"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="//ADUTTA:Added for apple fraud project
function mCheckTOT(OrderId)
{

	try
	{
		var boTransferNumber = TheApplication().GetBusObject(&quot;VF Transfer Number Request&quot;);
		var bcTransferNumber = boTransferNumber.GetBusComp(&quot;VF Transfer Number Request&quot;);
		var sTOTLov = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_TRANSFER_TYPE&quot;,&quot;Transfer of Title&quot;);
		var sCATLov = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_TRANSFER_TYPE&quot;,&quot;Customer Account Transfer&quot;);
		var IsTOT = &quot;N&quot;;
		with(bcTransferNumber)
		{
			ClearToQuery();
			SetViewMode(AllView);
			SetSearchExpr(&quot;[Connect Order Id] = &apos;&quot;+OrderId+&quot;&apos; AND ([Transfer Type] = &apos;&quot;+sTOTLov+&quot;&apos; OR [Transfer Type] = &apos;&quot;+sCATLov+&quot;&apos;)&quot;);
			ExecuteQuery(ForwardOnly);
			if(FirstRecord())
				IsTOT = &quot;Y&quot;;
		}
		return IsTOT;
	}
	catch(e)
	{
		TheApplication().RaiseErrorText(e.toString());
	}
	finally
	{
		 bcTransferNumber = null;
		 boTransferNumber = null;
	}
}"
