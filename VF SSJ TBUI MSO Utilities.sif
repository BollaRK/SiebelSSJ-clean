			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mProcessMsg"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mProcessMsg(Inputs,Outputs)
{
	/*
	* Component Name        : 	mProcessMsg
	* Method Name           : 	
	* Component Information : 	This function removes the Fulfilment Request (Root) 
	* 							for which doesn&apos;t have Out of Stock Device and Accessories
	*
	* Modification History  :
	* Date			Author		Config #	Description
	* ============ ===========	===========	================================
	* 13/06/2016	Saravanan J				Added code for TBUI Connect
	*/
	var psIn=Inputs.GetChild(0);
	
	if (Inputs.GetProperty(&quot;Flow&quot;) == &quot;TBUI Connect&quot;) // JS: 13062016: Created for AoA
	{
		for(var m = 0; m &lt; psIn.GetChild(0).GetChild(0).GetChild(0).GetChildCount(); m++)
		{
			if (psIn.GetChild(0).GetChild(0).GetChild(0).GetChild(m).GetProperty(&quot;VF Out of Stock Indicator&quot;) != TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_ORDER_STOCK_INDICATOR&quot;,&quot;Out of Stock - Connect Later&quot;))
			{
				for(var n = 0; n &lt; psIn.GetChild(0).GetChild(0).GetChild(0).GetChild(m).GetChildCount(); n++)
				{
					if(psIn.GetChild(0).GetChild(0).GetChild(0).GetChild(m).GetChild(n).GetType() == &quot;ListOfFulfilmentAccessoryItems&quot; &amp;&amp; psIn.GetChild(0).GetChild(0).GetChild(0).GetChild(m).GetChild(n).GetChildCount() == 0)
					{
						psIn.GetChild(0).GetChild(0).GetChild(0).RemoveChild(m);
						m--;
						break;
					}
				}
			}
		}
	}
	if (Inputs.GetProperty(&quot;Flow&quot;) == &quot;TBUI Upgrade&quot;)
	{
		for(var j=0; j&lt;psIn.GetChild(0).GetChild(0).GetChild(0).GetChildCount(); j++)
		{
			for(var i=0; i&lt;psIn.GetChild(0).GetChild(0).GetChild(0).GetChild(j).GetChildCount(); i++)
			{
				if(psIn.GetChild(0).GetChild(0).GetChild(0).GetChild(j).GetChild(i).GetType() == &quot;ListOfChildOrderItem&quot; &amp;&amp; psIn.GetChild(0).GetChild(0).GetChild(0).GetChild(j).GetChild(i).GetChildCount()==0)
				{
					psIn.GetChild(0).GetChild(0).GetChild(0).RemoveChild(j);
					j--;
					break;
				}
			}
		}
	}			
	Outputs.AddChild(psIn.Copy());
}"
