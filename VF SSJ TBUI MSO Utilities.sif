			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="Check4GBackup"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function Check4GBackup(Inputs,Outputs)
{
try
{
       
       var strimei;
       var sIMEIBC = TheApplication().GetBusObject(&quot;VF IMEI List&quot;).GetBusComp(&quot;VF IMEI List&quot;);
       var sConfigListBC = TheApplication().GetBusObject(&quot;VHA Configuration List&quot;).GetBusComp(&quot;VHA Configuration List&quot;);
       
       
with(sIMEIBC)
			{
				ClearToQuery();
				SetViewMode(AllView);
				ActivateField(&quot;IMEI&quot;);
				ActivateField(&quot;Product Code&quot;);
				SetSearchSpec(&quot;IMEI&quot;,strimei);
				ExecuteQuery(ForwardOnly);
				if(FirstRecord())
				{							
					var sProdCode = GetFieldValue(&quot;Product Code&quot;);
                }
            }
			
			if(sProdCode != &quot;&quot; &amp;&amp; sProdCode != null)
		{
			with(sConfigListBC)
			{
				ClearToQuery();
				ActivateField(&quot;Type&quot;);
				ActivateField(&quot;String 1&quot;);
				ActivateField(&quot;String 3&quot;);
				ActivateField(&quot;String 6&quot;);
				ActivateField(&quot;Flag 02&quot;);
				ActivateField(&quot;Active Flg&quot;);
				ActivateField(&quot;Flag 01&quot;);
				ActivateField(&quot;Type&quot;);
				SetViewMode(AllView);
				SetSearchSpec(&quot;Type&quot;,&quot;TPGT_MODEM_COMPATIBILITY_MATRIX&quot;);
				SetSearchSpec(&quot;String 1&quot;,sProdCode);
				SetSearchSpec(&quot;String 3&quot;, &quot;Live&quot;);
				SetSearchSpec(&quot;Active Flg&quot;, &quot;Y&quot;);
				ExecuteQuery(ForwardOnly);
				if(FirstRecord())
				{
					var sFlag = GetFieldValue(&quot;Flag 01&quot;);
				}
			}
		}
return(sFlag);	
}//try
catch(e)
	{
	throw e;
	}
	finally
	{
		
	}
}	"
