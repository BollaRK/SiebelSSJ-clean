			if (sConnectNowFlag == &quot;Y&quot;)
			{
				TheApplication().SetProfileAttr(&quot;TBUIStockInd&quot;, sConnectNow);
				bsOutputs.SetProperty(&quot;FulfilmentType&quot;, sConnectNow);
			}
			if (sConnectLaterFlag == &quot;Y&quot;)
			{
