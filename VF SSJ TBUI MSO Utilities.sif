			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="UpdateLineItems"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function UpdateLineItems(sAddProperties)
{
	try
	{
		var bsEAIService = TheApplication().GetService(&quot;EAI Siebel Adapter&quot;);
		var bsService = TheApplication().GetService(&quot;EAI Data Transformation Engine&quot;);
		var psInputs = TheApplication().NewPropertySet();
		var psOutputs = TheApplication().NewPropertySet();
		var iNoOfServices = 0;
		//psInputs.SetProperty(&quot;OutputIntObjectName&quot;,&quot;VF Task Validation&quot;);
		//psInputs.SetProperty(&quot;SearchSpec&quot;, &quot;[VF Task Validation.Order Id] = &apos;&quot; + sOrderId + &quot;&apos;&quot;);
		psInputs.SetProperty(&quot;OutputIntObjectName&quot;, &quot;VF Task Line Item Update Query&quot;);
		psInputs.SetProperty(&quot;SearchSpec&quot;, &quot;[VF Task Line Item Update Query.Order Id] = &apos;&quot; + sOrderId + &quot;&apos;&quot;);
		
		bsEAIService.InvokeMethod(&quot;Query&quot;, psInputs, psOutputs);
		iNoOfServices = psOutputs.GetChild(0).GetChild(0).GetChildCount();
		
	    //Nikhil Joshi: 21.04.2016: Added below code for ST # 272
		var boOrder = TheApplication().GetBusObject(&quot;VF Order Entry Thin BO&quot;);
		var bcOrder = boOrder.GetBusComp(&quot;VF Order Entry - Orders Thin BC&quot;);
		var bcSOrder = boOrder.GetBusComp(&quot;VF Order Line Items - Thin BC&quot;);
		bcOrder.ClearToQuery();
		bcOrder.SetViewMode(AllView);
		bcOrder.SetSearchExpr(&quot;[Id] = &apos;&quot;+sOrderId+&quot;&apos;&quot;);
		bcSOrder.ClearToQuery();
		bcSOrder.SetViewMode(AllView);
		bcSOrder.ActivateField(&quot;Service PIN&quot;);
		bcSOrder.SetSearchExpr(&quot;[Parent Order Item Id] IS NULL&quot;);
		bcOrder.ExecuteQuery(ForwardOnly);
		if(bcOrder.FirstRecord())
		{
			for(var bRec=bcSOrder.FirstRecord();bRec;bRec=bcSOrder.NextRecord())
			{
				for (var i=0;i &lt; iNoOfServices; i++)
				{
					if(psOutputs.GetChild(0).GetChild(0).GetChild(i).GetProperty(&quot;Order Item Id&quot;) == bcSOrder.GetFieldValue(&quot;Id&quot;)
					&amp;&amp; bcSOrder.GetFieldValue(&quot;Service PIN&quot;) != &quot;&quot; &amp;&amp; bcSOrder.GetFieldValue(&quot;Service PIN&quot;) != null)
					{
						psOutputs.GetChild(0).GetChild(0).GetChild(i).SetProperty(&quot;Service PIN&quot;, bcSOrder.GetFieldValue(&quot;Service PIN&quot;));
					}
				}
			}
		}
		//Nikhil Joshi: 21.04.2016: Added above code for ST # 272
		
		//Map the data
		psInputs.Reset();
		//psOutputs.SetProperty(&quot;MapName&quot;,&quot;VF Temp Order Item Task Insert&quot;);
		psOutputs.SetProperty(&quot;OutputIntObjectName&quot;,&quot;VF Order Item Task Insert&quot;);
		psOutputs.SetProperty(&quot;MapName&quot;,&quot;VF Task Update Order Item Fields&quot;);
		bsService.InvokeMethod(&quot;Execute&quot;, psOutputs, psInputs);
		
		if (sAddProperties == &quot;YES&quot;)
		{
			for (var i=0;i &lt; iNoOfServices; i++)
			{
				psInputs.GetChild(0).GetChild(0).GetChild(i).SetProperty(&quot;VF Comments&quot;, TheApplication().GetProfileAttr(&quot;VF Dealer Sales Person Name Attr&quot;) + &quot; - &quot; + TheApplication().GetProfileAttr(&quot;VF Dealer Code Attr&quot;) + &quot; - Sales to New Customer&quot;);
				psInputs.GetChild(0).GetChild(0).GetChild(i).SetProperty(&quot;VF Out of Stock Indicator&quot;, psOutputs.GetChild(0).GetChild(0).GetChild(i).GetProperty(&quot;Stock Indicator&quot;));
				psInputs.GetChild(0).GetChild(0).GetChild(i).SetProperty(&quot;Display Reason Code&quot;, TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_REASON_CODE&quot;, &quot;Customer Requested&quot;));
			}
		}

		psOutputs.Reset();
		bsEAIService.InvokeMethod(&quot;Upsert&quot;, psInputs, psOutputs);

	}
	catch(e)
	{
		throw e;
	}
	finally
	{
		bsEAIService = null;
		bsService = null;
		psInputs = null;
		psOutputs = null;
		/*Below variables are nullified by Sharukh on 18/03/2019*/
		bcOrder = null;
		bcSOrder = null;
		boOrder = null;
		
		

	}
}"
			   SEQUENCE="129"
			   UPDATED="01/09/2026 15:43:16"
			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 15:43:16"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="UpdateTNR"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function UpdateTNR(DOB, MSISDN, AccNum, TNRId, PretoPost)
{
	try
	{
		var oTNRBO = TheApplication().GetBusObject(&quot;VF MNP Transfer Number Request&quot;);
		var oTNRBC = oTNRBO.GetBusComp(&quot;VF Transfer Number Request - Without BC Read Prop&quot;);
		var strErrorMsg = &quot;&quot;, sStatus = &quot;&quot;, sStatusMsg = &quot;&quot;, sOpenClose = &quot;&quot;;
		with (oTNRBC)
		{
			ActivateField(&quot;AccountReferenceNumber&quot;);
			ActivateField(&quot;CustomerDOB&quot;);
			ActivateField(&quot;MSISDN&quot;);
			ClearToQuery();
			SetSearchSpec(&quot;Id&quot;, TNRId);
			ExecuteQuery(ForwardOnly);
			if(FirstRecord())
			{
				//SetFieldValue(&quot;MSISDN&quot;, MSISDN);
				/*
				*Subramanian - 3rd Sep,2015
				*PKE20927: MSISDN not updated on Prev Next scenario for Port In case. 
				*/
				SetFieldValue(&quot;MSISDN&quot;, MSISDN);
				if (PretoPost == &quot;PortIn&quot;)
				{
					SetFieldValue(&quot;AccountReferenceNumber&quot;, AccNum);
					SetFieldValue(&quot;CustomerDOB&quot;, DOB);
				}
				WriteRecord();
				
				try
				{
					InvokeMethod(&quot;Validate&quot;);
				}
				catch(e)
				{
					strErrorMsg = e.toString();
				}
				
				sStatus = GetFieldValue(&quot;Status&quot;);
				sStatusMsg = GetFieldValue(&quot;Status Message&quot;);
				sOpenClose = GetFieldValue(&quot;Status Summary&quot;);
				// Throw status msg
				if(sOpenClose == &quot;Open&quot;)
				{
					ActivateField(&quot;Allocate Prod Group Type&quot;);
					ActivateField(&quot;Status&quot;);
					SetFieldValue(&quot;Status&quot;, TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_TRANSFER_STATUS&quot;, &quot;Configure Subscription&quot;));
					SetFieldValue(&quot;Allocate Prod Group Type&quot;, TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_MSISDN_GROUP&quot;, &quot;General&quot;));
					WriteRecord();
				}
				else
				{
					/*if (strSessionType == TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_WIZARD_SESSION_TYPE&quot;, &quot;New Connection&quot;));
					{ */
					strErrorMsg = &quot;The MSISDN is not currently available to be ported in. Please refer to the Transfer Number Request for further details&quot;;
					//}
				}
			}
		}
		return(strErrorMsg);
	}
	catch(e)
	{
		throw e;
	}
	finally
	{
		oTNRBC = null;
		oTNRBO = null;
	}
}"
			   SEQUENCE="130"
			   UPDATED="01/09/2026 15:43:16"
			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 15:43:16"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="UpsertFulfilmentItems"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function UpsertFulfilmentItems(psInputs)
{
	try
	{
		//var psInputs = TheApplication().NewPropertySet();
		var psOutputs = TheApplication().NewPropertySet();
		//Inputs.SetType(&quot;ListOfVF Task Fulfilment Items&quot;);
		psInputs.SetProperty(&quot;IntObjectName&quot;, &quot;VF Task Fulfilment Items&quot;);
		//psInputs.AddChild(Inputs);
		TheApplication().GetService(&quot;EAI Integration Object to XML Hierarchy Converter&quot;).InvokeMethod(&quot;PSHierToIntObjHier&quot;, psInputs, psOutputs);
		psInputs.Reset();
		TheApplication().GetService(&quot;EAI Siebel Adapter&quot;).InvokeMethod(&quot;Upsert&quot;, psOutputs, psInputs);
	}
	catch(e)
	{
		throw e;
	}
	finally
	{
		psInputs = null;
		psOutputs = null;
	}
}"
