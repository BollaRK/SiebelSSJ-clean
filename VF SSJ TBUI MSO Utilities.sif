			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mDeleteEquipment"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mDeleteEquipment(Inputs)
{
	try
	{
		var OrderId = Inputs.GetProperty(&quot;OrderId&quot;);
		var AccountId = Inputs.GetProperty(&quot;AccountId&quot;);
		var AssetId = Inputs.GetProperty(&quot;AssetId&quot;);
		var LineId = Inputs.GetProperty(&quot;OrderLineId&quot;);
		var OrderType = Inputs.GetProperty(&quot;OrderType&quot;);
		var isRecord;
		
		var oEqAccntBO = TheApplication().GetBusObject(&quot;VHA Equipment Account&quot;);
		var oEqAccntBC = oEqAccntBO.GetBusComp(&quot;VHA Equipment Account&quot;);
		var sDeviceEquipmentType = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_EQUIPMENT_TYPE&quot;,&quot;Device Equipment Limit&quot;);//Vinodhini-29/06/2019-Added for MHI
		
		var sBillingMPP = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;PRODUCT_TYPE&quot;,&quot;Billing - MPP&quot;);
		var sBillingGPP = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;PRODUCT_TYPE&quot;,&quot;Billing - GPP&quot;);
		
		if(AccountId !=&quot;&quot; &amp;&amp; AssetId!=&quot;&quot;)
		{
			if(OrderType == &quot;Decon/Con Transfer FROM&quot;)
			{
				var sLineBC = TheApplication().GetBusObject(&quot;Order Entry - Thin MSO&quot;).GetBusComp(&quot;VF Order Line Items - Thin&quot;);
				var sSearchStr = &quot;([Product Type] = &apos;&quot;+sBillingMPP+&quot;&apos; OR [Product Type] = &apos;&quot;+sBillingGPP+&quot;&apos;) AND [Root Order Item Id] = &apos;&quot;+LineId+&quot;&apos; AND [VHA Waive Charges] = &apos;N&apos;&quot;;
				
				with (sLineBC)
				{
					 ClearToQuery();
					 SetViewMode(AllView);
					 ActivateField(&quot;Asset Integration Id&quot;);
					 ActivateField(&quot;Product Type&quot;);
					 //SetSearchSpec(&quot;Root Order Item Id&quot;, LineId);
					 //SetSearchSpec(&quot;VHA Waive Charges&quot;, &quot;N&quot;);
					 SetSearchExpr(sSearchStr);
					 ExecuteQuery(ForwardBackward);
					 var isrec = FirstRecord();
					 
					 while(isrec)
				 	 {	
				 	 
				 	 if(GetFieldValue(&quot;Product Type&quot;) == sBillingMPP)
						var sSearchStr = &quot;[Account Id]=&apos;&quot;+AccountId+&quot;&apos; AND [Asset Id]=&apos;&quot;+AssetId+&quot;&apos; AND [Type]=&apos;Equipment Limit&apos;&quot;;
					 else
						var sSearchStr = &quot;[Account Id]=&apos;&quot;+AccountId+&quot;&apos; AND [Asset Id]=&apos;&quot;+AssetId+&quot;&apos; AND [Type]=&apos;&quot;+sDeviceEquipmentType+&quot;&apos; AND [Asset Integeration Id] = &apos;&quot;+GetFieldValue(&quot;Asset Integration Id&quot;)+&quot;&apos;&quot;;
					  
					  	mDeleteRecord(oEqAccntBC,sSearchStr);
					  	isrec = NextRecord();
					 }
				 }
			}
			else
			{
				var iCount=0;
				
				oEqAccntBC.ActivateField(&quot;Account Id&quot;);
				oEqAccntBC.ActivateField(&quot;Asset Id&quot;);
				oEqAccntBC.ClearToQuery();
				oEqAccntBC.SetSearchSpec(&quot;Account Id&quot;,AccountId);
				oEqAccntBC.SetSearchSpec(&quot;Asset Id&quot;,AssetId);
				oEqAccntBC.ExecuteQuery();
				isRecord = oEqAccntBC.FirstRecord();
				while(isRecord)
				{
					oEqAccntBC.DeleteRecord();
					isRecord=oEqAccntBC.FirstRecord();
				}
			}
		}
	}
	
	catch(e)
	{
		throw e;
	}
	finally
	{
		//sLineBC = null;  /* This variable is nullified by Sharukh on 18/03/2019*/
		if(defined(sLineBC)) { sLineBC = null; }/*This variable is nullified by GURUPRASAD on 03/10/2019*/
		oEqAccntBC	= null;
		oEqAccntBO = null;
		

	}
}"
			   SEQUENCE="61"
