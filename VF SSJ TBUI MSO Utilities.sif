			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="AddDeviceSiebelOnlyProducts"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function AddDeviceSiebelOnlyProducts()
{
	try
	{
		var bsEAIService = TheApplication().GetService(&quot;EAI Siebel Adapter&quot;);
		var psInputs = TheApplication().NewPropertySet();
		var psOutputs = TheApplication().NewPropertySet();
		var Inputs = TheApplication().NewPropertySet();
		psInputs.SetProperty(&quot;SearchSpec&quot;,&quot;[VF Order Task Item Primary Product.Order Header Id] = &apos;&quot; + sOrderId + &quot;&apos;&quot;);
		psInputs.SetProperty(&quot;OutputIntObjectName&quot;, &quot;VF Order Task Item Primary Product&quot;);
		var iNoOfServices=0;
		var sStockInd = &quot;&quot;;
		var boHM, bcHMVer, bcHM;
	
		
		var strDeviceName, strRCCIncGST, strRRPIncGST, strRCCExcGST, strRRPExcGST, strHMRowId, sErrMessage = &quot;&quot;, strSearch, bContinue;
		var strProductCode = &quot;&quot;, strNewRatePlan = &quot;&quot;, strHandsetName = &quot;&quot;, strRootId = &quot;&quot;;
		var sProductName	  = &quot;Device-Siebel Only&quot;;
		var psProductAttributes = TheApplication().NewPropertySet();
		var psProductDetails    = TheApplication().NewPropertySet();
		
		boHM = TheApplication().GetBusObject( &quot;VF Handset Matrix&quot; );
		bcHMVer = boHM.GetBusComp( &quot;VF Handset Matrix Version&quot; );
		bcHM = boHM.GetBusComp( &quot;VF Handset Matrix&quot; );
		
		var sConnectNow = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_ORDER_STOCK_INDICATOR&quot;,&quot;Out of Stock - Connect Now&quot;);
		var sConnectLater = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_ORDER_STOCK_INDICATOR&quot;,&quot;Out of Stock - Connect Later&quot;);
		
		bsEAIService.InvokeMethod(&quot;Query&quot;, psInputs, psOutputs);
		psInputs.Reset();
		psInputs = psOutputs.GetChild(0).GetChild(0).Copy();
		iNoOfServices = psInputs.GetChildCount();

		for (var i=0;i &lt; iNoOfServices; i++)
		{
			sStockInd = psInputs.GetChild(i).GetProperty(&quot;VF Stock Indicator TBUI&quot;);
			if (sStockInd == sConnectNow || sStockInd == sConnectLater)
			{
				Inputs.Reset();
				
				strDeviceName		  = &quot;&quot;;
				strRCCIncGST		  = &quot;&quot;;
				strRRPIncGST		  = &quot;&quot;;
				strRCCExcGST		  = &quot;&quot;;
				strRRPExcGST		  = &quot;&quot;;
				strHMRowId			  = &quot;&quot;;
				//sErrMessage			  = &quot;&quot;;
				
				strSearch = &quot;&quot;;
				bContinue = false;
				
				strProductCode = psInputs.GetChild(i).GetProperty(&quot;VF Handset Code TBUI&quot;);
				strNewRatePlan = psInputs.GetChild(i).GetProperty(&quot;Product&quot;);
				strHandsetName = psInputs.GetChild(i).GetProperty(&quot;VF Device TBUI&quot;);
				strRootId = psInputs.GetChild(i).GetProperty(&quot;Root Order Item Id&quot;);
				
				if(strProductCode != &quot;&quot;)
				{
					bcHMVer.ClearToQuery();
					bcHM.ActivateField(&quot;Device Name&quot;);
					bcHM.ActivateField(&quot;Recommended Customer Contribution&quot;);
					bcHM.ActivateField(&quot;RRP&quot;);
					bcHM.ActivateField(&quot;RCC Exc GST&quot;);
					bcHM.ActivateField(&quot;RRP Exc GST&quot;);
					bcHM.ActivateField(&quot;Product Code&quot;);
					bcHM.ActivateField(&quot;Plan Name&quot;);
					bcHM.ActivateField(&quot;Id&quot;);
					bcHMVer.SetSearchSpec(&quot;Version Status&quot;, &quot;Live&quot;);
					bcHM.SetSearchSpec(&quot;Product Code&quot;, strProductCode);
					bcHM.SetSearchSpec(&quot;Plan Name&quot;, strNewRatePlan);
					bcHMVer.SetViewMode(AllView);
					bcHMVer.ExecuteQuery();
					
					if (bcHM.FirstRecord())
					{
					
						//3.Get Field Value of Device Name, RCC(inc and Exc GST), RRP (inc and exc GST). 
						strHMRowId	  = bcHM.GetFieldValue( &quot;Id&quot; );
						strDeviceName = bcHM.GetFieldValue( &quot;Device Name&quot; );
						strRCCIncGST = bcHM.GetFieldValue( &quot;Recommended Customer Contribution&quot; );
						strRRPIncGST = bcHM.GetFieldValue( &quot;RRP&quot; );
						strRCCExcGST = bcHM.GetFieldValue( &quot;RCC Exc GST&quot; );
						strRRPExcGST = bcHM.GetFieldValue( &quot;RRP Exc GST&quot; );
						
						//get Device Name, RCC(inc and Exc GST), RRP (inc and exc GST) etc in a property set		
		
						psProductAttributes.SetProperty(&quot;Device Code&quot;,strProductCode);	
						psProductAttributes.SetProperty(&quot;Device Name&quot;,strDeviceName);
						psProductAttributes.SetProperty(&quot;Device RCC Inc GST&quot;,strRCCIncGST);
						psProductAttributes.SetProperty(&quot;Device Price Inc GST&quot;, strRRPIncGST);
						psProductAttributes.SetProperty(&quot;Device RCC Exc GST&quot;,strRCCExcGST);
						psProductAttributes.SetProperty(&quot;Device Price Exc GST&quot;,strRRPExcGST);			
	
		   	  			Inputs.SetProperty(&quot;PropositionName&quot;,psInputs.GetChild(i).GetProperty(&quot;Parent Product&quot;));
						Inputs.SetProperty(&quot;ProductName&quot;, sProductName);
						Inputs.AddChild(psProductAttributes);
			
						//4. Get Port ID details on a different property set..Pass the port ID details to add the new line item	
						mGetPortIdsOnClass(Inputs,psProductDetails);						
						mWriteProductLineItem(sOrderId,strRootId,psProductDetails);
						//Subramanian 7.11.2014: Resetting both psProductDetails and psProductAttributes as it was taking same device and writing it for multiple out of stocks. QC#3406
						psProductDetails.Reset();
						psProductAttributes.Reset();
					}
					else
					{
						// Note : This error code is bypassed in Wizard Utilities BS method :mUpdateSessionDetails
						sErrMessage = &quot;Line Number: &quot; + psInputs.GetChild(i).GetProperty(&quot;VF Line Number&quot;) + &quot; - VFErr#9900990 :The Handset &apos;&quot; + strHandsetName + &quot;&apos; is not offered along with the rate plan: &apos;&quot; 
						+ strNewRatePlan + &quot;&apos;.Please reselect Plan.\r\n&quot;;
						//Sets Error message in the Wizard Session
					}

				}//if(strProductCode != &quot;&quot;)
			}//if (sStockInd == sConnectNow || sStockInd == sConnectLater)
		}//for (i=0;i &lt; iNoOfServices; i++)
		return(sErrMessage);
	}
	catch(e)
	{
		throw e;
	}
	finally
	{
		psInputs = null;
		psOutputs = null;
		bsEAIService = null;
		psProductAttributes = null;
		psProductDetails = null;
		Inputs = null;
		bcHMVer = null;
		bcHM = null;
		boHM = null;
	}
}"
			   SEQUENCE="2"
			   UPDATED="01/09/2026 15:43:15"
			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 15:43:15"
