			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fnQueryLOVCheckResp"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function fnQueryLOVCheckResp(Inputs,Outputs)
{
	try
	{	    	
		var Type = Inputs.GetProperty(&quot;Type&quot;);
		var Value = Inputs.GetProperty(&quot;Value&quot;);
		var Name = &quot;&quot;;
		var boLOV = TheApplication().GetBusObject(&quot;List Of Values&quot;);
		var bcLOV = boLOV.GetBusComp(&quot;List Of Values&quot;);
		with(bcLOV)
		{
			ClearToQuery();
			SetViewMode(AllView);
			ActivateField(&quot;Type&quot;);
			ActivateField(&quot;Value&quot;);			
			ActivateField(&quot;Name&quot;);
			ActivateField(&quot;Description&quot;);
			SetSearchSpec(&quot;Type&quot;,Type);	
			SetSearchSpec(&quot;Value&quot;,Value);
			ExecuteQuery(ForwardOnly);
			if(FirstRecord())
			{
				Name = GetFieldValue(&quot;Name&quot;);
			}
		}//with bcLOV
		
		var bsRespCheck = TheApplication().GetService(&quot;VF Check Responsibilities&quot;);
		
		var psInputs = TheApplication().NewPropertySet();
		var psOutputs = TheApplication().NewPropertySet();
	
		psInputs.SetProperty(&quot;Responsibility&quot;, Name);
		
		bsRespCheck.InvokeMethod(&quot;Check Responsibilities&quot;, psInputs, psOutputs);
		
		Outputs.SetProperty(&quot;RespExists&quot;,psOutputs.GetProperty(&quot;Exists&quot;));
	}

	catch (e)
	{
		throw (e);
	}

	finally
	{
		bcLOV = boLOV = null;
	}
}"
			   SEQUENCE="22"
			   UPDATED="01/09/2026 15:43:17"
			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 15:43:17"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fnStartEndDt"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	=======================================================
 * 05/08/2016   Subramanian K			Taken from Product Modelling service to calculate start end date for MPP contract
 */
function fnStartEndDt(sFirstSubmitDt,psInputs1,psOutputs1)
{
	try
	{
		var dStartDate = new Date(sFirstSubmitDt);
		var sStartDayDate = ToString(dStartDate.getDate());
		var sStartMonthDate = ToString(dStartDate.getMonth() + 1);
		if (sStartDayDate.length == 1)
		{
			sStartDayDate = &quot;0&quot; + sStartDayDate;
		};
		if (sStartMonthDate.length == 1)
		{
			sStartMonthDate = &quot;0&quot; + sStartMonthDate;
		};
		var sStartDateObj = sStartDayDate + &quot;/&quot; + sStartMonthDate + &quot;/&quot; + dStartDate.getFullYear();
		
		var	dDueDate = mAddWeekDaysToCurrentDate(mGetSystemPreferences(&quot;VF MPP Clawback Week Days&quot;),sFirstSubmitDt);
		var sDueDayDate = ToString(dDueDate.getDate());
		var sDueMonthDate = ToString(dDueDate.getMonth() + 1);
		if (sDueDayDate.length == 1)
		{
			sDueDayDate = &quot;0&quot; + sDueDayDate;
		};
		if (sDueMonthDate.length == 1)
		{
			sDueMonthDate = &quot;0&quot; + sDueMonthDate;
		};
		var sDueDateObj = sDueDayDate + &quot;/&quot; + sDueMonthDate + &quot;/&quot; + dDueDate.getFullYear();
		
		psOutputs1.SetProperty(&quot;Start Date&quot;,sStartDateObj);
		psOutputs1.SetProperty(&quot;End Date&quot;,sDueDateObj);
		
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
	} 	
}"
			   SEQUENCE="23"
