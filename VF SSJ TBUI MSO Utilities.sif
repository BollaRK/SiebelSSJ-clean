			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCheckSIMAdded"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCheckSIMAdded(Inputs, Outputs)
{
    var boOrder = TheApplication().GetBusObject(&quot;Order Entry&quot;);
    var bcOrder = boOrder.GetBusComp(&quot;Order Entry - Orders&quot;);
    var bcOrderLI = boOrder.GetBusComp(&quot;Order Entry - Line Items (Simple)&quot;);
    var sOId = Inputs.GetProperty(&quot;Order Id&quot;);
    var sSIMfound = &quot;Y&quot;;
	var iCount = 0;
    try {
        if (sOId != &quot;&quot; &amp;&amp; sOId != null) {
            bcOrder.ClearToQuery();
            bcOrderLI.ClearToQuery();
            bcOrder.SetViewMode(AllView);
            bcOrderLI.SetViewMode(AllView);
            bcOrder.SetSearchSpec(&quot;Id&quot;, sOId);
            bcOrderLI.SetSearchSpec(&quot;Parent Order Item Id&quot;, &quot;IS NULL&quot;);
            bcOrder.ExecuteQuery(ForwardOnly);
            bcOrderLI.ExecuteQuery(ForwardOnly);

            if (bcOrder.FirstRecord() &amp;&amp; bcOrderLI.FirstRecord()) {
                var srec = bcOrderLI.FirstRecord();
                while (srec) {
                    var sItemId = bcOrderLI.GetFieldValue(&quot;Id&quot;);
                    var sbcXA = boOrder.GetBusComp(&quot;Order Item XA (No Link)&quot;);
                    with(sbcXA) {
                        ClearToQuery();
                        SetViewMode(AllView);
                        SetSearchSpec(&quot;Order Item Root Id&quot;, sItemId);
                        SetSearchSpec(&quot;Name&quot;, &quot;Accessory Name&quot;);
                        SetSearchSpec(&quot;Text Value&quot;, &quot;SIM&quot;);
                        ExecuteQuery(ForwardOnly);
                        iCount = CountRecords();
                        if (iCount == 0)
                            sSIMfound = &quot;N&quot;;
                    }
                    srec = bcOrderLI.NextRecord();
                }
            }
        }

        Outputs.SetProperty(&quot;SIMFound&quot;, sSIMfound);

    } catch (e) {
        throw (e);
    } finally {
        bcOrderLI = null;
        bcOrder = null;
        boOrder = null;
    }
}
"
