			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCreateConnectFOAttribs"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/* Component Name        : 	mCreateFulfilmentOrderHeader
* Component Information : 	TBUI - Connect Order Flow: To add Attributes under the Fulfilment Order Line Items
*
* Modification History  :
* Date			Author		Config #	Description
* ============ ===========	===========	================================
* 26/10/2015	Thulsi 		Initial Draft Version  
*/

function mCreateConnectFOAttribs(Inputs,Outputs)
{

try
{
	//******************************************
	//* Variable Declarations
	//******************************************
	var psOrderItem 		= TheApplication().NewPropertySet();	
	var psChildOrderItem 	= TheApplication().NewPropertySet();
	var psOutputs		 	= TheApplication().NewPropertySet();
	var boOrder, bcOrder, bcOrderLineItem, bcOrderFulItems,bcOrderAccessoryFulItems,bcOrderLineItemSimple,bcItemXA;
	//Added for Kogan Defect 138
	var sPropCode = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_FUL_ORD_PROP_CODE_DEFAULT&quot;,&quot;DefaultPropositionCode&quot;);
			
	psOutputs 			= Inputs.GetChild(0); 					
	psOrderItem 		= psOutputs.GetChild(0).GetChild(0).GetChild(0);  	
	var sConnectOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
	var isRecord;
	
	if (sConnectOrderId.legth == 0)
		return (CancelOperation);

	//******************************************
	//* 1) Add Attributes under Child Line Items
	//* 2) Add Attributes under Root Line Items
	//******************************************				
	
	for (var i=0; i&lt;psOrderItem.GetChildCount(); i++)
	{

		var sRootItemId = psOrderItem.GetChild(i).GetProperty(&quot;Related Service order Id&quot;);
		
		boOrder 			= TheApplication().GetBusObject(&quot;VF Order Simple - eUpgrades&quot;);
		bcOrder 			= boOrder.GetBusComp(&quot;Order Entry - Orders&quot;); 
		bcOrderLineItem 	= boOrder.GetBusComp(&quot;VF Order Entry - Line Items (Simple) - eUpgrades&quot;); 
		bcOrderLineItemSimple 	= boOrder.GetBusComp(&quot;Order Entry - Line Items (Simple)&quot;);
		bcOrderFulItems 	= boOrder.GetBusComp(&quot;VF Fulfilment Items&quot;);
		bcOrderAccessoryFulItems = boOrder.GetBusComp(&quot;VHA Accessory Items&quot;);
		bcItemXA = boOrder.GetBusComp(&quot;VF Order Item XA&quot;);
		
		//Added if condition for Kogan Defect 138
		if (sConnectOrderId != &quot;&quot; &amp;&amp; sConnectOrderId != null &amp;&amp; sConnectOrderId != &quot;undefined&quot;)
		{
			with(bcOrder) 
			{
				ClearToQuery();
				SetViewMode(AllView);
				SetSearchSpec(&quot;Id&quot;, sConnectOrderId); 
				ExecuteQuery(ForwardOnly)
			}
		}
		//Added if condition for Kogan Defect 138
		if(sRootItemId != &quot;&quot; &amp;&amp; sRootItemId != null &amp;&amp; sRootItemId != &quot;undefined&quot;)
		{
			//Attributes query Added for Kogan defect 138
			with (bcItemXA)
			{
				SetViewMode(AllView);			 	 		 	
				ActivateField(&quot;Order Id&quot;);
				ActivateField(&quot;Object Id&quot;);
				ActivateField(&quot;Name&quot;);
				ActivateField(&quot;Text Value&quot;);
				ClearToQuery();
				var sSearchExpr = &quot;[Object Id] = &apos;&quot; + sRootItemId + &quot;&apos; AND [Name] = &apos;Proposition Code&apos;&quot;;
				SetSearchExpr(sSearchExpr);
				ExecuteQuery(ForwardOnly);			
				if (FirstRecord())
				{	
					sPropCode = GetFieldValue(&quot;Text Value&quot;);
				} 		
			}
			with (bcOrderLineItem)
			{
				SetViewMode(AllView);			 	 		 	
				ActivateField(&quot;Product&quot;);
				ActivateField(&quot;VF Root Siebel Prod Type&quot;);
				ClearToQuery();
				var sSearchExpr = &quot;[Root Order Item Id] = &apos;&quot; + sRootItemId + &quot;&apos; AND [Primary Product Flag] = &apos;Y&apos;&quot;;
				SetSearchExpr(sSearchExpr);
				ExecuteQuery(ForwardOnly);			
			}				
			with (bcOrderFulItems)
			{
				SetViewMode(AllView);			 	 		 	
				//ActivateField(&quot;VF Line Item Id&quot;);
				ClearToQuery();
				SetSearchSpec(&quot;VF Line Item Id&quot;, sRootItemId);
				ExecuteQuery(ForwardOnly);
				var iRecord = FirstRecord();  		
			}
			
		}
		
		//******************************************
		//* Set Child Line Items Attributes
		//******************************************				
		
		while(iRecord)
		{
			var sItemType = bcOrderFulItems.GetFieldValue(&quot;Item Type&quot;);		
			var psListOfAttributes 	= TheApplication().NewPropertySet();
			psListOfAttributes.SetType(&quot;ListOfOrderItemXa&quot;);
			
			if (sItemType == &quot;Hardware&quot;)
			{
				psChildOrderItem = psOrderItem.GetChild(i).GetChild(0);
				for (var j=0; j&lt;=psChildOrderItem.GetChildCount(); j++)
				{
					if (psChildOrderItem.GetChild(j).GetChildCount() == 0 &amp;&amp; psChildOrderItem.GetChild(j).GetProperty(&quot;Product&quot;) == &quot;Device&quot;)
					{
						mAddAttribs(&quot;Device&quot;, psListOfAttributes, bcOrderFulItems,&quot;&quot;);							
						break;
					}
				}				
				psChildOrderItem.GetChild(j).AddChild(psListOfAttributes);									
			}
			else if (sItemType == &quot;Accessory&quot;)
			{
				psChildOrderItem = psOrderItem.GetChild(i).GetChild(0);
				for (var j=0; j&lt;psChildOrderItem.GetChildCount(); j++)
				{
					if (psChildOrderItem.GetChild(j).GetChildCount() == 0 &amp;&amp; psChildOrderItem.GetChild(j).GetProperty(&quot;Product&quot;) == &quot;Accessory Item&quot;)
					{
						mAddAttribs(&quot;Accessory&quot;, psListOfAttributes, bcOrderFulItems,&quot;&quot;);							
						break;						
					}
				}
				psChildOrderItem.GetChild(j).AddChild(psListOfAttributes);	
			}
			iRecord = bcOrderFulItems.NextRecord();			
		}		
		//Query Acessory Line Item - Chitra Added for 16.3 Fulfilment APP attributes addition 21-4-2016
		with(bcOrder) 
		{
			ClearToQuery();
			SetViewMode(AllView);
			SetSearchSpec(&quot;Id&quot;, sConnectOrderId); 
			ExecuteQuery(ForwardOnly)
		}
		with (bcOrderLineItemSimple)
		{
			SetViewMode(AllView);			 	 		 	
			ActivateField(&quot;Product&quot;);
			ClearToQuery();
			var sSearchExpr = &quot;[Root Order Item Id] = &apos;&quot; + sRootItemId + &quot;&apos; AND [Parent Order Item Id] IS NULL&quot;;
			SetSearchExpr(sSearchExpr);
			ExecuteQuery(ForwardOnly);
					
		}
		with (bcOrderAccessoryFulItems)
		{
			SetViewMode(AllView);			 	 		 	
			ActivateField(&quot;Related Service Order Id&quot;);
			ActivateField(&quot;Hardware Code&quot;);
			ActivateField(&quot;VHA Hardware Name&quot;);
			ActivateField(&quot;VHA RRP Exc GST&quot;);
			ActivateField(&quot;VHA RRP inc GST&quot;);
			ActivateField(&quot;Order Number&quot;);
			ActivateField(&quot;VHA Category&quot;); //ATOM: Balaji:To include in Accessory attribute
			ClearToQuery();
			SetSearchSpec(&quot;Related Service Order Id&quot;, sRootItemId);
			SetSearchSpec(&quot;VHA App Stock Indicator&quot;, &quot;Out of Stock&quot;);
			ExecuteQuery(ForwardOnly);
			isRecord = FirstRecord(); 
					
		}
		//Set Accessory Child Line Items Attributes - Chitra Added for 16.3 Fulfilment APP attributes addition 21-4-2016
		while(isRecord)
		{
			
			var psListOfAttributes 	= TheApplication().NewPropertySet();
			psListOfAttributes.SetType(&quot;ListOfOrderItemXa&quot;);
			psChildOrderItem = psOrderItem.GetChild(i).GetChild(0);
			
				for (var j=0; j&lt;psChildOrderItem.GetChildCount(); j++)
				{
					if (psChildOrderItem.GetChild(j).GetChildCount() == 0 &amp;&amp; psChildOrderItem.GetChild(j).GetProperty(&quot;Product&quot;) == &quot;Accessory&quot;)
					{
						mAddAttribs(&quot;APPAccessory&quot;, psListOfAttributes, bcOrderAccessoryFulItems,&quot;&quot;);							
						break;
					}
				}				
				psChildOrderItem.GetChild(j).AddChild(psListOfAttributes);									
			
			
			isRecord = bcOrderAccessoryFulItems.NextRecord();			
		}
		
		//******************************************
		//* Set Root Line Item Attributes
		//******************************************
		var psListOfRootAttr = TheApplication().NewPropertySet();
		psListOfRootAttr.SetType(&quot;ListOfOrderHeaderItemXa&quot;);	
		mAddAttribs(&quot;Root&quot;, psListOfRootAttr, bcOrderLineItem,sPropCode);
		psOrderItem.GetChild(i).AddChild(psListOfRootAttr);				
	}
	Outputs.AddChild(psOutputs); 
}
catch(e)
{
	if (defined(e.errText))
	{
		var strError = e.errText + &quot;\r&quot; + e.toString(); 
	}
	else
	{
		var strError = e.toString(); 
	}
	throw (strError);
}
finally
{
	
	bcOrder = null; 
	bcOrderLineItem  = null;
	bcOrderFulItems  = null;
	bcItemXA = null;
	psOutputs = null;
	/*Below variables are nullified by Sharukh on 18/03/2019*/
	bcOrderLineItemSimple = null;
	bcOrderAccessoryFulItems = null;
	boOrder  = null; 
	psOrderItem = null;
	psChildOrderItem = null;
	psListOfAttributes = null;
	psListOfAttributes = null;
	psListOfRootAttr = null;

}		
}"
			   SEQUENCE="54"
			   UPDATED="01/09/2026 15:43:18"
			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 15:43:18"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCreateFulfilmentOrderHeader"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/* Component Name        : 	mCreateFulfilmentOrderHeader
* Component Information : 	This function is to Create Fulfilment Order Header for TBUI - Connect Order 
*
* Modification History  :
* Date			Author		Config #	Description
* ============ ===========	===========	================================
* 21/10/2015	Thulsi 		Initial Draft Version 
* 20/11/2015 	Roseline	Modified the code to fix the Ext Ref Id issue
* 02/04/2019	Christy					Added for Unified Application 
*/
		
function mCreateFulfilmentOrderHeader(bsOutputs)
{
	try
	{
   		//********************************************
   		//* Declare Variables
   		//********************************************	
		var sOrderSubType 	= &quot;Fulfilment&quot;;
   		var sOrderType    	= &quot;Sales Order&quot;;		
		var sWBIReasonCode	= &quot;Brightpoint&quot;;   
		var sOrderFunction	= &quot;Acquisition&quot;;
		var sOrdChannel 	= &quot;Telesales&quot;;		
		var sStockInd 		= TheApplication().GetProfileAttr(&quot;TBUIStockInd&quot;);
		//var sAppName 		= TheApplication().GetProfileAttr(&quot;ApplicationName&quot;);
		//02/04/2019: Christy :Modified for unified application
		var sAppName 		= TheApplication().GetProfileAttr(&quot;VHA User Type&quot;);
		var sOutStockLater	= TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_WIZ_CON_STOCK_INDICATOR&quot;, &quot;Out of Stock - Connect Later&quot;);
		var sOutStockNow	= TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_WIZ_CON_STOCK_INDICATOR&quot;, &quot;Out of Stock - Connect Now&quot;);
		var sOutStockType  = bsOutputs.GetProperty(&quot;FulfilmentType&quot;);
				
					
		//********************************************
   		//* Create Fulfilment Order Header
   		//********************************************	
		
	//	var boOrder = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);	
	// Shanmugam: Changed the BO to fix long running SQL issue for order creation.
	    var boOrder = TheApplication().GetBusObject(&quot;Order Entry - Simple&quot;);		
		var bcOrder = boOrder.GetBusComp(&quot;Order Entry - Orders&quot;);
		with (bcOrder)
		{
			NewRecord(NewBefore);
			SetFieldValue(&quot;Order Sub Type&quot;, 	sOrderSubType);
			SetFieldValue(&quot;Order Type&quot;, 		sOrderType);
			SetFieldValue(&quot;WBI Reason Code&quot;, 	sWBIReasonCode);  
			SetFieldValue(&quot;VF Order Function&quot;, 	sOrderFunction);		
			SetFieldValue(&quot;Service Account Id&quot;, sCustAccountId);
			SetFieldValue(&quot;Account Id&quot;, 		sCustAccountId);
			SetFieldValue(&quot;Billing Account Id&quot;,	gBillAccountId);
			SetFieldValue(&quot;VF Order Channel&quot;,	sOrdChannel);		
			WriteRecord();			
			var sFulfilOrderId = GetFieldValue(&quot;Id&quot;);
			var sFulfilOrderNum = GetFieldValue(&quot;Order Number&quot;);
			
			//02/04/2019: Christy :Modified for unified application
			//if(sAppName == &quot;Siebel Power Communications&quot;)
			if(sAppName == TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_USER_TYPE&quot;, &quot;Care&quot;))
			{
				ActivateField(&quot;VF External Reference Id&quot;);
				SetFieldValue(&quot;VF External Reference Id&quot;,sFulfilOrderNum);
				SetFieldValue(&quot;VF Out of Stock Indicator&quot;,&quot;In Stock&quot;);//Value for OLS &amp; CSR:&quot;In Stock&quot; and Dealer: &quot;Out of Stock - Connect Later&quot;
				WriteRecord();		
			}
			else
			{
				if (sStockInd == sOutStockNow)
				{
					SetFieldValue(&quot;VF Order Channel&quot;,&quot;instoreDF&quot;);
				}  
				else
				{
					SetFieldValue(&quot;VF Order Channel&quot;,&quot;CLinstore&quot;);
				}
				SetFieldValue(&quot;VF Out of Stock Indicator&quot;,sOutStockType);
				WriteRecord();
			}
		
		}
		
		//******************************
   		//* Update Parent Connect Order 
   		//******************************
		mUpdateConnectOrder(sFulfilOrderNum);
		
		return (sFulfilOrderId);
	}
	catch(e)
	{
		var sErrorMsg;
		if (defined(e.errText))
		{
			sErrorMsg = e.errText + &quot;\r&quot; + e.toString(); 
		}
		else
		{
			sErrorMsg = e.toString(); 
		}
		throw (sErrorMsg);
	} 
	finally
	{
		bcOrder = null;
		boOrder = null;
	}		
}"
			   SEQUENCE="55"
			   UPDATED="01/09/2026 15:43:18"
			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 15:43:18"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCreateUpgradeFOAttribs"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/* Component Name        : 	mCreateFulfilmentOrderHeader
* Component Information : 	TBUI - Upgrade Order Flow: To add Attributes under the Fulfilment Order Root Line Items
*
* Modification History  :
* Date			Author		Config #	Description
* ============ ===========	===========	================================
* 13/11/2015	Thulsi 		Initial Draft Version  
*/

function mCreateUpgradeFOAttribs(Inputs,Outputs)
{

try
{
	//******************************************
	//* Variable Declarations
	//******************************************
	var psOrderItem 		= TheApplication().NewPropertySet();		
	var psOutputs		 	= TheApplication().NewPropertySet();
	var boOrder, bcOrder, bcOrderLineItem,bcItemXA;
	//Added for Kogan Defect 138
	var sPropCode = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_FUL_ORD_PROP_CODE_DEFAULT&quot;,&quot;DefaultPropositionCode&quot;);
			
	psOutputs 			= Inputs.GetChild(0); 					
	psOrderItem 		= psOutputs.GetChild(0).GetChild(0).GetChild(0);  	
	var sUpgradeOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
	
	if (sUpgradeOrderId.legth == 0)
		return (CancelOperation);

	//******************************************	
	//* Add Attributes under Root Line Items
	//******************************************				
	
	for (var i=0; i&lt;psOrderItem.GetChildCount(); i++)
	{

		var sRootItemId = psOrderItem.GetChild(i).GetProperty(&quot;Related Service order Id&quot;);
		
		boOrder 			= TheApplication().GetBusObject(&quot;VF Order Simple - eUpgrades&quot;);
		bcOrder 			= boOrder.GetBusComp(&quot;Order Entry - Orders&quot;); 
		bcOrderLineItem 	= boOrder.GetBusComp(&quot;VF Order Entry - Line Items (Simple) - eUpgrades&quot;); 		
		bcItemXA = boOrder.GetBusComp(&quot;VF Order Item XA&quot;);
		//Added if condition for Kogan Defect 138
		if (sUpgradeOrderId != &quot;&quot; &amp;&amp; sUpgradeOrderId != null &amp;&amp; sUpgradeOrderId != &quot;undefined&quot;)
		{
			with(bcOrder) 
			{
				ClearToQuery();
				SetViewMode(AllView);
				SetSearchSpec(&quot;Id&quot;, sUpgradeOrderId); 
				ExecuteQuery(ForwardOnly)
			}
		}
		//Added if condition for Kogan Defect 138
		if (sRootItemId != &quot;&quot; &amp;&amp; sRootItemId != null &amp;&amp; sRootItemId != &quot;undefined&quot;)
		{
			//Added attribute query for Kogan Defect 138
			with (bcItemXA)
			{
				SetViewMode(AllView);			 	 		 	
				ActivateField(&quot;Object Id&quot;);
				ActivateField(&quot;Name&quot;);
				ActivateField(&quot;Text Value&quot;);
				ClearToQuery();
				var sSearchExpr = &quot;[Object Id] = &apos;&quot; + sRootItemId + &quot;&apos; AND [Name] = &apos;Proposition Code&apos;&quot;;
				SetSearchExpr(sSearchExpr);
				ExecuteQuery(ForwardOnly);			
				if (FirstRecord())
				{	
					sPropCode = GetFieldValue(&quot;Text Value&quot;);
				} 		
			}
			with (bcOrderLineItem)
			{
				SetViewMode(AllView);			 	 		 	
				ActivateField(&quot;Product&quot;);
				ActivateField(&quot;VF Root Siebel Prod Type&quot;);
				ClearToQuery();
				var sSearchExpr = &quot;[Root Order Item Id] = &apos;&quot; + sRootItemId + &quot;&apos; AND [Action Code] &lt;&gt;&apos;Delete&apos; AND [Primary Product Flag] = &apos;Y&apos;&quot;;
				SetSearchExpr(sSearchExpr);
				ExecuteQuery(ForwardOnly);			
			}
					
		}
		var psListOfRootAttr = TheApplication().NewPropertySet();
		psListOfRootAttr.SetType(&quot;ListOfOrderHeaderItemXa&quot;);	
		mAddAttribs(&quot;Root&quot;, psListOfRootAttr, bcOrderLineItem,sPropCode);
		psOrderItem.GetChild(i).AddChild(psListOfRootAttr);				
	}
	Outputs.AddChild(psOutputs); 
}
catch(e)
{
	if (defined(e.errText))
	{
		var strError = e.errText + &quot;\r&quot; + e.toString(); 
	}
	else
	{
		var strError = e.toString(); 
	}
	throw (strError);
}
finally
{
	
	bcOrder = null; 
	bcOrderLineItem  = null;
	bcItemXA = null;	
	boOrder  = null; 
	psOutputs = null;
	/*Below variables are nullified by Sharukh on 18/03/2019*/
	psOrderItem = null;
	psListOfRootAttr = null;

}		
}"
			   SEQUENCE="56"
			   UPDATED="01/09/2026 15:43:18"
			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 15:43:18"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mDecideScenario"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mDecideScenario(PortInType, LineItemType)
{
	if (LineItemType == &quot;Pre to Post transfer&quot;)
	{
		return(&quot;PretoPost&quot;)
	}
	else if (LineItemType == &quot;New Connection&quot; || LineItemType == &quot;NBN to 5G transfer&quot;)
	{
		if(TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_WIZ_MSISDN_SOURCE&quot;, &quot;New&quot;) == PortInType)
		{
			return(&quot;NewConnect&quot;);
		}
		else
		{
			return(&quot;PortIn&quot;);
		}
	}
	else
	{
		return(&quot;Other&quot;);
	}
}"
			   SEQUENCE="57"
			   UPDATED="01/09/2026 15:43:18"
			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 15:43:18"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mDeleteAccessory"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mDeleteAccessory(Inputs)
{
	try
	{
		var sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
		var boOrder = TheApplication().GetBusObject(&quot;Order Entry - Simple&quot;);
		var sBCOrder = boOrder.GetBusComp(&quot;Order Entry - Orders&quot;);
		var bcOrderLineIt = boOrder.GetBusComp(&quot;Order Entry - Line Items (Simple)&quot;);
		var sIncType = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_PROD_TYPE&quot;, &quot;SD Insurance&quot;);
		var sFreeIncType = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_PROD_TYPE&quot;, &quot;Free SD Insurance&quot;);
		var sSPIDType = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;PRODUCT_TYPE&quot;, &quot;Device Content Subscription&quot;);
		with(sBCOrder)
		{
			ClearToQuery();
			SetViewMode(AllView);
			SetSearchSpec(&quot;Id&quot;,sOrderId);
			ExecuteQuery(ForwardOnly);
			if(FirstRecord())
			{
				with(bcOrderLineIt)
				{
					ClearToQuery();
					SetViewMode(AllView);
					SetSearchExpr(&quot;[Order Header Id] = &apos;&quot;+ sOrderId+&quot;&apos; AND [Action Code] = &apos;Add&apos; AND ([Product] = &apos;Accessory&apos; OR [Product Type] = &apos;&quot;+sSPIDType+&quot;&apos; OR [VF Siebel Product Type] = &apos;&quot;+sIncType+&quot;&apos; OR [VF Siebel Product Type] = &apos;&quot;+sFreeIncType+&quot;&apos;)&quot;); // ATOM Project: Balaji: Included the &apos;Secondary Subscription SPID&apos; and Insurance product as well
					ExecuteQuery(ForwardOnly);
					while(FirstRecord())
					{		
						DeleteRecord();
					}
				}//end of with(bcOrderLineIt)
			}//end of if(FirstRecord())
		}// end of with(sBCOrder)
	}//end of try
	catch(e)
	{
		throw(e);
	}
	finally
	{
		sOrderId = null;
		bcOrderLineIt = null;
		sBCOrder = null;
		boOrder = null;
	}
}"
			   SEQUENCE="58"
			   UPDATED="01/09/2026 15:43:18"
			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 15:43:18"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
