			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mInsertAppleVoucher"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mInsertAppleVoucher(Inputs,sTerm,sVoucherAmount,sItemName,sServiceitemId,sAssetIntegrationId,OrderId,sCustAccountId,AccountType,sMSISDN)
{
	try
	{		
		
		var oEqAccntBO = TheApplication().GetBusObject(&quot;VHA Equipment Account&quot;);
		var oEqAccntBC = oEqAccntBO.GetBusComp(&quot;VHA Equipment Account&quot;);					
	
		var sArray =  sTerm.split(&quot; &quot;);
	
			with (oEqAccntBC)
			{
				ActivateField(&quot;Term&quot;);
				ActivateField(&quot;Account Id&quot;);
				ActivateField(&quot;Service Order Id&quot;);
				ActivateField(&quot;Order Id&quot;);
				ActivateField(&quot;RRP&quot;);
				ActivateField(&quot;Type&quot;);
				ActivateField(&quot;Asset Integeration Id&quot;);
				ActivateField(&quot;Prepayment Amount&quot;);
				ActivateField(&quot;Contract Start Date&quot;);
				ClearToQuery();
				SetViewMode(AllView);
				SetSearchSpec(&quot;Account Id&quot;, sCustAccountId);
				SetSearchSpec(&quot;Order Id&quot;,OrderId);
				SetSearchSpec(&quot;Service Order Id&quot;,sServiceitemId);
				SetSearchSpec(&quot;Type&quot;, &quot;Plan Equipment Limit&quot;); 
				SetSearchSpec(&quot;Asset Integeration Id&quot;, sAssetIntegrationId);								
				ExecuteQuery();
				if(!FirstRecord())
				{ 
					NewRecord(NewAfter);
					SetFieldValue(&quot;Type&quot;, &quot;Plan Equipment Limit&quot;);													
					SetFieldValue(&quot;Term&quot;,sArray[0]);
					SetFieldValue(&quot;Account Id&quot;, sCustAccountId);
					SetFieldValue(&quot;Order Id&quot;,OrderId);
					SetFieldValue(&quot;Service Order Id&quot;,sServiceitemId);
					SetFieldValue(&quot;RRP&quot;,sVoucherAmount);									
					SetFieldValue(&quot;Asset Id&quot;,sAssetIntegrationId);
					SetFieldValue(&quot;Asset Integeration Id&quot;,sAssetIntegrationId);
					SetFieldValue(&quot;Prepayment Amount&quot;,0);
					SetFieldValue(&quot;Item Name&quot;,sItemName);
					//SetFieldValue(&quot;MSISDN&quot;,sMSISDN);
					
					//SetFieldValue(&quot;Contract Start Date&quot;,scontr);									
					//SetFieldValue(&quot;Asset Id&quot;,sAssetId);			
				
					WriteRecord();
				}
			
		}
	}
	catch(e)
	{
	throw e;
	}
	finally
	{
		oEqAccntBC = null;
		oEqAccntBO = null;
	}
							
	}"
			   SEQUENCE="77"
			   UPDATED="01/09/2026 15:43:18"
			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 15:43:18"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mInsertEquipment"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mInsertEquipment(Inputs)
{
	try
	{
		var OrderId = Inputs.GetProperty(&quot;OrderId&quot;);
		sCustAccountId = Inputs.GetProperty(&quot;AccountId&quot;);
		var AccountType = Inputs.GetProperty(&quot;Account Type&quot;);
		var sEGWBusSubType = Inputs.GetProperty(&quot;EGWSubType&quot;);
		var strReqLimit = &quot;&quot;;//ADUTTA:Apple Fraud
		var psOut = TheApplication().NewPropertySet();
		var IsTOT = &quot;N&quot;;
		var AppleFraud = Inputs.GetProperty(&quot;AppleFraud&quot;);//ADUTTA:Apple Fraud
		var sOrderType = Inputs.GetProperty(&quot;OrderType&quot;);//ADUTTA:Apple Fraud
		var AppleLOV = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CR_ENABLE_FLAG&quot;,&quot;Apple Plan&quot;)
		var sEGWSwitch = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_EGW_INVOKE_LOGIC&quot;,&quot;EGWEquipCheck&quot;);//Added for EMS2560

		//Start:ADUTTA:Apple Voucher Fraud 
	     if(AppleLOV == &quot;Y&quot; &amp;&amp; AppleFraud == &quot;Y&quot;)
		 {
		if (sOrderType == &quot;Connect&quot;)
		IsTOT = mCheckTOT(OrderId);//ADUTTA:Apple Fraud
		
		
		if(sOrderType != &quot;Change Ownership Connect&quot; &amp;&amp; sOrderType != &quot;Reactivate&quot; &amp;&amp; IsTOT == &quot;N&quot;)
		{
		mCheckAppleVoucherAmount(Inputs,psOut,OrderId);
		var sItemName = psOut.GetProperty(&quot;ssItemName&quot;);							
		var sTerm = psOut.GetProperty(&quot;ssNewTerm&quot;);						
		var sServiceitemId = psOut.GetProperty(&quot;ssServiceitemId&quot;);							
		var sVoucherAmount = psOut.GetProperty(&quot;ssVoucherAmount&quot;);						
		var sAssetIntegrationId = psOut.GetProperty(&quot;ssAssetIntegrationId&quot;);
		var sMSISDN = psOut.GetProperty(&quot;MSISDN&quot;);
		var sNewMSISDN = psOut.GetProperty(&quot;NewMSISDN&quot;);
		if(sNewMSISDN != &quot;&quot;)
		sMSISDN = sNewMSISDN;
		strReqLimit = GetEquipmentLimit(Inputs,psOut,sCustAccountId);
		TheApplication().SetProfileAttr(&quot;Applefraud&quot;,sItemName + sTerm + sServiceitemId + sVoucherAmount + sAssetIntegrationId + sMSISDN + sNewMSISDN + strReqLimit);
		if(sVoucherAmount != &quot;&quot; &amp;&amp; sVoucherAmount &lt; strReqLimit)
		{
		  mInsertAppleVoucher(Inputs,sTerm,sVoucherAmount,sItemName,sServiceitemId,sAssetIntegrationId,OrderId,sCustAccountId,AccountType,sMSISDN);
		}
		}
		}
		//END:Apple Voucher Fraud
		
		
		var oEqAccntBO = TheApplication().GetBusObject(&quot;VHA Equipment Account&quot;);
		var oEqAccntBC = oEqAccntBO.GetBusComp(&quot;VHA Equipment Account&quot;);
		var iCount=0;
		var sItemName = &quot;&quot;;
		////[Nagesh][Account Structure Shared fins]
		if( AccountType == &quot;Person&quot; || AccountType == &quot;Sole Trader&quot; || (sEGWBusSubType == &quot;First&quot; &amp;&amp; sEGWSwitch ==&quot;EGWEquipCheck_Y&quot;))
		{
			Inputs.SetProperty(&quot;Step&quot;,&quot;Insert&quot;);
  			var sTotalRRP=mCalculateRRP(Inputs,psOut);
			//psOut = psOutputs.GetChild(0).GetChild(0).Copy();
			iCount = psOut.GetChildCount();

			for (var i=0;i &lt; iCount; i++)
			{
				// Sachi - 01-June-2019 - Added for R19.3 - MHI EL rec insert for GPP
				var oBO = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
				var oLineItemBC = oBO.GetBusComp(&quot;Order Entry - Line Items&quot;);
				var oLineXA = oBO.GetBusComp(&quot;Order Item XA (Simple)&quot;);					
				var sOrderItemId = psOut.GetChild(i).GetProperty(&quot;LineItemId&quot;);
				var sLineRecExist = &quot;&quot;;	
					
							
				if(sOrderItemId != &quot;&quot; &amp;&amp; sOrderItemId != null)
				{
					with(oLineItemBC)
					{
						ClearToQuery();
						ActivateField(&quot;Product Type&quot;);
						ActivateField(&quot;VF Siebel Product Type&quot;);
						ActivateField(&quot;Root Order Item Id&quot;);
						ActivateField(&quot;Action Code&quot;);
						ActivateField(&quot;Asset Integration Id&quot;);
						//SetSearchExpr(&quot;[Product Type] = &apos;Billing - GPP&apos; AND [VF Siebel Product Type] = &apos;Device&apos; And [Id] = &apos;&quot; +sOrderItemId+ &quot;&apos;&quot;);
						SetSearchSpec(&quot;Product Type&quot;, &quot;Billing - GPP&quot;);
						SetSearchSpec(&quot;VF Siebel Product Type&quot;, &quot;Device&quot;);
						SetSearchSpec(&quot;Root Order Item Id&quot;, sOrderItemId);
						SetSearchSpec(&quot;Asset Integration Id&quot;, psOut.GetChild(i).GetProperty(&quot;AssetIntegId&quot;));
						SetSearchSpec(&quot;Action Code&quot;, &quot;Add&quot;);
						ExecuteQuery(ForwardOnly);
						sLineRecExist = FirstRecord();
						if(sLineRecExist)
						{
						 var sGPPId = GetFieldValue(&quot;Id&quot;);
						 sItemName = &quot;&quot;;
							with(oLineXA)
							{	
									ClearToQuery();
									SetViewMode(AllView);
									ActivateField(&quot;Text Value&quot;);
									ActivateField(&quot;Name&quot;);
									ActivateField(&quot;Object Id&quot;);
									SetSearchSpec(&quot;Name&quot;,&quot;Item Name&quot;);
									SetSearchSpec(&quot;Object Id&quot;, sGPPId);
									ExecuteQuery(ForwardOnly);								
									if (FirstRecord())
										sItemName = GetFieldValue(&quot;Text Value&quot;);
							}
							with (oEqAccntBC)
							{
								ActivateField(&quot;Term&quot;);
								ActivateField(&quot;Account Id&quot;);
								ActivateField(&quot;Service Order Id&quot;);
								ActivateField(&quot;Order Id&quot;);
								ActivateField(&quot;RRP&quot;);
								ActivateField(&quot;Type&quot;);
								ActivateField(&quot;Asset Integeration Id&quot;);
								ActivateField(&quot;Item Name&quot;);
								ActivateField(&quot;Prepayment Amount&quot;);
								ClearToQuery();
								SetViewMode(AllView);
								SetSearchSpec(&quot;Account Id&quot;, sCustAccountId);
								SetSearchSpec(&quot;Order Id&quot;,psOut.GetChild(i).GetProperty(&quot;OrderId&quot;));
								SetSearchSpec(&quot;Service Order Id&quot;,psOut.GetChild(i).GetProperty(&quot;LineItemId&quot;));
								SetSearchSpec(&quot;Type&quot;, &quot;Device Equipment Limit&quot;); //Chitra Added for AOA2 - 29/04/2016
								SetSearchSpec(&quot;Asset Integeration Id&quot;,psOut.GetChild(i).GetProperty(&quot;AssetIntegId&quot;)); //Indumathi Added for ATOM Project - 22/06/2017
								ExecuteQuery();
								if((!FirstRecord()) &amp;&amp; (psOut.GetChild(i).GetProperty(&quot;Term&quot;) != 0)) //SureshG - Modified the condition for 19.3 Prepayments
								{
									NewRecord(NewAfter);
									//Thileepa : 31/07/18: Added for PKE000000057942
									if((psOut.GetChild(i).GetProperty(&quot;Term&quot;)==&quot;&quot; || psOut.GetChild(i).GetProperty(&quot;Term&quot;) == null) &amp;&amp; psOut.GetChild(i).GetProperty(&quot;PlanProdType&quot;)== TheApplication().InvokeMethod(&quot;LookUpValue&quot;,&quot;VF_PROD_TYPE&quot;,&quot;SIMO Plan&quot;))
										SetFieldValue(&quot;Term&quot;,&quot;1&quot;);
									else
										SetFieldValue(&quot;Term&quot;,psOut.GetChild(i).GetProperty(&quot;Term&quot;));
									SetFieldValue(&quot;Item Name&quot;,sItemName);
									SetFieldValue(&quot;Account Id&quot;, sCustAccountId);
									SetFieldValue(&quot;Order Id&quot;,psOut.GetChild(i).GetProperty(&quot;OrderId&quot;));
									SetFieldValue(&quot;Service Order Id&quot;,psOut.GetChild(i).GetProperty(&quot;LineItemId&quot;));
									SetFieldValue(&quot;RRP&quot;,psOut.GetChild(i).GetProperty(&quot;RRP&quot;));
									SetFieldValue(&quot;Type&quot;, &quot;Device Equipment Limit&quot;);
									if(psOut.GetChild(i).GetProperty(&quot;AssetIntegId&quot;) != &quot;&quot;)
										SetFieldValue(&quot;Asset Integeration Id&quot;, psOut.GetChild(i).GetProperty(&quot;AssetIntegId&quot;));
									else
										SetFieldValue(&quot;Asset Integeration Id&quot;, sGPPId);
									SetFieldValue(&quot;Prepayment Amount&quot;,psOut.GetChild(i).GetProperty(&quot;PrepaymentAmount&quot;));
									WriteRecord();
								}
							}
						} // Sachi - 01-June-2019 - Added for R19.3 - MHI EL rec insert for GPP
						else
						{
							with (oEqAccntBC)
							{
								ActivateField(&quot;Term&quot;);
								ActivateField(&quot;Account Id&quot;);
								ActivateField(&quot;Service Order Id&quot;);
								ActivateField(&quot;Order Id&quot;);
								ActivateField(&quot;RRP&quot;);
								ActivateField(&quot;Type&quot;);
								ActivateField(&quot;Asset Integeration Id&quot;);
								ActivateField(&quot;Prepayment Amount&quot;);
								ClearToQuery();
								SetViewMode(AllView);
								SetSearchSpec(&quot;Account Id&quot;, sCustAccountId);
								SetSearchSpec(&quot;Order Id&quot;,psOut.GetChild(i).GetProperty(&quot;OrderId&quot;));
								SetSearchSpec(&quot;Service Order Id&quot;,psOut.GetChild(i).GetProperty(&quot;LineItemId&quot;));
								SetSearchSpec(&quot;Type&quot;,psOut.GetChild(i).GetProperty(&quot;Type&quot;)); //Chitra Added for AOA2 - 29/04/2016
								SetSearchSpec(&quot;Asset Integeration Id&quot;,psOut.GetChild(i).GetProperty(&quot;AssetIntegId&quot;)); //Indumathi Added for ATOM Project - 22/06/2017
								ExecuteQuery();
								if((!FirstRecord()) &amp;&amp; (psOut.GetChild(i).GetProperty(&quot;Term&quot;) != 0))//SureshG - Modified the condition for 19.3 Prepayments
								{
									NewRecord(NewAfter);
									//Thileepa : 31/07/18: Added for PKE000000057942
									if((psOut.GetChild(i).GetProperty(&quot;Term&quot;)==&quot;&quot; || psOut.GetChild(i).GetProperty(&quot;Term&quot;) == null) &amp;&amp; psOut.GetChild(i).GetProperty(&quot;PlanProdType&quot;)== TheApplication().InvokeMethod(&quot;LookUpValue&quot;,&quot;VF_PROD_TYPE&quot;,&quot;SIMO Plan&quot;))
										SetFieldValue(&quot;Term&quot;,&quot;1&quot;);
									else
										SetFieldValue(&quot;Term&quot;,psOut.GetChild(i).GetProperty(&quot;Term&quot;));
									SetFieldValue(&quot;Account Id&quot;, sCustAccountId);
									SetFieldValue(&quot;Order Id&quot;,psOut.GetChild(i).GetProperty(&quot;OrderId&quot;));
									SetFieldValue(&quot;Service Order Id&quot;,psOut.GetChild(i).GetProperty(&quot;LineItemId&quot;));
									SetFieldValue(&quot;RRP&quot;,psOut.GetChild(i).GetProperty(&quot;RRP&quot;));
									SetFieldValue(&quot;Type&quot;,psOut.GetChild(i).GetProperty(&quot;Type&quot;));
									SetFieldValue(&quot;Asset Integeration Id&quot;,psOut.GetChild(i).GetProperty(&quot;AssetIntegId&quot;));
									SetFieldValue(&quot;Prepayment Amount&quot;,psOut.GetChild(i).GetProperty(&quot;PrepaymentAmount&quot;));
									WriteRecord();
								}
							}
						}
					}
				}			
				
			}
		}
	}
	
	catch(e)
	{
		throw e;
	}
	finally
	{
		oLineItemBC = null;
		oEqAccntBC	= null;
		oBO = null;
		oEqAccntBO = null;
		psOut = null;
	}
}"
