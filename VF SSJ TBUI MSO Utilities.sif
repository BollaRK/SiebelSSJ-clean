			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mMPPValidation"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mMPPValidation(&amp;Outputs) 
{
	/*
	* Component Name        : 	mMPPValidation
	* Method Name           : 	
	* Component Information : 	
	*
	* Modification History  :
	* Date			Author		Config #	Description
	* ============ ===========	===========	================================
	* 10/09/2014	Balaji					Initial version
	*/
	
	try 
	{
		var iNoOfServices = 0;
		var sLineItemId;
		var psCopyInputs = TheApplication().NewPropertySet();
		var sContractErr = &quot;&quot;;//Nithu added for 16.2 DAS 109
		sContractErr = mValidateContractMonths();
		if (sContractErr != &quot;&quot;)
		TheApplication().RaiseErrorText(sContractErr);
		var bsEAIService = TheApplication().GetService(&quot;EAI Siebel Adapter&quot;);
		var psLineInputs = TheApplication().NewPropertySet();
		var psLineOutputs = TheApplication().NewPropertySet();
		psLineInputs.SetProperty(&quot;SearchSpec&quot;, &quot;[VF MPP Order Smartscript Support - TBUI.Order Id] = &apos;&quot; + sOrderId + &quot;&apos;&quot;);
		psLineInputs.SetProperty(&quot;OutputIntObjectName&quot;, &quot;VF MPP Order Task Support&quot;);
		bsEAIService.InvokeMethod(&quot;Query&quot;, psLineInputs, psLineOutputs);
		Outputs.SetProperty(&quot;ErrorMessage&quot;, &quot;&quot;);
		psCopyInputs = psLineOutputs.GetChild(0).GetChild(0).Copy();
		iNoOfServices = psCopyInputs.GetChildCount();
		var sConnType = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_SERVICE_STOCK_TBUI&quot;, &quot;Plan and Device&quot;);
		var sPrepayInput = TheApplication().NewPropertySet();
		var sPrepayOutput = TheApplication().NewPropertySet();
		var vTotalRcc = 0;
         var sPrepayInput = TheApplication().NewPropertySet();
		var sPrepayOutput = TheApplication().NewPropertySet();
        var PPAmountpaidupfront = 0, TotalAccessoryUpfront = 0, TotalDeviceAmountPaidUpfront = 0;		
		if (iNoOfServices &lt; 1) 
		{
			TheApplication().RaiseErrorText(&quot;No Line Item added for this Order&quot;);
		}
		//Loop Line Item to Validate MPP
		for (var i = 0; i &lt; iNoOfServices; i++) 
		{
		 	
			var sConnectionType=&quot;&quot;, sLineNum=&quot;&quot;, strFulfillmentOrderId=&quot;&quot;, vfpMPPTot=&quot;&quot;, vCA=&quot;&quot;, vPreMPPAmt=&quot;&quot;, vRCC=&quot;&quot;, sAcceptCode=&quot;&quot;, vCompAmt=&quot;&quot;, ErrMsg =&quot;&quot;, vApprovedCLA=0;
			sLineItemId = psCopyInputs.GetChild(i).GetProperty(&quot;Order Item Id&quot;);
			sConnectionType = psCopyInputs.GetChild(i).GetProperty(&quot;Connection Type&quot;);
			var vRCC = psCopyInputs.GetChild(i).GetProperty(&quot;MPP RCC F&quot;);
			var vVFFlag = psCopyInputs.GetChild(i).GetProperty(&quot;MPP IMEI Flag&quot;);
			var vMPPActive = psCopyInputs.GetChild(i).GetProperty(&quot;MPP Active&quot;);
			
			
			//if (sConnectionType == sConnType) 
			if(ToNumber(vRCC) &gt; 0)
			{
				
				sLineNum = psCopyInputs.GetChild(i).GetProperty(&quot;VF Line Number&quot;);
				strFulfillmentOrderId = psCopyInputs.GetChild(i).GetProperty(&quot;Fullfilment Id&quot;);
				vfpMPPTot = psCopyInputs.GetChild(i).GetProperty(&quot;MPP Contract Amount Task Validation&quot;); // from finacial profile
				vCA = psCopyInputs.GetChild(i).GetProperty(&quot;MPP Contract Amount&quot;); // from MPP stage BC
				vPreMPPAmt = psCopyInputs.GetChild(i).GetProperty(&quot;MPP Previous Amount&quot;);
				vApprovedCLA = psCopyInputs.GetChild(i).GetProperty(&quot;Approved Credit Limit&quot;); // credit limit from financial profile
				//vRCC = psCopyInputs.GetChild(i).GetProperty(&quot;MPP RCC F&quot;);
				sAcceptCode = psCopyInputs.GetChild(i).GetProperty(&quot;Credit Check Accept Code&quot;);
				ToNumber(vCompAmt);
				vCompAmt = ToNumber(vfpMPPTot) + ToNumber(vCA) - ToNumber(vPreMPPAmt);				
				vTotalRcc = ToNumber(vRCC) + ToNumber(vTotalRcc); // Get total RCC amount for all line items
				//balajiM added for 19.3 4Jun2019 
                 mGetPrepayAmt(sOrderId, sPrepayOutput);
				PPAmountpaidupfront = sPrepayOutput.GetProperty(&quot;PPAmountpaidupfront&quot;);
				TotalAccessoryUpfront = sPrepayOutput.GetProperty(&quot;TotalAccessoryUpfront&quot;);
				TotalDeviceAmountPaidUpfront = sPrepayOutput.GetProperty(&quot;TotalDeviceAmountPaidUpfront&quot;);
                 //balajiM added for 19.3 4Jun2019 END
				if (sAcceptCode == &quot;&quot;) 
				{
					ErrMsg = &quot;Line Item Number#&quot; + sLineNum + &quot; :- Customer does not have an approved contract limit&quot;;
					Outputs.SetProperty(&quot;ErrorMessage&quot;, ErrMsg);
					break;
				} 
				//else if (ToNumber(vRCC) &gt; ToNumber(vApprovedCLA)) 
				else if (ToNumber(vCA) &gt; ToNumber(vApprovedCLA))//TARIQ-14JAN2015-Changed
				{
					ErrMsg = &quot;Line Item Number#&quot; + sLineNum + &quot; :- Contract amount cannot exceed approved contract limit&quot;;
					Outputs.SetProperty(&quot;ErrorMessage&quot;, ErrMsg);
					break;
				} 
				/*else if (ToNumber(vCompAmt) &gt; ToNumber(vApprovedCLA)) 
				{
					ErrMsg = &quot;Line Item Number#&quot; + sLineNum + &quot; :- &lt;Total MPP Amount&gt; cannot exceed the &lt;Approved MPP Limit&gt;&quot;;
					Outputs.SetProperty(&quot;ErrorMessage&quot;, ErrMsg);
					break;
				} */ //NEEL 19.01.2015 - Code Inactivated
				else if (ToNumber(vCA) &lt; 0) 
				{
					ErrMsg = &quot;Line Item Number#&quot; + sLineNum + &quot; :- The MPP Contract Amount cannot be less than &quot;;
					Outputs.SetProperty(&quot;ErrorMessage&quot;, ErrMsg);
					break;
				}
				else if(ToNumber(vTotalRcc) &gt; (ToNumber(vApprovedCLA) + ToNumber(TotalDeviceAmountPaidUpfront)))
				{ // Total RCC value of all lineitems should be less than or eqaul to approved credit limit in fiancial profile
					
					ErrMsg = &quot;Total RCC amount of all service cannot exceed the Approve Credit Limit&quot;;
					Outputs.SetProperty(&quot;ErrorMessage&quot;, ErrMsg);
					break;				
				}
			
			}
			else if(vMPPActive == &quot;Y&quot; &amp;&amp; vVFFlag == &quot;N&quot; &amp;&amp; vRCC == &quot;&quot;)
			{
				ErrMsg = &quot;This device has not yet been specified as a Vodafone device. The Recommended Customer Contribution will not be displayed and cannot be null. Please check the Handset Matrix for your store.&quot;;
				Outputs.SetProperty(&quot;ErrorMessage&quot;, ErrMsg);
				break;
			}
		}
	} 
	catch (e) 
	{
		throw e;
	}
	finally {
	bsEAIService = null;/*This variable is nullified by GURUPRASAD on 23/10/2019*/
	}
}"
