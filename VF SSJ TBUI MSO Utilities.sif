			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCheckDeleteVoucher"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCheckDeleteVoucher(Inputs,Outputs)
{
  try
  {
	var sLineId = Inputs.GetProperty(&quot;LineId&quot;);	

	var oOrderBO=TheApplication().GetBusObject(&quot;Order Item&quot;);
	//var oOrderBC=TheApplication().GetBusObject(&quot;Order Entry&quot;).GetBusComp(&quot;Order Entry - Orders&quot;);	
	var oLineBC = oOrderBO.GetBusComp(&quot;Order Entry - Line Items (Simple)&quot;);
	var oLineXA = oOrderBO.GetBusComp(&quot;Order Item XA (Simple)&quot;);	
								
	
	var sRootProductId;
	var irecord;
	var sProductId;
	var ssmproditemId;
	var sVouchrAmount;
	var ssamId=&quot;&quot;;
	var ssearchexpr=&quot;&quot;;			
	var PlanSamId = &quot;&quot;;
	var sProd = &quot;&quot;;		
	with (oLineBC)
	{
		ClearToQuery();
		ActivateField(&quot;Order Id&quot;);
		ActivateField(&quot;Action Code&quot;);
		ActivateField(&quot;Asset Integration Id&quot;);
		ActivateField(&quot;Root Product Id&quot;);
		ActivateField(&quot;Root Order Item Id&quot;);
		ActivateField(&quot;Root Asset Integration Id&quot;);
		ActivateField(&quot;Primary Product Flag&quot;);
		SetViewMode(AllView);
		SetSearchSpec(&quot;Root Order Item Id&quot;, sLineId);													
		SetSearchSpec(&quot;Action Code&quot;, &quot;Delete&quot;);
		SetSearchSpec(&quot;Primary Product Flag&quot;, &quot;Y&quot;);
		ExecuteQuery();				
		if (FirstRecord())
		{  								
			
			ssamId = GetFieldValue(&quot;Id&quot;);
			PlanSamId = GetFieldValue(&quot;SAM Product Id&quot;);//ADUTTA:Apple fraud
			sProd = GetFieldValue(&quot;Product&quot;);//ADUTTA:Apple fraud			
			//var sActionCode=&quot;Add&quot;;
			var xssearchexpr=&quot;[Name] = &apos;Voucher Amount&apos;&quot;;
			xssearchexpr = &quot;(&quot;+xssearchexpr +&quot;)&quot;+&quot; AND &quot;+&quot;[Object Id] = &quot; + &quot;&apos;&quot;+ssamId+&quot;&apos;&quot;;	
			//xssearchexpr = &quot;(&quot;+xssearchexpr +&quot;)&quot;+&quot; AND &quot;+&quot;[Action Code] = &quot; + &quot;&apos;&quot;+sActionCode+&quot;&apos;&quot;;	
			with (oLineXA)
			{
				ClearToQuery();
				ActivateField(&quot;Name&quot;);
				ActivateField(&quot;Text Value&quot;);
				ActivateField(&quot;Value&quot;);
				SetViewMode(AllView);											
				SetSearchExpr(xssearchexpr);	
				//SetSearchExpr(&quot;[Name] = &apos;Voucher Amount&apos; OR [Name] = &apos;Term&apos; OR [Name] = &apos;New Term&apos; OR [Name] = &apos;Term Override&apos;&quot;);											
				ExecuteQuery();																	
				if (FirstRecord())
				{
						
						var AttrName = GetFieldValue(&quot;Name&quot;);
						
						if(AttrName==&quot;Voucher Amount&quot;)
						sVouchrAmount = GetFieldValue(&quot;Text Value&quot;);
					
						if(sVouchrAmount==null || sVouchrAmount==&quot;&quot;)
						ssamId=&quot;&quot;;						
					
					
				}
				else
				{
					ssamId=&quot;&quot;;
				}
			}
		}
	}

		
	Outputs.SetProperty(&quot;ssamId&quot;,ssamId);
    Outputs.SetProperty(&quot;PlanSamId&quot;,PlanSamId);//ADUTTA:AppleFraud
	Outputs.SetProperty(&quot;ProductName&quot;,sProd);//ADUTTA:AppleFraud
	
}
catch (e)
	{   ssamId=&quot;&quot;;
		throw e;
	}
	finally
	{			
		oLineXA = null;
		oLineBC = null;
		//oOrderBC = null;
		oOrderBO = null;
	}
}"
