			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCheckVoucherAmount"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCheckVoucherAmount(Inputs,Outputs)
{
  try
  {
	var OrderId = Inputs.GetProperty(&quot;OrderId&quot;);	

	var oOrderBO=TheApplication().GetBusObject(&quot;Order Item&quot;);
	var oOrderBC=TheApplication().GetBusObject(&quot;Order Entry&quot;).GetBusComp(&quot;Order Entry - Orders&quot;);
	var oVoucherBC=TheApplication().GetBusObject(&quot;Order Entry&quot;).GetBusComp(&quot;VF Voucher Details&quot;);	
	var oLineBC = oOrderBO.GetBusComp(&quot;Order Entry - Line Items (Simple)&quot;);
	var oLineXA = oOrderBO.GetBusComp(&quot;Order Item XA (Simple)&quot;);
		
	var oProductBO;
	var oInternalproduct;
	var oPrimaryProduct;									
									
	/*var ssItemName;
	var ssTerm=&quot;&quot;;	
	var ssServiceitemId;	
	var ssVoucherAmount=0;
	var ssApprovalId;	
	var ssAssetIntegrationId;*/
	var sRootProductId;
	var irecord;
	var sProductId;
	var ssmproditemId;
	
	//var ssNewTerm;
	
	var ssearchexpr=&quot;&quot;;
	
	with(oOrderBC)
	{
		ClearToQuery();
		ActivateField(&quot;VF Order Channel&quot;);
		ActivateField(&quot;Approval Id&quot;);
		ActivateField(&quot;Voucher Amount&quot;);
		ActivateField(&quot;New Term&quot;);
		SetViewMode(AllView);
		SetSearchSpec(&quot;Id&quot;, OrderId);
		ExecuteQuery();
		if(FirstRecord())			
		{	
			ssApprovalId = GetFieldValue(&quot;Approval Id&quot;);			
			
			if(ssApprovalId != null &amp;&amp; ssApprovalId!=&quot;&quot;)
			{
				with (oLineBC)
				{
					ClearToQuery();
					ActivateField(&quot;Order Id&quot;);
					ActivateField(&quot;Action Code&quot;);
					ActivateField(&quot;Asset Integration Id&quot;);
					ActivateField(&quot;Root Product Id&quot;);
					ActivateField(&quot;Root Order Item Id&quot;);
					ActivateField(&quot;Root Asset Integration Id&quot;);
					ActivateField(&quot;Primary Product Flag&quot;);
					SetViewMode(AllView);
					SetSearchSpec(&quot;Order Header Id&quot;, OrderId);													
					SetSearchSpec(&quot;Action Code&quot;, &quot;Add&quot;);
					SetSearchSpec(&quot;Primary Product Flag&quot;, &quot;Y&quot;);
					ExecuteQuery();				
					if (FirstRecord())
					{   
											
						sRootProductId = GetFieldValue(&quot;Root Product Id&quot;);
						ssServiceitemId = GetFieldValue(&quot;Root Order Item Id&quot;);
						//ssAssetIntegrationId = GetFieldValue(&quot;Root Asset Integration Id&quot;);
						ssmproditemId = GetFieldValue(&quot;Id&quot;);
						ssItemName = GetFieldValue(&quot;Product&quot;);
						ssAssetIntegrationId = GetFieldValue(&quot;Asset Integration Id&quot;);
						var sActionCode=&quot;Add&quot;;
						var xssearchexpr=&quot;[Name] = &apos;Voucher Amount&apos; OR [Name] = &apos;New Term&apos;&quot;;
						xssearchexpr = &quot;(&quot;+xssearchexpr +&quot;)&quot;+&quot; AND &quot;+&quot;[Object Id] = &quot; + &quot;&apos;&quot;+ssmproditemId+&quot;&apos;&quot;;	
						xssearchexpr = &quot;(&quot;+xssearchexpr +&quot;)&quot;+&quot; AND &quot;+&quot;[Action Code] = &quot; + &quot;&apos;&quot;+sActionCode+&quot;&apos;&quot;;	
						with (oLineXA)
						{
							ClearToQuery();
							ActivateField(&quot;Name&quot;);
							ActivateField(&quot;Text Value&quot;);
							ActivateField(&quot;Value&quot;);
							SetViewMode(AllView);											
							SetSearchExpr(xssearchexpr);	
							//SetSearchExpr(&quot;[Name] = &apos;Voucher Amount&apos; OR [Name] = &apos;Term&apos; OR [Name] = &apos;New Term&apos; OR [Name] = &apos;Term Override&apos;&quot;);											
							ExecuteQuery();
							var irec =FirstRecord();													
							if (FirstRecord())
							{
								while(irec)
								{	
									var AttrName = GetFieldValue(&quot;Name&quot;);
									
									if(AttrName==&quot;Voucher Amount&quot;)
									ssVoucherAmount = GetFieldValue(&quot;Text Value&quot;);

									if(AttrName==&quot;New Term&quot;)
									ssNewTerm = GetFieldValue(&quot;Text Value&quot;);
								
									/*
									if(AttrName==&quot;Term&quot; &amp;&amp; (ssTerm ==null || ssTerm==&quot;&quot;))
									ssTerm = GetFieldValue(&quot;Text Value&quot;);
								
									if(AttrName==&quot;Term Override&quot;)
									{
										var strTermOverride = GetFieldValue(&quot;Text Value&quot;);													
										if(strTermOverride!=&quot;_&quot; &amp;&amp; (strTermOverride !=&quot;&quot; &amp;&amp; strTermOverride != null))
										ssTerm = strTermOverride;
									}
									*/
									irec = NextRecord();														
									
								}
								
								with(oVoucherBC)
								{
									ClearToQuery();		
									ActivateField(&quot;Order Id&quot;);
									ActivateField(&quot;Voucher Amount&quot;);
									ActivateField(&quot;New Term&quot;);
									SetViewMode(AllView);
									SetSearchSpec(&quot;Order Id&quot;, OrderId);
									ExecuteQuery();
									if(FirstRecord())			
									{	
										SetFieldValue(&quot;Voucher Amount&quot;,ssVoucherAmount);
										SetFieldValue(&quot;New Term&quot;,ssNewTerm);
										WriteRecord();
										
									}
								}
								
							}
						}
					}
				}
			}
		
		}
	}
	TheApplication().SetProfileAttr(&quot;VoucherAmount3&quot;,ssVoucherAmount); 
	Outputs.SetProperty(&quot;ssItemName&quot;,ssItemName);
	//Outputs.SetProperty(&quot;ssTerm&quot;,ssTerm);
	Outputs.SetProperty(&quot;ssNewTerm&quot;,ssNewTerm);	
	Outputs.SetProperty(&quot;ssServiceitemId&quot;,ssServiceitemId);
	Outputs.SetProperty(&quot;ssVoucherAmount&quot;,ssVoucherAmount);
	Outputs.SetProperty(&quot;ssAssetIntegrationId&quot;,ssAssetIntegrationId);
	Outputs.SetProperty(&quot;ssApprovalId&quot;,ssApprovalId);

	
}
catch (e)
	{
		throw e;
	}
	finally
	{	
		oVoucherBC = null;		
		oLineXA = null;
		oLineBC = null;
		oOrderBC = null;
		oOrderBO = null;
	}
}"
