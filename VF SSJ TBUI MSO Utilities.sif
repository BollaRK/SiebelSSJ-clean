			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mUpdateEquipment"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mUpdateEquipment(Inputs)
{
	try
	{
		var AccountId = Inputs.GetProperty(&quot;AccountId&quot;);
		var LineId = Inputs.GetProperty(&quot;OrderLineId&quot;);
		var AssetId = Inputs.GetProperty(&quot;AssetId&quot;);
		var sOldAssetId = Inputs.GetProperty(&quot;OldAssetId&quot;);
		var OrderType = Inputs.GetProperty(&quot;OrderType&quot;);
		var OrderFn = Inputs.GetProperty(&quot;OrderFn&quot;);
		var OldLineId = Inputs.GetProperty(&quot;OldOrderLineId&quot;);
		var sLineBC,oEqAccntBO,oEqAccntBC;
		oEqAccntBO = TheApplication().GetBusObject(&quot;VHA Equipment Account&quot;);
		oEqAccntBC = oEqAccntBO.GetBusComp(&quot;VHA Equipment Account&quot;);
		var sDeviceEquipmentType = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_EQUIPMENT_TYPE&quot;,&quot;Device Equipment Limit&quot;);//Vinodhini-29/06/2019-Added for MHI
		var sBillingMPP = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;PRODUCT_TYPE&quot;,&quot;Billing - MPP&quot;);
		var sBillingGPP = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;PRODUCT_TYPE&quot;,&quot;Billing - GPP&quot;);
		var sBillingRecurring = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;PRODUCT_TYPE&quot;,&quot;Billing - Recurring&quot;);	
        var sSIMO = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_PROD_TYPE&quot;,&quot;SIMO Plan&quot;);		
		var sPlanEquipment = &quot;Plan Equipment Limit&quot;;

		var psIn = TheApplication().NewPropertySet();
		var psOut = TheApplication().NewPropertySet();
		if(OrderType==&quot;Change Proposition&quot;)
			psIn.SetProperty(&quot;LineId&quot;,OldLineId);
		else
			psIn.SetProperty(&quot;LineId&quot;,LineId);
		mCheckDeleteVoucher(psIn,psOut);
		var ssamId = psOut.GetProperty(&quot;ssamId&quot;);
		var PlanSamId = psOut.GetProperty(&quot;PlanSamId&quot;);//ADUTTA:AppleFraud
		var ProductName = psOut.GetProperty(&quot;ProductName&quot;);//ADUTTA:AppleFraud
		
		var AppleVoucher = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_APPLE_VOUCR_PLN_ID&quot;,PlanSamId);
		var AppleLOV = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CR_ENABLE_FLAG&quot;,&quot;Apple Plan&quot;);
		//if(OrderFn!=&quot;UPGRADE&quot;)
		
	     
		if(OrderFn!=&quot;UPGRADE&quot; || (ssamId!=null &amp;&amp; ssamId!=&quot;&quot;))
		{
			sLineBC = TheApplication().GetBusObject(&quot;Order Entry - Thin MSO&quot;).GetBusComp(&quot;VF Order Line Items - Thin&quot;);
			
			
			if(ssamId!=null &amp;&amp; ssamId!=&quot;&quot; &amp;&amp; AppleVoucher!=&quot;Y&quot;)
			{
				if(OrderType==&quot;Change Proposition&quot;)
				var sSearchStr = &quot;(([Product Type] = &apos;&quot;+sBillingMPP+&quot;&apos; OR ([Product Type] = &apos;&quot;+sBillingGPP+&quot;&apos; AND [Siebel Product Type] = &apos;Device&apos;)) AND [Root Order Item Id] = &apos;&quot;+LineId+&quot;&apos; AND ([VHA Waive Charges] = &apos;N&apos; OR [Action Code] = &apos;Delete&apos;)) OR ([Id]= &apos;&quot;+ssamId+&quot;&apos; AND [Root Order Item Id] = &apos;&quot;+OldLineId+&quot;&apos; AND [Action Code] = &apos;Delete&apos;) &quot;;
				else
				var sSearchStr = &quot;(([Product Type] = &apos;&quot;+sBillingMPP+&quot;&apos; OR ([Product Type] = &apos;&quot;+sBillingGPP+&quot;&apos; AND [Siebel Product Type] = &apos;Device&apos;)) OR [Id]= &apos;&quot;+ssamId+&quot;&apos;) AND [Root Order Item Id] = &apos;&quot;+LineId+&quot;&apos; AND ([VHA Waive Charges] = &apos;N&apos; OR [Action Code] = &apos;Delete&apos;)&quot;;
			}
			else if(AppleVoucher==&quot;Y&quot; &amp;&amp; AppleLOV==&quot;Y&quot;)
			{
				if(OrderType==&quot;Change Proposition&quot;)
				var sSearchStr = &quot;(([Product Type] = &apos;&quot;+sBillingRecurring+&quot;&apos; AND [Siebel Product Type] = &apos;&quot;+sSIMO+&quot;&apos; AND [Product] = &apos;&quot;+ProductName+&quot;&apos;) AND [Root Order Item Id] = &apos;&quot;+OldLineId+&quot;&apos; AND [Action Code] = &apos;Delete&apos;)&quot;;
                 else
                var sSearchStr = &quot;(([Product Type] = &apos;&quot;+sBillingRecurring+&quot;&apos; AND [Siebel Product Type] = &apos;&quot;+sSIMO+&quot;&apos; AND [Product] = &apos;&quot;+ProductName+&quot;&apos;) AND [Root Order Item Id] = &apos;&quot;+LineId+&quot;&apos; AND [Action Code] = &apos;Delete&apos;)&quot;;
			}
			else
			var sSearchStr = &quot;([Product Type] = &apos;&quot;+sBillingMPP+&quot;&apos; OR ([Product Type] = &apos;&quot;+sBillingGPP+&quot;&apos; AND [Siebel Product Type] = &apos;Device&apos;)) AND [Root Order Item Id] = &apos;&quot;+LineId+&quot;&apos; AND ([VHA Waive Charges] = &apos;N&apos; OR [Action Code] = &apos;Delete&apos;)&quot;;
			
			with (sLineBC)
			{
				 ClearToQuery();
				 SetViewMode(AllView);
				 ActivateField(&quot;Asset Integration Id&quot;);
				 ActivateField(&quot;Product Type&quot;);
				 //SetSearchSpec(&quot;Root Order Item Id&quot;, LineId);
				 //SetSearchSpec(&quot;VHA Waive Charges&quot;, &quot;N&quot;);
				 //SetSearchSpec(&quot;Product Type&quot;);
				 SetSearchExpr(sSearchStr);
				 ExecuteQuery(ForwardBackward);
				 var isrec = FirstRecord();
				 while(isrec)
				 {	  
					
					if(OrderType==&quot;Change Proposition&quot;)
					{
						if(GetFieldValue(&quot;Product Type&quot;) == sBillingMPP)
							var sSearchStr = &quot;[Account Id]=&apos;&quot;+AccountId+&quot;&apos; AND [Asset Id]=&apos;&quot;+sOldAssetId+&quot;&apos; AND [Type]=&apos;Equipment Limit&apos;&quot;;
						else
							var sSearchStr = &quot;[Account Id]=&apos;&quot;+AccountId+&quot;&apos; AND ([Asset Id]=&apos;&quot;+sOldAssetId+&quot;&apos; OR [Asset Id]=&apos;&quot;+AssetId+&quot;&apos;) AND ([Type]=&apos;&quot;+sDeviceEquipmentType+&quot;&apos; OR [Type]=&apos;&quot;+sPlanEquipment+&quot;&apos;) AND [Asset Integeration Id] = &apos;&quot;+GetFieldValue(&quot;Asset Integration Id&quot;)+&quot;&apos;&quot;;
						//	var sSearchStr = &quot;[Account Id]=&apos;&quot;+AccountId+&quot;&apos; AND [Asset Id]=&apos;&quot;+sOldAssetId+&quot;&apos; AND [Type]=&apos;&quot;+sDeviceEquipmentType+&quot;&apos; AND [Asset Integeration Id] = &apos;&quot;+GetFieldValue(&quot;Asset Integration Id&quot;)+&quot;&apos;&quot;;
					}
					else
					{
						if(GetFieldValue(&quot;Product Type&quot;) == sBillingMPP)
							var sSearchStr = &quot;[Account Id]=&apos;&quot;+AccountId+&quot;&apos; AND [Asset Id]=&apos;&quot;+AssetId+&quot;&apos; AND [Type]=&apos;Equipment Limit&apos;&quot;;
						else
							var sSearchStr = &quot;[Account Id]=&apos;&quot;+AccountId+&quot;&apos; AND [Asset Id]=&apos;&quot;+AssetId+&quot;&apos; AND ([Type]=&apos;&quot;+sDeviceEquipmentType+&quot;&apos; OR [Type]=&apos;&quot;+sPlanEquipment+&quot;&apos;) AND [Asset Integeration Id] = &apos;&quot;+GetFieldValue(&quot;Asset Integration Id&quot;)+&quot;&apos;&quot;;
						  //var sSearchStr = &quot;[Account Id]=&apos;&quot;+AccountId+&quot;&apos; AND [Asset Id]=&apos;&quot;+AssetId+&quot;&apos; AND [Type]=&apos;&quot;+sDeviceEquipmentType+&quot;&apos; AND [Asset Integeration Id] = &apos;&quot;+GetFieldValue(&quot;Asset Integration Id&quot;)+&quot;&apos;&quot;;
					}
				  	//mDeleteEquipment(Inputs);
				  	
					mDeleteRecord(oEqAccntBC,sSearchStr);
					isrec = NextRecord();
				 }
				 
			 }
		}
		
		//else
		//{
					
			with (oEqAccntBC)
			{
				SetViewMode(AllView);
				ActivateField(&quot;Account Id&quot;);
				ActivateField(&quot;Service Order Id&quot;);
				ActivateField(&quot;Asset Id&quot;);
				ActivateField(&quot;Type&quot;);
				ActivateField(&quot;Asset Integeration Id&quot;);
				
				if(OrderType ==&quot;Decon/Con Transfer TO&quot;)
				{
					var sAssetIntId = Inputs.GetProperty(&quot;Custom Asset Int Id&quot;);
					var OrderId = Inputs.GetProperty(&quot;OrderId&quot;);
	 
					var boAccount = TheApplication().GetBusObject(&quot;Account&quot;);
					var bcAssetHeader = boAccount.GetBusComp(&quot;Asset Mgmt - Asset - Header&quot;);
					 
					bcAssetHeader.ClearToQuery();
					bcAssetHeader.SetViewMode(AllView);
					bcAssetHeader.ActivateField(&quot;Integration Id&quot;);
					bcAssetHeader.SetSearchSpec(&quot;Integration Id&quot;, sAssetIntId);
					bcAssetHeader.ExecuteQuery(ForwardOnly);
					if (bcAssetHeader.FirstRecord())
					{
						var AssetDetails = TheApplication().NewPropertySet();
						GetAssetDetails(OrderId, AssetDetails);
						
						ActivateField(&quot;Order Id&quot;);
						ClearToQuery();
						SetSearchSpec(&quot;Account Id&quot;,AccountId);
						SetSearchSpec(&quot;Asset Id&quot;,bcAssetHeader.GetFieldValue(&quot;Id&quot;));
						ExecuteQuery();
						var isRec = FirstRecord();
						while(isRec)
						{
							SetFieldValue(&quot;Asset Id&quot;, AssetId);
							SetFieldValue(&quot;Service Order Id&quot;, LineId);
							SetFieldValue(&quot;Order Id&quot;, OrderId);
							if((GetFieldValue(&quot;Type&quot;) == &quot;Accessory Limit&quot; || GetFieldValue(&quot;Type&quot;) == sDeviceEquipmentType) &amp;&amp; AssetDetails.GetProperty(GetFieldValue(&quot;Asset Integeration Id&quot;))!=&quot;&quot;)
								SetFieldValue(&quot;Asset Integeration Id&quot;, AssetDetails.GetProperty(GetFieldValue(&quot;Asset Integeration Id&quot;)));
							WriteRecord();
							isRec=NextRecord();
						}
					}
				}
				else
				{
					if(sOldAssetId!=&quot;&quot; &amp;&amp; OrderType== &quot;Change Proposition&quot;)
					{
						SetViewMode(AllView);
						ActivateField(&quot;Account Id&quot;);
						ActivateField(&quot;Service Order Id&quot;);
						ActivateField(&quot;Asset Id&quot;);
						ClearToQuery();
						SetSearchSpec(&quot;Account Id&quot;,AccountId);
						SetSearchSpec(&quot;Asset Id&quot;,sOldAssetId);
						ExecuteQuery();
						var iRec=FirstRecord();
						while(iRec)
						{
							SetFieldValue(&quot;Asset Id&quot;,AssetId);
							WriteRecord();
							iRec=NextRecord();
						}
					}
					ClearToQuery();
					SetSearchSpec(&quot;Account Id&quot;,AccountId);
					SetSearchSpec(&quot;Service Order Id&quot;,LineId);
					ExecuteQuery();
					var isRec = FirstRecord();
					while(isRec) //Chitra changed if loop to while for AOA2 - 29/04/2016
					{
						//sOldAssetId = GetFieldValue(&quot;Asset Id&quot;);
						SetFieldValue(&quot;Asset Id&quot;,AssetId);
						WriteRecord();
						isRec=NextRecord();
					}

				}				
			}		
		//}
	}	
	catch(e)
	{
		throw e;
	}
	finally
	{
		sLineBC = null;
		oEqAccntBC	= null;
		oEqAccntBO = null;
		/*Below variables are nullified by Sharukh on 18/03/2019*/
		/*bcAssetHeader = null;
		AssetDetails = null;
		boAccount = null;*/

		/*Below variables are nullified by GURUPRASAD on 03/10/2019*/
		if(defined(bcAssetHeader)) { bcAssetHeader = null; }
		if(defined(AssetDetails)) { AssetDetails = null; }
		if(defined(boAccount)) { boAccount = null; }
		

	}
}"
			   SEQUENCE="110"
			   UPDATED="01/09/2026 15:43:20"
			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 15:43:20"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mUpdateFulfilmentStartDate"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mUpdateFulfilmentStartDate(Inputs, Outputs)
{
/*
 * Component Name        : 	VF TBUI MSO Utilities
 * Function Name         : 	mUpdateFulfilmentStartDate
 * Component Information : 	Updates the Due Date for the Fulfilment Root Line Items
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 15/10/2015	Roseline	R16.1 MSOD	Initial Version									
 */
	try
	{	
		var sOrderId =Inputs.GetProperty(&quot;Order Id&quot;);
		var dtToday = Date.fromSystem(Clib.time());
		var sFormattedTodayDate = (dtToday.getMonth() + 1) + &quot;/&quot; + dtToday.getDate() + &quot;/&quot; + dtToday.getFullYear();
		var sFormattedTodayDateTime = sFormattedTodayDate + &quot; &quot; + dtToday.getHours() + &quot;:&quot; + dtToday.getMinutes() + &quot;:&quot; + dtToday.getSeconds();
		var	boOrder = TheApplication().GetBusObject(&quot;VF Order Entry Thin BO&quot;);
		var	bcOrderItem = boOrder.GetBusComp(&quot;VF Order Line Items - Thin BC&quot;);
		with(bcOrderItem)
		{
			SetViewMode(AllView);
			ActivateField(&quot;Order Header Id&quot;);
			ActivateField(&quot;Parent Order Item Id&quot;);
			ActivateField(&quot;Action Code&quot;);
			ActivateField(&quot;Due Date&quot;);
			ClearToQuery();
			var searchst = &quot;[Order Header Id] = &apos;&quot; + sOrderId + &quot;&apos; AND [Parent Order Item Id] IS NULL AND [Action Code] &lt;&gt; &apos;Delete&apos;&quot;;
			SetSearchExpr(searchst);
			ExecuteQuery(ForwardOnly);
			var isRec = FirstRecord();
			while(isRec)
			{
				SetFieldValue(&quot;Due Date&quot;,sFormattedTodayDateTime);
				WriteRecord();
				isRec = NextRecord();	
			}   
		}
		return(CancelOperation);
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
			bcOrderItem = null;
			boOrder = null;
	}
}"
			   SEQUENCE="111"
			   UPDATED="01/09/2026 15:43:20"
			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 15:43:20"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mUpdateMPPContractAttribute"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	=======================================================
 * 05/08/2016   Subramanian K			To get start and end date from line items and upsert for MPP Contract line item
 * 14/12/2016   Subramanian K			Added to code to trigger only if Order sub type is not CON/DECON, and future submit date to be upsert as contract start date.
 * 05/01/2017   Nirmal Rajeevan			Added logic to stamp the install date of MPP contract from asset to the Period Override attribute&apos;s description for PKE000000041878
 */
function mUpdateMPPContractAttribute(Inputs,Outputs)
{
	try
	{
		//Get input property
		var sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
		var sOrderSubType = Inputs.GetProperty(&quot;OrderSubType&quot;); //05/01/2017 NIRMAL -- New input from the step added for PKE000000041878
		
		//Variable declarations
		var i;
		var j;
		var sContStDt = &quot;&quot;, sContEndDt = &quot;&quot;;
		
		//Property set 
		var psInputs1 = TheApplication().NewPropertySet();
		var psOutputs1 = TheApplication().NewPropertySet();	
		var psOutputs2 = TheApplication().NewPropertySet();	
		
		//Call EAI Siebel Adapter to get order, order LI, and order LI XA for MPP Contract Line item with action code Add
		var bsEAIService = TheApplication().GetService(&quot;EAI Siebel Adapter&quot;);
		var psInputs = TheApplication().NewPropertySet();
		var psOutputs = TheApplication().NewPropertySet();
		
		var EAIUpsertFlag = &quot;N&quot;; //05/01/2017 NIRMAL -- Added for PKE000000041878
		
		psInputs.SetProperty(&quot;OutputIntObjectName&quot;, &quot;VHA MPP Misalignment IO&quot;);
		psInputs.SetProperty(&quot;PrimaryRowId&quot;,sOrderId);
		if(sOrderSubType == &quot;Decon/Con Transfer FROM&quot;) { //05/01/2017 NIRMAL -- Added for PKE000000041878
			psInputs.SetProperty(&quot;SearchSpec&quot;,&quot;[VHA Order Entry Line Items Query Thin.Order Header Id] = &apos;&quot;+sOrderId+&quot;&apos; AND [VHA Order Entry Line Items Query Thin.Product] = &apos;MPP Contract&apos; AND ([VF Order Item XA.Name] = &apos;Period Override&apos;)&quot;);
		} else {
			psInputs.SetProperty(&quot;SearchSpec&quot;,&quot;[VHA Order Entry Line Items Query Thin.Order Header Id] = &apos;&quot;+sOrderId+&quot;&apos; AND [VHA Order Entry Line Items Query Thin.Product] = &apos;MPP Contract&apos; AND [VHA Order Entry Line Items Query Thin.Action Code] = &apos;Add&apos; AND ([VF Order Item XA.Name] = &apos;Contract Start Date&apos; OR [VF Order Item XA.Name] = &apos;Due Date&apos;)&quot;);
		}
		bsEAIService.InvokeMethod(&quot;Query&quot;, psInputs, psOutputs);
		Outputs.AddChild(psOutputs);
		    
		//Code should trigger for all other subtypes apart from CON/DECON Orders //05/01/2017 NIRMAL --Added Decon/Con Transfer FROM to conditions
		if (psOutputs.GetChild(0).GetChild(0).GetChild(0).GetProperty(&quot;Order Sub Type&quot;) != &quot;Change Ownership Connect&quot; &amp;&amp; psOutputs.GetChild(0).GetChild(0).GetChild(0).GetProperty(&quot;Order Sub Type&quot;) != &quot;Change Ownership Disconnect&quot; &amp;&amp; psOutputs.GetChild(0).GetChild(0).GetChild(0).GetProperty(&quot;Order Sub Type&quot;) != &quot;Decon/Con Transfer TO&quot; &amp;&amp; psOutputs.GetChild(0).GetChild(0).GetChild(0).GetProperty(&quot;Order Sub Type&quot;) != &quot;Decon/Con Transfer FROM&quot;)
		{
			//Get first submitted date and time.
			var sFirstSubmitDt = psOutputs.GetChild(0).GetChild(0).GetChild(0).GetProperty(&quot;VF First Submit DateTime&quot;);
			
			if (sFirstSubmitDt != &quot;&quot; &amp;&amp; sFirstSubmitDt != null)
			{
				//Start Date End Date Calculation
				fnStartEndDt(sFirstSubmitDt,psInputs1,psOutputs1);
				sContStDt = psOutputs1.GetProperty(&quot;Start Date&quot;);
				sContEndDt = psOutputs1.GetProperty(&quot;End Date&quot;);
				
				//Get number of line items count
				var sOrderLICount = psOutputs.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChildCount();
				
				//For each line item get the attributes
				for(i=0;i&lt;sOrderLICount;i++)
				{
					
					//Look for Line Item Attributes
					var sOrderLIXACount = psOutputs.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(i).GetChild(0).GetChildCount();
	
					//For each line item attributes
					for(j=0;j&lt;sOrderLIXACount;j++)
					{
						//Get the attribute name
						var sName = psOutputs.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(i).GetChild(0).GetChild(j).GetProperty(&quot;Name&quot;);
						//If attribute name is Contract start date, set property start date else set property end date
						if (sName == &quot;Contract Start Date&quot;)
							psOutputs.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(i).GetChild(0).GetChild(j).SetProperty(&quot;Value&quot;,sContStDt);
						else if (sName == &quot;Due Date&quot;)
							psOutputs.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(i).GetChild(0).GetChild(j).SetProperty(&quot;Value&quot;,sContEndDt);
					}//for each XA attribute
				}//for each LI
				
				//Upsert the new values to line item
				//bsEAIService.InvokeMethod(&quot;Upsert&quot;, psOutputs, psOutputs2);  //05/01/2017 NIRMAL  -- Commented for PKE000000041878
				EAIUpsertFlag = &quot;Y&quot;; //05/01/2017 NIRMAL  -- Added for PKE000000041878
			}
		}

		//05/01/2017 NIRMAL -- Added for PKE000000041878
		if (psOutputs.GetChild(0).GetChild(0).GetChild(0).GetProperty(&quot;Order Sub Type&quot;) == &quot;Decon/Con Transfer FROM&quot;){
			var sOrderLICount = psOutputs.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChildCount();
			//For each line item get the attributes
			for(i=0;i&lt;sOrderLICount;i++){
				if(psOutputs.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(i).GetProperty(&quot;Product&quot;) == &quot;MPP Contract&quot;){
					var sIntegrationId = psOutputs.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(i).GetProperty(&quot;Asset Integration Id&quot;);			
					var boAsset = TheApplication().GetBusObject(&quot;VF Asset Mgmt - Simple&quot;);
					var bcAssetComp = boAsset.GetBusComp(&quot;Asset Mgmt - Asset Simple&quot;);					
					bcAssetComp.ActivateField(&quot;Install Date&quot;);
					bcAssetComp.SetSearchSpec(&quot;Integration Id&quot;,sIntegrationId);
					bcAssetComp.SetViewMode(AllView);
					bcAssetComp.ExecuteQuery();
					if(bcAssetComp.FirstRecord()){
						var sInstallDate = bcAssetComp.GetFieldValue(&quot;Install Date&quot;);
						var sOrderLIXACount = psOutputs.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(i).GetChild(0).GetChildCount();
						//For each line item attributes
						for(j=0;j&lt;sOrderLIXACount;j++) {
							//Get the attribute name
							var sName = psOutputs.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(i).GetChild(0).GetChild(j).GetProperty(&quot;Name&quot;);
							//If attribute name is Contract start date, set property start date else set property end date
							if (sName == &quot;Period Override&quot;){
								psOutputs.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(i).GetChild(0).GetChild(j).SetProperty(&quot;Description&quot;,sInstallDate);
								EAIUpsertFlag = &quot;Y&quot;;
							}
						}//for each XA attribute
					}
				}
			}
		}
		if (EAIUpsertFlag == &quot;Y&quot;){
			bsEAIService.InvokeMethod(&quot;Upsert&quot;, psOutputs, psOutputs2);
		}
		//05/01/2017 NIRMAL -- End changes for PKE000000041878
		
		/*else
		{
			//throw(psOutputs.GetChild(0).GetChild(0).GetChild(0).GetProperty(&quot;Order Sub Type&quot;));
		}*/
		
	} 
	catch(e)
	{
		throw(e);
	}
	finally
	{
	/*Below variables are nullified by Sharukh on 18/03/2019*/
	//bcAssetComp = null;
	//boAsset = null;
	if(defined(bcAssetComp)) { bcAssetComp = null; }/*This variable is nullified by GURUPRASAD on 03/10/2019*/
	if(defined(boAsset)) { boAsset = null; }/*This variable is nullified by GURUPRASAD on 03/10/2019*/
	psInputs1 = null;
	psOutputs1 = null;
	psOutputs2 = null;
	bsEAIService = null;
	psInputs = null;
	psOutputs = null;
	
	

	} 	

}"
			   SEQUENCE="112"
			   UPDATED="01/09/2026 15:43:20"
			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 15:43:20"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mUpdateOrderLineItems"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mUpdateOrderLineItems(Inputs, Outputs)
{
/*
 * Component Name        : 	VF TBUI MSO Utilities
 * Function Name         : 	mUpdateConnectOrderLineItems
 * Component Information : 	Updates the Line Items Status of Connect Order, Set New MSISDN in Fulfilment Order
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 03/11/2015	Roseline	R16.1 MSOD	Initial Version									
 */
	try
	{	
		var sParentOrderId =Inputs.GetProperty(&quot;Parent Order Id&quot;);
		var sFulfilOrderId = Inputs.GetProperty(&quot;Fulfilment Order Id&quot;);
		var sStockIndicator = &quot;&quot;;
		var sNewMSISDNId = &quot;&quot;;
		var sRootOrderItemId = &quot;&quot;;
		var	sboOrder, sbcOrderItem;
		
		//Update Line Item Status
		var	boOrder = TheApplication().GetBusObject(&quot;VF Order Entry Thin BO&quot;);
		var	bcOrderItem = boOrder.GetBusComp(&quot;VF Order Line Items - Thin BC&quot;);
		with(bcOrderItem)
		{
			bcOrderItem.SetViewMode(AllView);
			bcOrderItem.ActivateField(&quot;Order Header Id&quot;);
			bcOrderItem.ActivateField(&quot;Parent Order Item Id&quot;);
			bcOrderItem.ActivateField(&quot;Action Code&quot;);
			bcOrderItem.ActivateField(&quot;Status&quot;);
			bcOrderItem.ActivateField(&quot;VF Stock Indicator TBUI&quot;);
			bcOrderItem.ClearToQuery();
			var searchst = &quot;[Order Header Id] = &apos;&quot; + sParentOrderId + &quot;&apos; AND [Parent Order Item Id] IS NULL AND [Action Code] &lt;&gt; &apos;Delete&apos;&quot;;
			bcOrderItem.SetSearchExpr(searchst);
			bcOrderItem.ExecuteQuery(ForwardOnly);
			var isRec = bcOrderItem.FirstRecord();
			while(isRec)
			{
				sStockIndicator = bcOrderItem.GetFieldValue(&quot;VF Stock Indicator TBUI&quot;);
				sRootOrderItemId = bcOrderItem.GetFieldValue(&quot;Id&quot;);
			
				//Query for New MSISDN
				if(sStockIndicator != &quot;In Stock&quot;)
				{
					var	sboOrder = TheApplication().GetBusObject(&quot;VF Order Entry Thin BO&quot;);
					var	sbcOrderItem = sboOrder.GetBusComp(&quot;VF Order Line Items - Thin BC&quot;);
					with(sbcOrderItem)
					{
						sbcOrderItem.SetViewMode(AllView);
						sbcOrderItem.ActivateField(&quot;New MSISDN Id&quot;);
						sbcOrderItem.ActivateField(&quot;Product Type&quot;);
						sbcOrderItem.ActivateField(&quot;Order Header Id&quot;);
						sbcOrderItem.ActivateField(&quot;Root Order Item Id&quot;); // JS: 11-09-2016 Added for PKE000000040453
						sbcOrderItem.ClearToQuery();
						// JS: 11-09-2016 included [Root Order Item Id] = &apos;&quot; + sRootOrderItemId + &quot;&apos; for PKE000000040453 in search expression
						var searchst1 = &quot;[Order Header Id] = &apos;&quot; + sParentOrderId + &quot;&apos; AND [Root Order Item Id] = &apos;&quot; + sRootOrderItemId + &quot;&apos; AND [Product Type] = &apos;Service&apos; AND [New MSISDN Id] IS NOT NULL&quot;;
						sbcOrderItem.SetSearchExpr(searchst1);
						sbcOrderItem.ExecuteQuery(ForwardOnly);
						if(sbcOrderItem.FirstRecord())
						{
							sNewMSISDNId = sbcOrderItem.GetFieldValue(&quot;New MSISDN Id&quot;);
						}
					}
					mSetMSISDN(sFulfilOrderId,sNewMSISDNId,sRootOrderItemId);	
				}		
				isRec = bcOrderItem.NextRecord();
			}//while(isRec)
		} //with(bcOrderItem)
		
		return(CancelOperation);
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
			sbcOrderItem = null;
			sboOrder = null;
			bcOrderItem = null;
			boOrder = null;
	}
}"
			   SEQUENCE="113"
			   UPDATED="01/09/2026 15:43:20"
			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 15:43:20"
