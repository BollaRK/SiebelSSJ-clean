			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="ChangeShipmentAssociation"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function ChangeShipmentAssociation(FulfillmentOrderId, OrderId, &amp;strShipmentId)
{
	try
	{
		var bcShipment = TheApplication().GetBusObject(&quot;VF FS Shipment Update&quot;).GetBusComp(&quot;VF FS Shipment&quot;);
		if (FulfillmentOrderId == &quot;&quot; || FulfillmentOrderId == null)
		{
			FulfillmentOrderId = &quot;DELETED&quot;;
		}
		with (bcShipment)
		{
			ActivateField(&quot;Primary Order Id&quot;);
			ClearToQuery();
			SetViewMode(AllView);
			if (strShipmentId != &quot;&quot;)
			{
				SetSearchSpec(&quot;Id&quot;, strShipmentId);
			}
			else
			{
				SetSearchSpec(&quot;Primary Order Id&quot;, OrderId);
			}
			ExecuteQuery();
			if (FirstRecord())
			{
				strShipmentId = GetFieldValue(&quot;Id&quot;);
				SetFieldValue(&quot;Primary Order Id&quot;, FulfillmentOrderId);
				WriteRecord();
			}
		}
	}
	catch(e)
	{
		throw e;
	}
	finally
	{
		bcShipment = null;
	}
}"
