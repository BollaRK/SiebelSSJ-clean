			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="DeleteFulfilmentItems"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function DeleteFulfilmentItems(SearchString)
{
	try
	{
		var boOrder = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
		var bcOrder = boOrder.GetBusComp(&quot;Order Entry - Orders&quot;);
		var bcFulfilItems = boOrder.GetBusComp(&quot;VF Fulfilment Items&quot;);
		var isRecord = false;
		with (bcOrder)
		{
			ClearToQuery();
			SetViewMode(AllView);
			SetSearchSpec(&quot;Id&quot;, sOrderId);
			ExecuteQuery(ForwardOnly);
			if (FirstRecord())
			{
				with (bcFulfilItems)
				{
					ClearToQuery();
					SetViewMode(AllView);
					SetSearchExpr(SearchString);
					ExecuteQuery();
					isRecord = FirstRecord();
					while(isRecord)
					{
						DeleteRecord();
						isRecord = FirstRecord();
					}
				}
			}
		}
	}
	catch(e)
	{
		throw e;
	}
	finally
	{
		bcFulfilItems = null;
		bcOrder = null;
		boOrder = null;
	}
}"
