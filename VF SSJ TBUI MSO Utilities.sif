			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mMPPGetPlanDetails"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mMPPGetPlanDetails(LineItemId, &amp;psOut)
{
	try
	{
		var sBO = TheApplication().GetBusObject(&quot;VF MPP Orders&quot;)
		var sBC = sBO.GetBusComp(&quot;VF MPP Line Item Primary Product&quot;);
		var strPlan = &quot;&quot;, strDueDate = &quot;&quot;, strNewTerm = &quot;&quot;, strTerm = &quot;&quot;, strFinalTerm = &quot;&quot;, iSpace = &quot;&quot;, strProdType = &quot;&quot;;
		var sSIMO = TheApplication().InvokeMethod(&quot;LookUpValue&quot;,&quot;VF_PROD_TYPE&quot;,&quot;SIMO Plan&quot;);
		var sFbbonly = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_FBB_PROPOSITION_TYPE&quot;, &quot;FBB Only&quot;);
		var sFbbwmbb = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_FBB_PROPOSITION_TYPE&quot;, &quot;FBB with MBB&quot;);
		var strProdTypeRoot;
		with (sBC)
		{
			ClearToQuery();
			SetViewMode(AllView);//Indumathi: 07/06/2018:Added setviewmode
			ActivateField(&quot;VF Siebel Product Type&quot;);
			ActivateField(&quot;Root Prod Type&quot;);
			SetSearchSpec(&quot;Root Order Item Id&quot;, LineItemId);
			ExecuteQuery();
			if (FirstRecord())
			{
				strPlan = GetFieldValue(&quot;Product&quot;);
				strDueDate = GetFieldValue(&quot;Created&quot;);
				strNewTerm = GetFieldValue(&quot;New Term&quot;);
				strTerm = GetFieldValue(&quot;Term&quot;);
				strProdType = GetFieldValue(&quot;VF Siebel Product Type&quot;);
				strProdTypeRoot = GetFieldValue(&quot;Root Prod Type&quot;);
				iSpace = strNewTerm.indexOf(&quot; &quot;);
				strFinalTerm = strNewTerm.substring(0, iSpace);
				
				if(strFinalTerm == &quot;&quot;)
				{
					iSpace = strTerm.indexOf(&quot; &quot;);
					strFinalTerm = strTerm.substring(0, iSpace);
				}
				
				if (strFinalTerm == &quot;&quot; || strFinalTerm == null || strFinalTerm == &quot;_&quot;){
					if(strProdType == sSIMO)//SK 16.1.17 - Commented as plan term fix has been given in IO || strProdTypeRoot == sFbbonly || strProdTypeRoot == sFbbwmbb)//Nithu cond added for PKE000000039720 
							strFinalTerm = &quot;&quot;;//Nithu set the default value as null for DAS-110 16.2
					else
						strFinalTerm = &quot;1&quot;;
				}
			}
		}
		
		psOut.SetProperty(&quot;Plan&quot;, strPlan);
		psOut.SetProperty(&quot;Term&quot;, strFinalTerm);
		psOut.SetProperty(&quot;DueDate&quot;, strDueDate);
		psOut.SetProperty(&quot;PlanProdType&quot;,strProdType); //Thileepa: 31/07/18: Added for PKE000000057942
	}
	catch(e)
	{
		throw e;
	}
	finally
	{
		sBC = null;
		sBO = null;
	}
}"
