			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="DissociateFulfilmentItems"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function DissociateFulfilmentItems()
{
	try
	{
		var bsEAIService = TheApplication().GetService(&quot;EAI Siebel Adapter&quot;);
		var psInputs = TheApplication().NewPropertySet();
		var psOutputs = TheApplication().NewPropertySet();
		var iNoOfServices=0;
		psInputs.SetProperty(&quot;SearchSpec&quot;,&quot;[VF Task Fulfilment Items.Order Id] = &apos;&quot; + sOrderId + &quot;&apos; AND [VF Task Fulfilment Items.VF TBUI Fulfilment Item] IS NOT NULL&quot;);
		psInputs.SetProperty(&quot;OutputIntObjectName&quot;, &quot;VF Task Fulfilment Items&quot;);
		bsEAIService.InvokeMethod(&quot;Query&quot;, psInputs, psOutputs);

		iNoOfServices = psOutputs.GetChild(0).GetChild(0).GetChildCount();
		for (var i=0;i &lt; iNoOfServices; i++)
		{
			psOutputs.GetChild(0).GetChild(0).GetChild(i).SetProperty(&quot;Order Id&quot;, &quot;DELETED&quot;);
			psOutputs.GetChild(0).GetChild(0).GetChild(i).SetProperty(&quot;VF Line Item Id&quot;, &quot;&quot;);
		}

		psInputs.Reset();
		bsEAIService.InvokeMethod(&quot;Update&quot;, psOutputs, psInputs);
	}
	catch(e)
	{
		throw e;
	}
	finally
	{
		bsEAIService = null;
		psInputs = null;
		psOutputs = null;
	}
}"
