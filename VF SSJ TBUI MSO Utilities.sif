			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mValidateServiceDetails"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mValidateServiceDetails (Inputs)
{
try
{
	/* Component Name        : 	TBUI - mValidateServiceDetails
		* Component Information : 	This method is to validate whether the &quot;MPP Product&quot; is added to an order
		* Modification History  :
		* Date			Author		Config #	Description
		* ============ ===========	===========	================================
		* 08/05/2014	MuralidharanK 		Initial Draft Version - For Validate Service Details
		* 20/8/2014     Muralidharank       Added for Service Details for DeAllocate IMEI
		* 21/08/2014    MuralidharanK		Removed Customize Logic validation for Account Level Proposition
		*/
	var strmsisdn,strsim,strportin,strstockindicator,strimei,strPortindob,strportinserno,strportinserac,strorderid,strstockindicator,strAccId,strhandsetcode,strhandsetid,strhandset,strbillingact,strconnectiontype,strordersubtype,strProposition,strErrorMsg,blnValidCJPortinMSISDN,strHandset,strvalidcustomized,vOLICustomised,strvROrderId, strInitialised;
	var strReservationId, strReservationStatus;
	var sPROP_ERR_MSG    = &quot;A Proposition is required. Please enter a value for this field.&quot;;
	var sMSISDN_ERR_MSG  = &quot;A MSISDN is required. Please enter a value for this field.&quot;;
	var sIMEI_ERR_MSG    = &quot;An IMEI is required. Please enter a value for this field.&quot;;
	var sProdLine = &quot;SIM ONLY&quot;, sPrLine = &quot;&quot;, SIMOLov=&quot;&quot;; //TRISHAG for simo
	var sIMEI_DONT_FILL_MSG    = &quot;IMEI cannot be allocated for Out of Stock service orders. Please deallocate the IMEI&quot;;//TARIQ-05SEP2014
	var sSIM_DONT_FILL_MSG    = &quot;SIM cannot be allocated for Out of Stock - Connect Later service orders. Please deallocate the SIM&quot;;//TARIQ-05SEP2014
	var sSIM_ERR_MSG     = &quot;A SIM is required. Please enter a value for this field.&quot;;
	var sBA_ERR_MSG      = &quot;A Billing Account is required. Please enter a value for this field.&quot;;
	var sACC_NUM_ERR_MSG = &quot;An Account Reference # is required. Please enter a value for this field.&quot;;
	var sDOB_ERR_MSG     = &quot;A Date of Birth is required. Please enter a value for this field.&quot;;
	var sHANDSET_ERR_MSG = &quot;A Handset Make and Model is required. Please enter a value for this field.&quot;;
	var sPLAN_CHECK_MSG  = &quot;Please make sure you have clicked on the Customize button&quot;;
	var sCONN_TYPE_ERR_MSG    = &quot;Please Select the Connection Type&quot;;
	var sSTOCK_IND_ERR_MSG    = &quot;Please Select the Stock Indicator&quot;;
	var sMSISDN_SOURCE_ERR_MSG = &quot;Please Select the MSISDN Source&quot;;
	var sDEALLOCATE_IMEI =	&quot;Please Deallocate IMEI to proceed with order.&quot;;
	var sPORT_CONNECT_TYPE_ERR_MSG = &quot;Out of Stock cannot be selected for Port In Service Orders&quot;;
	var sINVALID_COMBI    = &quot;Port In options are not available for Out Of Stock - Connect Later&quot;;//Neel 30.10.2014 - PortIn / Out Of Stock
	var seSIM_ERR_MSG = &quot;eSIM Download is mandatory. Please enter eSIM Download to proceed further&quot;; // vasavi 18/07/2022 Added for tree Project
	strvROrderId = Inputs.GetProperty(&quot;Order Item Id&quot;);//Changed
	strconnectiontype = Inputs.GetProperty(&quot;VF ConnectionType&quot;);
	strmsisdn = Inputs.GetProperty(&quot;VF MSISDN TBUI&quot;);//Changed
	strsim = 	Inputs.GetProperty(&quot;VF SIM TBUI&quot;);//Changed
	strReservationId = Inputs.GetProperty(&quot;Reservation Id&quot;);
	strReservationStatus = Inputs.GetProperty(&quot;Reservation Status&quot;);
	strportin = Inputs.GetProperty(&quot;VF Port In TBUI&quot;);//Changed
	strimei = Inputs.GetProperty(&quot;VF IMEI TBUI&quot;);//Changed
	strPortindob = 	Inputs.GetProperty(&quot;VF Port In - DOB TBUI&quot;);//Changed
	strportinserno = Inputs.GetProperty(&quot;VF Port In - Service Number TBUI&quot;);//Changed
	strportinserac = Inputs.GetProperty(&quot;VF Port In - Service Account TBUI&quot;);//Changed
	strorderid = Inputs.GetProperty(&quot;Order Header Id&quot;);//Changed
	strAccId = Inputs.GetProperty(&quot;Customer Account Id&quot;);//Changed
	strstockindicator = Inputs.GetProperty(&quot;VF Stock Indicator TBUI&quot;);//Changed
	strbillingact=Inputs.GetProperty(&quot;Billing Account Id&quot;);//Chaned
	strProposition=Inputs.GetProperty(&quot;Product Id&quot;);//Changed
	strordersubtype = Inputs.GetProperty(&quot;VF Order Type TBUI&quot;);//TARIQ - Changed //VF Order Sub Type TBUI
	strHandset = Inputs.GetProperty(&quot;VF Device TBUI&quot;);//Changed
	strInitialised = Inputs.GetProperty(&quot;Initialised&quot;);//TARIQ-25SEP2014-Retrieving the initialized attribute
	var stresim = Inputs.GetProperty(&quot;eSIM Download&quot;);// vasavi 18/07/2022 Added for tree Project
	var strsimtype = Inputs.GetProperty(&quot;Shipping&quot;);// vasavi 18/07/2022 Added for tree Project
	var sSIMType = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;FM_SHIPPING&quot;, &quot;eSIM&quot;);// vasavi 18/07/2022 Added for tree Project
	var strPortInPrepay = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_WIZ_MSISDN_SOURCE&quot;, &quot;Port In - Prepay&quot;);
	var strPortInPostpay = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_WIZ_MSISDN_SOURCE&quot;, &quot;Port In - Postpay&quot;);
	var strNewNumber = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_WIZ_MSISDN_SOURCE&quot;, &quot;New&quot;);
	var sOutOfStockLater = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_WIZ_CON_STOCK_INDICATOR&quot;, &quot;Out of Stock - Connect Later&quot;);
	var sInStock = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_WIZ_CON_STOCK_INDICATOR&quot;, &quot;In Stock&quot;);
	var sCJ_SERVICE_NOT_FOUND = &quot;The MSISDN entered to be ported in does not exist in the CJ MSISDN List. Please check and re-enter the correct CJ&apos;s MSISDN.&quot;;
	var BYO_ERROR = &quot;9013&quot;;
	var sSIM_FBB_ERROR = &quot;9026&quot;;
	var sBYO_STCK_INDICATOR = &quot;VFErrorCode#9013&quot; + &quot; - &quot; +  TheApplication().LookupMessage(&quot;User Defined Errors&quot;, BYO_ERROR);	
	var sSIM_FBB_ERROR_MSG = &quot;VFErrorCode#9026&quot; + &quot; - &quot; +  TheApplication().LookupMessage(&quot;User Defined Errors&quot;, sSIM_FBB_ERROR);	
	var sErrMsg =&quot;&quot;;
	var sRaiseError=&quot;N&quot;;
	//ADUTTA:Archadiyan Modem.
	var bkpFlag = &quot;&quot;;
	var sModemSKUCode = &quot;&quot;;
	if(strorderid != &quot;&quot; &amp;&amp; strvROrderId != &quot;&quot;)
	{
		var sSearchspec = &quot;&quot;;	
		var boOrderFBB = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;); 
		var bcOrderFBB = boOrderFBB.GetBusComp(&quot;VF Order Entry - Orders Thin BC&quot;);
		var bcOrderItemsFBB = boOrderFBB.GetBusComp(&quot;VF Order Line Items - Thin BC&quot;);
		var sNBNOnly = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_FBB_PROPOSITION_TYPE&quot;,&quot;FBB Only&quot;);
		var sNBNwithMBB = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_FBB_PROPOSITION_TYPE&quot;,&quot;FBB with MBB&quot;);
		sSearchspec = &quot;[Order Header Id] = &apos;&quot; + strorderid + &quot;&apos; AND [Id] = &apos;&quot; + strvROrderId + &quot;&apos; AND [Action Code] &lt;&gt; &apos;Delete&apos; AND ([VF Siebel Product Type] = &apos;&quot; + sNBNOnly + &quot;&apos; OR [VF Siebel Product Type] = &apos;&quot; + sNBNwithMBB + &quot;&apos;)&quot;;

		bcOrderFBB.SetViewMode(AllView);
		bcOrderFBB.ClearToQuery();
		bcOrderFBB.SetSearchSpec(&quot;Id&quot;,strorderid);
		bcOrderItemsFBB.SetSearchExpr(sSearchspec);	
		bcOrderItemsFBB.ExecuteQuery(ForwardOnly);
		if(bcOrderItemsFBB.FirstRecord())
		{
			var bsSvc = TheApplication().GetService(&quot;VHA Fibre Upgrade Processing Ext Service&quot;); 
			var inp1 = TheApplication().NewPropertySet();
			var out1 = TheApplication().NewPropertySet(); 
			inp1.SetProperty(&quot;OrderId&quot;,strorderid);
			inp1.SetProperty(&quot;StockIndicator&quot;,strstockindicator);
			inp1.SetProperty(&quot;IMEI&quot;,strimei);
			inp1.SetProperty(&quot;Device&quot;,strHandset);
			inp1.SetProperty(&quot;RootOrderItemId&quot;,strvROrderId);
			bsSvc.InvokeMethod(&quot;SkipAutoAllocateSIM&quot;, inp1, out1);
			bkpFlag = out1.GetProperty(&quot;BackupFlag&quot;);
			sModemSKUCode = out1.GetProperty(&quot;ModemSKUCode&quot;);		
		}
	 }

	//23/2/2017 Muthushankari - Added for PIPE
	var sFBBOnly = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_FBB_PROPOSITION_TYPE&quot;,&quot;FBB Only&quot;);
	var boOrder = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;); 
	var bcOrd = boOrder.GetBusComp(&quot;Order Entry - Orders&quot;);//ADUTTA Archadiyan Modem  
	var sProductBC = boOrder.GetBusComp(&quot;VF Internal Product TBUI&quot;); 
	var searchspecSIM = &quot;[Id] = &apos;&quot;+strProposition+&quot;&apos; AND [Siebel Product Type] = &apos;&quot;+sFBBOnly+&quot;&apos;&quot;;
	var sFBBOnly = &quot;N&quot;;	
	with(sProductBC)
	{
		SetViewMode(AllView);
		ClearToQuery();			
		SetSearchExpr(searchspecSIM);
		ExecuteQuery(ForwardOnly);
		if(FirstRecord())
		{
			sFBBOnly = &quot;Y&quot;;
		}
	}
    //ADUTTA Archadiyan Modem
	/*
	var sFWA = &quot;N&quot;;
	var sOrderId = strorderid;
	var sTBUIFWA = GetFWAFlowName(sOrderId,bcOrd);
	if(sTBUIFWA == &quot;ConnectFWA&quot;)
	{ 
       sFWA = &quot;Y&quot;;
	}
	*/
	if((strReservationId != &quot;&quot; &amp;&amp; strReservationId != null) &amp;&amp; strReservationStatus!=&quot;Reserved&quot;)
		return(&quot;Please check the Store Reservations&quot;);
	
	if(((strconnectiontype == &quot;&quot;) || (strconnectiontype == null)))
	
	{
		//Outputs.SetProperty(&quot;ErrMsg&quot;,sCONN_TYPE_ERR_MSG);
		return(sCONN_TYPE_ERR_MSG);
	}
	
	
	if(((strstockindicator == &quot;&quot;) || (strstockindicator == null)))
	
	{
		//Outputs.SetProperty(&quot;ErrMsg&quot;,sSTOCK_IND_ERR_MSG);
		return(sSTOCK_IND_ERR_MSG);
	}
	
	if(((strportin == &quot;&quot;) || (strportin == null)))
	
	{
		//Outputs.SetProperty(&quot;ErrMsg&quot;,sMSISDN_SOURCE_ERR_MSG);
		return(sMSISDN_SOURCE_ERR_MSG);
	}
	
	if(strstockindicator != &quot;In Stock&quot; &amp;&amp; strportin != &quot;No&quot;)
	{
		sINVALID_COMBI = strportin+&quot; AND &quot;+ strstockindicator+&quot; is not a valid combination&quot;;
		return(sINVALID_COMBI);
	}
	switch (strconnectiontype)
		{			
			//Check for required fields based on the Connection Type.
			case &quot;Plan and Device&quot;:	
				SIMOLov = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CR_ENABLE_FLAG&quot;,&quot;SIMO_TWO_DOT_ZERO&quot;);//25062025:RAJUD:Added LOV switch check. 
				if(SIMOLov == &quot;SIMO_TWO_DOT_ZERO_Y&quot;)
				{
					//TRISHAG added for simo
					with(sProductBC)
					{
						SetViewMode(AllView);
						ClearToQuery();			
						SetSearchSpec(&quot;Id&quot;,strProposition);
						ExecuteQuery(ForwardOnly);
						if(FirstRecord())
						{
							sPrLine = GetFieldValue(&quot;Product Line&quot;);
						}
					}
				 }//end RAJUD
				if (strstockindicator == sInStock)
				{
					//if (strimei == &quot;&quot; &amp;&amp; (strReservationId ==&quot;&quot; || strReservationId == null))
					if (strimei == &quot;&quot; &amp;&amp; (strReservationId ==&quot;&quot; || strReservationId == null) &amp;&amp; (sPrLine != sProdLine))
					{
						//Outputs.SetProperty(&quot;ErrMsg&quot;,sIMEI_ERR_MSG);
						return(sIMEI_ERR_MSG);
	
					}
				}
				else
				{
					if (strHandset == &quot;&quot;)
					{
						//Outputs.SetProperty(&quot;ErrMsg&quot;,sHANDSET_ERR_MSG);
						return(sHANDSET_ERR_MSG);
					}
					
					//TARIQ-05SEP2014-Added to force the user to deallocate IMEI for out of stock scenario
					if (strimei != &quot;&quot; &amp;&amp; strimei != null)
					{
						//Outputs.SetProperty(&quot;ErrMsg&quot;,sIMEI_ERR_MSG);
						return(sIMEI_DONT_FILL_MSG);
	
					}
					//Added for tree Project
					if (stresim == &quot;&quot;  &amp;&amp; strsimtype == sSIMType)
					{
						return(seSIM_ERR_MSG);
					}
				}
				
				if (strbillingact == &quot;&quot;)
				{
						//Outputs.SetProperty(&quot;ErrMsg&quot;,sBA_ERR_MSG);
						return(sBA_ERR_MSG);
				}
				
				if ((strstockindicator != sOutOfStockLater) &amp;&amp; (sFBBOnly != &quot;Y&quot; || (sModemSKUCode != &quot;&quot; &amp;&amp; sModemSKUCode != null)))//Muthushankari - Added for PIPE
				{
					if (strsim == &quot;&quot; &amp;&amp; (strReservationId ==&quot;&quot; || strReservationId == null))
					{
					 if((sModemSKUCode != &quot;&quot; &amp;&amp; sModemSKUCode != null &amp;&amp; bkpFlag !=&quot;N&quot;) || sModemSKUCode == &quot;&quot;)//Added backup flag Archadiyan
					 {
						//Outputs.SetProperty(&quot;ErrMsg&quot;,sSIM_ERR_MSG);
						return(sSIM_ERR_MSG);
					  }
					}
				}
				//TARIQ-05SEP2014-Added to force the user to deallocate the SIM for Out of Stock - Connect Later
				else
				{
					if (strsim != &quot;&quot; &amp;&amp; strsim != null)
					{
						if (strstockindicator != sOutOfStockLater &amp;&amp; sFBBOnly == &quot;Y&quot; &amp;&amp; sModemSKUCode == &quot;&quot;)
						{
						if(sModemSKUCode == &quot;&quot;)
						{
                            if ((strimei == &quot;&quot; || strimei == null) &amp;&amp; (strHandset == &quot;&quot; || strHandset == null))
							return(sSIM_FBB_ERROR_MSG);
						 }
						}
						else	//Outputs.SetProperty(&quot;ErrMsg&quot;,sSIM_ERR_MSG);
							return(sSIM_DONT_FILL_MSG);
					}
				}
				if(strNewNumber == strportin)
				{
						if ((strmsisdn == &quot;&quot;) || (strmsisdn == null))
						{
						   //Outputs.SetProperty(&quot;ErrMsg&quot;,sMSISDN_ERR_MSG);
						   return(sMSISDN_ERR_MSG);
						}
				
				}	
				else
				{
						if ((strportinserno == &quot;&quot;) || (strportinserno == null))
						{
						   //Outputs.SetProperty(&quot;ErrMsg&quot;,sMSISDN_ERR_MSG);
						   return(sMSISDN_ERR_MSG);
						}
				}
					
				break;
				
				
			case &quot;SIM Only&quot;:
				if (strbillingact == &quot;&quot;)
				{
						//Outputs.SetProperty(&quot;ErrMsg&quot;,sBA_ERR_MSG);
						return(sBA_ERR_MSG);
				}
				
				if((strimei != &quot;&quot;) &amp;&amp; (strimei != null))
				{
						//Outputs.SetProperty(&quot;ErrMsg&quot;,sDEALLOCATE_IMEI);
						return(sDEALLOCATE_IMEI);
				}
				
				if ((strstockindicator != sOutOfStockLater) &amp;&amp; (sFBBOnly != &quot;Y&quot; || (sModemSKUCode != &quot;&quot; &amp;&amp; sModemSKUCode != null)))//Muthushankari - Added for PIPE
				{
				if(sModemSKUCode != &quot;&quot; &amp;&amp; sModemSKUCode != null &amp;&amp; bkpFlag == &quot;Y&quot; &amp;&amp; strsim == &quot;&quot;)//Arcadiyan
						return(sSIM_ERR_MSG);
					else if (strsim == &quot;&quot;)
					{
						//Outputs.SetProperty(&quot;ErrMsg&quot;,sSIM_ERR_MSG);
						return(sSIM_ERR_MSG);
					}
				}
				
				if(strNewNumber == strportin)
				{
						if ((strmsisdn == &quot;&quot;) || (strmsisdn == null))
						{
						   //Outputs.SetProperty(&quot;ErrMsg&quot;,sMSISDN_ERR_MSG);
						   return(sMSISDN_ERR_MSG);
						}
				
				}	
				else
				{
						if ((strportinserno == &quot;&quot;) || (strportinserno == null))
						{
						   //Outputs.SetProperty(&quot;ErrMsg&quot;,sMSISDN_ERR_MSG);
						   return(sMSISDN_ERR_MSG);
						}
				}							
				break;	
			case &quot;Bring Your Device&quot;://Muthushankari - Added for PIPE
				if ((strmsisdn == &quot;&quot;) || (strmsisdn == null))
				{
						   return(sMSISDN_ERR_MSG);
				}
				if ((strstockindicator != sOutOfStockLater) &amp;&amp; (sFBBOnly != &quot;Y&quot; || (sModemSKUCode != &quot;&quot; &amp;&amp; sModemSKUCode != null)))
				{
				if(sModemSKUCode != &quot;&quot; &amp;&amp; sModemSKUCode != null &amp;&amp; bkpFlag == &quot;Y&quot; &amp;&amp; strsim == &quot;&quot;)//Arcadiyan
						return(sSIM_ERR_MSG);
					else if (strsim == &quot;&quot;)
					{
						return(sSIM_ERR_MSG);
					}
				}
				if (strstockindicator == sOutOfStockLater)
					return(sBYO_STCK_INDICATOR);
					
				break;
		}
		
				//A Proposition is always requried
		if (strProposition == &quot;&quot;)
		{
			//Outputs.SetProperty(&quot;ErrMsg&quot;,sPROP_ERR_MSG);
			return(sPROP_ERR_MSG);
		}	
		
		
		//If a Port In check required fields
		if (strordersubtype == &quot;New Connection&quot; &amp;&amp; strNewNumber != strportin)
		{
			//TARIQ - 25SEP2014 - For forcing the user to choose In stock for Port In scenario
			if (strstockindicator != sInStock)
			{
				return(sPORT_CONNECT_TYPE_ERR_MSG);
			}
			//Prepay
			if(strPortInPrepay == strportin &amp;&amp; strPortindob == &quot;&quot;)
			{
				//Outputs.SetProperty(&quot;ErrMsg&quot;,sDOB_ERR_MSG);
				return(sDOB_ERR_MSG);
			}
			//Postpay
			else if(strPortInPostpay == strportin &amp;&amp; strportinserac == &quot;&quot;)
			{
				//Outputs.SetProperty(&quot;ErrMsg&quot;,sACC_NUM_ERR_MSG);
				return(sACC_NUM_ERR_MSG);
			}
		}
		
 	 //if((strProposition != &quot;&quot;) &amp;&amp; (strProposition != null))
	    if (((strProposition != &quot;&quot;) &amp;&amp; (strProposition != null)) &amp;&amp; (strconnectiontype != &quot;Account Level Proposition&quot;)) // 1/sep/2014:Commented for defect 2088
		{
			/*var psInputs = TheApplication().NewPropertySet();
			var psOutputs = TheApplication().NewPropertySet();
			var bscustomize = TheApplication().GetService(&quot;VHA Interactive Service&quot;);
			//if(TheApplication().GetProfileAttr(&quot;ViewName&quot;) == &quot;FifthView&quot;) // Added for defect 2156
			//{
				psInputs.SetProperty(&quot;Order Id&quot;, strorderid);
				bscustomize.InvokeMethod(&quot;CheckInitialisedAttribute&quot;,psInputs, psOutputs);
				vOLICustomised = psOutputs.GetProperty(&quot;Initialised&quot;);*/
			/*}
			else
			{
				psInputs.SetProperty(&quot;vOrderId&quot;, strorderid);
				psInputs.SetProperty(&quot;vROrderId&quot;, strvROrderId);
				bscustomize.InvokeMethod(&quot;CheckOLICustomised&quot;, psInputs, psOutputs);
				vOLICustomised = psOutputs.GetProperty(&quot;vOLICustomised&quot;);
			}vOLICustomised=&quot;Y&quot;;//TARIQ-ForTesting	*/
		/*	if(strInitialised != &quot;Yes&quot;)
			{
				//Outputs.SetProperty(&quot;ErrMsg&quot;,sPLAN_CHECK_MSG);
				return(sPLAN_CHECK_MSG);
			}*/
			
		}
		return(&quot;&quot;);//TARIQ-Successful Response

}	
	catch (e)
	{
		throw e;
	}
	finally
	{
	/*Below variables are nullified by Sharukh on 18/03/2019*/
	sProductBC = null;
	boOrder = null;
	sPrLine = null;
	SIMOLov=null;
	
	}
}"
			   SEQUENCE="121"
			   UPDATED="01/09/2026 15:43:20"
			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 15:43:20"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mValidateSharingProposition"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mValidateSharingProposition (OrderId)
{
	/*
	* Component Name        : 	mValidateSharingProposition
	* Method Name           : 	
	* Component Information : 	Checks whether the sharing orders have correct shiopment preference
	* Modification History  :
	* Date			Author		Config #		Description
	* ============ ===========	===========		================================
	* 08/02/2016	Roseline	R16.1 MSOD		Defect# 547 - Changed the logic for shipment preference validation
	*/
	try
	{
		//Roseline:08/02/2016 - Added for R16.1 MSOD - Defect# 547
		var sSharingIndicator = &quot;&quot;; 
		var isParent = &quot;N&quot;;
		var isChild = &quot;N&quot;;
		//End
		var boFOrder = TheApplication().GetBusObject(&quot;Order Entry - Simple&quot;);
		var bcFOrder = boFOrder.GetBusComp(&quot;Order Entry - Orders&quot;);
		var bcFOrderLI = boFOrder.GetBusComp(&quot;Order Entry - Line Items (Simple)&quot;);
		var sChildConnection = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_SHARE_FLAG&quot;,&quot;Child Connection&quot;);
		var sParentConnection = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_SHARE_FLAG&quot;,&quot;Parent Connection&quot;);
		bcFOrder.SetViewMode(AllView);
		bcFOrder.ClearToQuery();
		bcFOrder.SetSearchSpec(&quot;Id&quot;, OrderId);
		bcFOrder.ExecuteQuery(ForwardOnly);
		if (bcFOrder.FirstRecord()) 
		{
			//Roseline:08/02/2016 - Added for R16.1 MSOD - Defect# 547
			bcFOrderLI.SetViewMode(AllView);
			bcFOrderLI.ActivateField(&quot;VF Sharing Indicator&quot;);
			bcFOrderLI.ActivateField(&quot;Action Code&quot;);
			bcFOrderLI.ClearToQuery();
			var sSearchExpr = &quot;([VF Sharing Indicator] = &apos;&quot; + sChildConnection + &quot;&apos; OR [VF Sharing Indicator] = &apos;&quot;+sParentConnection+&quot;&apos;) AND [Action Code] &lt;&gt; &apos;Delete&apos;&quot;;
			bcFOrderLI.SetSearchExpr(sSearchExpr);
			bcFOrderLI.ExecuteQuery(ForwardOnly);
			var isRec = bcFOrderLI.FirstRecord();
			while(isRec) 
			{
				var sSharingIndicator = bcFOrderLI.GetFieldValue(&quot;VF Sharing Indicator&quot;);
				if(sSharingIndicator == &quot;Parent Connection&quot;)
				{
					isParent = &quot;Y&quot;;
				}
				if(sSharingIndicator == &quot;Child Connection&quot;)
				{
					isChild = &quot;Y&quot;;
				}
				isRec = bcFOrderLI.NextRecord();
			} //while(isRec) 
			if(isParent == &quot;Y&quot; &amp;&amp; isChild == &quot;Y&quot;)
			{
				isShared = &quot;Y&quot;;
			}
			else
			{
				isShared = &quot;N&quot;;
			}		
		} //if (bcFOrder.FirstRecord()) 
		//End Of Code
		return(CancelOperation);
	}
	catch (e)
	{
		throw e;
	}
	finally
	{
	//Kailash - Modified BO,BC nullification		
		bcFOrder = null;
		bcFOrderLI = null;
		boFOrder = null;
	}
}"
			   SEQUENCE="122"
			   UPDATED="01/09/2026 15:43:20"
			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 15:43:20"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mValidateUpgradeShippingAddress"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mValidateUpgradeShippingAddress(Inputs,Outputs)
{
/*
 * Component Name        : 	VF TBUI MSO Utilities
 * Function Name         : 	mValidateUpgradeShippingAddress
 * Component Information : 	Checks for a shipping address for non dealer upgrades orders
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 15/10/2015	Roseline	R16.1 MSOD	Ensures addresses are not created when matching products dont exist and 
 *										ensures addresses do exist for any device/accessory items and non device items.  
 *										Also added validation to ensure that the primary contact is always populated.
 */
	try
	{
		var	boOrder = TheApplication().GetBusObject(&quot;VF Order Entry Thin BO&quot;);
		var	bcOrder = boOrder.GetBusComp(&quot;VF Order Entry - Orders Thin BC&quot;);
		var	bcOrderLineItems = boOrder.GetBusComp(&quot;VF Order Line Items - Thin BC&quot;);
		var bcFSShipment = boOrder.GetBusComp(&quot;FS Shipment&quot;);
		var sFulfilmentOrderId = Inputs.GetProperty(&quot;Fulfilment Order Id&quot;);
		
		var searchst, sRootId, isRec, sSearchExpr;	
		var sErrMessage;
		
		var DEVICE_PROD_NAME = &quot;Device&quot;;
		var NON_DEVICE_PROD_NAME = &quot;Other Item&quot;;
		var ACCESS_PROD_NAME = &quot;Accessory Item&quot;;
		var SHIPPING_METHOD_FIELD= &quot;Ship Via&quot;
		var BRIGHTPOINT_METHOD = &quot;Brightpoint&quot;;
		var PINPOINT_METHOD = &quot;Pinpoint&quot;;
		var PINPOINT_REASON_CD = &quot;Pinpoint&quot;;
		var BRIGHTPOINT_REASON_CD = &quot;Brightpoint&quot;;
		var COMBINED_REASON_CD = &quot;Combined&quot;;
		var sWBIReasonCd = &quot;&quot;;
		var bOrderItemRecord, sShipToFirstName, sShipToLastName;
		var bShipmentRecord;
		
		with(bcOrderLineItems)
		{
			bcOrderLineItems.SetViewMode(AllView);
			bcOrderLineItems.ActivateField(&quot;Order Header Id&quot;);
			bcOrderLineItems.ActivateField(&quot;Parent Order Item Id&quot;);
			bcOrderLineItems.ActivateField(&quot;Root Order Item Id&quot;);
			bcOrderLineItems.ActivateField(&quot;Product&quot;);
			bcOrderLineItems.ActivateField(&quot;Action Code&quot;);
			bcOrderLineItems.ClearToQuery();
			searchst = &quot;[Order Header Id] = &apos;&quot; + sFulfilmentOrderId + &quot;&apos;AND [Parent Order Item Id] is null AND [Action Code] &lt;&gt; &apos;Delete&apos;&quot;;
			bcOrderLineItems.SetSearchExpr(searchst);
			bcOrderLineItems.ExecuteQuery(ForwardOnly);
			isRec = bcOrderLineItems.FirstRecord();
			if(isRec)
			{
				sRootId = bcOrderLineItems.GetFieldValue(&quot;Id&quot;);
				
				sSearchExpr = &quot;[Root Order Item Id] = &apos;&quot; + sRootId + &quot;&apos; AND ([Product] = &apos;&quot; + DEVICE_PROD_NAME + &quot;&apos; OR &quot; + &quot;[Product] = &apos;&quot; + ACCESS_PROD_NAME + &quot;&apos;)&quot;;
				bcOrderLineItems.SetSearchExpr(sSearchExpr);
				bcOrderLineItems.ExecuteQuery(ForwardOnly);
				bOrderItemRecord = bcOrderLineItems.FirstRecord();
				{
					bcFSShipment.SetViewMode(AllView);
					bcFSShipment.ClearToQuery();
					bcFSShipment.ActivateField(&quot;Primary Order Id&quot;);
					bcFSShipment.ActivateField(SHIPPING_METHOD_FIELD);
					bcFSShipment.ActivateField(&quot;VF Ship To Contact First Name&quot;);
					bcFSShipment.ActivateField(&quot;VF Ship To Contact Last Name&quot;);
					bcFSShipment.SetSearchSpec(&quot;Primary Order Id&quot;,sFulfilmentOrderId);
					bcFSShipment.SetSearchSpec(SHIPPING_METHOD_FIELD,BRIGHTPOINT_METHOD);
					bcFSShipment.ExecuteQuery();
					bShipmentRecord = bcFSShipment.FirstRecord();
					if ((!bShipmentRecord) &amp;&amp; bOrderItemRecord)
					{
						sErrMessage = &quot;Please enter a shipping address for the Device/Accessory items before proceeding.&quot;;
						Outputs.SetProperty(&quot;Message&quot;, sErrMessage);
						Outputs.SetProperty(&quot;Continue&quot;, &quot;N&quot;);
						gContinue = false;
						return(CancelOperation);
					} 
					else if (bShipmentRecord &amp;&amp; (!bOrderItemRecord))
					{
						sErrMessage = &quot;There are no Device/Accessory items.  Please remove the Brightpoint shipping address before proceeding.&quot;;
						Outputs.SetProperty(&quot;Message&quot;, sErrMessage);
						Outputs.SetProperty(&quot;Continue&quot;, &quot;N&quot;);
						gContinue = false;
						return(CancelOperation);					
					} 
					else if (bOrderItemRecord &amp;&amp; bShipmentRecord)
					{
						sShipToFirstName = bcFSShipment.GetFieldValue(&quot;VF Ship To Contact First Name&quot;);
						sShipToLastName = bcFSShipment.GetFieldValue(&quot;VF Ship To Contact Last Name&quot;);	
						if (sShipToFirstName == &quot;&quot; || sShipToFirstName == null || sShipToLastName == &quot;&quot; || sShipToLastName == null )
						{
							sErrMessage = &quot;Please enter a Ship To Contact First Name and Surname for the Brightpoint shipping address before proceeding.&quot;;
							Outputs.SetProperty(&quot;Message&quot;, sErrMessage);
							Outputs.SetProperty(&quot;Continue&quot;, &quot;N&quot;);
							gContinue = false;
							return(CancelOperation);
						}
						sWBIReasonCd = BRIGHTPOINT_REASON_CD;
					}
				}										

				bcOrderLineItems.SetSearchSpec(&quot;Product&quot;,NON_DEVICE_PROD_NAME);
				bcOrderLineItems.SetSearchSpec(&quot;Root Order Item Id&quot;,sRootId);
				bcOrderLineItems.ExecuteQuery();
				bOrderItemRecord = bcOrderLineItems.FirstRecord();
				bcFSShipment.SetViewMode(AllView);
				bcFSShipment.ClearToQuery();				
				bcFSShipment.ActivateField(&quot;Primary Order Id&quot;);
				bcFSShipment.ActivateField(SHIPPING_METHOD_FIELD);
				bcFSShipment.ActivateField(&quot;VF Ship To Contact First Name&quot;);
				bcFSShipment.ActivateField(&quot;VF Ship To Contact Last Name&quot;);
				bcFSShipment.SetSearchSpec(&quot;Primary Order Id&quot;,strOrderId);
				bcFSShipment.SetSearchSpec(SHIPPING_METHOD_FIELD,PINPOINT_METHOD);
				bcFSShipment.ExecuteQuery();
				bShipmentRecord = bcFSShipment.FirstRecord();
				if ((!bShipmentRecord) &amp;&amp; bOrderItemRecord)
				{
					sErrMessage = &quot;Please enter a shipping address for the Non Device before proceeding.&quot;;
					Outputs.SetProperty(&quot;Message&quot;, sErrMessage);
					Outputs.SetProperty(&quot;Continue&quot;, &quot;N&quot;);
					gContinue = false;
					return(CancelOperation);					
				} 
				else if (bShipmentRecord &amp;&amp; (!bOrderItemRecord))
				{
					sErrMessage = &quot;There are no Non Device items.  Please remove the Pinpoint shipping address before proceeding.&quot;;
					Outputs.SetProperty(&quot;Message&quot;, sErrMessage);
					Outputs.SetProperty(&quot;Continue&quot;, &quot;N&quot;);
					gContinue = false;
					return(CancelOperation);									
				} 
				else if (bOrderItemRecord &amp;&amp; bShipmentRecord)
				{				
					sShipToFirstName = bcFSShipment.GetFieldValue(&quot;VF Ship To Contact First Name&quot;);
					sShipToLastName = bcFSShipment.GetFieldValue(&quot;VF Ship To Contact Last Name&quot;);					
					if (sShipToFirstName == &quot;&quot; || sShipToFirstName == null || sShipToLastName == &quot;&quot; || sShipToLastName == null )
					{
						sErrMessage = &quot;Please enter a Ship To Contact First Name and Surname for the Pinpoint shipping address before proceeding.&quot;;
						Outputs.SetProperty(&quot;Message&quot;, sErrMessage);
						Outputs.SetProperty(&quot;Continue&quot;, &quot;N&quot;);
						gContinue = false;
						return(CancelOperation);
					}					
					if(sWBIReasonCd == BRIGHTPOINT_REASON_CD)
						sWBIReasonCd = COMBINED_REASON_CD;
					else
						sWBIReasonCd = PINPOINT_REASON_CD;						
				}
				if(sWBIReasonCd != &quot;&quot;)
				{
					//set connection type field on order
					bcOrder.SetFieldValue(&quot;WBI Reason Code&quot;, sWBIReasonCd);
					bcOrder.WriteRecord();
	
					bcOrderLineItems.SetFieldValue(&quot;VF WBI Reason Code&quot;,sWBIReasonCd);	
					bcOrderLineItems.WriteRecord();
				}
				isRec = bcOrderLineItems.NextRecord();
			}
		}
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		bcFSShipment = null;
		bcOrderLineItems = null;
		bcOrder = null;
		boOrder = null;	
	} 
}"
			   SEQUENCE="123"
			   UPDATED="01/09/2026 15:43:20"
			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 15:43:20"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mWriteProductLineItem"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mWriteProductLineItem(strOrderId,strRootId,psProductDetails)
{
/*
 * Component Name        : 	VF Generic Product Manipulation Service
 * Method Name           : 	mWriteProductLineItem
 * Component Information : 	This function writes product line item and
 *							product attribute records, under the given orderId and
 *							rootLineItemId.
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 17/08/2009	POUSHB					Initial Version - created for use by 
 *										Workflow: VF Upgrade Smartscript Processing 
 * 09/08/2011	KARP	TD#14273		We need to set the LOV Type in the attributes
 * 31/10/2012	EW						Updated for Release 12.6	
 * 12/08/2014    Bharat		Defect #441 - CT Siebel 8.1: Junk Characters in Matrices upload error messages
 */
	try
	{
	
		/******************
		* Declare Variables
		******************/		
		/* Object Variables */
		var boOrder = TheApplication().GetBusObject(&quot;Order Entry&quot;);
		var bcOrder = boOrder.GetBusComp(&quot;Order Entry - Orders&quot;);
		var bcOrderItem = boOrder.GetBusComp(&quot;Order Entry - Line Items&quot;);
		var bcOrderItemXA = boOrder.GetBusComp(&quot;Order Item XA&quot;);	
		var psProductAttribList = TheApplication().NewPropertySet();
		var psProductAttrib = TheApplication().NewPropertySet();
	
		/* Other Variables */
		var strPropositionName;
		var strParOwnerIntId;
		var strLineItemId;
		var strAction = &quot;Add&quot;;
		var strPortItemId;
		var strProdItemId;
		var strItemProductId;
		var strXACfgState;
		var count;
		var childCount = 0;
		var sErrorMessage;
		
	
		/* Set variables based on Input PropertySet Details */
		strPortItemId = psProductDetails.GetProperty(&quot;PortItemId&quot;);
		strProdItemId = psProductDetails.GetProperty(&quot;ProdItemId&quot;);
		strItemProductId = psProductDetails.GetProperty(&quot;ItemProductId&quot;);
		strXACfgState = psProductDetails.GetProperty(&quot;XACfgState&quot;);

		if(psProductDetails.GetChildCount() != 0)
				psProductAttribList = psProductDetails.GetChild(0);


		/******************
		* Query to Check given Order Id 
		* is valid and exists.
		******************/	
		bcOrder.SetViewMode(AllView);
		bcOrder.ClearToQuery();
		bcOrder.SetSearchSpec(&quot;Order Id&quot;, strOrderId);
		bcOrder.ExecuteQuery(ForwardOnly);
		
		/* If Order found */
		if(bcOrder.FirstRecord())
		{
			
			/* Add order Line Item */
			bcOrderItem.NewRecord(NewAfter);
			bcOrderItem.SetFieldValue(&quot;Action Code&quot;, strAction);
			bcOrderItem.SetFieldValue(&quot;Product Id&quot;, strItemProductId); 
			bcOrderItem.SetFieldValue(&quot;Product Port Id&quot;, strPortItemId); 
			bcOrderItem.SetFieldValue(&quot;Prod Item Id&quot;, strProdItemId);	
			bcOrderItem.SetFieldValue(&quot;Root Order Item Id&quot;, strRootId);
			bcOrderItem.SetFieldValue(&quot;Parent Order Item Id&quot;, strRootId);
			bcOrderItem.SetFieldValue(&quot;Order Header Id&quot;, strOrderId);
			bcOrderItem.SetFieldValue(&quot;Cfg State Code&quot;, &quot;User Requested Item&quot;);
			bcOrderItem.SetFieldValue(&quot;VF Line Number&quot;, &quot;&quot;);
			bcOrderItem.SetFieldValue(&quot;VF Configuration Status&quot;, &quot;&quot;);
			
			/* Set Product Line Item Id */
			strLineItemId = bcOrderItem.GetFieldValue(&quot;Id&quot;);
			bcOrderItem.WriteRecord();


			/************************************** 
			* Traverse through Property Set of product
			* attributes and add attributes to the 
			* product line item
			***************************************/
			
			/* Query for Product line Item */
			bcOrderItem.SetViewMode(AllView);
			bcOrderItem.ClearToQuery();
			bcOrderItem.SetSearchSpec(&quot;Id&quot;, strLineItemId);
			bcOrderItem.ExecuteQuery();
			if(bcOrderItem.FirstRecord())
			{
			    
			    /* Add atrribute details - One attribute at a time */ 				    
			    childCount = psProductAttribList.GetChildCount();
    	  		for (count = 0; count &lt; childCount; count++)
	      		{
    	  			psProductAttrib = psProductAttribList.GetChild(count);
	    	  		bcOrderItemXA.NewRecord(NewAfter);
				    bcOrderItemXA.SetFieldValue(&quot;Action Code&quot;, 		strAction);
				    bcOrderItemXA.SetFieldValue(&quot;Attribute Id&quot;, 	psProductAttrib.GetProperty(&quot;NewAttrXAId&quot;));
				    bcOrderItemXA.SetFieldValue(&quot;Name&quot;, 			psProductAttrib.GetProperty(&quot;NewAttrName&quot;));
			    	bcOrderItemXA.SetFieldValue(&quot;Display Name&quot;, 	psProductAttrib.GetProperty(&quot;NewAttrName&quot;));
			    	bcOrderItemXA.SetFieldValue(&quot;Text Value&quot;, 		psProductAttrib.GetProperty(&quot;NewAttrValue&quot;));
			    	bcOrderItemXA.SetFieldValue(&quot;Data Type&quot;, 		psProductAttrib.GetProperty(&quot;NewAttrPropTypeCode&quot;));
				    bcOrderItemXA.SetFieldValue(&quot;Object Id&quot;, 		strLineItemId);
				   /* if (psProductAttrib.GetProperty(&quot;NewAttrLOVType&quot;) != &quot;&quot;) // KARP : 09 AUG 2011	: TD# 14273
				    {
				    	bcOrderItemXA.SetFieldValue(&quot;LOV Type&quot;, psProductAttrib.GetProperty(&quot;NewAttrLOVType&quot;));
				    } */ //Karthika Removed as 8.1 not required this change.
				    
				    // EW Release 12.6
				    if (strXACfgState != &quot;&quot;)
				    {
				    	bcOrderItemXA.SetFieldValue(&quot;Cfg State Code&quot;, strXACfgState);
				    }
				    bcOrderItemXA.WriteRecord();	    	
		      	}
			     	
			}
			else
			{
 				sErrorMessage = &quot;Order Line Item &apos;&quot; + strRootId + &quot;&apos; for Order Id &apos;&quot; 
 								+ strOrderId + &quot;&apos; could not be found. &quot;;
 				throw(sErrorMessage);
			}
		}	
		else
		{
 				sErrorMessage = &quot;Order Id &apos;&quot; + strOrderId +&quot;&apos; could not be found. &quot;;
 				throw(sErrorMessage);
		}			
	}
	catch (e)
	{
		if (defined(e.errText))
		{
			var strError = e.errText + &quot;\r\n&quot; + e.toString(); 
		}
		else
		{
			var strError = e.toString(); 
		}
		throw (strError);
	}
	finally
	{
		/* Destroy Objects */
		psProductAttrib = null;
		psProductAttribList = null;
		bcOrderItemXA = null;
		bcOrderItem = null;
		bcOrder = null;
		boOrder  = null;
	}
}"
			   SEQUENCE="124"
			   UPDATED="01/09/2026 15:43:20"
			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 15:43:20"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
		</BUSINESS_SERVICE>
	</PROJECT>
</REPOSITORY>



