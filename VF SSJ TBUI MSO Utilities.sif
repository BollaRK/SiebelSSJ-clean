			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mSetMSISDN"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mSetMSISDN(sFulfilOrderId,sNewMSISDNId,sRootOrderItemId)
{
/*
 * Component Name        :      VHA MSOD Utilities
 * Function Name         :      mSetMSISDN
 * Component Information :      Sets MSISDN in Fulfilment Line items
 * Modification History  :
 * Date                 Author          Config #        Description
 * ============ ===========     ===========     ================================
 * 03/11/2015   Roseline        R16.1 MSOD      Initial Version
 */
     try
     {
     	 var bcOrderLineItemsDevice;
         var boOrder = TheApplication().GetBusObject(&quot;VF Order Entry Thin BO&quot;);
         var bcOrder = boOrder.GetBusComp(&quot;VF Order Entry - Orders Thin BC&quot;);
         var bcOrderLineItems = boOrder.GetBusComp(&quot;VF Order Line Items - Thin BC&quot;);

         bcOrder.SetViewMode(AllView);
         bcOrder.ClearToQuery();
         bcOrder.SetSearchSpec(&quot;Id&quot;, sFulfilOrderId);
         bcOrder.ExecuteQuery(ForwardOnly);
         if (bcOrder.FirstRecord())
         {
             bcOrderLineItems.SetViewMode(AllView);
             bcOrderLineItems.ActivateField(&quot;Parent Order Item Id&quot;);
             bcOrderLineItems.ActivateField(&quot;Order Header Id&quot;);
             bcOrderLineItems.ActivateField(&quot;Related Service Order Id&quot;);
             bcOrderLineItems.ClearToQuery();
             bcOrderLineItems.SetSearchSpec(&quot;Order Header Id&quot;,sFulfilOrderId);
             bcOrderLineItems.SetSearchSpec(&quot;Parent Order Item Id&quot;, &quot;IS NULL&quot;);
			 bcOrderLineItems.SetSearchSpec(&quot;Related Service Order Id&quot;, sRootOrderItemId);
             bcOrderLineItems.ExecuteQuery(ForwardOnly);
             var isRecord = bcOrderLineItems.FirstRecord();
             if (isRecord)
             {
                 var sFRootLineItemId = bcOrderLineItems.GetFieldValue(&quot;Id&quot;);
                             
                  bcOrderLineItemsDevice = boOrder.GetBusComp(&quot;VF Order Line Items - Thin BC&quot;);
				  bcOrderLineItemsDevice.SetViewMode(AllView);
                  bcOrderLineItemsDevice.ActivateField(&quot;New MSISDN Id&quot;);
                  bcOrderLineItemsDevice.ActivateField(&quot;Parent Order Item Id&quot;);
                  bcOrderLineItemsDevice.ActivateField(&quot;Product&quot;);
                  bcOrderLineItemsDevice.ClearToQuery();
                  bcOrderLineItemsDevice.SetSearchSpec(&quot;Product&quot;, &quot;Device&quot;);
				  bcOrderLineItemsDevice.SetSearchSpec(&quot;Parent Order Item Id&quot;, sFRootLineItemId);
                  bcOrderLineItemsDevice.ExecuteQuery(ForwardOnly);
                  var bRecordExists = bcOrderLineItemsDevice.FirstRecord();
                  if(bRecordExists)
				  {
					bcOrderLineItemsDevice.SetFieldValue(&quot;New MSISDN Id&quot;, sNewMSISDNId);
					bcOrderLineItemsDevice.WriteRecord();
				  }
          	}//if(isRecord)
   		}//end of If
        return(CancelOperation);
     }// end try
     catch(e)
     {
             if (defined(e.errText))
             {
                     var strError = e.errText + &quot;\r\n&quot; + e.toString();
             }
             else
             {
                     var strError = e.toString();
             }
             throw (strError);
     }
     finally
     {
             // Destroy object
			 bcOrderLineItemsDevice = null;
             bcOrderLineItems = null;
             bcOrder = null;
             boOrder = null;




     }


}"
			   SEQUENCE="104"
			   UPDATED="01/09/2026 15:43:19"
			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 15:43:19"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mSubmitOrder"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mSubmitOrder(psInputs)
{
	/* Component Name        : 	TBUI - mSubmitOrder
	* Component Information : 	This method is to validate whether the &quot;MPP Product&quot; is added to an order
	* Modification History  :
	* Date			Author		Config #	Description
	* ============ ===========	===========	================================
	* 30/05/2014	Neel 		Initial Draft Version - Cloned from VF Wizard Utilities with necessary changes to remove Wizard BO reference
	*/
	
	try
	{
		var strError = &quot;&quot;
		var strOrderId = psInputs.GetProperty(&quot;Order Id&quot;);
		var strReasonCode = psInputs.GetProperty(&quot;Reason Code&quot;);
		var strComments = psInputs.GetProperty(&quot;Comments&quot;);
		var strCalculateCharges = psInputs.GetProperty(&quot;Calculate Charges&quot;);
		var strExternalCustAccNum = psInputs.GetProperty(&quot;External Customer Account&quot;);
		var strCJPortedInMSISDN = psInputs.GetProperty(&quot;Ported MSISDN&quot;);		
		TheApplication().SetProfileAttr(&quot;VFWizardSkipChargesViewFlg&quot;,&quot;FALSE&quot;);//VF CMA Siebel 8.1.x upg proj
		

	
		
		var bsCalcCharges = TheApplication().GetService(&quot;VF Calculate Charges Service MSO&quot;);
		var boSalesOrder = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
		var bcOrders = boSalesOrder.GetBusComp(&quot;Order Entry - Orders&quot;);

		
		with(bcOrders)
		{
			ClearToQuery();
			SetViewMode(AllView);
			ActivateField(&quot;Display Reason Code&quot;);
			ActivateField(&quot;Description&quot;);
			ActivateField(&quot;Updated Non UTC&quot;);
			ActivateField(&quot;VF Calculate Charges DateTime&quot;);
			ActivateField(&quot;VF Submit Method&quot;);
			ActivateField(&quot;Status&quot;);
			ActivateField(&quot;Order Sub Type&quot;); //VF CMA Siebel 8.1.x upg proj
			
			SetSearchSpec(&quot;Id&quot;, strOrderId);
			
			// EW 11.D - Only do this if the status of the order is pending
			SetSearchSpec(&quot;Status&quot;, &quot;Pending&quot;);
			ExecuteQuery(ForwardOnly);

			if(FirstRecord())
			{
				//Calculate Charges
				if (strCalculateCharges == &quot;Y&quot;)
				{
					InvokeMethod(&quot;CalculateCharges&quot;);
				}

				//Set required fields on Order 
				if(strReasonCode != &quot;&quot;)
				{
					SetFieldValue(&quot;Display Reason Code&quot;, strReasonCode);
				}

				if(strComments != &quot;&quot;)
				{
					SetFieldValue(&quot;Description&quot;, strComments);
				}
				//SetFieldValue(&quot;VF Submit Method&quot;, &quot;Siebel Express&quot;);
				SetFieldValue(&quot;VF Submit Method&quot;, &quot;TBUI&quot;);//Neel Changed to identified TBUI process
				WriteRecord();

		 		// As the order&apos;s been updated after the calculate charges has been pressed
		 		// then we need to reset the calculation time.  We can do this because we are in the
	 			// wizard and have definitely visited the manage offer page and calculated charges
	 			// already.  There&apos;s no calculate charges button on the final page so this needs
	 			// to be bypassed
	 			
	 			//psInputs = TheApplication().NewPropertySet();
	 			//psOutputs = TheApplication().NewPropertySet();
	 			
	 			var psInputsUpdCalc = TheApplication().NewPropertySet();
				var psOutputsUpdCalc = TheApplication().NewPropertySet();
				
				psInputsUpdCalc.SetProperty(&quot;Order Id&quot;, strOrderId);
				
				bsCalcCharges.InvokeMethod(&quot;UpdateCalcDateTime&quot;, psInputsUpdCalc, psOutputsUpdCalc);
					
				// Need to requery the order because this business service creates a new instance
				ClearToQuery();
				SetViewMode(AllView);
				SetSearchSpec(&quot;Id&quot;, strOrderId);
				ExecuteQuery(ForwardOnly);

				//Call Submit Order
				InvokeMethod(&quot;VFSubmitOrder&quot;);
				
				if (strCJPortedInMSISDN !=&quot;&quot; &amp;&amp; strExternalCustAccNum !=&quot;&quot;)
				{
					mSetCJServiceMigratedFlg(strCJPortedInMSISDN);
				}
			}
	 	//VHA Balamurugan 15/06/2020 -Added for PKE000000080834
	  	 else
			{
			var sErrorMessage = TheApplication().LookupMessage(&quot;User Defined Errors&quot;,&quot;09303&quot;)
			throw(sErrorMessage);
			}//ends here
		}

	}
	catch(e)
	{
		//throw(e);
		if (defined(e.errText))
		{
			strError = e.errText; 
		}
		else
		{
			strError = ToString(e); 
		}
		
		throw (strError);
	}
	finally
	{
		bcOrders = null;
		boSalesOrder = null;
	//	psOutputs = null;
		psOutputsUpdCalc = null;
		psInputsUpdCalc = null;
		psInputs = null;
		bsCalcCharges = null;
		
	
	}

}"
			   SEQUENCE="105"
			   UPDATED="01/09/2026 15:43:19"
			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 15:43:19"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mSubmitOrder_LinkageId"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mSubmitOrder_LinkageId(Inputs) 
{
/* Component Name        : 	mSyncAccount_LinkageId
* Component Information : 	This method is to Get the Linkage Id for Account Sync API
* Modification History  :
* Date			Author		Config #	  Description
* ============ ===========	===========	  ================================
* 06/04/2016	Trisha 		Initial Draft In case order is submitted for account type as Consumer - Person , Linkage Id will be the Customer account id of Business - Sole Trader for the same contact and vice versa.
  
*/

    var boOrder=null,
    bcOrder=null,
    bcAccountContact=null,
    bcAccount=null,
    sOrderId=&quot;&quot;,
    isRecord=null,
    sCon = &quot;&quot;,
    sAcc = &quot;&quot;,
    sType = &quot;&quot;,
    searchst1 = &quot;&quot;,
    sAccount = &quot;&quot;,
    sMasterAcId = &quot;&quot;;
    try {
        boOrder = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
        bcOrder = boOrder.GetBusComp(&quot;Order Entry - Orders&quot;);
        bcAccountContact = boOrder.GetBusComp(&quot;Account Contact&quot;);
        bcAccount = boOrder.GetBusComp(&quot;Account&quot;);
        sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
        isRecord = false;
        with (bcOrder) {
            ActivateField(&quot;Account Id&quot;);
            ActivateField(&quot;VF Order Acct Contact Id&quot;);
            ClearToQuery();
            SetViewMode(AllView);
            SetSearchSpec(&quot;Id&quot;, sOrderId);
            ExecuteQuery(ForwardOnly);
            if (FirstRecord()) {
                sCon = GetFieldValue(&quot;VF Order Acct Contact Id&quot;);
                sAcc = GetFieldValue(&quot;Account Id&quot;);
                if (sAcc) {
                    with (bcAccount) {
                        ActivateField(&quot;VF Customer Type&quot;);
                        ClearToQuery();
                        SetViewMode(AllView);
                        SetSearchSpec(&quot;Id&quot;, sAcc);
                        ExecuteQuery();
                        if (FirstRecord()) {
                            sType = GetFieldValue(&quot;VF Customer Type&quot;);
                        }
                    }
                }
                if (sCon) {
                    with (bcAccountContact) {
                        ActivateField(&quot;Contact Id&quot;);
                        ActivateField(&quot;Account Id&quot;);
                        ClearToQuery();
                        SetViewMode(AllView);
                        SetSearchSpec(&quot;Contact Id&quot;, sCon);
                        ExecuteQuery();
                        isRecord = FirstRecord();
                        while (isRecord) {
                            sAccount = GetFieldValue(&quot;Account Id&quot;);
                            if (sType == &quot;Sole Trader&quot;)
                                searchst1 = &quot;[Id] = &apos;&quot; + sAccount + &quot;&apos; AND [VF Customer Type] =&apos;Person&apos;&quot;;
                            else if (sType == &quot;Person&quot;)
                                searchst1 = &quot;[Id] = &apos;&quot; + sAccount + &quot;&apos; AND [VF Customer Type] =&apos;Sole Trader&apos;&quot;;
							else
								searchst1 = &quot;[Id] =&apos;ABCDE&apos;&quot;; //10062025 : RAJUD: Added this else condition for defect CM-3770
                            with (bcAccount) {
                                ActivateField(&quot;VF Customer Type&quot;);
                                ActivateField(&quot;Master Account Id&quot;);
                                ClearToQuery();
                                SetViewMode(AllView);
                                SetSearchExpr(searchst1);
                                ExecuteQuery();
                                if (FirstRecord()) {
                                    sMasterAcId = GetFieldValue(&quot;Master Account Id&quot;);
									break;
                                }
                            }
                            isRecord = NextRecord();
                        }
                    }
                }
            }
        }
        return (sMasterAcId);
    } catch (e) {
        throw e;
    } finally {
        bcAccount = null;
        bcAccountContact = null;
        bcOrder = null;
        boOrder = null;
    }
}"
			   SEQUENCE="106"
			   UPDATED="01/09/2026 15:43:19"
			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 15:43:19"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mSyncAccount_LinkageId"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mSyncAccount_LinkageId(Inputs) 
{
/* Component Name        : 	mSyncAccount_LinkageId
* Component Information : 	This method is to Get the Linkage Id for Account Sync API
* Modification History  :
* Date			Author		Config #	  Description
* ============ ===========	===========	  ================================
* 06/04/2016	Trisha 		Initial Draft In case of updates for account type as Consumer - Person , Linkage Id will be the Customer account id of Business - Sole Trader for the same contact and vice versa.
  
*/

	var boAccount = null,sId=&quot;&quot;,
    bcAccountContact = null,isRecord =null,
    bcAccount = null,sAccId=&quot;&quot;,sAccType=&quot;&quot;,bcAccount1=null,
    sType = &quot;&quot;,
    sContactId = &quot;&quot;,
    searchst1 = &quot;&quot;,
    sAccount = &quot;&quot;,
    sMasterAcId = &quot;&quot;;
try 
{
        boAccount = TheApplication().GetBusObject(&quot;Account&quot;);
        bcAccountContact = boAccount.GetBusComp(&quot;Account Contact&quot;);
        bcAccount = boAccount.GetBusComp(&quot;Account&quot;);
        sContactId = Inputs.GetProperty(&quot;ContactId&quot;);
		sId = Inputs.GetProperty(&quot;sAccId&quot;);
		if (sId) 
		{
                    with (bcAccount) 
					{
						ActivateField(&quot;Master Account Id&quot;);
                        ClearToQuery();
                        SetViewMode(AllView);
                        SetSearchSpec(&quot;Id&quot;, sId);
                        ExecuteQuery();
                        if (FirstRecord()) 
						{
							sAccId =GetFieldValue(&quot;Master Account Id&quot;);
							
                        }
                    }
					with (bcAccount) 
					{
                        ActivateField(&quot;VF Customer Type&quot;);
						ClearToQuery();
                        SetViewMode(AllView);
                        SetSearchSpec(&quot;Id&quot;, sAccId);
                        ExecuteQuery();
                        if (FirstRecord()) 
						{
                            sType = GetFieldValue(&quot;VF Customer Type&quot;);
							
                        }
                    }
       }//end sId
 
        if (sContactId)
		{
                        if (sType == &quot;Sole Trader&quot;)
                            searchst1 = &quot;[Primary Contact Id] = &apos;&quot; +  sContactId  + &quot;&apos; AND [VF Customer Type] = &apos;Person&apos;&quot;;
                        else if (sType == &quot;Person&quot;)
                            searchst1 = &quot;[Primary Contact Id] = &apos;&quot; +  sContactId  + &quot;&apos; AND [VF Customer Type] = &apos;Sole Trader&apos;&quot;;
						else
								searchst1 = &quot;[Id] =&apos;ABCDE&apos;&quot;; //10062025 : RAJUD: Added this else condition for defect CM-3770
                        with (bcAccount) 
						{
                            
							ActivateField(&quot;VF Customer Type&quot;);
							ActivateField(&quot;Primary Contact Id&quot;);
                            ActivateField(&quot;Master Account Id&quot;);
                            ClearToQuery();
                            SetViewMode(AllView);
							SetSearchExpr(searchst1);
                            ExecuteQuery();
							if (FirstRecord()) 
							{
						
							sMasterAcId = GetFieldValue(&quot;Master Account Id&quot;);

							}
                         
                        } //end accountbc
                    }
               
            return (sMasterAcId);
    } 
	catch (e) 
	{
        throw (e);
    } 
	finally 
	{
        bcAccount = null;
        bcAccountContact = null;
        boAccount = null;
        sType = null;
        sContactId = null;
        searchst1 = null;
        sAccount = null;
        //sMasterAcId = null;
    }
}"
			   SEQUENCE="107"
			   UPDATED="01/09/2026 15:43:19"
			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 15:43:19"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mUpdateConnectLineItems"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mUpdateConnectLineItems(Inputs, Outputs)
{
/*
 * Component Name        : 	VF TBUI MSO Utilities
 * Function Name         : 	mUpdateConnectLineItems
 * Component Information : 	Updates the Line Items Status of Connect Order 
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 22/12/2015	Roseline	R16.1 MSOD	Defect# 140								
 */
	try
	{	
		
		var sConnectNow = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_ORDER_STOCK_INDICATOR&quot;,&quot;Out of Stock - Connect Now&quot;);
		var sConnectLater = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_ORDER_STOCK_INDICATOR&quot;,&quot;Out of Stock - Connect Later&quot;);
		var sInStock = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_ORDER_STOCK_INDICATOR&quot;,&quot;In Stock&quot;);
		var sStatusPending = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;FS_ORDER_STATUS&quot;,&quot;Pending&quot;);
		var sStatusPendingFulfilment = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;FS_ORDER_STATUS&quot;,&quot;Pending Fulfilment&quot;);
		var sConnectOrderId = Inputs.GetProperty(&quot;Connect Order Id&quot;);
		
		//Update Line Item Status
		var	boOrder = TheApplication().GetBusObject(&quot;VF Order Entry Thin BO&quot;);
		var	bcOrderItem = boOrder.GetBusComp(&quot;VF Order Line Items - Thin BC&quot;);
		with(bcOrderItem)
		{
			bcOrderItem.SetViewMode(AllView);
			bcOrderItem.ActivateField(&quot;Order Header Id&quot;);
			bcOrderItem.ActivateField(&quot;Parent Order Item Id&quot;);
			bcOrderItem.ActivateField(&quot;Action Code&quot;);
			bcOrderItem.ActivateField(&quot;Status&quot;);
			bcOrderItem.ActivateField(&quot;VF Stock Indicator TBUI&quot;);
			bcOrderItem.ClearToQuery();
			var searchst = &quot;[Order Header Id] = &apos;&quot; + sConnectOrderId + &quot;&apos; AND [Parent Order Item Id] IS NULL AND [Action Code] &lt;&gt; &apos;Delete&apos;&quot;;
			bcOrderItem.SetSearchExpr(searchst);
			bcOrderItem.ExecuteQuery(ForwardOnly);
			var isRec = bcOrderItem.FirstRecord();
			while(isRec)
			{
				var sStockIndicator = bcOrderItem.GetFieldValue(&quot;VF Stock Indicator TBUI&quot;);
				if((sStockIndicator == sConnectNow) || (sStockIndicator == sInStock))
				{
					bcOrderItem.SetFieldValue(&quot;Status&quot;, sStatusPending);
				}
				else
				{
					bcOrderItem.SetFieldValue(&quot;Status&quot;, sStatusPendingFulfilment);	
				}
				bcOrderItem.WriteRecord();
				isRec = NextRecord();
			}//while(isRec) 
		}//with
		
		return(CancelOperation);
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
			bcOrderItem = null;
			boOrder = null;
	}
}"
			   SEQUENCE="108"
			   UPDATED="01/09/2026 15:43:20"
			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 15:43:20"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mUpdateConnectOrder"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/* Component Name        : 	mUpdateConnectOrder
* Component Information : 	TBUI - Connect Order Flow - This function is to update Fulfilment Order # on the Connect Order Header 
*
* Modification History  :
* Date			Author		Config #	Description
* ============ ===========	===========	================================
* 26/10/2015	Thulsi 		Initial Draft Version  
*/
function mUpdateConnectOrder(FulfilOrderNum)
{
	try
	{
		var bcOrder = TheApplication().GetBusObject(&quot;MACD Performance Order&quot;).GetBusComp(&quot;MACD Order Entry - Orders&quot;);
		with (bcOrder)
		{
			ActivateField(&quot;VF Fulfilment Order Number&quot;);
			SetViewMode(AllView);
			ClearToQuery();
			SetSearchSpec(&quot;Id&quot;, sOrderId);
			ExecuteQuery();
			if (FirstRecord())
			{
				SetFieldValue(&quot;VF Fulfilment Order Number&quot;, FulfilOrderNum);				
				WriteRecord();
			}
		}
	}
	catch(e)
	{
		throw e;
	}
	finally
	{
		bcOrder = null;
	}
}"
			   SEQUENCE="109"
