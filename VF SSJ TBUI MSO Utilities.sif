		}*/
		//MOCN proj Code-End - 01/12/2022.

		if (vCoverageSwitchFWA == &quot;ON&quot; &amp;&amp; sTBUIFWA == &quot;ConnectFWA&quot;)
		{
			var sSessionId = TheApplication().ActiveBusObject().GetBusComp(&quot;VF Capture Customer Details TBC&quot;).GetFieldValue(&quot;Session Id&quot;);
			var sCustId = TheApplication().ActiveBusObject().GetBusComp(&quot;VF Capture Customer Details TBC&quot;).GetFieldValue(&quot;Customer Row Id&quot;);
			
			var sAcntBC = TheApplication().GetBusObject(&quot;Account&quot;).GetBusComp(&quot;Account&quot;);
			var sAddr;
			//MCON-2 : Sandesh 3/10/2024
			var sBCCoverage =  TheApplication().GetBusObject(&quot;VF Coverage Check&quot;).GetBusComp(&quot;VF Coverage Check&quot;);
			var sCapacity = &quot;&quot;;
			var psInputs1 = TheApplication().NewPropertySet();
			var psOutputs2 = TheApplication().NewPropertySet();
			psInputs1.SetProperty(&quot;OrderId&quot;,sOrderId);
			var sBS = TheApplication().GetService(&quot;VHA Store Pickup Reservation Service&quot;);
			sBS.InvokeMethod(&quot;GetFWASpeed&quot;,psInputs1,psOutputs2);
			var sUploadspeed = psOutputs2.GetProperty(&quot;UploadSpeed&quot;);
			var sDownloadspeed = psOutputs2.GetProperty(&quot;DownloadSpeed&quot;);
			with (sBCCoverage)
			{
				ClearToQuery();		
				ActivateField(&quot;Originator&quot;);
				ActivateField(&quot;Capacity&quot;);
				ActivateField(&quot;UploadSpeed&quot;);
				ActivateField(&quot;DownloadSpeed&quot;);
				SetViewMode(AllView);
				SetSearchSpec(&quot;Originator&quot;, sOrderId);
				ExecuteQuery();
				if(FirstRecord())			
				{	
					sCapacity = GetFieldValue(&quot;Capacity&quot;);
				}

					
			}
			sUploadspeed = ToNumber(sUploadspeed);
			sDownloadspeed = ToNumber(sDownloadspeed);
			sCapacity = ToNumber(sCapacity);
			//End ; MCON-2 : Sandesh 3/10/24
			with(sAcntBC)
			{
				ActivateField(&quot;Primary Address Id&quot;);
				SetViewMode(AllView);
				ClearToQuery();
				SetSearchSpec(&quot;Id&quot;,sCustId);
				ExecuteQuery();				
				if(FirstRecord())
				{
					sAddr = GetFieldValue(&quot;Primary Address Id&quot;);
				}
			}
			bcOrd.SetViewMode(AllView);
			bcOrd.ClearToQuery();
			bcOrd.ActivateField(&quot;Id&quot;);
			bcOrd.ActivateField(&quot;Order Sub Type&quot;);
			bcOrd.ActivateField(&quot;FWA Override User ID&quot;);//Vasavi added for moconsq
			bcOrd.SetSearchSpec(&quot;Id&quot;,sOrderId);
			bcOrd.SetSearchSpec(&quot;Order Sub Type&quot;,&quot;Connect&quot;);
			bcOrd.ExecuteQuery(ForwardOnly);
			if(bcOrd.FirstRecord())
			{
				sServiceAddrLogin = bcOrd.GetFieldValue(&quot;FWA Override User ID&quot;);//Vasavi added for moconsq
				sServiceAddrId = bcOrd.GetFieldValue(&quot;Service Address ID&quot;);//Vasavi added for moconsq
				if(sServiceAddrLogin == &quot;&quot; || sServiceAddrLogin == null)//Vasavi added if cond for moconsq
				{
					with (bcLineItems)
					{
						SetViewMode(AllView);
						ClearToQuery();
						ActivateField(&quot;Product&quot;);
						ActivateField(&quot;CoverageType&quot;);
						ActivateField(&quot;VF Line Number&quot;);
						SetSearchSpec(&quot;Order Header Id&quot;,sOrderId);
						SetSearchSpec(&quot;Action Code&quot;,&quot; &lt;&gt;Delete&quot;);
						SetSearchSpec(&quot;Parent Order Item Id&quot;,&quot; IS NULL&quot;);
						ExecuteQuery();				
						var sRec = FirstRecord();
						var vCoverageFlag;
						var psIn = TheApplication().NewPropertySet();			
						var psOut = TheApplication().NewPropertySet();
						var sBS = TheApplication().GetService(&quot;VHA Get Session Token Service&quot;);	
						
						while(sRec)
						{
							var sProdCoverageType = GetFieldValue(&quot;CoverageType&quot;);
							var sLineNum = GetFieldValue(&quot;VF Line Number&quot;);
							if(sProdCoverageType == sCovType4G || sProdCoverageType == sCovType5Gnsa)
							{
								psIn.Reset(); 
								psOut.Reset(); 	
								psIn.SetProperty(&quot;OrderId&quot;,sOrderId);
								psIn.SetProperty(&quot;PrimaryAddrId&quot;,sAddr);
								psIn.SetProperty(&quot;ServiceAddrId&quot;,sServiceAddrId);//vasavi added for moconsq
								psIn.SetProperty(&quot;SessionId&quot;,sSessionId);
								psIn.SetProperty(&quot;ProdCoverageType&quot;,sProdCoverageType);	
								sBS.InvokeMethod(&quot;CheckCoverage&quot;,psIn,psOut);	
								vCoverageFlag = psOut.GetProperty(&quot;CoverageFlag&quot;);	
								TheApplication().SetProfileAttr(&quot;Speed&quot;,sDownloadspeed +&quot;--&quot; + sCapacity+ &quot;--&quot; + sUploadspeed +&quot;--&quot;+sProdCoverageType +&quot;--&quot;+ sCovType5Gnsa);
								if(vCoverageFlag == &quot;N&quot;)
								{
									if(sServiceAddrId != &quot;&quot; &amp;&amp; sServiceAddrId != null)
									{
										sIndErrMsg = TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;19082&quot;);
										TheApplication().RaiseErrorText( &quot;Line Number: &quot;  + sLineNum + &quot;-&quot; + sIndErrMsg );

									}
									else
									{
										sIndErrMsg = TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;19081&quot;);
										TheApplication().RaiseErrorText( &quot;Line Number: &quot;  + sLineNum + &quot;-&quot; + sIndErrMsg );
									}
								}
											
							}
							sRec = NextRecord();				
						}
					}
				}	
			}	
				
		//Vasavi added for moconsq FWA
		bcOrd.SetViewMode(AllView);
		bcOrd.ClearToQuery();
		bcOrd.ActivateField(&quot;Id&quot;);
		bcOrd.ActivateField(&quot;Order Sub Type&quot;);
		bcOrd.SetSearchSpec(&quot;Id&quot;,sOrderId);
		bcOrd.SetSearchSpec(&quot;Order Sub Type&quot;,&quot;Connect&quot;);
		bcOrd.ExecuteQuery(ForwardOnly);
		if(bcOrd.FirstRecord())
		{
			with (bcLineItems)
			{
				SetViewMode(AllView);
				ClearToQuery();
				ActivateField(&quot;Product&quot;);
				ActivateField(&quot;CoverageType&quot;);
				ActivateField(&quot;VF Line Number&quot;);
				SetSearchSpec(&quot;Order Header Id&quot;,sOrderId);
				SetSearchSpec(&quot;Action Code&quot;,&quot; &lt;&gt;Delete&quot;);
				SetSearchSpec(&quot;Parent Order Item Id&quot;,&quot; IS NULL&quot;);
				ExecuteQuery();				
				var sRec = FirstRecord();
				while(sRec)
				{
					var sProdCovType = GetFieldValue(&quot;CoverageType&quot;);
					if(sProdCovType == sCovType4G)
					{
						var sProdCovType4G = sCovType4G;		
					}
					if(sProdCovType == sCovType5Gnsa)
					{
						var sProdCovType5G = sCovType5Gnsa;			
					}
					sRec = NextRecord();				
				}
			}
		}
		
		var sProdCoverage;
		if(sProdCovType5G != &quot;&quot; &amp;&amp; sProdCovType5G != null)
			sProdCoverage = sProdCovType5G;
		else
		{
			if(sProdCovType4G != &quot;&quot; &amp;&amp; sProdCovType4G != null)
				sProdCoverage = sProdCovType4G;
			else
				sProdCoverage = &quot;&quot;;
		}
		
		if(sProdCoverage != &quot;&quot; &amp;&amp; sProdCoverage != null)
		{
			var psInp = TheApplication().NewPropertySet();			
			var psOutp = TheApplication().NewPropertySet();
			var sBS = TheApplication().GetService(&quot;VHA FWA Service BS&quot;);					
			//psInp.SetProperty(&quot;MethodName&quot;,&quot;UpdateAddress&quot;);	
			psInp.SetProperty(&quot;OrderId&quot;,sOrderId);
			psInp.SetProperty(&quot;ProdCoverageType&quot;,sProdCoverage);
			TheApplication().SetProfileAttr(&quot;UAddr&quot;,sOrderId + sProdCoverage);
			psInp.SetProperty(&quot;PrimaryAddrId&quot;,sServiceAddrId);
			psInp.SetProperty(&quot;FWAUserId&quot;,sServiceAddrLogin);
			psInp.SetProperty(&quot;SessionId&quot;,sSessionId);
			sBS.InvokeMethod(&quot;UpdateAddress&quot;,psInp,psOutp);
			//mUpdateAddress(psInp, psOutp);
		}
		//Added for zeus MOCN : Sandesh 29/4/25
		if(mconreservlov == &quot;Y&quot;)
		{
			if((sDownloadspeed &gt; sCapacity )&amp;&amp; sCapacity &gt; &quot;0&quot; &amp;&amp; (sCapacity != &quot;&quot; &amp;&amp; sCapacity != null) &amp;&amp; sProdCoverageType == sCovType5Gnsa)//Added for MCON2 Zeus changes 22/10/2024 : Sandesh
			{
				sIndErrMsg = TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;19082&quot;);
				TheApplication().RaiseErrorText( &quot;Line Number: &quot;  + sLineNum + &quot;-&quot; + sIndErrMsg );
			}
		}
		//end Vasavi added for moconsq FWA
		}

	}
	catch(e)
	{
		//mInsertInValidationBC(psInputs, psOutputs);
		if (sInserntInOrder == &quot;Y&quot;)
		{
			//mInsertInLineItemBC(psInputs, psOutputs, sCreatedTNR, iNoOfServices, sFulfilOrderId);//To update TNR
			mInsertInTempValidationBC(psInputs, psOutputs);//Update the validation BC for TNR Id
		}
		
		if( sIndErrMsg != &quot;&quot;)
		{
		  throw e;
		}
		else 
		{
			TheApplication().RaiseErrorText(errorMessage(e));
		}
	}
	finally
	{
		//SK 10.6.17 - Added below for retrofit 17.2 on 17.3
		sOrderItemId = null;
		sOrderHeadId = null;
		if(defined(bcOrd)) { bcOrd = null; }
		if(defined(boOrd)) { boOrd = null; }
		
		psInputs = null;
		Outputs = null;
		psOutputs = null;
		boAOA = null;
        bcAOA = null;
		psSysPrefInp = null;
		psSysPrefOut = null;
		arrayCheckAcc = null;
		arrayAccLineNums = null;			
		//SK 10.6.17 - Added below for retrofit 17.2 on 17.3
		bcFulfilment = null;		
		boOrder = null;
		/*Below variables are nullified by Sharukh on 18/03/2019*/
		//acItemBC = null;
		//OrderBusObj = null;

		/*Below variables are nullified by GURUPRASAD on 03/10/2019*/
