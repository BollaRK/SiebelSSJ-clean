			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mInvokePostConfiguration"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mInvokePostConfiguration(Inputs, &amp;Outputs)
{
	try
	{
		
	    sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
		var sType = Inputs.GetProperty(&quot;TransactionType&quot;);
	    sCustAccountId = Inputs.GetProperty(&quot;AccountId&quot;);
	    gManageAPPScenario = Inputs.GetProperty(&quot;ManageAPPScenario&quot;);
	    gRefundTerm = Inputs.GetProperty(&quot;RefundTerm&quot;);
	    gInstRemain = Inputs.GetProperty(&quot;InstalmentsRemaining&quot;);
	    gContAmt = Inputs.GetProperty(&quot;ContractAmt&quot;);
	    gContAmtOVRD = Inputs.GetProperty(&quot;ContractAmtOvrd&quot;);
	    gNonRefundPrepaymentAmt = Inputs.GetProperty(&quot;NonRefundPrepaymentAmt&quot;);/*Kathambari - added for prepayment*/
		var bsEAIService = TheApplication().GetService(&quot;EAI Siebel Adapter&quot;);
		var psInputs = TheApplication().NewPropertySet();
		var psOutputs = TheApplication().NewPropertySet();
		var iNoOfServices=0, sLineNum = &quot;&quot;, sIndErrMsg = &quot;&quot;, sErrMsg = &quot;&quot;;
		if(sType == &quot;APPEvaluate&quot;)
			psInputs.SetProperty(&quot;SearchSpec&quot;,&quot;[VF Order Item Task Simple.Order Header Id] = &apos;&quot; + sOrderId + &quot;&apos; AND [VF Order Item Task Simple.Product Type] &lt;&gt; &apos;Promotion&apos; AND [VF Order Item Task Simple.Action Code] &lt;&gt; &apos;Delete&apos;&quot;);
		else
			psInputs.SetProperty(&quot;SearchSpec&quot;,&quot;[VF Order Item Task Simple.Order Header Id] = &apos;&quot; + sOrderId + &quot;&apos; AND [VF Order Item Task Simple.Product Type] &lt;&gt; &apos;Promotion&apos;&quot;);
		psInputs.SetProperty(&quot;OutputIntObjectName&quot;, &quot;VF Order Item Task Simple&quot;);
		bsEAIService.InvokeMethod(&quot;Query&quot;, psInputs, psOutputs);
		
		switch(sType)
		{
			case &quot;PropositionNext&quot;:
				mPropositionNext(psOutputs, Outputs);
				break;
				
			case &quot;AllocateMSISDN&quot;:
				AllocateMSISDN(psOutputs, Outputs);
				break;
				
			case &quot;MPPEvaluate&quot;:
			
				mMPPEvaluate(psOutputs, Outputs);		
				break;
			case &quot;MPPAPPEvaluate&quot;:					
				mMPPEvaluate(psOutputs, Outputs);					
				mAPPEvaluate(psOutputs, Outputs);		
				break;
				
			case &quot;APPEvaluate&quot;:
				mAPPEvaluate(psOutputs, Outputs);		
				break;
				
			default:
				break;
		}//end switch
	}
	catch (e)
	{
		throw e;
	}
	finally
	{
		bsEAIService = null;
		psInputs = null;
		psOutputs = null;
	}
}"
