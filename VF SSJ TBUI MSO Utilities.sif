			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetPortIdsOnClass"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mGetPortIdsOnClass(Inputs,Outputs)
{
/*
 * Component Name        : 	VF Generic Product Manipulation Service
 * Method Name           : 	mGetPortIdsOnClass
 * Component Information : 	This funciton retrieves the Port Ids
 *							required by the eConfigurator to modify
 *							an order&apos;s line items.  Inputs to the function
 *							are: 
 *								- Product Name of the item we want to modify
 *								- Proposition Name: Root order Item&apos;s product name
 *								- An Attribute Property set which contains name/value pairs
 *								  of all attributes that we need to add/modify.  This function
 *								  will then set up an Attribute property set in the
 *								  format required by the eConfigurator
 *									
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 06/08/2009	POUSHB					Initial Version - Copied from VF CG Services
 * 20/08/2009	POUSHB					Method extended to search for Port Ids on the
 *										Class proposition if the products are not defined
 *										on the provided proposition.
 * 09/08/2011	KARP		TD# 14273	Need to Get the LOV Type as well.	
 * 12/08/2014    Bharat		Defect #441 - CT Siebel 8.1: Junk Characters in Matrices upload error messages				
 * 15/05/2015   SATHISH     Changed the logic to upgraded BC&apos; for JuneBFX PKE000000022416	 
*/	
	try {
		// Object Declarations
		var boAdminProdDef = TheApplication().GetBusObject(&quot;Admin ISS Prod Struct&quot;);
		var bcInternalProduct = boAdminProdDef.GetBusComp(&quot;Internal Product&quot;);
		var bcComplexProdStruct = boAdminProdDef.GetBusComp(&quot;ISS Product Structure Admin&quot;);
		var bcComplexProdStructXA =  boAdminProdDef.GetBusComp(&quot;ISS Prod Attribute VOD&quot;);
		
		var boAdminProdDef1 = TheApplication().GetBusObject(&quot;Admin ISS Prod Class Struct&quot;);
		var bcComplexProdStruct1 = boAdminProdDef1.GetBusComp(&quot;ISS Product Struct Class Admin&quot;);
		var bcComplexProdStructXA1 =  boAdminProdDef1.GetBusComp(&quot;ISS Prod Attribute VOD&quot;);

		var bcMore;	

		var psActionXA = TheApplication().NewPropertySet();		
		var psXA = Inputs.GetChild(0);
		
		// Variable Declarations
		var sProductName = Inputs.GetProperty(&quot;ProductName&quot;);
		var sPropositionName = Inputs.GetProperty(&quot;PropositionName&quot;);
		var sProdItemId = &quot;&quot;;
		var	sPortItemId = &quot;&quot;;
		var	sItemProductId = &quot;&quot;;
		var	sXAId = &quot;&quot;;
		var sXATypeCode = &quot;&quot;;
		var sXAName = &quot;&quot;;
		var sXAValue = &quot;&quot;;
		var sLOVType = &quot;&quot;;
	
		// Get the Product Id from Product name
		sItemProductId = GetProductIdFromName(sProductName);
		
		// Get the name &amp; value of the first attribute to be operated on
		sXAName = psXA.GetFirstProperty();
		if (sXAName != &quot;&quot; &amp;&amp; sXAName != null)
			sXAValue = psXA.GetProperty(sXAName);
		
		// Query the Internal Product BC for the Product required and the
		// first attribute, if supplied
		bcInternalProduct.SetViewMode(AllView);
		bcInternalProduct.ClearToQuery();
		bcComplexProdStruct.ActivateField(&quot;Item Name&quot;);
		bcComplexProdStruct.ActivateField(&quot;Sub Object Id&quot;);
		bcComplexProdStructXA.ActivateField(&quot;Name&quot;);
		bcComplexProdStruct.ActivateField(&quot;Orig Id&quot;);
   		bcComplexProdStruct.ActivateField(&quot;Port Id&quot;);
		
		bcInternalProduct.SetSearchSpec(&quot;Name&quot;, sPropositionName);
		if (sXAName != &quot;&quot; &amp;&amp; sXAName != null)
			bcComplexProdStructXA.SetSearchSpec(&quot;Name&quot;, sXAName);
		//bcComplexProdStruct.SetSearchSpec(&quot;Item Name&quot;,sProductName);		
		bcComplexProdStruct.SetSearchSpec(&quot;Sub Object Id&quot;,sItemProductId);
		bcInternalProduct.ExecuteQuery(ForwardOnly);

		if (bcInternalProduct.FirstRecord())
			TheApplication().SetProfileAttr(&quot;sPropositionId&quot;,bcInternalProduct.GetFieldValue(&quot;Id&quot;));
		
		// If a product is found matching the Input Name
		bcMore = bcComplexProdStruct.FirstRecord();
		
		if (bcMore)
		{
			// Set up Id&apos;s required by the eConfiurator for this product
			sProdItemId = bcComplexProdStruct.GetFieldValue(&quot;Orig Id&quot;);
			sPortItemId = bcComplexProdStruct.GetFieldValue(&quot;Port Id&quot;);
			//sItemProductId = bcComplexProdStruct.GetFieldValue(&quot;Prod Id&quot;);
			
			if (sPortItemId == &quot;&quot; || sPortItemId == null)
				sPortItemId = sProdItemId;
			
			var psLstActionXA = TheApplication().NewPropertySet();
			var bcMoreXA = bcComplexProdStructXA.FirstRecord();
			
			// While loop which will re-query the Attribute BC
			// to obtain all attribute ids for the input property
			// set
			while (bcMoreXA || (sXAName != &quot;&quot; &amp;&amp; sXAName != null))
			{
			
				psActionXA = TheApplication().NewPropertySet();
				
				if (sXAName != &quot;&quot; &amp;&amp; sXAName != null)
				{
					if (bcMoreXA)
					{
						// Set up Attribute Property set for each input attr
						// with required Ids for the configurator
						bcComplexProdStructXA.ActivateField(&quot;Data Type&quot;);
                 		bcComplexProdStructXA.ActivateField(&quot;Attribute Name&quot;);
						sXAId = bcComplexProdStructXA.GetFieldValue(&quot;Id&quot;);
						sXATypeCode = bcComplexProdStructXA.GetFieldValue(&quot;Data Type&quot;);
						sLOVType = bcComplexProdStructXA.GetFieldValue(&quot;Attribute Name&quot;);//KARP : 08/08/2011 : TD# 14273
						
						psActionXA.SetProperty(&quot;NewAttrXAId&quot;,sXAId);
						psActionXA.SetProperty(&quot;NewAttrValue&quot;,sXAValue);
						psActionXA.SetProperty(&quot;NewAttrName&quot;,sXAName);
						psActionXA.SetProperty(&quot;NewAttrPropTypeCode&quot;,sXATypeCode);
						psActionXA.SetProperty(&quot;NewAttrLOVType&quot;,sLOVType);//KARP : 08/08/2011 : TD# 14273
						
					} else
						throw (&quot;Attribute: &quot;+sXAName+&quot; not found.&quot;);
				}
				
				// Add the current attribute to the List of Attribute Property Set
				// This property set will eventually be added as a child to 
				// an &quot;Action&quot; property set for use within the configurator
				psLstActionXA.AddChild(psActionXA);
				
				sXAName = psXA.GetNextProperty();	
				
				// Re-query Attribute BC for the next attribute in the set
				if (sXAName != &quot;&quot; &amp;&amp; sXAName != null) {
					sXAValue = psXA.GetProperty(sXAName);
					bcComplexProdStructXA.ClearToQuery();
					bcComplexProdStructXA.SetSearchSpec(&quot;Name&quot;, sXAName);
					bcComplexProdStructXA.ExecuteQuery(ForwardBackward);
					bcMoreXA = bcComplexProdStructXA.FirstRecord();
				} else
					bcMoreXA = null;
				
			}
		} 
		else
		{
			// Query the Internal Product BC for the Product required and the
			// first attribute, if supplied
			bcInternalProduct.SetViewMode(AllView);
			bcInternalProduct.ClearToQuery();
			bcInternalProduct.ActivateField(&quot;XA Class Id&quot;);
			bcInternalProduct.SetSearchSpec(&quot;Name&quot;, sPropositionName);
			bcInternalProduct.ExecuteQuery(ForwardOnly);
			
			if (bcInternalProduct.FirstRecord())
      		{
      			var strClassId = bcInternalProduct.GetFieldValue(&quot;XA Class Id&quot;);
      			
	     		/* Requery as before - but now with ClassPropositionId */
	     		// Query the Internal Product BC for the Product required and the
				// first attribute, if supplied
				//bcInternalProduct.SetViewMode(AllView);
				//bcInternalProduct.ClearToQuery();
		     	//bcInternalProduct.ActivateField(&quot;Class Product Flag&quot;);
		    	bcComplexProdStruct1.ActivateField(&quot;Object Num&quot;);
		      	bcComplexProdStruct1.SetSearchSpec(&quot;Object Num&quot;, strClassId);
	    	  	//bcInternalProduct.SetSearchSpec(&quot;Class Product Flag&quot;, &quot;Y&quot;);
				bcComplexProdStruct1.ActivateField(&quot;Item Name&quot;);
				bcComplexProdStruct1.ActivateField(&quot;Sub Object Id&quot;);
				bcComplexProdStructXA1.ActivateField(&quot;Name&quot;);
				bcComplexProdStructXA1.ActivateField(&quot;Data Type&quot;);
				bcComplexProdStruct1.ActivateField(&quot;Orig Id&quot;);
		        bcComplexProdStruct1.ActivateField(&quot;Port Id&quot;);
				
				bcComplexProdStructXA1.ActivateField(&quot;Attribute Name&quot;);//KARP : 08/08/2011 : TD# 14273	
				if (sXAName != &quot;&quot; &amp;&amp; sXAName != null)
				bcComplexProdStructXA1.SetSearchSpec(&quot;Name&quot;, sXAName);
				bcComplexProdStruct1.SetSearchSpec(&quot;Item Name&quot;,sProductName);
				bcComplexProdStruct1.SetSearchSpec(&quot;Sub Object Id&quot;,sItemProductId);
			    bcComplexProdStruct1.ExecuteQuery(ForwardOnly);

				//if (bcInternalProduct.FirstRecord())
				//TheApplication().SetProfileAttr(&quot;sPropositionId&quot;,bcInternalProduct.GetFieldValue(&quot;Id&quot;));
		
				// If a product is found matching the Input Name
				bcMore = bcComplexProdStruct1.FirstRecord();
		
				if (bcMore)
				{
					// Set up Id&apos;s required by the eConfiurator for this product
					sProdItemId = bcComplexProdStruct1.GetFieldValue(&quot;Orig Id&quot;);
					sPortItemId = bcComplexProdStruct1.GetFieldValue(&quot;Port Id&quot;);
					//sItemProductId = bcComplexProdStruct.GetFieldValue(&quot;Prod Id&quot;);
			
					if (sPortItemId == &quot;&quot; || sPortItemId == null)
						sPortItemId = sProdItemId;
			
					var psLstActionXA = TheApplication().NewPropertySet();
					var bcMoreXA = bcComplexProdStructXA1.FirstRecord();
			
					// While loop which will re-query the Attribute BC
					// to obtain all attribute ids for the input property
					// set
					while (bcMoreXA || (sXAName != &quot;&quot; &amp;&amp; sXAName != null))
					{
			
						psActionXA = TheApplication().NewPropertySet();
			
						if (sXAName != &quot;&quot; &amp;&amp; sXAName != null)
						{
							if (bcMoreXA)
							{
								 bcComplexProdStructXA1.ActivateField(&quot;Data Type&quot;);
				                 bcComplexProdStructXA1.ActivateField(&quot;Attribute Name&quot;);								
								// Set up Attribute Property set for each input attr
								// with required Ids for the configurator
								sXAId = bcComplexProdStructXA1.GetFieldValue(&quot;Id&quot;);
								sXATypeCode = bcComplexProdStructXA1.GetFieldValue(&quot;Data Type&quot;);
								sLOVType = bcComplexProdStructXA1.GetFieldValue(&quot;Attribute Name&quot;);//KARP : 08/08/2011 : TD# 14273
						
								psActionXA.SetProperty(&quot;NewAttrXAId&quot;,sXAId);
								psActionXA.SetProperty(&quot;NewAttrValue&quot;,sXAValue);
								psActionXA.SetProperty(&quot;NewAttrName&quot;,sXAName);
								psActionXA.SetProperty(&quot;NewAttrPropTypeCode&quot;,sXATypeCode);
								psActionXA.SetProperty(&quot;NewAttrLOVType&quot;,sLOVType);//KARP : 08/08/2011 : TD# 14273
						
							} else
								throw (&quot;Attribute: &quot;+sXAName+&quot; not found.&quot;);
						}
				
						// Add the current attribute to the List of Attribute Property Set
						// This property set will eventually be added as a child to 
						// an &quot;Action&quot; property set for use within the configurator
						psLstActionXA.AddChild(psActionXA);
			
						sXAName = psXA.GetNextProperty();	
			
						// Re-query Attribute BC for the next attribute in the set
						if (sXAName != &quot;&quot; &amp;&amp; sXAName != null) {
							sXAValue = psXA.GetProperty(sXAName);
							bcComplexProdStructXA1.ClearToQuery();
							bcComplexProdStructXA1.SetSearchSpec(&quot;Name&quot;, sXAName);
							bcComplexProdStructXA1.ExecuteQuery(ForwardBackward);
							bcMoreXA = bcComplexProdStructXA1.FirstRecord();
						} else
							bcMoreXA = null;
					}
				}
				else
					throw (&quot;Port Ids not found&quot;);
			}
			else
				throw (&quot;Proposition not found&quot;);		
		}				
		Outputs.SetProperty(&quot;ProdItemId&quot;,sProdItemId);
		Outputs.SetProperty(&quot;PortItemId&quot;,sPortItemId);
		Outputs.SetProperty(&quot;ItemProductId&quot;,sItemProductId);
		Outputs.AddChild(psLstActionXA);
		
	}
	catch (e)
	{
	
		// Throw error
		if (defined(e.errText))
		{
		    var strError = e.errText + &quot;\r\n&quot; + e.toString();
		}
		else
		{
			var strError = e.toString();
		}
		throw (strError);
	}
	finally
	{
		// Destroy Objects
		bcInternalProduct = null;
		bcComplexProdStruct = null;
		bcComplexProdStructXA = null;
		bcMore = null;
		bcComplexProdStruct1 = null;
		bcComplexProdStructXA1 = null;
		boAdminProdDef = null;
		boAdminProdDef1 = null;
		/*Below variables are nullified by Sharukh on 18/03/2019*/
		psActionXA = null;
		psLstActionXA = null;
		psActionXA = null;
		psLstActionXA = null;
		psActionXA = null;

		
	}
	
}"
