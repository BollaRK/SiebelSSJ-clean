			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCheckFulfilmentOrderStatus"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="//VHA Balamurugan 01/07/2020 : Added for PKE000000080834
function mCheckFulfilmentOrderStatus(strOrderId) 
{
    try 
	{
        var ErrorMessage = &quot;&quot;;
        var boOrder = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
        var bcOrder = boOrder.GetBusComp(&quot;Order Entry - Orders&quot;);
        var sFulfilmentStatus;
        var strFulfillmentOrderId;

        if (strOrderId != &quot;&quot; &amp;&amp; strOrderId != &apos;null&apos;)
		 {
            bcOrder.SetViewMode(AllView);
            bcOrder.ClearToQuery();
            bcOrder.ActivateField(&quot;Status&quot;);
            bcOrder.SetSearchSpec(&quot;Id&quot;, strOrderId);
            bcOrder.ExecuteQuery();
            if (bcOrder.FirstRecord())
			 {
                strFulfillmentOrderId = bcOrder.GetFieldValue(&quot;VF Fulfilment Order Id&quot;);
                if (strFulfillmentOrderId != &quot;&quot; &amp;&amp; strFulfillmentOrderId != null)
				 {
                    bcOrder.ClearToQuery();
                    bcOrder.ActivateField(&quot;Status&quot;);
                    bcOrder.SetSearchSpec(&quot;Id&quot;, strFulfillmentOrderId);
                    bcOrder.ExecuteQuery();
                    if (bcOrder.FirstRecord()) 
					{
                        sFulfilmentStatus = bcOrder.GetFieldValue(&quot;Status&quot;);
                    }
                 }

             }
          }
        if (sFulfilmentStatus == &quot;Cancelled&quot;)
		 {
            ErrorMessage = TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;09303&quot;);
            return (ErrorMessage);
        }
        else
		 {
            ErrorMessage = &quot;&quot;;
            return (ErrorMessage);
         }
    }
    catch (e) 
	{
        throw (e);
    }
    finally
	 {
        bcOrder = null;
        boOrder = null;
     }
}
"
