			   SCRIPT="function mGetProductName(sSAMId)
{//Saravanan J 24012022 Created for project swap &amp; go
	try
	{
		var boProduct = TheApplication().GetBusObject(&quot;Internal Product&quot;);
		var bcProduct = boProduct.GetBusComp(&quot;Internal Product&quot;);
		var sProdName = &quot;&quot;;
		if(sSAMId != null &amp;&amp; sSAMId != &quot;&quot;)
		{
			with(bcProduct)
			{
				ClearToQuery();
				SetViewMode(AllView);
				ActivateField(&quot;Vendor Part Number&quot;);
				SetSearchSpec(&quot;Vendor Part Number&quot;,sSAMId);
				ExecuteQuery();				
				if(FirstRecord())
					sProdName = GetFieldValue(&quot;Name&quot;);
			}
		}			
		return(sProdName);
	}
	catch(e)
	{
		if(gErrorMessage == &quot;&quot;)
		{
			if(defined(e.errText))
			{
				var strError = e.errText + &quot;\r\n&quot; + e.toString(); 
			}
			else
			{
				var strError = e.toString(); 
			}
		}
		else
			throw(gErrorMessage)	
	
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace( &quot;ERROR:mGetProductName: &quot; + strError );
		}	
		throw (strError);	
	}
	finally
	{
		bcProduct = null;
		boProduct = null;	
	}
}"
