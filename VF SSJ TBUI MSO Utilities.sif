			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="ValidateOrderMSO"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function ValidateOrderMSO()
{
	try
	{
		var bcOrderAttach = TheApplication().GetBusObject(&quot;VF Order Item Task Validation&quot;).GetBusComp(&quot;Order Entry Attachment&quot;);
		var bsEAIService = TheApplication().GetService(&quot;EAI Siebel Adapter&quot;);
		var psInputs = TheApplication().NewPropertySet();
		var psOutputs = TheApplication().NewPropertySet();
        var sPrepayInput = TheApplication().NewPropertySet();
		var sPrepayOutput = TheApplication().NewPropertySet();
		var i = 0, j=0, iCount = 0, jCount = 0, sDevicePrice = &quot;&quot;, strErrorMsg = &quot;&quot;, sLineNum = &quot;&quot;, sMPPContractId = &quot;&quot;, nContractAmount = 0, nUpfrontAmount = 0, nDevicePrice = 0, nMPPContractAmt = 0, isrecord = false;
		//var sConnectLater = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_ORDER_STOCK_INDICATOR&quot;,&quot;Out of Stock - Connect Later&quot;);
  var PPAmountpaidupfront = 0, TotalAccessoryUpfront = 0, TotalDeviceAmountPaidUpfront = 0;
		//02/04/2019: Christy :Modified for unified application
		//if (TheApplication().GetProfileAttr(&quot;ApplicationName&quot;) == &quot;Siebel Power Communications&quot;)
		//if (TheApplication().GetProfileAttr(&quot;VHA User Type&quot;) == TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_USER_TYPE&quot;, &quot;Care&quot;))
		var sAppName = TheApplication().GetProfileAttr(&quot;VHA User Type&quot;);
		var sAllowFlg = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_ALLOW_GEN_CONTRACT&quot;, sAppName);
	//	if(sAppName == TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_USER_TYPE&quot;, &quot;Care&quot;))
		if(sAllowFlg == &quot;Y&quot;)
		{
		}
		else if(sReservationId == &quot;&quot; || sReservationId == null)
		{
			with (bcOrderAttach)
			{
				ClearToQuery();
				ActivateField(&quot;OrderComments&quot;);
				SetSearchSpec(&quot;Order Id&quot;, sOrderId);
				SetSortSpec(&quot;Created (DESC)&quot;);
				ExecuteQuery(ForwardOnly);
				isrecord = FirstRecord();
				if (isrecord)
				{
					while(isrecord)
					{
						if (GetFieldValue(&quot;OrderComments&quot;) == &quot;&quot;)
						{
							if (strErrorMsg == &quot;&quot;)
							{
								strErrorMsg = &quot;You have generated the contract, but not opened the file(s) - &quot; + GetFieldValue(&quot;OrderFileName&quot;);
							}
							else
							{
								strErrorMsg = strErrorMsg + &quot;, &quot; + GetFieldValue(&quot;OrderFileName&quot;);
							}
						}
						isrecord = NextRecord();
					}
					if (strErrorMsg != &quot;&quot;)
					{
			 			strErrorMsg = strErrorMsg + &quot;. Please click the link below the &apos;Generate Contract&apos; button first&quot;;
			 		}
				}
				else
				{
					strErrorMsg = &quot;You have not generated the contract.  Please click the &apos;Generate Contract&apos; button first. &quot;;
				}
			}
		}
		else//--&gt;19/11/2025: Nikhil: Modified for Paperless Popup reason
		{
			if(TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_ALLOW_GEN_CONTRACT&quot;, &quot;PaperlessPopUp&quot;) == &quot;Y&quot;)
			{
				var boOrder = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
				var bcOrder = boOrder.GetBusComp(&quot;Order Entry - Orders&quot;);
				with(bcOrder)
				{
					ClearToQuery();
					SetViewMode(AllView);
					SetSearchSpec(&quot;Id&quot;, sOrderId);
					ExecuteQuery();
					if(FirstRecord())
					{
						var sPaperlessFlag = GetFieldValue(&quot;VF Dealer Paperless Enabled Flag&quot;);
						var sPaperlessReasonCd = GetFieldValue(&quot;VF Digital Contract Bypass Reason&quot;);
						if(sPaperlessFlag != &quot;Y&quot; || sPaperlessReasonCd == null || sPaperlessReasonCd == &quot;&quot;)
						{
							strErrorMsg = &quot;Please provide bypass reason code&quot;;
						}
					}
				}
			}
		}//--&gt;Modified for Paperless Popup reason
		
		if (strErrorMsg != &quot;&quot;)
		{
			return (strErrorMsg);
		}
		
		psInputs.SetProperty(&quot;OutputIntObjectName&quot;,&quot;VF Order Item Task Validation&quot;);
					psInputs.SetProperty(&quot;SearchSpec&quot;, &quot;[VF Order Item Task Validation.Order Header Id] = &apos;&quot; + sOrderId + &quot;&apos;AND [VF Order Item Task Validation.Action Code] = &apos;Add&apos;&quot;);
		/*if(sStockIndicator != sConnectLater)
		{
			psInputs.SetProperty(&quot;SearchSpec&quot;, &quot;[VF Order Item Task Validation.Order Header Id] = &apos;&quot; + sOrderId + &quot;&apos;AND [VF Order Item Task Validation.Action Code] = &apos;Add&apos; AND [VF Order Item Task Validation.Product Name] = &apos;Device-Siebel Only&apos;&quot;);
		/*}
		else
		{		
			psInputs.SetProperty(&quot;SearchSpec&quot;, &quot;[VF Order Item Task Validation.Order Header Id] = &apos;&quot; + sOrderId + &quot;&apos;AND [VF Order Item Task Validation.Action Code] = &apos;Add&apos; AND ([VF Order Item Task Validation.Product Name] = &apos;Device-Siebel Only&apos;  OR  [VF Order Item Task Validation.Product Name] = &apos;MPP Contract&apos;)&quot;);
		}
		*/
		bsEAIService.InvokeMethod(&quot;Query&quot;, psInputs, psOutputs);
		
		iCount = psOutputs.GetChild(0).GetChild(0).GetChildCount();
		
		if (iCount &gt; 0)
		{
			for (var i=0; i &lt; iCount; i++)
			{
				sDevicePrice = psOutputs.GetChild(0).GetChild(0).GetChild(i).GetProperty(&quot;Device RCC Inc GST&quot;);
				sLineNum = psOutputs.GetChild(0).GetChild(0).GetChild(i).GetProperty(&quot;VF Line Number&quot;);
				nContractAmount = ToNumber(psOutputs.GetChild(0).GetChild(0).GetChild(i).GetProperty(&quot;Contract Amount&quot;));
				nUpfrontAmount = ToNumber(psOutputs.GetChild(0).GetChild(0).GetChild(i).GetProperty(&quot;Prepayment Amount&quot;));
				
				// 5/08/2015 - Subramanian, PKE23437 : Added MPP Contract Id property to check if Contract Id is null - No MPP Created (Upfront == RCC case)
				sMPPContractId = psOutputs.GetChild(0).GetChild(0).GetChild(i).GetProperty(&quot;MPP Line Id&quot;);
				if (sDevicePrice == &quot;N/A&quot;)
				{
					strErrorMsg = strErrorMsg + &quot;Line: &quot; + sLineNum + &quot; This device cannot be sold on this plan. Please select a different device or plan to proceed with order submission.\r\n&quot;;
				}
				else
				{
					nDevicePrice = ToNumber(sDevicePrice);
					nMPPContractAmt = nContractAmount + nUpfrontAmount;
                    //balajiM added for 19.3 4JUN2019
                    /*mGetPrepayAmt(sOrderId, sPrepayOutput);
                    PPAmountpaidupfront = sPrepayOutput.GetProperty(&quot;PPAmountpaidupfront&quot;);
                    TotalAccessoryUpfront = sPrepayOutput.GetProperty(&quot;TotalAccessoryUpfront&quot;);
                    TotalDeviceAmountPaidUpfront = sPrepayOutput.GetProperty(&quot;TotalDeviceAmountPaidUpfront&quot;);*/
                    //balajiM added for 19.3 4JUN2019 END
					/* Changes for PKE 23437 start
					* Out Of Stock - Connect Later, where Upfront == RCC the following error is triggered.
					* For Upfront == RCC no MPP is created, thus MPP Contract Id is null. 
					* Check made to see if contract id is null (meaning Upfront is same as RCC). 
					* Otherwise device price will be compared against Upfront + Contract Amt(s).
					*/
					
					if(sMPPContractId != &quot;&quot; &amp;&amp; sMPPContractId != null)
					{
						if(nDevicePrice != nMPPContractAmt)//balajiM modified for 19.3
						{
							strErrorMsg = strErrorMsg + &quot;Line: &quot; + sLineNum + &quot; MPP Contract amount is not matching the Device RCC amount. Please revisit the Order configuration\r\n&quot;;
						}
						
					/* Changes for PKE 23437 end */
					}
				}
			}
		}

			//PKE# 92688 Home Wireless Error
			else
			{	
				if(TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CR_ENABLE_FLAG&quot;,&quot;IMEIPlanCheck&quot;) == &quot;Y&quot;)
				{
		
					var boOrderLine = TheApplication().GetBusObject(&quot;VF Order Entry - Line Items&quot;);
					var bcOrderLine = boOrderLine.GetBusComp(&quot;VF Order Entry - Line Items&quot;);
					var simeiRcc = &quot;&quot;, sLineNo=&quot;&quot;, sVfFlag = &quot;&quot;;
					with(bcOrderLine)
					{

						ClearToQuery();
						SetViewMode(AllView);
						ActivateField(&quot;VF Line Number&quot;);
						ActivateField(&quot;VF IMEI RCC&quot;);
						ActivateField(&quot;VF Flag&quot;);
						SetSearchExpr(&quot;[Order Header Id]=&apos;&quot; +sOrderId+&quot;&apos; AND [Root Order Item Id]=[VF Row Id]&quot;);
						ExecuteQuery(ForwardOnly);
						isrecord = FirstRecord();
	
						while (isrecord)
						{
							simeiRcc = GetFieldValue(&quot;VF IMEI RCC&quot;);
							sVfFlag = GetFieldValue(&quot;VF Flag&quot;);
							sLineNo = GetFieldValue(&quot;VF Line Number&quot;);
							if(((simeiRcc == &quot;N/A&quot;)||(simeiRcc ==&quot;&quot;)||(simeiRcc == &quot;Null&quot;))&amp;&amp;(sVfFlag ==&quot;Y&quot;))
							{
								strErrorMsg = strErrorMsg + &quot;Line: &quot; + sLineNo + &quot; This device cannot be sold on this plan. Please select a different device or plan to procceed with order submission.\r\n&quot;;
							}
							isrecord = NextRecord();
						}
					}
				}
			}
	//End of Code PKE#92688 Home Wireless Errro
		
		return (strErrorMsg);
	}
	catch(e)
	{
		throw e;
	}
	finally
	{
	    bcOrderAttach = null;  /* This variable is nullified by Sharukh on 18/03/2019*/
		bsEAIService = null;
		psInputs = null;
		psOutputs = null;
		

	}
}"
			   SEQUENCE="132"
			   UPDATED="01/09/2026 15:43:16"
			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 15:43:16"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="ValidateShippingDetails"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function ValidateShippingDetails(OrderId, &amp;sShippingValdnDone)
{

	try {
	var bcShip = TheApplication().GetBusObject(&quot;VF FS Shipment&quot;).GetBusComp(&quot;FS Shipment&quot;);
	var sTitle = &quot;&quot;, sFirstName = &quot;&quot;, sLastName = &quot;&quot;, sEmailAddress = &quot;&quot;, sFullAddress = &quot;&quot;,sNotificationMethod = &quot;&quot;, sNotificationMSISDN = &quot;&quot;, sPreference = &quot;&quot;;
	var sErrorMsg = &quot;All shipping fields are required.  Please enter a value for each of these fields.&quot;;
	with (bcShip)
	{
		ActivateField(&quot;VF Ship To Contact Title&quot;);
		ActivateField(&quot;VF Ship To Contact First Name&quot;);
		ActivateField(&quot;VF Ship To Contact Last Name&quot;);
		ActivateField(&quot;VF Email Address&quot;);
		ActivateField(&quot;Cal Full Address&quot;);
		ActivateField(&quot;Shipping Notification MSISDN&quot;);
		ActivateField(&quot;Shipping Notification Method&quot;);
		ActivateField(&quot;VHA Shipment Preference Calc&quot;);
		ClearToQuery();
		SetSearchSpec(&quot;Primary Order Id&quot;, OrderId);
		ExecuteQuery(ForwardOnly);
		if (FirstRecord())
		{
		    sTitle = GetFieldValue(&quot;VF Ship To Contact Title&quot;);
			var sOrgName = GetFieldValue (&quot;VHA Org Name&quot;);
			if(sOrgName == &quot;Kogan&quot;) //Wave 900 Added for Title Transfer .by Bhava
			{
			if(sTitle == &quot;&quot; || sTitle == null)
			{
				return(sErrorMsg);
			}}
			sFirstName = GetFieldValue(&quot;VF Ship To Contact First Name&quot;);
			if (sFirstName == &quot;&quot; || sFirstName == null)
			{
				return(sErrorMsg);
			}
			sLastName = GetFieldValue(&quot;VF Ship To Contact Last Name&quot;);
			if (sLastName == &quot;&quot; || sLastName == null)
			{
				return(sErrorMsg);
			}
			sFullAddress = GetFieldValue(&quot;Cal Full Address&quot;);
			if (sFullAddress == &quot;&quot; || sFullAddress == null)
			{
				return(sErrorMsg);
			}
			sPreference = GetFieldValue(&quot;VHA Shipment Preference Calc&quot;);//Added by MuthuShankari for MSOD
			if (sPreference == &quot;&quot; || sPreference == null)
			{
				return(sErrorMsg);
			}
			else if(sPreference == &quot;Partial&quot;)
			{
				mValidateSharingProposition(OrderId);
				if(isShared == &quot;Y&quot;)
				return(&quot;As this is a Sharing order, please select Shipment Preference as “Full” to proceed further.&quot;);
			}
			sNotificationMethod = GetFieldValue(&quot;Shipping Notification Method&quot;);
			if (sNotificationMethod == &quot;&quot; || sNotificationMethod == null)
			{
				return(&quot;Shipping Notification Method is a required field&quot;);
			}
			//Aarthi:20/11/2015 : Added for T&amp;T2 - Validation
			else
			{
				sNotificationMSISDN = GetFieldValue(&quot;Shipping Notification MSISDN&quot;);
				sEmailAddress = GetFieldValue(&quot;VF Email Address&quot;);
				switch(sNotificationMethod)
				{
					case &quot;TXT&quot;:
						if (sNotificationMSISDN == &quot;&quot; || sNotificationMSISDN == null)
						{
							return(&quot;Shipping Notification MSISDN is a required field&quot;);
						}						
					break;
					case &quot;Email and TXT&quot;:
						if (sEmailAddress == &quot;&quot; || sNotificationMSISDN == &quot;&quot;)
						{
							return(&quot;Tracking Email and Notification MSISDN are required fields&quot;);
						}
										
					break;
					case &quot;Email&quot;:
						if (sEmailAddress == &quot;&quot; || sEmailAddress == null)
						{
							return(&quot;Tracking Email is a required field&quot;);
						}	
					break;			
					default:
					break;
				}
			}
			
		if(sNotificationMethod != &quot;None&quot;)
		{
				if(sNotificationMSISDN != &quot;&quot;)
				{	
					if (sNotificationMSISDN.indexOf(&quot; &quot;) &gt; 0)
					{				
						return(&quot;Notification MSISDN must be entered with no spaces.&quot;);
					}
		
					// Check there are no brackets
					if ((sNotificationMSISDN.indexOf(&quot;(&quot;) &gt; 0) || (sNotificationMSISDN.indexOf(&quot;)&quot;) &gt; 0))
					{
						return(&quot;Notification MSISDN must be entered with no brackets.&quot;);
		
					}
					if (isNaN(sNotificationMSISDN))
					{
						return(&quot;Notification MSISDN  must be numeric&quot;);
					}
						
		            if( sNotificationMSISDN.indexOf(&quot;614&quot;) != 0)
		            { 
						return(&quot;Notification MSISDN must be starting with digits 614&quot;); 
				    }
		
					if (sNotificationMSISDN != &quot;&quot; &amp;&amp; sNotificationMSISDN.length != 11)
					{	
						return(&quot;Notification MSISDN  must be 11 characters long.&quot;);
					}
						sShippingValdnDone = &quot;Y&quot;;
						return(&quot;&quot;);
							
				}
				
				if(sEmailAddress != &quot;&quot;)
				{
					sErrorMsg = mValidateEmail(sEmailAddress);
					if (sErrorMsg == &quot;&quot; || sErrorMsg == null)
					{
						sShippingValdnDone = &quot;Y&quot;;
					}
					return(sErrorMsg);
				}
			}
				sShippingValdnDone = &quot;Y&quot;; // JS: Added for T&amp;T ST # 163
				return(&quot;&quot;);			
		}
		else
		{
			return(sErrorMsg);
		}
	}
	}
	catch(e)
	{
	throw e ;
	}
	finally
	{
	bcShip = null;  /* This variable is nullified by Sharukh on 18/03/2019*/
	}
}"
