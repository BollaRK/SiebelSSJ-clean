			UpsertFulfilmentItems(Outputs);//Upsert in fulfil items in BC using the PS created above
			sCreateFulfilOrder = &quot;Y&quot;;
		}
		else
		{
			sCreateFulfilOrder = CheckFulfilmentItems();//Check if user has manually created fulfil items
		}
		RemoveDeviceSiebelOnlyProducts();//Made changes as apart of June Release SIT Def#42//Remove Device-Siebel Onl1y products from Connect Order
		if (sCreateFulfilOrder == &quot;Y&quot; || sAOAFulfilItems == &quot;Y&quot;)
