			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mDeleteEqRecord"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mDeleteEqRecord(AccountId, OrderId)
{
	try
	{
		var oEqAccntBO = TheApplication().GetBusObject(&quot;VHA Equipment Account&quot;);
		var oEqAccntBC = oEqAccntBO.GetBusComp(&quot;VHA Equipment Account&quot;);
		var isRecord = &quot;&quot;;
		
		with (oEqAccntBC)
		{	
			ActivateField(&quot;Account Id&quot;);
			ActivateField(&quot;Order Id&quot;);
			ClearToQuery();
			SetSearchSpec(&quot;Account Id&quot;, AccountId);
			SetSearchSpec(&quot;Order Id&quot;, OrderId);
			ExecuteQuery();
			isRecord = FirstRecord();
			while(isRecord)
			{
				DeleteRecord();
				isRecord = FirstRecord();
			}
		}
	}
	catch(e)
	{
	}
	finally
	{
		oEqAccntBC = null;
		oEqAccntBO = null;	
	}
}"
