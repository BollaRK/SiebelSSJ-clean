			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 15:43:17"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mAPPEvaluate"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mAPPEvaluate(psOutputs, &amp;Outputs)
{
	/*
	* Method Name        : 	mAPPEvaluate     : 	
	* Component Information : psOutputs has group of line item. This function will loop in all
	*						  line item to evaluate it	
	*
	* Modification History  :
	* Date			Author		Config #	Description
	* ============ ===========	===========	================================
	* 03/16/2016	Kamali					Initial version
	*/
	try
	{
	
		var iNoOfServices = 0;
		var sLineItemId, sConnectType =&quot;&quot;;	
		var LineIn = TheApplication().NewPropertySet();
		var LineOut = TheApplication().NewPropertySet();
		var psCopyInputs = TheApplication().NewPropertySet();
		var psCopyInp = TheApplication().NewPropertySet();
		var strAcceptCode=&quot;&quot;, strCCExpDate=&quot;&quot;, strApprovedCLA=&quot;&quot;, strCAmt=&quot;&quot;, strDealerCode=&quot;&quot;, MPPExists=&quot;&quot;, sMppContId=&quot;&quot;;
		var strContactId = &quot;&quot;, strCustAccId = &quot;&quot;, strAccType = &quot;&quot;, strOrderFunctionPlan = &quot;&quot;;
		var sConnType = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_SERVICE_STOCK_TBUI&quot;,&quot;Plan and Device&quot;);	
		var sConnectLater = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_ORDER_STOCK_INDICATOR&quot;,&quot;Out of Stock - Connect Later&quot;);	//Balaji : 11 02 2015:Added for SPS
		var sStockInd = &quot;&quot;;
		psCopyInputs = psOutputs.GetChild(0).GetChild(0).Copy();
		psCopyInp.SetType(psCopyInputs.GetType());	
		iNoOfServices = psCopyInputs.GetChildCount();
		
		Outputs.SetProperty(&quot;GotoAPPView&quot;, &quot;&quot;);
		
		var oBO = TheApplication().GetBusObject(&quot;VHA APP Order Task Support&quot;);
		var oBC = oBO.GetBusComp(&quot;VHA APP Accessory TBUI BC&quot;);
		var sSearchStr = &quot;[Order Id]=&apos;&quot;+sOrderId+&quot;&apos;&quot;;		
		mDeleteRecord(oBC,sSearchStr);
		
		var oLineBC = TheApplication().GetBusObject(&quot;Order Entry - Thin MSO&quot;).GetBusComp(&quot;VF Order Line Items - Thin&quot;);
		var sSearchStr = &quot;[Order Id]=&apos;&quot;+sOrderId+&quot;&apos; AND [Product Type]=&apos;Billing - APP&apos; AND [Action Code]=&apos;Add&apos;&quot;;	
		mDeleteRecord(oLineBC,sSearchStr);
	
		if (iNoOfServices &lt; 1)
			TheApplication().RaiseErrorText(&quot;No Line Item added for this Order&quot;);
	
		for (var i=0; i &lt; iNoOfServices; i++)
		{
			// Evaluate APP starts here
			sLineItemId = psCopyInputs.GetChild(i).GetProperty(&quot;Order Item Id&quot;); 
			sConnectType = psCopyInputs.GetChild(i).GetProperty(&quot;VF ConnectionType&quot;); 
			sStockInd = psCopyInputs.GetChild(i).GetProperty(&quot;VF Stock Indicator TBUI&quot;);
			LineIn.SetProperty(&quot;LineItemId&quot;, sLineItemId);
			LineIn.SetProperty(&quot;Cursor&quot;, i);
			LineIn.SetProperty(&quot;RootAssetIntId&quot;, psCopyInputs.GetChild(i).GetProperty(&quot;Asset Integration Id&quot;));
		
			mAPPEachLineItem(LineIn, psCopyInputs);	
			
			var sRCC = psCopyInputs.GetChild(i).GetProperty(&quot;MPP RCC F&quot;);
			if(ToNumber(sRCC) &gt; 0 || (ToNumber(sRCC) == 0 &amp;&amp; ToNumber(gNonRefundPrepaymentAmt) &gt; 0)) /*Kathambari - changed this condition to fix prepayment defect 485.*/
			{
				Outputs.SetProperty(&quot;GotoAPPView&quot;, &quot;Y&quot;);
				psCopyInputs.GetChild(i).SetProperty(&quot;Order Header Id&quot;, sOrderId);
				psCopyInp.AddChild(psCopyInputs.GetChild(i).Copy());
			}			
			else
				psCopyInputs.GetChild(i).SetProperty(&quot;MPP Active&quot;, &quot;N&quot;);
			
		}	
		if(psCopyInp.GetChildCount()&gt;0)
		{
			//Call APP Smartscript BC update *##*
			var sOutIO = &quot;VHA APP Order Task Support&quot;;
			var sMap = &quot;VHA APP Order Task Support&quot;;
			psOutputs.SetProperty(&quot;Category&quot;, &quot;Accessory&quot;);
			if(gManageAPPScenario == &quot;RefundAPP&quot;)/*Kathambari - added for prepayment.*/
			{
			psOutputs.SetProperty(&quot;NonRFPrepayment&quot;, gNonRefundPrepaymentAmt);
			}
			mMPPBCUpsert(psCopyInp, psOutputs, sOutIO, sMap);
		}
	}
	catch (e)
	{
		throw e;
	}
	finally
	{
		LineIn = null;	
		LineOut = null;
		psCopyInputs = null;
		psCopyInp = null;
		/*Below variables are nullified by Sharukh on 18/03/2019*/
		oBC = null;
		oLineBC = null;
		oBO = null;
		

	}
}"
			   SEQUENCE="36"
			   UPDATED="01/09/2026 15:43:17"
			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 15:43:17"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mAPPGetAccessoryDetails"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mAPPGetAccessoryDetails(sLineItemId, &amp;psOut)
{
	try
	{
		var sBO = TheApplication().GetBusObject(&quot;VHA Accessory Items&quot;);
		var sBC = sBO.GetBusComp(&quot;VHA Accessory Items&quot;);
		var iCount =0;
		var strNonAPP=&quot;&quot;, strOrderNum=&quot;&quot;, iRRP=0, iTotalRPP=0, iRec, sTerm=&quot;&quot;;//TULASIY:06Feb2024::Created for APP Term
		var iSdRRP = 0, iAccRRP = 0, iSdRRPTotal=0, SdCount=0;
		var sdMinRRP = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_SD_RRP&quot;,&quot;Min RRP Inc GST&quot;);
		with (sBC)
		{
			SetViewMode(AllView);
			ClearToQuery();
			
			ActivateField(&quot;Order Id&quot;);
			ActivateField(&quot;Order Number&quot;);
			ActivateField(&quot;VHA Non App&quot;);
			ActivateField(&quot;VHA RRP inc GST&quot;);
			ActivateField(&quot;Contract Term&quot;);//TULASIY:06Feb2024::Created for APP Term
			SetSearchSpec(&quot;Related Service Order Id&quot;, sLineItemId);
			if(psOut.GetProperty(&quot;AddAPP&quot;) == &quot;Y&quot;)
			SetSearchSpec(&quot;VHA Category&quot;, &quot;&lt;&gt; Secondary Device&quot;); // Balaji : ATOM Project: to exclude the secondary device accessory.
			ExecuteQuery();
			iRec = FirstRecord();
			while (iRec)
			{
				iRRP=0;
				if(GetFieldValue(&quot;VHA Category&quot;) == &quot;Secondary Device&quot;)		// Indumathi:	Added for ATOM
				{
					iRRP = ToNumber(GetFieldValue(&quot;VHA RRP inc GST&quot;));
					
					if(iRRP&lt;ToNumber(sdMinRRP))	// VHA Suresh: Added for ATOM:	14/07/2017
						TheApplication().RaiseErrorText (&quot;VFErrorCode#97033 Line Number: &quot; + sLineItemId + &quot; - &quot;+ TheApplication().LookupMessage(&quot;User Defined Errors&quot;, &quot;97033&quot;));
					iSdRRPTotal += iRRP;
					SdCount++;
				}
				else
				{
				sTerm = GetFieldValue(&quot;Contract Term&quot;);//TULASIY:06Feb2024::Created for APP Term
				strOrderNum = GetFieldValue(&quot;Order Number&quot;);
				strNonAPP = GetFieldValue(&quot;VHA Non App&quot;);
				iRRP = ToNumber(GetFieldValue(&quot;VHA RRP inc GST&quot;));		
				iAccRRP+=iRRP;
				iCount++;
				}
				if(iRRP != &quot;&quot;)
					iTotalRPP += iRRP;
				iRec = NextRecord();
			}
		}
		psOut.SetProperty(&quot;Term&quot;, sTerm);//TULASIY:06Feb2024::Created for APP Term
		psOut.SetProperty(&quot;NonAPP&quot;, strNonAPP);
		psOut.SetProperty(&quot;TotalRRP&quot;, iTotalRPP);
		psOut.SetProperty(&quot;AccRRPTotal&quot;, iAccRRP);	// VHA Suresh: Added for ATOM:	14/07/2017
		psOut.SetProperty(&quot;SDRRPTotal&quot;, iSdRRPTotal);	// VHA Suresh: Added for ATOM:	14/07/2017
		psOut.SetProperty(&quot;NumOfSD&quot;, SdCount);	// VHA Suresh: Added for ATOM:	14/07/2017
		psOut.SetProperty(&quot;TotalNumofAccessories&quot;, iCount);
		psOut.SetProperty(&quot;OrderNumber&quot;, strOrderNum);
	}
	catch(e)
	{
		throw e;
	}
	finally
	{
		sBC = null;
		sBO = null;
	}
}"
			   SEQUENCE="37"
			   UPDATED="01/09/2026 15:43:17"
			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 15:43:17"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mAddAccessory"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mAddAccessory(Inputs,&amp;Outputs)
{
	try
	{
		var psOutputs = TheApplication().NewPropertySet();
		var psIn = TheApplication().NewPropertySet();
		var psOut = TheApplication().NewPropertySet();
		var psAttributes = TheApplication().NewPropertySet();
		var psSPIDAttributes = TheApplication().NewPropertySet();
		var psIncAttributes = TheApplication().NewPropertySet();
		var bsInputs = TheApplication().NewPropertySet();
		var bsOutputs = TheApplication().NewPropertySet();
		var sSDGrpId = &quot;&quot;;
		
		var bsEAIService = TheApplication().GetService(&quot;EAI Siebel Adapter&quot;);
		var bsEAIMapService = TheApplication().GetService(&quot;EAI Data Transformation Engine&quot;);
		var bsGenProdManService = TheApplication().GetService(&quot;VF Generic Product Manipulation Service&quot;);
		
		var sConnectOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
		var sIncName = &quot;&quot;;
		var sPIncName = &quot;&quot;;
		var sCategory = &quot;&quot;;
		var sModifyAPP = Inputs.GetProperty(&quot;ModifyAPP&quot;);
		mDeleteAccessory(Inputs);

		bsInputs.SetProperty(&quot;OutputIntObjectName&quot;, &quot;VHA Order Entry Accessory Query&quot;);
		bsInputs.SetProperty(&quot;SearchSpec&quot;,&quot;[LineItems.Action Code]&lt;&gt;&apos;Delete&apos; AND [LineItems.Parent Order Item Id] IS NULL AND [Order.Id]=&apos;&quot;+sConnectOrderId+&quot;&apos;&quot;);
		bsEAIService.InvokeMethod(&quot;Query&quot;, bsInputs, bsOutputs);	
		
		psAttributes.SetProperty(&quot;Accessory Code&quot;, &quot;&quot;);
		psAttributes.SetProperty(&quot;Accessory Name&quot;, &quot;&quot;);
		psAttributes.SetProperty(&quot;Category&quot;, &quot;&quot;); //Introduced in ATOM Project: Balaji: 07/06/2017 
		psAttributes.SetProperty(&quot;Accessory RRP Exc GST&quot;, &quot;&quot;);
		psAttributes.SetProperty(&quot;Accessory RRP Inc GST&quot;, &quot;&quot;);
		psAttributes.SetProperty(&quot;Prepayment Amount&quot;,&quot;&quot;);		// VHA Suresh P: Added for Prepayments
		
		//Introduced in ATOM Project: Balaji: 07/06/2017 : Add SPID Product and attribute
		var oBS = TheApplication().GetService(&quot;VHA ATOM Processing Service&quot;);
		oBS.InvokeMethod(&quot;GetSPIDSAMID&quot;, bsInputs, bsOutputs);
		var sSPID = bsOutputs.GetProperty(&quot;SPIDProdName&quot;);

		for (var i=0; i&lt;bsOutputs.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChildCount(); i++)
		{
			for (var j=0; j&lt;bsOutputs.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(i).GetChild(0).GetChildCount(); j++)
			{		
				psIn.SetProperty(&quot;PropositionName&quot;,bsOutputs.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(i).GetProperty(&quot;Product&quot;));
				psIn.SetProperty(&quot;ProductName&quot;, &quot;Accessory&quot;);
				psIn.AddChild(psAttributes);				
				bsGenProdManService.InvokeMethod(&quot;Get PortIds On Class&quot;,psIn,psOut);
				bsOutputs.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(i).SetProperty(&quot;Prod Item Id&quot;,psOut.GetProperty(&quot;ProdItemId&quot;));
				bsOutputs.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(i).SetProperty(&quot;Product Port Id&quot;,psOut.GetProperty(&quot;PortItemId&quot;));
				
				//Introduced in ATOM Project: Balaji: 07/06/2017 : Add SPID Product and attribute
				bsOutputs.SetProperty(&quot;ModifyAPP&quot;, sModifyAPP);
				sCategory = bsOutputs.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(i).GetChild(0).GetChild(j).GetProperty(&quot;VHA Category&quot;);
				if(sCategory == &quot;Secondary Device&quot;)
				{
					psIn.Reset();
					psOut.Reset();				
					psIn.SetProperty(&quot;PropositionName&quot;, bsOutputs.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(i).GetProperty(&quot;Product&quot;));
					psIn.SetProperty(&quot;ProductName&quot;, sSPID);
					psIn.AddChild(psSPIDAttributes);				
					bsGenProdManService.InvokeMethod(&quot;Get PortIds On Class&quot;,psIn,psOut);
					//BalajiM modified for swapgo MSO lineitem issue 15/03/2022
					/*bsOutputs.SetProperty(&quot;SPIDProdItemId&quot;,psOut.GetProperty(&quot;ProdItemId&quot;));
					bsOutputs.SetProperty(&quot;SPIDProductPortId&quot;,psOut.GetProperty(&quot;PortItemId&quot;));*/
					bsOutputs.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(i).GetChild(0).GetChild(j).SetProperty(&quot;SPIDProdItemId&quot;,psOut.GetProperty(&quot;ProdItemId&quot;));
					bsOutputs.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(i).GetChild(0).GetChild(j).SetProperty(&quot;SPIDProductPortId&quot;,psOut.GetProperty(&quot;PortItemId&quot;));
								
					sIncName = bsOutputs.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(i).GetChild(0).GetChild(j).GetProperty(&quot;Insurance&quot;);
					if(sIncName != null &amp;&amp; sIncName != &quot;&quot;)
					{
						sSDGrpId = bsOutputs.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(i).GetChild(0).GetChild(j).GetProperty(&quot;SD Group Id&quot;);
						psIn.Reset();
						psOut.Reset();
						psIn.SetProperty(&quot;PropositionName&quot;, bsOutputs.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(i).GetProperty(&quot;Product&quot;));
						psIn.SetProperty(&quot;ProductName&quot;, sIncName);
						psIn.AddChild(psIncAttributes);				
						bsGenProdManService.InvokeMethod(&quot;Get PortIds On Class&quot;,psIn,psOut);
						//BalajiM modified for swapgo MSO lineitem issue 15/03/2022
						/*bsOutputs.SetProperty(&quot;IncProdItemId&quot;+sSDGrpId, psOut.GetProperty(&quot;ProdItemId&quot;));
						bsOutputs.SetProperty(&quot;IncProductPortId&quot;+sSDGrpId, psOut.GetProperty(&quot;PortItemId&quot;));*/
						bsOutputs.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(i).GetChild(0).GetChild(j).SetProperty(&quot;IncProdItemId&quot;, psOut.GetProperty(&quot;ProdItemId&quot;));
						bsOutputs.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(i).GetChild(0).GetChild(j).SetProperty(&quot;IncProductPortId&quot;, psOut.GetProperty(&quot;PortItemId&quot;));

						//Start: Saravanan J 24012022 Added for Project Swap &amp; Go
						var sSAMId = mGetSAMId(sIncName);
						var sPSAMId = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_INSURANCE_ADD&quot;,sSAMId);
					/*	var vBO = TheApplication().GetBusObject(&quot;List Of Values&quot;);	// START Added Madhu for 50%Swap n Go PKE
						var vBC = vBO.GetBusComp(&quot;List Of Values&quot;);
						
						  with(vBC)
						  {
							   ClearToQuery();
							   SetViewMode(AllView);
							   ActivateField(&quot;Active&quot;);
							   ActivateField(&quot;Name&quot;);
							   ActivateField(&quot;Value&quot;);
							   ActivateField(&quot;Sub Type&quot;);
							   ActivateField(&quot;Type&quot;);
							   SetSearchSpec(&quot;Value&quot;, sPSAMId);
							   SetSearchSpec(&quot;Type&quot;, &quot;VHA_INSURANCE_ADD&quot;);
							   SetSearchSpec(&quot;Sub Type&quot;, sPSAMId);
							   ExecuteQuery(ForwardOnly);
							   if(FirstRecord())
							   {
							    var vActFlg = GetFieldValue(&quot;Active&quot;);
							   }
						  }//END Added Madhu for 50%Swap n Go PKE*/
						//if((sPSAMId != null &amp;&amp; sPSAMId != &quot;&quot;) &amp;&amp; vActFlg == &apos;Y&apos;)//Modified Madhu for 50%Swap n Go PKE
						if(sPSAMId != null &amp;&amp; sPSAMId != &quot;&quot;)
						{
							sPIncName = mGetProductName(sPSAMId);
						}						

						if(sPIncName != null &amp;&amp; sPIncName != &quot;&quot;)
						{
							psIn.Reset();
							psOut.Reset();
							psIn.SetProperty(&quot;PropositionName&quot;, bsOutputs.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(i).GetProperty(&quot;Product&quot;));
							psIn.SetProperty(&quot;ProductName&quot;, sPIncName);
							psIn.AddChild(psIncAttributes);				
							bsGenProdManService.InvokeMethod(&quot;Get PortIds On Class&quot;,psIn,psOut);
							//BalajiM modified for swapgo MSO lineitem issue 15/03/2022
							/*bsOutputs.SetProperty(&quot;PIncProdItemId&quot;+sSDGrpId, psOut.GetProperty(&quot;ProdItemId&quot;));
							bsOutputs.SetProperty(&quot;PIncProductPortId&quot;+sSDGrpId, psOut.GetProperty(&quot;PortItemId&quot;));
							bsOutputs.SetProperty(&quot;PIncProduct&quot;+sSDGrpId, sPIncName);*/		
							
							bsOutputs.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(i).GetChild(0).GetChild(j).SetProperty(&quot;PIncProdItemId&quot;, psOut.GetProperty(&quot;ProdItemId&quot;));
							bsOutputs.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(i).GetChild(0).GetChild(j).SetProperty(&quot;PIncProductPortId&quot;, psOut.GetProperty(&quot;PortItemId&quot;));
							bsOutputs.GetChild(0).GetChild(0).GetChild(0).GetChild(0).GetChild(i).GetChild(0).GetChild(j).SetProperty(&quot;PIncProduct&quot;, sPIncName);
						}//End: Saravanan J 24012022 Added for Project Swap &amp; Go
					}
				}
			}
		}
		
		bsOutputs.SetProperty(&quot;MapName&quot;,&quot;VHA Add Accessory&quot;);
		bsOutputs.SetProperty(&quot;OutputIntObjectName&quot;,&quot;VHA Fulfilment Order TBUI Upsert&quot;);
		bsEAIMapService.InvokeMethod(&quot;Execute&quot;,bsOutputs,psOutputs);
					
		bsOutputs.Reset();	
		bsEAIService.InvokeMethod(&quot;Upsert&quot;, psOutputs, bsOutputs);
	}
	catch(e)
	{
		if (defined(e.errText))
		{
			var strError = e.errText + &quot;\r&quot; + e.toString(); 
		}
		else
		{
			var strError = e.toString(); 
		}
		throw (strError);
	}
	finally
	{	
	 	psIn = null
	 	psOut = null;
		psOutputs = null;
		psAttributes = null;
		bsInputs = null;
		bsOutputs = null;
		bsEAIService = null;
		bsEAIMapService = null;
		bsGenProdManService = null;
		/*Below variables are nullified by Sharukh on 18/03/2019*/
		psSPIDAttributes = null;
		psIncAttributes = null;
		oBS = null;

	}		
}"
