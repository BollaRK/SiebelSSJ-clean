			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mValidateCreditCheckStatus"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mValidateCreditCheckStatus()
{
	
		//Perform Credit Check Validation
		var psInputs = TheApplication().NewPropertySet();
		var psOutputs = TheApplication().NewPropertySet();
		var bscustomize = TheApplication().GetService(&quot;VF OM Order Validation&quot;);
		psInputs.SetProperty(&quot;OrderId&quot;, sOrderId);
		psInputs.SetProperty(&quot;CustomerAcountId&quot;, sCustAccountId);
		bscustomize.InvokeMethod(&quot;CheckCreditCheckStatus&quot;,psInputs, psOutputs);
	
		psInputs=null;
		psOutputs=null;
		bscustomize=null;
	
}"
