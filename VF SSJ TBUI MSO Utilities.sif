			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fnGetProfileAttribute"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Component Name        : 	
 * Method Name           : 	fnGetProfileAttribute
 * Component Information : 	Used to get profile attribute
 *
 * Modification History  :
 * Date			Author		Description
 * ============ ===========	=========================================
 * 29-08-2017	SK			Created to get profile attributes
 */
function fnGetProfileAttribute (Inputs, Outputs)
{
	try
	{
		var strPropName = &quot;&quot;, strPropValue = &quot;&quot;;
		strPropName = Inputs.GetFirstProperty();
		
		while (strPropName != &quot;&quot;)
		{
			strPropValue = TheApplication().GetProfileAttr(strPropName);
			strPropName = Inputs.GetNextProperty();
		}
		Outputs.SetProperty(strPropName,strPropValue);
	}
	catch (e)
	{
		throw (e);
	}

	finally{
	}
}"
