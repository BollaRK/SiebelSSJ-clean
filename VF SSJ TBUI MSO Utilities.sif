			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="GetProductIdFromName"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function GetProductIdFromName(ProductName)
{
/*
 * Component Name        : 	VF Generic Product Manipulation Service
 * Method Name           : 	mGetPropositionFromPlan
 * Component Information : 	Finds the product Id for a product name
 *							
 *							
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 17/10/2009	NG						Initial Version
 * 12/08/2014    Bharat		Defect #441 - CT Siebel 8.1: Junk Characters in Matrices upload error messages                                    
 */
 	try
	{
		var boProduct = TheApplication().GetBusObject(&quot;Internal Product&quot;);
		var bcProduct = boProduct.GetBusComp(&quot;Internal Product&quot;);

		var sProdName = ProductName;
		var sProdId;

		if(sProdName != null &amp;&amp; sProdName != &quot;&quot;)
		{
			with(bcProduct)
			{
				ClearToQuery();
				SetViewMode(AllView);
				SetSearchSpec(&quot;Name&quot;,sProdName);
				ExecuteQuery();
				
				if(FirstRecord())
					sProdId = GetFieldValue(&quot;Id&quot;);
				else
					throw(gErrorMessage = &quot;The product with product name: &quot; +  sProdName + &quot; cannot be found.&quot;)
			}

		}
		else
			throw(gErrorMessage = &quot;The product name was not passed into function: GetProductIdFromName.&quot;);
			
		return(sProdId);
	}
	catch(e)
	{
		if(gErrorMessage == &quot;&quot;)
		{
			if(defined(e.errText))
			{
				var strError = e.errText + &quot;\r\n&quot; + e.toString(); 
			}
			else
			{
				var strError = e.toString(); 
			}
		}
		else
			throw(gErrorMessage)	
	
			
		throw (strError);	
	}
	finally
	{
		bcProduct = null;
		boProduct = null;	
	}
}"
