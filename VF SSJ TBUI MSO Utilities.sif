			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="AllocateTNR"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function AllocateTNR(OrderId, LineItemId, TNRId)
{
	try
	{
		var psInputs = TheApplication().NewPropertySet();
		var psOutputs = TheApplication().NewPropertySet();
		psInputs.SetProperty(&quot;Order Id&quot;, OrderId);
		psInputs.SetProperty(&quot;Object Id&quot;, TNRId);
		psInputs.SetProperty(&quot;Root Line Item Id&quot;, LineItemId);
		psInputs.SetProperty(&quot;ProcessName&quot;, &quot;VF MNP Allocate Pending Transfer Number&quot;);
		TheApplication().GetService(&quot;Workflow Process Manager&quot;).InvokeMethod(&quot;RunProcess&quot;, psInputs, psOutputs);
		return(&quot;&quot;);//Successful
	}
	catch(e)
	{
		throw e;
	}
	finally
	{
		psInputs = null;
		psOutputs = null;
	}
}"
