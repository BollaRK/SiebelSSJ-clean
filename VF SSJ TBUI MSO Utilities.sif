			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="fnUpdateAPPId"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function fnUpdateAPPId(psCopyInputs)
{
	try
	{
		var bsInputs=TheApplication().NewPropertySet();
		var bsOutputs=TheApplication().NewPropertySet();
		var bsOut=TheApplication().NewPropertySet();
		var sAssetIntId = &quot;&quot;;
		var bsEAIService = TheApplication().GetService(&quot;EAI Siebel Adapter&quot;);
		var iNoOfServices = psCopyInputs.GetChildCount();
		
		for (var i=0; i &lt; iNoOfServices; i++)
		{
			bsInputs.Reset();
			bsOutputs.Reset();
			bsOut.Reset();
			bsInputs.SetProperty(&quot;OutputIntObjectName&quot;, &quot;VHA Accessory Items&quot;);
			bsInputs.SetProperty(&quot;SearchSpec&quot;,&quot;[VHA Accessory Items.Category] &lt;&gt; &apos;Secondary Device&apos; AND [VHA Accessory Items.Related Service Order Id]=&apos;&quot;+psCopyInputs.GetChild(i).GetProperty(&quot;Order Item Id&quot;)+&quot;&apos;&quot;); 
			bsEAIService.InvokeMethod(&quot;Query&quot;, bsInputs, bsOutputs);
			sAssetIntId = psCopyInputs.GetChild(i).GetProperty(&quot;Asset Integration Id&quot;);
			for (var k =0;k&lt;bsOutputs.GetChild(0).GetChild(0).GetChildCount();k++)
			{
				bsOut.Reset();
				bsOut.SetType(&quot;VHA Accessory Items&quot;);
				bsOut.SetProperty(&quot;Asset Integration Id&quot;,sAssetIntId);
				bsOut.SetProperty(&quot;Id&quot;,bsOutputs.GetChild(0).GetChild(0).GetChild(k).GetProperty(&quot;Id&quot;));
				bsOutputs.GetChild(0).GetChild(0).RemoveChild(k);
				bsOutputs.GetChild(0).GetChild(0).InsertChildAt(bsOut.Copy(),k);
			}
					
			bsEAIService.InvokeMethod(&quot;Upsert&quot;, bsOutputs, bsOut);
		}
	}
	catch(e)
	{
		throw e;
	}
	finally
	{
	/*Below variables are nullified by Sharukh on 18/03/2019*/
	bsInputs = null;
	bsOutputs = null;
	bsOut = null;
	bsEAIService = null;

	}
}"
			   SEQUENCE="24"
			   UPDATED="01/09/2026 15:43:17"
			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 15:43:17"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="getInstAssetIdFromActiveRel"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function getInstAssetIdFromActiveRel(sPortMSISDN,bcInstalledAsset,Outputs,strErrorMsg)
{
	var boResource;
	var bcMSISDNRel;
	var strInstalledAssetId;
	var strACTIVE = &quot;Active&quot;;
	var strSUSPENDED = &quot;Suspended&quot;;
	var strPaymentMethodstr = &quot;Prepay&quot;;
	var status;
	var ExistMSISDN;
	try
	{
		// Trace Statement
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;START:getInstAssetIdFromActiveRel.strMSISDN=&quot; + sPortMSISDN);
		}	
	
		boResource = TheApplication().GetBusObject(&quot;VF Resource&quot;);
		bcMSISDNRel = boResource.GetBusComp(&quot;VF Resource Mgmt - MSISDN Relationship&quot;);
		
		bcMSISDNRel.ClearToQuery();
		bcMSISDNRel.ActivateField(&quot;Parent Asset Id&quot;);
		bcMSISDNRel.ActivateField(&quot;Status&quot;);
		//bcMSISDNRel.SetSearchSpec(&quot;Asset Number&quot;, sPortMSISDN);
		bcMSISDNRel.SetSearchExpr(&quot;[Asset Number] = &apos;&quot;+sPortMSISDN+&quot;&apos; AND ([Status] = &apos;&quot;+strACTIVE+&quot;&apos; OR [Status] = &apos;&quot;+strSUSPENDED+&quot;&apos;)&quot;);		
		//bcMSISDNRel.SetSearchSpec(&quot;Status&quot;, strACTIVE);
		bcMSISDNRel.ExecuteQuery(ForwardOnly);
		TheApplication().Trace(&quot;AssetNumber: &quot;+sPortMSISDN);
		
		if (bcMSISDNRel.FirstRecord())
		{
			strInstalledAssetId = bcMSISDNRel.GetFieldValue(&quot;Parent Asset Id&quot;);
			status = bcMSISDNRel.GetFieldValue(&quot;Status&quot;);
			
			bcInstalledAsset.SetViewMode(AllView);	// Needed for access to all records
			bcInstalledAsset.ActivateField(&quot;Payment Method Calc&quot;);
			bcInstalledAsset.ActivateField(&quot;Primary Organization Id&quot;);
			bcInstalledAsset.ActivateField(&quot;Billing Account Number&quot;);
			bcInstalledAsset.ActivateField(&quot;Service Account Id&quot;);
			bcInstalledAsset.ActivateField(&quot;Payment Method&quot;);
			bcInstalledAsset.ClearToQuery();
			bcInstalledAsset.SetSearchExpr(&quot;[Id] = &apos;&quot;+strInstalledAssetId+&quot;&apos; AND [Payment Method] = &apos;Prepay&apos;&quot;);
			/*bcInstalledAsset.SetSearchSpec(&quot;Id&quot;, strInstalledAssetId);
			bcInstalledAsset.SetSearchSpec(&quot;Payment Method&quot;, strPaymentMethodstr);
			*/
			bcInstalledAsset.ExecuteQuery(ForwardOnly);
					
			if (bcInstalledAsset.FirstRecord())
			{
				ExistMSISDN = &quot;Y&quot;;
				//Outputs.SetProperty(&quot;ActiveMSISDN&quot;,&quot;Y&quot;);	
				/*TheApplication().RaiseErrorText(&quot;Active relationship found for Vodafone number. You cannot choose this Port In Number in Connect Postpaid. Please do a Pre to Post if this Port In number is required.&quot;);
				strErrorMsg = &quot;Relationship found for Vodafone number with &quot;+status+&quot; status . You cannot choose this Port In Number in Connect Postpaid. Please do a Pre to Post if this Port In number is required.&quot;;	
				*/
			}
			else
			{
				ExistMSISDN = &quot;N&quot;;
				//Outputs.SetProperty(&quot;ActiveMSISDN&quot;,&quot;N&quot;);
			}
		}	
		
		return (ExistMSISDN);
	}
	catch(e)
	{
		if (defined(e.errText))
		{
			var strError = e.errText + &quot;\r\n&quot; + e.toString(); 
		}
		else
		{
			var strError = e.toString(); 
		}
		throw (strError);
	}
	finally
	{
		bcMSISDNRel = null;
		boResource = null;
		
		// Trace Statement
		if (TheApplication().GetProfileAttr(&quot;TraceOn&quot;) == &quot;Y&quot;)
		{
			TheApplication().Trace(&quot;END:getInstAssetIdFromActiveRel.strMSISDN=&quot; + sPortMSISDN);
		}		
	}
}"
			   SEQUENCE="28"
