			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mAPPAdd"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mAPPAdd(Inputs,Outputs)
{
	try
	{
		var iNoOfServices = 0;
		var psCopyInputs = TheApplication().NewPropertySet();
		var bsEAIService = TheApplication().GetService(&quot;EAI Siebel Adapter&quot;);
		var psLineInputs = TheApplication().NewPropertySet();
		var psLineOutputs = TheApplication().NewPropertySet();
		var bsInputs=TheApplication().NewPropertySet();
		var bsOutputs=TheApplication().NewPropertySet();
		var bsOutputs1=TheApplication().NewPropertySet();
		var bsOut=TheApplication().NewPropertySet();
		var bsOut1=TheApplication().NewPropertySet();
		var sManageAPP = Inputs.GetProperty(&quot;ManageAPP&quot;);
		var sManageAPPScenario = Inputs.GetProperty(&quot;ManageAPPScenario&quot;);
		var sAPPId = Inputs.GetProperty(&quot;APPId&quot;);
		
		var sIOName = &quot;VHA APP Order Task Support&quot;;
		if(sManageAPP == &quot;Y&quot;)
		{
			sIOName = &quot;VHA Manage APP Accessory TBUI IO&quot;;
			if (sManageAPPScenario != &quot;ModifyAPP&quot;)
				psLineInputs.SetProperty(&quot;SearchSpec&quot;,&quot;[VHA Manage APP Accessory TBUI BC.Order Id] = &apos;&quot; + sOrderId + &quot;&apos;&quot;);
			else
				psLineInputs.SetProperty(&quot;SearchSpec&quot;,&quot;[VHA Manage APP Accessory TBUI BC.Asset Integration Id] = &apos;&quot;+sAPPId+&quot;&apos;&quot;);
		}
		else
		{
		psLineInputs.SetProperty(&quot;SearchSpec&quot;,&quot;[VHA APP Accessory TBUI BC.Order Id] = &apos;&quot; + sOrderId + &quot;&apos;&quot;);
		} 
		psLineInputs.SetProperty(&quot;OutputIntObjectName&quot;, sIOName);
		bsEAIService.InvokeMethod(&quot;Query&quot;, psLineInputs, psLineOutputs);	
		psCopyInputs = psLineOutputs.GetChild(0).GetChild(0).Copy();	
		iNoOfServices = psCopyInputs.GetChildCount();
		if (sManageAPPScenario != &quot;ModifyAPP&quot;)
		{
			var oLineBC = TheApplication().GetBusObject(&quot;Order Entry - Thin MSO&quot;).GetBusComp(&quot;VF Order Line Items - Thin&quot;);
			var sSearchStr = &quot;[Order Id]=&apos;&quot;+sOrderId+&quot;&apos; AND [Product Type]=&apos;Billing - APP&apos; AND [Action Code]=&apos;Add&apos;&quot;;	
			mDeleteRecord(oLineBC,sSearchStr);
		}
		if (ToNumber(iNoOfServices) &gt; 0)
		{
			//TheApplication().RaiseErrorText(&quot;No Line Item added for this Order&quot;);
				
			for (var i=0; i &lt; iNoOfServices; i++)
			{
				if (sManageAPPScenario == &quot;ModifyAPP&quot;)
				{
					mAPPAddBSCall(i, psCopyInputs,bsOutputs,bsOutputs1,sManageAPPScenario,Inputs,Outputs);
					
				}
				else
				{
					bsInputs.Reset();
					bsOutputs.Reset();
					bsInputs.SetProperty(&quot;OutputIntObjectName&quot;, &quot;VHA Order Line Item&quot;);
				//	bsInputs.SetProperty(&quot;SearchSpec&quot;,&quot;[LineItem.Product] = &apos;Accessory&apos; AND [LineItem.Order Header Id]=&apos;&quot;+sOrderId+&quot;&apos; AND [LineItem.Root Order Item Id]=&apos;&quot;+psCopyInputs.GetChild(i).GetProperty(&quot;Related Service Order Id&quot;)+&quot;&apos;&quot;);
					bsInputs.SetProperty(&quot;SearchSpec&quot;,&quot;[LineItem.Product] = &apos;Accessory&apos; AND [LineItem.SD Group Id] IS NULL AND [LineItem.Order Header Id]=&apos;&quot;+sOrderId+&quot;&apos; AND [LineItem.Root Order Item Id]=&apos;&quot;+psCopyInputs.GetChild(i).GetProperty(&quot;Related Service Order Id&quot;)+&quot;&apos;&quot;); // Changed in ATOM Project : Balaji
					bsEAIService.InvokeMethod(&quot;Query&quot;, bsInputs, bsOutputs);
					bsInputs.Reset();
					bsOutputs1.Reset();
					bsInputs.SetProperty(&quot;OutputIntObjectName&quot;, &quot;VHA Accessory Items&quot;);
				//	bsInputs.SetProperty(&quot;SearchSpec&quot;,&quot;[VHA Accessory Items.Related Service Order Id]=&apos;&quot;+psCopyInputs.GetChild(i).GetProperty(&quot;Related Service Order Id&quot;)+&quot;&apos;&quot;);
					var sSDId = psCopyInputs.GetChild(i).GetProperty(&quot;SD Group Id&quot;);
					if(sSDId != null &amp;&amp; sSDId != &quot;&quot;)
						bsInputs.SetProperty(&quot;SearchSpec&quot;,&quot;[VHA Accessory Items.SD Group Id] = &apos;&quot;+sSDId+&quot;&apos; AND [VHA Accessory Items.Related Service Order Id]=&apos;&quot;+psCopyInputs.GetChild(i).GetProperty(&quot;Related Service Order Id&quot;)+&quot;&apos;&quot;); // Changed in ATOM Project : Balaji
					else
						bsInputs.SetProperty(&quot;SearchSpec&quot;,&quot;[VHA Accessory Items.SD Group Id] IS NULL AND [VHA Accessory Items.Related Service Order Id]=&apos;&quot;+psCopyInputs.GetChild(i).GetProperty(&quot;Related Service Order Id&quot;)+&quot;&apos;&quot;); // Changed in ATOM Project : Balaji
					bsEAIService.InvokeMethod(&quot;Query&quot;, bsInputs, bsOutputs1);						
					mAPPAddBSCall(i, psCopyInputs,bsOutputs,bsOutputs1,sManageAPPScenario,Inputs,Outputs);			
				}
			}
			
			// Update the &quot;Related Asset Integration Id&quot; value in APP TBUI // updating APP ID of APP in cx table
			var sOutIO = &quot;VHA APP Accessories IO&quot;; // ATOM Project: Balaji : changed the IO from &apos;VHA APP Order Task Support&apos; to upsert multiple APP under one service line item
			var sMap = &quot;VHA SD APP Update Order Task Support&quot;; // ATOM Project: Balaji : changed the mapname from &apos;VHA APP Update Order Task Support&apos; to upsert multiple APP under one service line item
			if(sManageAPP == &quot;Y&quot;)
			{
			//	sMap = &quot;VHA Manage APP Order Task Support&quot;;
			//	sOutIO = &quot;VHA APP Order Task Support&quot;;
				sMap = &quot;VHA Manage SD APP Order Task Support&quot;;
				sOutIO = &quot;VHA SD APP Order Task Support&quot;;
			}
			mMPPBCUpsert(psCopyInputs, psLineOutputs, sOutIO, sMap);
					
			// Update the &quot;APP Contract Id&quot; value in Task Validation BC
			var sOutIO = &quot;VF Task Validation&quot;;
			var sMap = &quot;VHA APP Update Task Validation&quot;;
			if(sManageAPP == &quot;Y&quot;)
			sMap = &quot;VHA Manage APP Update Task Validation&quot;;
			mMPPBCUpsert(psCopyInputs, psLineOutputs, sOutIO, sMap);
		}
	}
	catch (e)
	{
		throw e;
	}
	finally
	{
	/*Below variables are nullified by Sharukh on 18/03/2019*/
	//oLineBC = null;
	if(defined(oLineBC)) { oLineBC = null; }/*This variable is nullified by GURUPRASAD on 03/10/2019*/
	bsInputs = null;
	bsOutputs = null;
	bsOutputs1 = null;
	bsOut = null;
	bsOut1 = null;
	psCopyInputs = null;
	bsEAIService = null;
	psLineInputs = null;
	psLineOutputs = null;
	
	
		
	}
}"
			   SEQUENCE="33"
			   UPDATED="01/09/2026 15:43:17"
			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 15:43:17"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mAPPAddBSCall"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mAPPAddBSCall(i, &amp;psCopyInputs,&amp;bsLineOut,&amp;bsLineOut1,sManageAPPScenario,Inputs,Outputs)
{	
	try
	{
		var sRRP = psCopyInputs.GetChild(i).GetProperty(&quot;VHA RRP inc GST&quot;);
		var sRRPOverride = psCopyInputs.GetChild(i).GetProperty(&quot;Contract Amount Override&quot;);
		var sLineItemId = &quot;&quot;;
		//if(sRRPOverride != &quot;&quot;)
		//	sRRP = sRRPOverride;
		
		if(ToNumber(sRRP) &gt;= 0)//SureshG - Modified If condition with = for 19.3 Prepayments
		{
			if(sManageAPPScenario != &quot;ModifyAPP&quot;)
				sLineItemId = psCopyInputs.GetChild(i).GetProperty(&quot;Related Service Order Id&quot;);
			else
				sLineItemId = Inputs.GetProperty(&quot;OrderLineId&quot;);
			var bsService = TheApplication().GetService(&quot;VF Generic Product Manipulation Service&quot;);
			var bsInputs = TheApplication().NewPropertySet();
			var bsOutputs = TheApplication().NewPropertySet();
			var bsOut=TheApplication().NewPropertySet();
			var bsOut1=TheApplication().NewPropertySet();
			var bsEAIService = TheApplication().GetService(&quot;EAI Siebel Adapter&quot;);
			var sAPPContAmt = sRRP;
			var sAPPContId=&quot;&quot;;
			var sAssetIntId = &quot;&quot;;
			var sMPA = psCopyInputs.GetChild(i).GetProperty(&quot;Monthly Payment Amount&quot;);
			var sMPAOverride = psCopyInputs.GetChild(i).GetProperty(&quot;VHA Manage APP Monthly Payment&quot;);
			if(sMPAOverride != &quot;&quot;)
				sMPA = sMPAOverride;
			var sTerm = psCopyInputs.GetChild(i).GetProperty(&quot;Contract Term&quot;);
			var sTermOverride = psCopyInputs.GetChild(i).GetProperty(&quot;Contract Term Override&quot;);
			//if(sTermOverride != &quot;&quot;)
			//	sTerm = sTermOverride;

			//bsInputs.SetProperty(&quot;Upfront Payment Amount&quot;, psCopyInputs.GetChild(i).GetProperty(&quot;APP Pay To Dealer&quot;));
			bsInputs.SetProperty(&quot;EMR&quot;, sMPA);
			bsInputs.SetProperty(&quot;MPP Product Name&quot;, TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_APP_PRODUCT&quot;,&quot;APP&quot;));
			bsInputs.SetProperty(&quot;Order Id&quot;, sOrderId); // Get from task
			bsInputs.SetProperty(&quot;Term&quot;, sTerm);
			bsInputs.SetProperty(&quot;Term Override&quot;, sTermOverride);
			bsInputs.SetProperty(&quot;Product Code&quot;, psCopyInputs.GetChild(i).GetProperty(&quot;Proposition Id&quot;));
			bsInputs.SetProperty(&quot;Total RRP&quot;, sRRP);
			bsInputs.SetProperty(&quot;Root Line Item Id&quot;, sLineItemId);
			bsInputs.SetProperty(&quot;Contract Amount&quot;, sRRP);			
			bsInputs.SetProperty(&quot;Order Item Id&quot;, psCopyInputs.GetChild(i).GetProperty(&quot;APP Contract Id&quot;));
			bsInputs.SetProperty(&quot;Due Date&quot;,&quot;&quot;);
			bsInputs.SetProperty(&quot;TotalNumofAccessories&quot;,psCopyInputs.GetChild(i).GetProperty(&quot;Total Number of Accessories&quot;));
			bsInputs.SetProperty(&quot;Contract Amount Override&quot;,sRRPOverride);
			
			if(ToNumber(psCopyInputs.GetChild(i).GetProperty(&quot;VHA APP Prepayment Amount&quot;)) &gt; 0)
			{
			bsInputs.SetProperty(&quot;Prepayment Amount&quot;,psCopyInputs.GetChild(i).GetProperty(&quot;VHA APP Prepayment Amount&quot;));
			bsInputs.SetProperty(&quot;Additional Info&quot;,mGetPrepaymentOption(sOrderId));
			}
			else if(ToNumber(psCopyInputs.GetChild(i).GetProperty(&quot;VHA APP Prepayment Amount&quot;)) == 0)
			{
				bsInputs.SetProperty(&quot;Prepayment Amount&quot;, &quot;&quot;);
				bsInputs.SetProperty(&quot;Additional Info&quot;, &quot;&quot;);
			}
		//ATOM Project: Balaji: Update Related Asset Integration Id against APP contract line item
			var sCategory = psCopyInputs.GetChild(i).GetProperty(&quot;Category&quot;);
			var sIMEI = psCopyInputs.GetChild(i).GetProperty(&quot;IMEI&quot;);
			var sId = psCopyInputs.GetChild(i).GetProperty(&quot;Id&quot;);
			if(sCategory == &quot;Secondary Device&quot;)
				bsInputs.SetProperty(&quot;APP Id&quot;, psCopyInputs.GetChild(i).GetProperty(&quot;Asset Integration Id&quot;));
			else
				bsInputs.SetProperty(&quot;APP Id&quot;, &quot;&quot;);
			bsInputs.SetProperty(&quot;SDGroupID&quot;, psCopyInputs.GetChild(i).GetProperty(&quot;SD Group Id&quot;));  
			bsInputs.SetProperty(&quot;SDRefId&quot;, psCopyInputs.GetChild(i).GetProperty(&quot;SD Reference Id&quot;)); 
			if(sCategory == &quot;&quot; || sCategory == null)
				sCategory = &quot;Accessory&quot;;
		// ATOM Project: end		
			if(sTermOverride != &quot;&quot;)
				sTerm = sTermOverride;
			
			/*Kathambari-09/05/2016- Added for AOA*/
			var dStartDate = new Date();
			var sStartDayDate = ToString(dStartDate.getDate());
			var sStartMonthDate = ToString(dStartDate.getMonth() + 1);
			if (sStartDayDate.length == 1)
			{
				sStartDayDate = &quot;0&quot; + sStartDayDate;
			};
			if (sStartMonthDate.length == 1)
			{
				sStartMonthDate = &quot;0&quot; + sStartMonthDate;
			};
			var sStartDateObj = sStartDayDate + &quot;/&quot; + sStartMonthDate + &quot;/&quot; + dStartDate.getFullYear();
			var sStartDateObjMMDDYY = sStartMonthDate + &quot;/&quot; + sStartDayDate + &quot;/&quot; + dStartDate.getFullYear();
			var	dDueDate = bsService.AddMonthsToDate(dStartDate, sTerm);
			var sDueDayDate = ToString(dDueDate.getDate());
			var sDueMonthDate = ToString(dDueDate.getMonth() + 1);
			if (sDueDayDate.length == 1)
			{
				sDueDayDate = &quot;0&quot; + sDueDayDate;
			};
			if (sDueMonthDate.length == 1)
			{
				sDueMonthDate = &quot;0&quot; + sDueMonthDate;
			};
			var sDueDateObj = sDueDayDate + &quot;/&quot; + sDueMonthDate + &quot;/&quot; + dDueDate.getFullYear();
			var sDueDateObjMMDDYY = sDueMonthDate + &quot;/&quot; + sDueDayDate + &quot;/&quot; + dDueDate.getFullYear();
			
			if(ToNumber(sTerm) == 0) //SureshG Added this block for 19.3
			{			
			sDueDateObj = sStartDateObj;
			sDueDateObjMMDDYY = sStartDateObjMMDDYY;			
			}			
			
			bsInputs.SetProperty(&quot;Contract End Date&quot;,sDueDateObj);
			bsInputs.SetProperty(&quot;Contract Start Date&quot;,sStartDateObj);
			//ATOM Project: Balaji: Added New APP Attribute
			bsInputs.SetProperty(&quot;ManageAPP&quot;, Inputs.GetProperty(&quot;ManageAPP&quot;)); 
			if(sCategory == &quot;Secondary Device&quot;)
				bsInputs.SetProperty(&quot;Category&quot;, sCategory);
			else
				bsInputs.SetProperty(&quot;Category&quot;, &quot;&quot;);
			bsInputs.SetProperty(&quot;IMEI&quot;, sIMEI);
			
			/*Kathambari - End of Code*/
			bsOutputs.Reset();
			bsService.InvokeMethod(&quot;Add APP Products&quot;, bsInputs, bsOutputs);
			sAPPContId = bsOutputs.GetProperty(&quot;APPLineId&quot;);
			sAssetIntId = bsOutputs.GetProperty(&quot;AssetIntId&quot;);
			
			//psCopyInputs.GetChild(i).SetProperty(&quot;VF Upfront Payment&quot;, &quot;&quot;);	
			//psCopyInputs.GetChild(i).SetProperty(&quot;VF APP Altered&quot;, &quot;0&quot;);
			psCopyInputs.GetChild(i).SetProperty(&quot;APP Contract Id&quot;, sAPPContId);
			psCopyInputs.GetChild(i).SetProperty(&quot;Asset Integration Id&quot;, sAssetIntId);
			
			if(sManageAPPScenario != &quot;ModifyAPP&quot;) 
			{
				for (var j =0;j&lt;bsLineOut.GetChild(0).GetChild(0).GetChildCount();j++)
				{
					bsOut.Reset();
					bsOut.SetType(&quot;LineItem&quot;);
					bsOut.SetProperty(&quot;Related Asset Integration Id&quot;,sAssetIntId);
					bsOut.SetProperty(&quot;Integration Id&quot;,bsLineOut.GetChild(0).GetChild(0).GetChild(j).GetProperty(&quot;Integration Id&quot;));
					bsLineOut.GetChild(0).GetChild(0).RemoveChild(j);
					bsLineOut.GetChild(0).GetChild(0).InsertChildAt(bsOut.Copy(),j);
				}
				for (var k =0;k&lt;bsLineOut1.GetChild(0).GetChild(0).GetChildCount();k++)
				{
					bsOut.Reset();
					bsOut.SetType(&quot;VHA Accessory Items&quot;);
					bsOut.SetProperty(&quot;Asset Integration Id&quot;,sAssetIntId);
					bsOut.SetProperty(&quot;Id&quot;,bsLineOut1.GetChild(0).GetChild(0).GetChild(k).GetProperty(&quot;Id&quot;));
					bsLineOut1.GetChild(0).GetChild(0).RemoveChild(k);
					bsLineOut1.GetChild(0).GetChild(0).InsertChildAt(bsOut.Copy(),k);
				}
			}
			//Added for getting new app id
			//Outputs.SetProperty(&quot;NewAPPId&quot;,sAssetIntId);
			
			var OrderBO = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
			var AccBC = OrderBO.GetBusComp(&quot;VHA APP Accessory TBUI BC&quot;);
			with(AccBC)
			{
			ClearToQuery();
			SetViewMode(AllView);
			ActivateField(&quot;Contract Start Date&quot;);
			ActivateField(&quot;Contract End Date&quot;);
			ActivateField(&quot;Related Service Order Id&quot;);
		//	SetSearchSpec(&quot;Related Service Order Id&quot;,sLineItemId);
			SetSearchSpec(&quot;Id&quot;,sId);
			ExecuteQuery(ForwardOnly);
			var fr = FirstRecord();
			if(fr)
			{
//			TheApplication().Trace(&quot;ConStartDate&quot;,sStartDateObjMMDDYY);
//			TheApplication().Trace(&quot;ConEndDate&quot;,sDueDateObjMMDDYY);
			SetFieldValue(&quot;Contract Start Date&quot;,sStartDateObjMMDDYY);
			SetFieldValue(&quot;Contract End Date&quot;,sDueDateObjMMDDYY);
			WriteRecord();
			}
			}
			
			if(sManageAPPScenario != &quot;ModifyAPP&quot;) 
			{
				bsOut.Reset();
				bsOut1.Reset();
				if(sCategory == &quot;Accessory&quot;)
					bsEAIService.InvokeMethod(&quot;Upsert&quot;, bsLineOut, bsOut); // update related asset inte id of accessory line item
				bsEAIService.InvokeMethod(&quot;Upsert&quot;, bsLineOut1, bsOut1);		// update app id of accessory in cx table
			}
		}
		else
			psCopyInputs.GetChild(i).SetProperty(&quot;APP Contract Id&quot;, &quot;&quot;);
	}
	catch (e)
	{
		throw e;
	}
	finally
	{	
	/*Below variables are nullified by Sharukh on 18/03/2019*/
	AccBC = null;
	OrderBO = null;
	bsService = null;
	bsInputs = null;
	bsOutputs = null;
	bsOut = null;
	bsOut1 = null;
	bsEAIService = null;
	
	
	
	}
}"
			   SEQUENCE="34"
			   UPDATED="01/09/2026 15:43:17"
			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 15:43:17"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mAPPEachLineItem"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mAPPEachLineItem(LineIn, &amp;psCopyInputs)
{
	try
	{
		var sLineItemId = LineIn.GetProperty(&quot;LineItemId&quot;);
		var i = LineIn.GetProperty(&quot;Cursor&quot;);
		var psOut = TheApplication().NewPropertySet();
		var psOut1 = TheApplication().NewPropertySet();
		var strRootAssetIntId = &quot;&quot;;
		var strDeviceType=&quot;&quot;, strRCC=&quot;&quot;, strProductCode=&quot;&quot;, strOrderNum =&quot;&quot;;
		var vAPPExists=&quot;&quot;, strAPPActionCode=&quot;&quot;, strAPPContractId=&quot;&quot;, strProductName=&quot;&quot;;
		var strAction = &quot;&quot;, strTerm=&quot;&quot;, strRCCOVRD = &quot;&quot;, strTermOvrd=&quot;&quot;;
		if((sOrderId != &quot;&quot; || sOrderId!= null)  &amp;&amp; (sLineItemId != &quot;&quot; || sLineItemId != null))
		{	
			psOut1.SetProperty(&quot;AddAPP&quot;,&quot;Y&quot;);
			mAPPGetAccessoryDetails(sLineItemId, psOut1);
			strRootAssetIntId = LineIn.GetProperty(&quot;RootAssetIntId&quot;);	
			strDeviceType = psOut1.GetProperty(&quot;AccessoryType&quot;);
			strRCC = psOut1.GetProperty(&quot;TotalRRP&quot;);
			strProductCode = psOut1.GetProperty(&quot;AccessoryCode&quot;);
			strOrderNum = psOut1.GetProperty(&quot;OrderNumber&quot;);
			strTerm = psOut1.GetProperty(&quot;Term&quot;);//TULASIY:06Feb24::Created for Quote APP Term
			/*mMPPGetPlanDetails(sLineItemId, psOut);
			strTerm = psOut.GetProperty(&quot;Term&quot;);*/
			
			if(gManageAPPScenario == &quot;RefundAPP&quot;)
			{
				strTerm = gRefundTerm;
				strTermOvrd = gInstRemain;
				strRCC = gContAmt;
				strRCCOVRD = gContAmtOVRD;
			
			}
			
			strAPPContractId = LineIn.GetProperty(&quot;APPContractId&quot;);
			if (strAPPContractId != &quot;&quot; &amp;&amp; strAPPContractId != null)
			{
				vAPPExists = &quot;Y&quot;;
				strAPPActionCode = &quot;Add&quot;;
			}
			else
			{
				vAPPExists = &quot;N&quot;;
				strAPPActionCode = &quot;&quot;;
			}		
			if (vAPPExists == &quot;Y&quot;) 
				strAction = &quot;ADD&quot;;
			else
				strAction = &quot;N/A&quot;;
			
			strProductName = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_APP_PRODUCT&quot;,&quot;APP&quot;);
			
			psCopyInputs.GetChild(i).SetProperty(&quot;MPP Active&quot;, &quot;Y&quot;);
			psCopyInputs.GetChild(i).SetProperty(&quot;Asset Integration Id&quot;, strRootAssetIntId);
			psCopyInputs.GetChild(i).SetProperty(&quot;MPP Order Item Id&quot;, sLineItemId);
			psCopyInputs.GetChild(i).SetProperty(&quot;MPP Type&quot;, TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_APP_PRODUCT&quot;,&quot;APP TBUI&quot;));
			psCopyInputs.GetChild(i).SetProperty(&quot;MPP RCC F&quot;, strRCC);
			psCopyInputs.GetChild(i).SetProperty(&quot;MPP Remaining Balance F&quot;, strRCCOVRD);
			psCopyInputs.GetChild(i).SetProperty(&quot;MPP Contract Id&quot;, strAPPContractId);
			psCopyInputs.GetChild(i).SetProperty(&quot;MPP Product Name&quot;, strProductName);
			psCopyInputs.GetChild(i).SetProperty(&quot;Line Number&quot;, psOut1.GetProperty(&quot;TotalNumofAccessories&quot;));
			psCopyInputs.GetChild(i).SetProperty(&quot;MPP Name&quot;, strOrderNum);
			psCopyInputs.GetChild(i).SetProperty(&quot;MPP Contract Months TBUI&quot;, strTerm);
			psCopyInputs.GetChild(i).SetProperty(&quot;VF Handset Id TBUI&quot;, strTermOvrd);
			//psCopyInputs.GetChild(i).SetProperty(&quot;NonRFPrepayment&quot;, strNRPrepayment);
			
		//	psCopyInputs.GetChild(i).SetProperty(&quot;Category&quot;, &quot;Accessory&quot;);
		}		
	}
	catch (e)
	{
		throw e;
	}
	finally
	{
		psOut1 = null;
		psOut = null;		
	}
}"
			   SEQUENCE="35"
