			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mMPPGetDeviceDetails"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mMPPGetDeviceDetails(psIns, &amp;psOut)
{
	try
	{
		var strLineItemId = psIns.GetProperty(&quot;LineItemId&quot;);
		var strStockIndicator = psIns.GetProperty(&quot;VF Stock Indicator TBUI&quot;);
		var boMPP = TheApplication().GetBusObject(&quot;VF MPP Orders&quot;)
		var bcIMEI = boMPP.GetBusComp(&quot;VF Allocate IMEI&quot;);
		var bcDevice = boMPP.GetBusComp(&quot;VF MPP RCC Details&quot;);
		var strIMEI = &quot;&quot;, strDeviceType = &quot;&quot;, strRCC = &quot;&quot;, strProductCode = &quot;&quot;, strVFFlag = &quot;&quot;, strMandateTerm = &quot;&quot;, strMandateAmount = &quot;&quot;;
		var sResId = psIns.GetProperty(&quot;ReservationId&quot;);
		var boHM = TheApplication().GetBusObject( &quot;VF Handset Matrix&quot; );
		var bcHMVer = boHM.GetBusComp( &quot;VF Handset Matrix Version&quot; );
		var bcHM = boHM.GetBusComp( &quot;VF Handset Matrix&quot; );
		
		if(sResId !=&quot;&quot;)
		{
			bcHMVer.ClearToQuery();
			bcHM.ActivateField(&quot;Device Name&quot;);
			bcHM.ActivateField(&quot;Recommended Customer Contribution&quot;);
			bcHM.ActivateField(&quot;Product Code&quot;);
			bcHM.ActivateField(&quot;Plan Name&quot;);
			bcHM.ActivateField(&quot;Id&quot;);
			bcHMVer.SetSearchSpec(&quot;Version Status&quot;, &quot;Live&quot;);
			bcHM.SetSearchSpec(&quot;Product Code&quot;, psIns.GetProperty(&quot;StoreDevice&quot;));
			bcHM.SetSearchSpec(&quot;Plan Name&quot;, psIns.GetProperty(&quot;Plan&quot;));
			bcHMVer.SetViewMode(AllView);
			bcHMVer.ExecuteQuery();
			
			if (bcHM.FirstRecord())
			{ 
				strDeviceType = bcHM.GetFieldValue(&quot;Device Name&quot;);
				strRCC = bcHM.GetFieldValue(&quot;Recommended Customer Contribution&quot;);
				strProductCode = bcHM.GetFieldValue(&quot;Product Code&quot;);
				strVFFlag = &quot;Y&quot;;
				strMandateAmount = strRCC;
			}
			else{
			TheApplication().RaiseErrorText(&quot;VFErr#9900990 :The Handset&quot;+psIns.GetProperty(&quot;StoreDevice&quot;)+&quot; is not offered along with the rate plan: &apos;&quot; + psIns.GetProperty(&quot;Plan&quot;) + &quot;&apos;.Please reselect Plan.\r\n&quot;);
			}
		}
		else{

		with (bcIMEI)
		{
			ActivateField(&quot;IMEI&quot;);
			ActivateField(&quot;Order Id&quot;);
			ActivateField(&quot;Device Name&quot;);
			ActivateField(&quot;Upfront Cost&quot;);
			ActivateField(&quot;Product Code&quot;);
			ActivateField(&quot;VF Flag&quot;);
			ActivateField(&quot;Mandatory Term&quot;);
			ActivateField(&quot;Mandatory Amount&quot;);
			ClearToQuery();	
			SetViewMode(AllView);
			SetSearchSpec(&quot;Root Order Line Item&quot;, strLineItemId);
			SetSearchSpec(&quot;Order Id&quot;, sOrderId);
			ExecuteQuery(ForwardOnly);
			if (FirstRecord())
			{
				strIMEI = GetFieldValue(&quot;IMEI&quot;);
				strDeviceType = GetFieldValue(&quot;Device Name&quot;);
				strRCC = GetFieldValue(&quot;Upfront Cost&quot;);
				strProductCode = GetFieldValue(&quot;Product Code&quot;);
				strVFFlag = GetFieldValue(&quot;VF Flag&quot;);
				strMandateTerm = GetFieldValue(&quot;Mandatory Term&quot;);
				strMandateAmount = GetFormattedFieldValue(&quot;Mandatory Amount&quot;);
				
				
				//TARIQ-22JAN2015-Added-Start
				if(strVFFlag == &quot;N&quot; || strVFFlag == &quot;Y&quot;)
				{
					//Do Nothing
				}
				else
				{
					strVFFlag = &quot;N&quot;
				}
				if(strVFFlag == &quot;N&quot;)// Not a vodafone imei
				{
					strRCC = &quot;&quot;;
				}
				else
				{
					if (strRCC == &quot;&quot; || strRCC == null)
						strRCC = &quot;0&quot;;
				}
				//TARIQ-22JAN2015-Added-End
			}
			else
			{
				with (bcDevice)
				{
					ClearToQuery();	
					SetViewMode(AllView);
					SetSearchSpec(&quot;Order Header Id&quot;, sOrderId);
					SetSearchSpec(&quot;Root Order Item Id&quot;, strLineItemId);
					SetSearchSpec(&quot;Action Code&quot;, &quot;&lt;&gt; Delete&quot;);
					ExecuteQuery(ForwardOnly);
					if (FirstRecord())
					{
						strRCC = GetFieldValue(&quot;Device RCC Inc GST&quot;);
						strProductCode = GetFieldValue(&quot;Device Code&quot;);
						strDeviceType = GetFieldValue(&quot;Device Name&quot;);
						strVFFlag = &quot;Y&quot;;
						strMandateAmount = strRCC;
						
					}
				}
			}
		}
		}
		TheApplication().SetProfileAttr(&quot;RCC3&quot;,strRCC + strVFFlag);
		psOut.SetProperty(&quot;IMEI&quot;, strIMEI);
		psOut.SetProperty(&quot;DeviceType&quot;, strDeviceType);
		psOut.SetProperty(&quot;RCC&quot;, strRCC);
		psOut.SetProperty(&quot;ProductCode&quot;, strProductCode);
		psOut.SetProperty(&quot;VFFlag&quot;, strVFFlag);
		psOut.SetProperty(&quot;IsUpgradeIMEI&quot;, &quot;&quot;);
		psOut.SetProperty(&quot;MandateTerm&quot;, strMandateTerm);
		psOut.SetProperty(&quot;MandateAmount&quot;, strMandateAmount);
		psOut.SetProperty(&quot;Mandate&quot;, &quot;Y&quot;);
		psOut.SetProperty(&quot;StockIndicator&quot;, strStockIndicator);
		
	}
	catch(e)
	{
		throw e;
	}
	finally
	{
			bcDevice = null;  /* This variable is nullified by Sharukh on 18/03/2019*/
			bcIMEI = null;
			boMPP = null;
	
	}
}"
			   SEQUENCE="94"
			   UPDATED="01/09/2026 15:43:19"
			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 15:43:19"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mMPPGetOrderDetails"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mMPPGetOrderDetails (sLineItemId, &amp;psOut)
{
	/*
	* Component Name        : 	mGetOrderDetails
	* Method Name           : 	
	* Component Information : 	  
	*
	* Modification History  :
	* Date			Author		Config #	Description
	* ============ ===========	===========	================================
	* 03/09/2014	Balaji					Initial version
	*/

	try
	{
		
		//var sLineItemId= psIns.GetProperty(&quot;LineItemId&quot;);
		 
		var boOrder = TheApplication().GetBusObject(&quot;VF Order Entry - IMEI&quot;);
		var boOrderUpgrades = TheApplication().GetBusObject(&quot;VF Order Simple - eUpgrades&quot;);
	
		var bcOrder = boOrder.GetBusComp(&quot;Order Entry - Orders&quot;);
		var bcOrderLI = boOrder.GetBusComp(&quot;Order Entry - Line Items&quot;);
		var bcOrderLIUpgrades = boOrderUpgrades.GetBusComp(&quot;VF Order Entry - Line Items (Simple) - eUpgrades&quot;);
		var bcOrderLIIMEI = boOrder.GetBusComp(&quot;VF Order Entry - Line Items - IMEI Required&quot;);
		var bcOrderLIAtt = boOrder.GetBusComp(&quot;Order Item XA&quot;);
		var strProduct = &quot;&quot;;
		var strTerm = &quot;&quot;;
		
		var strServiceType = &quot;&quot;;
		var strRootAssetIntId = &quot;&quot;;
		var strContactId = &quot;&quot;;		 
		var strOrderFunctionPlan = &quot;&quot;;
		var strAccType = &quot;&quot;, iSpace = &quot;&quot;;
		var strCustAccId = &quot;&quot;;
		var strDueDate = &quot;&quot;;
		bcOrder.ActivateField(&quot;Contact Id&quot;);
		bcOrder.ActivateField(&quot;Customer Account Id&quot;);
		bcOrder.ActivateField(&quot;Account Type&quot;);
		bcOrder.ActivateField(&quot;VF Order Function&quot;);
		bcOrderLI.ActivateField(&quot;Product Type&quot;);
		bcOrderLI.ActivateField(&quot;Root Order Item Id&quot;);
		bcOrderLIUpgrades.ActivateField(&quot;Product&quot;);
		bcOrderLIAtt.ActivateField(&quot;Name&quot;);
		bcOrderLIAtt.ActivateField(&quot;Text Value&quot;);
		bcOrder.SetViewMode(AllView);
		bcOrder.ClearToQuery();
		bcOrder.SetSearchSpec(&quot;Id&quot;, sOrderId);
		bcOrder.ExecuteQuery(ForwardBackward);
	    if (bcOrder.FirstRecord())
		{
			bcOrderLI.SetViewMode(AllView);
			bcOrderLI.ClearToQuery();
			bcOrderLI.SetSearchSpec(&quot;Id&quot;, sLineItemId);
			bcOrderLI.ExecuteQuery(ForwardBackward);
			if(bcOrderLI.FirstRecord())
			{			
				strContactId = bcOrder.GetFieldValue(&quot;Contact Id&quot;);
				strCustAccId = bcOrder.GetFieldValue(&quot;Customer Account Id&quot;);
				strAccType = bcOrder.GetFieldValue(&quot;Account Type&quot;);
				strOrderFunctionPlan = bcOrder.GetFieldValue(&quot;VF Order Function&quot;);			
				strServiceType = bcOrderLI.GetFieldValue(&quot;Service Type&quot;);
				strRootAssetIntId = bcOrderLI.GetFieldValue(&quot;Root Asset Integration Id&quot;);
				//sLineItemId = bcOrderLI.GetFieldValue(&quot;Id&quot;); // line item id for tbui				
				
				bcOrderLIUpgrades.ClearToQuery();
				bcOrderLIUpgrades.ActivateField(&quot;Action Code&quot;);
				bcOrderLIUpgrades.ActivateField(&quot;Order Header Id&quot;);
				
				bcOrderLIUpgrades.SetSearchSpec(&quot;Action Code&quot;,&quot;&lt;&gt; Delete&quot;);
				bcOrderLIUpgrades.SetSearchSpec(&quot;Order Header Id&quot;, sOrderId);
				bcOrderLIUpgrades.SetSearchSpec(&quot;Root Order Item Id&quot;, sLineItemId);
				bcOrderLIUpgrades.SetSearchSpec(&quot;Primary Product Flag&quot;, &quot;Y&quot;);
				bcOrderLIUpgrades.SetSearchSpec(&quot;Last Version&quot;, &quot;0&quot;);
				bcOrderLIUpgrades.ExecuteQuery(ForwardBackward);
				
				if(bcOrderLIUpgrades.FirstRecord())
				{
					
					strProduct = bcOrderLIUpgrades.GetFieldValue(&quot;Product&quot;);
					strDueDate = bcOrderLIUpgrades.GetFieldValue(&quot;Created&quot;);
					var strRowId = bcOrderLIUpgrades.GetFieldValue(&quot;Id&quot;);
					bcOrderLIIMEI.ClearToQuery();
					bcOrderLIIMEI.SetSearchSpec(&quot;Id&quot;, strRowId);
					bcOrderLIIMEI.ExecuteQuery(ForwardBackward);
					
					with(bcOrderLIAtt) 
					{
						ClearToQuery();
						SetViewMode(AllView);
						SetSearchSpec(&quot;Name&quot;, &quot;New Term&quot;);
						ExecuteQuery(ForwardBackward);
						if(FirstRecord())
						{
							strTerm = GetFieldValue(&quot;Text Value&quot;);
							iSpace = strTerm.indexOf(&apos; &apos;);
							strTerm = strTerm.substring(0, iSpace);
						}
						if (strTerm == &quot;&quot;)
						{
							ClearToQuery();
							SetViewMode(AllView);
							SetSearchSpec(&quot;Name&quot;, &quot;Term&quot;);
							ExecuteQuery(ForwardBackward);
							if(FirstRecord())
							{
								strTerm = GetFieldValue(&quot;Text Value&quot;);
								iSpace = strTerm.indexOf(&apos; &apos;);
								strTerm = strTerm.substring(0, iSpace);
							}// end  of if(FirstRecord())
						}//end of if (strTerm == &quot;&quot;)
					}// end of with(bcOrderLIAtt) 
				}//end of if(bcOrderLIUpgrades.FirstRecord())
			}// end if line item First record		
		}// end of if (bcOrder.FirstRecord())
	
		if (strTerm == &quot;&quot; || strTerm == null || strTerm == &quot;_&quot;)
			strTerm = &quot;&quot;;//Nithu set the default value as null for DAS-110 16.2
		
		psOut.SetProperty(&quot;Plan&quot;, strProduct);
		psOut.SetProperty(&quot;Term&quot;, strTerm);
		psOut.SetProperty(&quot;ContactId&quot;, strContactId);
		psOut.SetProperty(&quot;ServiceType&quot;, strServiceType);
		psOut.SetProperty(&quot;RootAssetIntId&quot;, strRootAssetIntId);
		psOut.SetProperty(&quot;AccType&quot;, strAccType);
		psOut.SetProperty(&quot;AccId&quot;, strCustAccId);
		psOut.SetProperty(&quot;DueDate&quot;, strDueDate);
		psOut.SetProperty(&quot;OrderFunctionPlan&quot;, strOrderFunctionPlan);
		psOut.SetProperty(&quot;LineItemId&quot;, sLineItemId);
	}
	catch(e)
	{
	      throw(e);
	}
	finally
	{
	      bcOrderLIAtt = null;
	      bcOrderLIUpgrades = null;
	      bcOrderLIIMEI = null;
	      bcOrderLI = null;
	      bcOrder = null;
	      boOrder = null;
		  boOrderUpgrades = null;  /* This variable is nullified by Sharukh on 18/03/2019*/

	}
}"
			   SEQUENCE="95"
			   UPDATED="01/09/2026 15:43:19"
			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 15:43:19"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mMPPGetOrderFields"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mMPPGetOrderFields(&amp;strContactId, &amp;strCustAccId, &amp;strAccType, &amp;strOrderFunctionPlan)
{
	try
	{
		var sBC = TheApplication().GetBusObject(&quot;VF MPP Orders&quot;).GetBusComp(&quot;VF MPP Order Header&quot;);
		with (sBC)
		{
			ClearToQuery();
			SetSearchSpec(&quot;Id&quot;, sOrderId);
			ExecuteQuery();
			if (FirstRecord())
			{
				strContactId = GetFieldValue(&quot;Contact Id&quot;);
				strCustAccId = GetFieldValue(&quot;Customer Account Id&quot;);
				strAccType = GetFieldValue(&quot;Account Type&quot;);
				strOrderFunctionPlan = GetFieldValue(&quot;VF Order Function&quot;);
			}
		}
	}
	catch(e)
	{
		throw e;
	}
	finally
	{
		sBC = null;
	}
}"
			   SEQUENCE="96"
			   UPDATED="01/09/2026 15:43:19"
			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 15:43:19"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mMPPGetOrderIMEIDetails"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mMPPGetOrderIMEIDetails (psIns, &amp;psOut)
{
	/*
	* Component Name        : 	mGetOrderIMEIDetails
	* Method Name           : 	
	* Component Information : 	
	*
	* Modification History  :
	* Date			Author		Config #	Description
	* ============ ===========	===========	================================
	* 04/09/2014	Balaji					Initial version
	*/
	
	try
	{
		var strOrderFunctionPlan = psIns.GetProperty(&quot;OrderFunctionPlan&quot;);
		var strTerm = psIns.GetProperty(&quot;Term&quot;);
		var strLineItemId = psIns.GetProperty(&quot;LineItemId&quot;);		

		 		
		
		var boOrder = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
		var bcOrder = boOrder.GetBusComp(&quot;Order Entry - Orders&quot;);
		var bcOrderItem = boOrder.GetBusComp(&quot;Order Entry - Line Items&quot;);
		var bcOrderItemXA = boOrder.GetBusComp(&quot;Order Item XA&quot;);
		var bcIMEI = boOrder.GetBusComp(&quot;VF Allocate IMEI&quot;);
		var strProductName = &quot;Device&quot;;
		var strProductType = &quot;Hardware&quot;;
		var strOrderFunction = &quot;UPGRADE&quot;
		var bIsOrderItemXA = false;
		var strAttribName = &quot;&quot;;
		var strAttribValue = &quot;&quot;;
		var strIMEI = &quot;&quot;;
		var strDeviceType = &quot;&quot;;
		var strRCC = &quot;&quot;;
		var strProductCode;
		var strVFFlag;
		var strIsUpgradeIMEI;
		var strProductName2 =&quot;Device-Siebel Only&quot;; 
		var strStockIndicator = &quot;&quot;;		
		
		var strMandateTerm = &quot;&quot;;
		var strMandateAmount = &quot;&quot;;
		var strPlanUpgrade = &quot;&quot;;
		
		
		bcOrder.SetViewMode(AllView);
		bcOrder.ClearToQuery();
		bcOrder.ActivateField(&quot;Order Id&quot;);
        bcOrder.ActivateField(&quot;VF Out of Stock Indicator&quot;);

		bcOrderItem.SetViewMode(AllView);
		bcOrderItem.ClearToQuery();
		bcOrderItem.ActivateField(&quot;Parent Order Item Id&quot;);
		bcOrderItem.ActivateField(&quot;Action Code&quot;);
		bcOrderItem.ActivateField(&quot;Order Header Id&quot;);
		bcOrderItem.ActivateField(&quot;VF Stock Indicator TBUI&quot;);

		bcIMEI.SetViewMode(AllView);
		bcIMEI.ClearToQuery();	
		bcIMEI.ActivateField(&quot;IMEI&quot;);
		bcIMEI.ActivateField(&quot;Order Id&quot;);
		bcIMEI.ActivateField(&quot;Device Name&quot;);
		bcIMEI.ActivateField(&quot;Upfront Cost&quot;);
		bcIMEI.ActivateField(&quot;Product Code&quot;);
		bcIMEI.ActivateField(&quot;VF Flag&quot;);
		bcIMEI.ActivateField(&quot;Mandatory Term&quot;);
		bcIMEI.ActivateField(&quot;Mandatory Amount&quot;);

		bcOrder.SetSearchSpec(&quot;Order Id&quot;, sOrderId);	
		bcOrderItem.SetSearchSpec(&quot;Order Header Id&quot;, sOrderId);
		bcOrderItem.SetSearchSpec(&quot;Parent Order Item Id&quot;, &quot;is NULL&quot;);
		bcOrderItem.SetSearchSpec(&quot;Id&quot;, strLineItemId);
		bcOrderItem.SetSearchSpec(&quot;Action Code&quot;, &quot;&lt;&gt; Delete&quot;);
		bcIMEI.SetSearchSpec(&quot;Root Order Line Item&quot;, strLineItemId);
		bcIMEI.SetSearchSpec(&quot;Order Id&quot;, sOrderId);

		bcOrder.ExecuteQuery(ForwardOnly);

		if(bcOrder.FirstRecord() &amp;&amp; bcOrderItem.FirstRecord() &amp;&amp; bcIMEI.FirstRecord())
		{
			
			strIMEI = bcIMEI.GetFieldValue(&quot;IMEI&quot;);
			strDeviceType = bcIMEI.GetFieldValue(&quot;Device Name&quot;);
			strRCC = bcIMEI.GetFieldValue(&quot;Upfront Cost&quot;);
			strProductCode = bcIMEI.GetFieldValue(&quot;Product Code&quot;);
			strVFFlag = bcIMEI.GetFieldValue(&quot;VF Flag&quot;);
			strMandateTerm = bcIMEI.GetFieldValue(&quot;Mandatory Term&quot;);
			strMandateAmount = bcIMEI.GetFormattedFieldValue(&quot;Mandatory Amount&quot;);
			strStockIndicator = bcOrderItem.GetFieldValue(&quot;VF Stock Indicator TBUI&quot;);
			
		}
		else
		{
								
			bcOrder.SetViewMode(AllView);
			bcOrder.ClearToQuery();
			bcOrder.ActivateField(&quot;VF Order Function&quot;);
			bcOrder.ActivateField(&quot;Order Id&quot;);
			// 11D Anoop-New Siebel Only Device Product for Project Johny(IPhone 5)
			bcOrder.ActivateField(&quot;VF Out of Stock Indicator&quot;);
			
			bcOrderItem.SetViewMode(AllView);
			bcOrderItem.ClearToQuery();
			bcOrderItem.ActivateField(&quot;Order Header Id&quot;);
			bcOrderItem.ActivateField(&quot;Product&quot;);
			bcOrderItem.ActivateField(&quot;Product Type&quot;);
			bcOrderItem.ActivateField(&quot;VF Stock Indicator TBUI&quot;);
			
			bcOrderItemXA.SetViewMode(AllView);
			bcOrderItemXA.ClearToQuery();
			bcOrderItemXA.ActivateField(&quot;Name&quot;);
			bcOrderItemXA.ActivateField(&quot;Value&quot;);
			
			bcOrder.SetSearchSpec(&quot;Order Id&quot;, sOrderId);
			bcOrder.SetSearchSpec(&quot;VF Order Function&quot;, strOrderFunction);
			bcOrderItem.SetSearchSpec(&quot;Order Header Id&quot;, sOrderId);
			bcOrderItem.SetSearchSpec(&quot;Root Order Item Id&quot;, strLineItemId);
			bcOrderItem.SetSearchSpec(&quot;Product&quot;, strProductName);
			bcOrderItem.SetSearchSpec(&quot;Product Type&quot;, strProductType);
			
			
			
			bcOrder.ExecuteQuery(ForwardOnly);
		
			if(bcOrder.FirstRecord() &amp;&amp; bcOrderItem.FirstRecord())
			{
				// 11D Anoop-New Siebel Only Device Product for Project Johny(IPhone 5)
				strStockIndicator = bcOrderItem.GetFieldValue(&quot;VF Stock Indicator TBUI&quot;);
							
				strIsUpgradeIMEI = &quot;Y&quot;;
				bIsOrderItemXA = bcOrderItemXA.FirstRecord();
				while(bIsOrderItemXA)
				{
					strAttribName = bcOrderItemXA.GetFieldValue(&quot;Name&quot;);
					strAttribValue = bcOrderItemXA.GetFieldValue(&quot;Value&quot;);
				
					if(strAttribName == &quot;Device RCC Inc GST&quot;)
					{
						strRCC = strAttribValue;
					}
					if(strAttribName == &quot;Device Code&quot;)
					{
						strProductCode = strAttribValue ;
					}
					if(strAttribName == &quot;Device Name&quot;)
					{
						strDeviceType = strAttribValue ;
					}
							
					bIsOrderItemXA = bcOrderItemXA.NextRecord();
					if(strStockIndicator == &quot;Out of Stock&quot;)
					{
						strMandateAmount = strRCC ;
					}
				}
			}
			else 
            {
				bcOrder.SetViewMode(AllView);
				bcOrder.ClearToQuery();
				bcOrder.ActivateField(&quot;Order Id&quot;);
				
				bcOrderItem.SetViewMode(AllView);
				bcOrderItem.ClearToQuery();
				bcOrderItem.ActivateField(&quot;Order Header Id&quot;);
				bcOrderItem.ActivateField(&quot;Product&quot;);
				bcOrderItem.ActivateField(&quot;Product Type&quot;);
				
				bcOrderItemXA.SetViewMode(AllView);
				bcOrderItemXA.ClearToQuery();
				bcOrderItemXA.ActivateField(&quot;Name&quot;);
				bcOrderItemXA.ActivateField(&quot;Value&quot;);
				
				bcOrder.SetSearchSpec(&quot;Order Id&quot;, sOrderId);
				bcOrderItem.SetSearchSpec(&quot;Order Header Id&quot;, sOrderId);
				bcOrderItem.SetSearchSpec(&quot;Root Order Item Id&quot;, strLineItemId);
				bcOrderItem.SetSearchSpec(&quot;Action Code&quot;, &quot;&lt;&gt; Delete&quot;);
				bcOrderItem.SetSearchSpec(&quot;Product&quot;, strProductName2);
				bcOrderItem.SetSearchSpec(&quot;Product Type&quot;, strProductType);
				
				bcOrder.ExecuteQuery(ForwardOnly);

				if(bcOrder.FirstRecord() &amp;&amp; bcOrderItem.FirstRecord())
				{
					strVFFlag = &quot;Y&quot;;
					bIsOrderItemXA = bcOrderItemXA.FirstRecord();	
	
					while(bIsOrderItemXA)
					{
						strAttribName = bcOrderItemXA.GetFieldValue(&quot;Name&quot;);
						strAttribValue = bcOrderItemXA.GetFieldValue(&quot;Value&quot;);
	
						if(strAttribName == &quot;Device RCC Inc GST&quot;)
						{
							strRCC = strAttribValue;
						}
						if(strAttribName == &quot;Device Code&quot;)
						{
							strProductCode = strAttribValue ;
						}
						if(strAttribName == &quot;Device Name&quot;)
						{
							strDeviceType = strAttribValue ;
						}
	                    strMandateAmount = strRCC ;
						bIsOrderItemXA = bcOrderItemXA.NextRecord(); 
					}
				}
			}
		}

		psOut.SetProperty(&quot;IMEI&quot;, strIMEI);
		psOut.SetProperty(&quot;DeviceType&quot;, strDeviceType);
		psOut.SetProperty(&quot;RCC&quot;, strRCC);
		psOut.SetProperty(&quot;ProductCode&quot;, strProductCode);
		psOut.SetProperty(&quot;VFFlag&quot;, strVFFlag);
		psOut.SetProperty(&quot;IsUpgradeIMEI&quot;, strIsUpgradeIMEI);
		psOut.SetProperty(&quot;MandateTerm&quot;, strMandateTerm);
		psOut.SetProperty(&quot;MandateAmount&quot;, strMandateAmount);
		psOut.SetProperty(&quot;Mandate&quot;, &quot;Y&quot;); 
		psOut.SetProperty(&quot;RCC&quot;, strRCC);
		psOut.SetProperty(&quot;StockIndicator&quot;, strStockIndicator);
	}
	
	catch(e)
	{
		throw(e);
	}
	
	finally
	{
		bcOrderItemXA = null;
		bcOrderItem = null;
		bcOrder = null;
		bcIMEI = null;
		boOrder = null;
	}
}"
