			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mValidateEmail"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mValidateEmail(emailAddress)
{
	//Sri:6/8/2014 : Added for Email Validation.
	try
	{
			var errorMsg1 = &quot;93000&quot;;
			var errorMsg2 = &quot;93001&quot;;
			var errorMsg3 = &quot;93002&quot;;
			var errorMsg4 = &quot;93003&quot;;
			var errorMsg5 = &quot;93004&quot;;
			var errorMsg6 = &quot;93005&quot;;
			var sErrorMessage;
				
			var indexNo = emailAddress.indexOf(&apos;@&apos;);
			var subStr=&quot;&quot;;
			var firstChar =emailAddress.charAt(0);
			var lastChar =emailAddress.charAt(emailAddress.length - 1);
		if(emailAddress.length &gt; 0)
		{
			if(emailAddress.length &gt; indexNo+1)
			{		
				subStr = emailAddress.substring(indexNo+1);
			}

			if( indexNo &lt; 0 || subStr.indexOf(&apos;@&apos;) &gt;= 0)
			{
					sErrorMessage = TheApplication().LookupMessage (&quot;User Defined Errors&quot;,errorMsg1);
					return (&quot;VFErrorCode#&quot; +	errorMsg1 + &quot;-&quot; + sErrorMessage);			
			}

			if( emailAddress.indexOf(&apos;.&apos;) &lt; 0)
			{
					sErrorMessage = TheApplication().LookupMessage (&quot;User Defined Errors&quot;,errorMsg2);
					return (&quot;VFErrorCode#&quot; +	errorMsg2 + &quot;-&quot; + sErrorMessage);
			}

			if( emailAddress.indexOf(&apos; &apos;) &gt;= 0)
			{
					sErrorMessage = TheApplication().LookupMessage (&quot;User Defined Errors&quot;,errorMsg3);
					return (&quot;VFErrorCode#&quot; +	errorMsg3 + &quot;-&quot; + sErrorMessage);
			}

			var i = emailAddress.indexOf(&apos;..&apos;);
			
			if( i != -1)
			{
				sErrorMessage = TheApplication().LookupMessage (&quot;User Defined Errors&quot;,errorMsg4);
				return (&quot;VFErrorCode#&quot; +	errorMsg4 + &quot;-&quot; + sErrorMessage);
			}
			if( firstChar == &quot;.&quot;)
			{
				sErrorMessage = TheApplication().LookupMessage (&quot;User Defined Errors&quot;,errorMsg5);
				return (&quot;VFErrorCode#&quot; +	errorMsg5 + &quot;-&quot; + sErrorMessage);
			}
			if( lastChar == &quot;.&quot;)
			{
				sErrorMessage = TheApplication().LookupMessage (&quot;User Defined Errors&quot;,errorMsg6);
				return (&quot;VFErrorCode#&quot; +	errorMsg6 + &quot;-&quot; + sErrorMessage);
			}
			return(&quot;&quot;);//TARIQ-04SEP2014-Validation successful
		
		}
	}
	catch(e)
	{
		TheApplication().RaiseErrorText(e);
	}
}"
			   SEQUENCE="118"
			   UPDATED="01/09/2026 15:43:20"
			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 15:43:20"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mValidateOrder"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mValidateOrder(Inputs, Outputs)
{
	/*
	* Component Name        : 	mValidateOrder
	* Method Name           : 	
	* Component Information : 	Validates Order specific logic
	* Modification History  :
	* Date			Author		Config #	Description
	* ============ ===========	===========	================================
	* 14/07/2011	Neel					Initial Version - Clone from VF Wizard Utitlies
	* 02/04/2019	Christy					Added for Unified Application
	*/
	
	var boOrder, bcOrder, bcOrderAttach, bcUpgradeOffer;
	
	var sOrderId, sOrderType, sMicroSIMConfirm, sMicroSIMRequired, sStockIndicator, sSubOrderType;
	var nDevicePrice, nMPPContractAmt;
	var sDevicePrice;
	var sFulfillmentOrder;
	
	try
	{
		// Initialise objects
		boOrder = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;)
		//bcWizardSession = boCurrent.GetBusComp(&quot;VF Wizard Session&quot;);
		bcOrder = boOrder.GetBusComp(&quot;Order Entry - Orders&quot;);
		bcOrderAttach = boOrder.GetBusComp(&quot;Order Entry Attachment&quot;);
		
		sOrderType = Inputs.GetProperty(&quot;OrderType&quot;);// Fetch Type of Order
		sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
		sFulfillmentOrder = Inputs.GetProperty(&quot;FulfillmentOrderId&quot;);
		
		// Check for upgrade orders that the Micro SIM confirmation has been ticked
		
		//if (bcWizardSession.GetFieldValue(&quot;Upgrade Fulfillment Order Exists?&quot;) == &quot;Y&quot;)
		//Uma:17/jul/2014:Commenting below code as it should be called for Postpay upgrade 
		/*if(sFulfillmentOrder != &quot;&quot; &amp;&amp; sFulfillmentOrder != null)
		{
			bcUpgradeOffer = boOrder.GetBusComp(&quot;VF Upgrade Offer&quot;);
			sMicroSIMConfirm = bcUpgradeOffer.GetFieldValue(&quot;Micro SIM Issued Confirmation&quot;);
			sMicroSIMRequired = bcUpgradeOffer.GetFieldValue(&quot;Micro SIM Required?&quot;);
			
			if (sMicroSIMRequired == &quot;Y&quot; &amp;&amp; (sMicroSIMConfirm == &quot;N&quot; || sMicroSIMConfirm == &quot;&quot;))
			{
				Outputs.SetProperty(&quot;ErrorMessage&quot;,&quot;Please confirm that you have provided the customer with a blank micro SIM (if required)&quot;);
			}
		}*/
		
		
		with(bcOrder)
		{
			ClearToQuery();
			SetViewMode(AllView);
			SetSearchSpec(&quot;Id&quot;, sOrderId);
			ExecuteQuery();
			if(FirstRecord())
			{
				
				//NEEL 12/09/2014 - Added for Application Check - Generate Contract Not Required for Core. QC2465
				//var sAppName = TheApplication().GetProfileAttr(&quot;ApplicationName&quot;);
				//if(sAppName == &quot;Siebel Power Communications&quot;)
				//02/04/2019: Christy :Modified for unified application
				var sAppName = TheApplication().GetProfileAttr(&quot;VHA User Type&quot;);
				var sAllowFlg = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_ALLOW_GEN_CONTRACT&quot;, sAppName);
			//	if(sAppName == TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_USER_TYPE&quot;, &quot;Care&quot;))
				if(sAllowFlg == &quot;Y&quot;)
				{
					//Do Nothing
				}
				else
				{
				// Check that the contract has been generated and opened
				with (bcOrderAttach)
				{
					ClearToQuery();
					ActivateField(&quot;OrderComments&quot;);
					SetSortSpec(&quot;Created (DESC)&quot;);
					ExecuteQuery(ForwardOnly);
		
					if (FirstRecord())
					{
						
						if (GetFieldValue(&quot;OrderComments&quot;) == &quot;&quot;)
						{
							if (sOrderType == &quot;Upgrade&quot;)
							{
								Outputs.SetProperty(&quot;ErrorMessage&quot;, &quot;You have generated the upgrade letter, but not opened the file.  Please click the link below the &apos;Generate Upgrade Letter&apos; button first.&quot;);
								//return (&quot;You have generated the upgrade letter, but not opened the file.  Please click the link below the &apos;Generate Upgrade Letter&apos; button first.&quot;);
							}
							else
							{
								
								Outputs.SetProperty(&quot;ErrorMessage&quot;, &quot;You have generated the contract, but not opened the file.  Please click the link below the &apos;Generate Contract&apos; button first&quot;);
								//return (&quot;You have generated the contract, but not opened the file.  Please click the link below the &apos;Generate Contract&apos; button first.&quot;);
							}				
						}
					}
					else
					{
						if (sOrderType == &quot;Upgrade&quot;)
						{
							Outputs.SetProperty(&quot;ErrorMessage&quot;, &quot;You have not generated the upgrade letter.  Please click the &apos;Generate Upgrade Letter&apos; button first.&quot;);
							//return (&quot;You have not generated the upgrade letter.  Please click the &apos;Generate Upgrade Letter&apos; button first. &quot;);
						}
						else
						{
							Outputs.SetProperty(&quot;ErrorMessage&quot;, &quot;You have not generated the contract.  Please click the &apos;Generate Contract&apos; button first.&quot;);
							//return (&quot;You have not generated the contract.  Please click the &apos;Generate Contract&apos; button first. &quot;);
						}
					}
				}
			}// End of Application Check
		
				// For out of stock, check that the RCC is the same as the device price for non-Fulfilment Orders - JW R14.1 SIT QC442
				sStockIndicator = GetFieldValue(&quot;VF Out of Stock Indicator&quot;);
				sSubOrderType = GetFieldValue(&quot;Order Sub Type&quot;);		
				if((sStockIndicator == &quot;Out of Stock - Connect Later&quot; || sStockIndicator == &quot;Out of Stock - Connect Now&quot;) &amp;&amp; (sSubOrderType != &quot;Fulfilment&quot;))
				{
					sDevicePrice = bcOrder.mGetDeviceRCC(sOrderId);
					
					if (sDevicePrice == &quot;N/A&quot;)
					{
						Outputs.SetProperty(&quot;ErrorMessage&quot;, &quot;This device cannot be sold on this plan. Please select a different device or plan to proceed with order submission.&quot;);
						//return (&quot;This device cannot be sold on this plan. Please select a different device or plan to proceed with order submission.&quot;);
					}
					else
					{
						nDevicePrice = ToNumber(sDevicePrice); 	//JW note this could return NaN;
					}			
					nMPPContractAmt = bcOrder.mGetMPPContractAmount(sOrderId);
		        			
					// throw error if MPP Contract is not matching the Device RCC value
					if(nDevicePrice != nMPPContractAmt)
					{
						Outputs.SetProperty(&quot;ErrorMessage&quot;, &quot;MPP Contract amount is not matching the Device RCC amount. Please revisit the Order configuration&quot;);
						//return (&quot;MPP Contract amount is not matching the Device RCC amount. Please revisit the Order configuration&quot;);
					}
				}
			}
			else
			{
				Outputs.SetProperty(&quot;ErrorMessage&quot;, &quot;Order Not Present in system&quot;);
			}
		}//End of if(FirstRecord())
	}
	catch (e)
	{
		throw e;
	}
	finally
	{
		bcOrderAttach = null;
		bcOrder = null;	
		boOrder = null;
		
	}
}"
