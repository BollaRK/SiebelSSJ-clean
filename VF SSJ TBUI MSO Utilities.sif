			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 15:43:18"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetPrepaymentOption"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mGetPrepaymentOption(sOrderId)//VHA Muthushankari - 4/6/2019 - Added for R19.3 Prepayments
{
	try
	{

		var sInvoluntory = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_PREPAYMENT_OPTION&quot;,&quot;Involuntary&quot;);
		var sVoluntory = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_PREPAYMENT_OPTION&quot;,&quot;Voluntary&quot;);
		var sPrepaymentOption = &quot;&quot;;
		var sBO = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
		var sPrepaymentsBC = sBO.GetBusComp(&quot;VHA Prepayment Account XM&quot;);
		with(sPrepaymentsBC)
		{
			ActivateField(&quot;PP Amount Paid Upfront&quot;);
			ActivateField(&quot;Prepayment Option Type&quot;);
			ClearToQuery();
			SetSearchExpr(&quot;[Order Id] = &apos;&quot;+sOrderId+&quot;&apos; &quot;);
			ExecuteQuery(ForwardOnly);
			if(FirstRecord())
			{
				if(ToNumber(GetFieldValue(&quot;PP Amount Paid Upfront&quot;)) &gt; 0)
				{
					if(GetFieldValue(&quot;Prepayment Option Type&quot;) == &quot;Y&quot;)
						sPrepaymentOption = sInvoluntory;
					else
						sPrepaymentOption = sVoluntory;
				}
			}
		}
		return (sPrepaymentOption);
	}
	catch(e)
	{
		throw(e);
	}
	finally
	{
		sPrepaymentsBC = null;
		sBO = null;
	}
}"
