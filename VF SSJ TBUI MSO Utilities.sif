			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="PrepareFulItemsPS"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function PrepareFulItemsPS(Inputs, &amp;Outputs, CanAddSIM)
{
	try
	{
		var psInputs = TheApplication().NewPropertySet();
		var psSIMInp, psSIMOut, sErrorMsg = &quot;&quot;;
		
		//Add Hardware
		psInputs.SetProperty(&quot;Item Type&quot;,&quot;Hardware&quot;);
		psInputs.SetProperty(&quot;VF TBUI Fulfilment Item&quot;,&quot;Hardware&quot;);
		psInputs.SetProperty(&quot;Hardware Name&quot;, Inputs.GetProperty(&quot;VF Device TBUI&quot;));
		psInputs.SetProperty(&quot;VF Line Item Id&quot;, Inputs.GetProperty(&quot;Order Item Id&quot;));
		psInputs.SetProperty(&quot;Name&quot;, Inputs.GetProperty(&quot;Order Item Id&quot;) + &quot;HardwareTBUI&quot;);
		psInputs.SetProperty(&quot;Type&quot;, &quot;Fulfilment Item&quot;);
		psInputs.SetProperty(&quot;Order Id&quot;, sOrderId);
		psInputs.SetType(&quot;VF Task Fulfilment Items&quot;);
		Outputs.AddChild(psInputs);
		
		if (CanAddSIM == &quot;Y&quot;)
		{
			psSIMInp = TheApplication().NewPropertySet();
			psSIMOut = TheApplication().NewPropertySet();
			psSIMInp.SetProperty(&quot;Handset Product Code&quot;, Inputs.GetProperty(&quot;VF Handset Code TBUI&quot;));
			TheApplication().GetService(&quot;VF IMEI Toolkit Service&quot;).InvokeMethod(&quot;SpecialSIMRequired&quot;, psSIMInp, psSIMOut);
			if (psSIMOut == &quot;Y&quot;)
			{
				psInputs.Reset();
				psInputs.SetProperty(&quot;Item Type&quot;,&quot;Accessory&quot;);
				psInputs.SetProperty(&quot;VF TBUI Fulfilment Item&quot;, &quot;Accessory&quot;);
				psInputs.SetProperty(&quot;Accessory Type&quot;, TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VFAU_UPGR_ACCESSORY&quot;, psSIMOut.GetProperty(&quot;SIM Product Code&quot;)));
				psInputs.SetProperty(&quot;VF Line Item Id&quot;, Inputs.GetProperty(&quot;Order Item Id&quot;));
				psInputs.SetProperty(&quot;Name&quot;, Inputs.GetProperty(&quot;Order Item Id&quot;) + &quot;AccessoryTBUI&quot;);
				psInputs.SetProperty(&quot;Type&quot;, &quot;Fulfilment Item&quot;);
				psInputs.SetProperty(&quot;Order Id&quot;, sOrderId);
				Outputs.AddChild(psInputs);
			}
			else
			{
				sErrorMsg = &quot;The SIM product code could not be found for the device selected.  The generated fulfilment order has been cancelled.  Please inform the help desk of this error.&quot;;
			}
		}
		return(sErrorMsg);
	}
	catch(e)
	{
		throw e;
	}
	finally
	{
		psSIMInp = null;
		psSIMOut = null;
		psInputs = null;
	}
}"
