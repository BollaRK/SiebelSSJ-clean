	try
	{
		
		var psInputs = TheApplication().NewPropertySet();
		var iNoOfServices = 0, sLineNum, sIndErrMsg = &quot;&quot;, i=0, sScenario = &quot;&quot;, sCreatedTNR = &quot;&quot;, sStockInd = &quot;&quot;, sPrevStockInd = &quot;&quot;, sShippingValdnDone = &quot;N&quot;, sFulfilOrderId = &quot;&quot;;
		var sInserntInOrder = &quot;N&quot;, sCreateFulfilOrder = &quot;N&quot;, psSysPrefInp, psSysPrefOut, sCanAddSIM, sFulfilDelOut = &quot;&quot;, sDeleteFulfilItem = &quot;N&quot;, sPrevFulOrderId = &quot;&quot;, sDontAllocate= &quot;&quot;;
		var sUpsertFulfilItems = &quot;N&quot;, strconnectiontype = &quot;&quot;,sAOAFulfilItems = &quot;N&quot;;
		var strSIMType = &quot;&quot;;//vasavi added for PKE00000092961
		var sConnectNowFlag = &quot;N&quot;, sConnectLaterFlag = &quot;N&quot;, sInStockFlag = &quot;N&quot;;
		var arrayCheckAcc = new Array();
		var arrayAccLineNums = new Array();
		var Outputs = TheApplication().NewPropertySet();
		var sConnectNow = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_ORDER_STOCK_INDICATOR&quot;,&quot;Out of Stock - Connect Now&quot;);
		var sConnectLater = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_ORDER_STOCK_INDICATOR&quot;,&quot;Out of Stock - Connect Later&quot;);
		var sInStock = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_ORDER_STOCK_INDICATOR&quot;,&quot;In Stock&quot;);
		var eSIM = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;FM_SHIPPING&quot;,&quot;eSIM&quot;);//added by balaji
		var eSIMPush = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_SIM&quot;,&quot;Push&quot;);//added for tree - vasavi
		var eSIMQRCode = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_SIM&quot;,&quot;QR Code&quot;);// added for TREE phase2
		var SIMTypecheck = &quot;&quot;;
		var sIndErrMsg = &quot;&quot;;
		var eSIMCheck = &quot;N&quot;;
		var eSIMPushCheck = &quot;&quot;;
		// SK 10.6.17 - Added below variables for retrogit 17.2 on 17.3
		var sOrderItemId = &quot;&quot;; 
		var sOrderHeadId = &quot;&quot;;
		var boOrder = &quot;&quot;;
		var bcFulfilment = &quot;&quot;;
		var boAOA = &quot;&quot;;//vasavi added for PKE00000092961
        var bcAOA = &quot;&quot;;//vasavi added for PKE00000092961
        var sSIMCheck = &quot;&quot;;//vasavi added for PKE00000092961
        var sAccOrderId = &quot;&quot;;//vasavi added for PKE00000092961
        var sAccOrderItemId = &quot;&quot;;//vasavi added for PKE00000092961
		var sESIMQRCheck = &quot;&quot;;
		var sOrg = TheApplication().GetProfileAttr(&quot;VHANewOrg&quot;); //SK 21.12.17 - Added for KOGAN 18.1
		var sOrgLOV = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_ORG_CONFIGURATION&quot;,sOrg); //SK 21.12.17 - Added for KOGAN 18.1
		var sActiveView = TheApplication().ActiveViewName();
		
		
		
		psInputs = psOutputs.GetChild(0).GetChild(0).Copy();
		iNoOfServices = psInputs.GetChildCount();
		if (iNoOfServices &lt; 1)
		{
			sIndErrMsg = &quot;Please add atleast one service to proceed with this order&quot;;
			TheApplication().RaiseErrorText(sIndErrMsg);
		}
		var sorderHeaderid = psInputs.GetChild(i).GetProperty(&quot;Order Header Id&quot;);// Added for mcon
		TheApplication().SetProfileAttr(&quot;Test32&quot;,sorderHeaderid + sOrderId );
		var mconreservlov = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_MCONRESERV_SWITCH&quot;,&quot;MCON_RESERVE_SWITCH&quot;);   
		//Validate All Service Orders
		for (i=0;i &lt; iNoOfServices; i++)
		{
			psInputs.GetChild(i).SetProperty(&quot;Validation Message&quot;,&quot;&quot;);
			sLineNum = psInputs.GetChild(i).GetProperty(&quot;VF Line Number&quot;);
			sIndErrMsg = mValidateServiceDetails(psInputs.GetChild(i));
			sStockInd = psInputs.GetChild(i).GetProperty(&quot;VF Stock Indicator TBUI&quot;);
			var sSIMType = psInputs.GetChild(i).GetProperty(&quot;Shipping&quot;); //vha balaji : 25/11/2018 added for atom phase2
			var seSIMDownload = psInputs.GetChild(i).GetProperty(&quot;eSIM Download&quot;);// vasavi 19/07/2022 added for tree project
			//bsOutputs.SetProperty(&quot;SIMType&quot;, sSIMType);
			if (sIndErrMsg != &quot;&quot;)
			{
				TheApplication().RaiseErrorText(&quot;Line Number: &quot; + sLineNum + &quot; - &quot; + sIndErrMsg);
			}
			//added by balaji 11/30/2018 for eSIM and Instock indicator check for atom phase2
			if(sSIMType == eSIM &amp;&amp; sStockInd == sInStock &amp;&amp; seSIMDownload == eSIMQRCode)
			{
			   SIMTypecheck = &quot;Y&quot;; 
			   sESIMQRCheck = &quot;Y&quot;;  
			}// end by balaji 11/30/2018

			//Added for Tree Project - vasavi
			if(sSIMType == eSIM &amp;&amp; seSIMDownload == eSIMPush)
			{
				eSIMPushCheck = &quot;Y&quot;;
			}//added for tree
			
			if(sSIMType == eSIM &amp;&amp; seSIMDownload == eSIMQRCode)
			{
				eSIMCheck = &quot;Y&quot;;
				sESIMQRCheck = &quot;Y&quot;;  
			}
			//Subramanian 25SEP2014: Setting the flag if out of stock connect now or connect later is chosen.
			switch(sStockInd)
			{
				case sConnectNow:
					sConnectNowFlag = &quot;Y&quot;;
					break;
					
				case sConnectLater:
					sConnectLaterFlag = &quot;Y&quot;;
					break;
					
				case sInStock:
					sInStockFlag = &quot;Y&quot;;
					break;
			}
		}
		bsOutputs.SetProperty(&quot;ESIMQRCheck&quot;, sESIMQRCheck);//Added for TREE Phase 2
		bsOutputs.SetProperty(&quot;eSIMPushCheck&quot;, eSIMPushCheck);// added for tree project
        bsOutputs.SetProperty(&quot;SIMTypecheck&quot;, SIMTypecheck);//added by balaji 11/30/2018 for atom phase2
        bsOutputs.SetProperty(&quot;eSIMCheck&quot;, eSIMCheck);//Vinodhini-28/12/2018-Added for atom Phase2
		//Subramanian 25SEP2014: Let&apos;s check if the both Out of Stock Connect Now and Connect Later are used in the same order.
		if(sConnectNowFlag == &quot;Y&quot; &amp;&amp; sConnectLaterFlag == &quot;Y&quot;)
		{
				sIndErrMsg = &quot;Cannot have Out Of Stock - Connect Now and Out Of Stock - Connect Later for the same order. Please select any one of them.&quot;;
				TheApplication().RaiseErrorText(sIndErrMsg);
		}
		//SK 26.12.17 - Added below condition check for R18.1 - KOGAN. LOV organization check to skip Credit Check and IMEI Mandatory Check for KOGAN NBN Flow (CC will not exist for KOGAN)
		if (sOrgLOV != &quot;Y&quot;) 
		{		
			try
			{
				mValidateCreditCheckStatus();
				CheckMandatoryIMEI();
			}
			catch(e)
			{
				sIndErrMsg = e;
				TheApplication().RaiseErrorText(sIndErrMsg);
			}
		}
		//mInsertInTempValidationBC(psInputs, psOutputs);//For Testing
		psSysPrefInp = TheApplication().NewPropertySet();
		psSysPrefOut = TheApplication().NewPropertySet();
		psSysPrefInp.SetProperty(&quot;System Preference Name&quot;,&quot;VF Wizard Auto SIM Fulfil Item&quot;);
		TheApplication().GetService(&quot;VF Get System Preference&quot;).InvokeMethod(&quot;Get System Preference&quot;, psSysPrefInp, psSysPrefOut);
		sCanAddSIM = psSysPrefOut.GetProperty(&quot;System Preference Value&quot;);//For adding fulfilment items
		
		for (i=0;i &lt; iNoOfServices; i++)
		{
			sScenario = mDecideScenario(psInputs.GetChild(i).GetProperty(&quot;VF Port In TBUI&quot;), psInputs.GetChild(i).GetProperty(&quot;VF Order Sub Type TBUI&quot;));
			//sScenario = mDecideScenario(psInputs.GetChild(i).GetProperty(&quot;VF Port In TBUI&quot;), psInputs.GetChild(i).GetProperty(&quot;VF Order Type TBUI&quot;));
			//sScenario = &quot;NewConnect&quot;;
			sLineNum = psInputs.GetChild(i).GetProperty(&quot;VF Line Number&quot;);
			strconnectiontype = psInputs.GetChild(i).GetProperty(&quot;VF ConnectionType&quot;);
			strSIMType = psInputs.GetChild(i).GetProperty(&quot;Shipping&quot;);//vasavi added for PKE00000092961
			switch (sScenario)
			{
				case &quot;PretoPost&quot;:
					//TARIQ-03SEP2014-Not in scope for MSO. This is just a placeholder. Not developed and tested
					sIndErrMsg = CreateRequestTNR(sScenario, sCreatedTNR, psInputs.GetChild(i));
					if (sCreatedTNR !=&quot;&quot;)
					{
						psInputs.GetChild(i).SetProperty(&quot;VF TNR Id&quot;, sCreatedTNR);
						sInserntInOrder = &quot;Y&quot;;
					}
					if (sIndErrMsg != &quot;&quot;)
					{
						TheApplication().RaiseErrorText(&quot;Line Number: &quot; + sLineNum + &quot; - &quot; + sIndErrMsg);
					}
					sIndErrMsg = AllocateTNR(psInputs.GetChild(i).GetProperty(&quot;Order Header Id&quot;), psInputs.GetChild(i).GetProperty(&quot;Order Item Id&quot;), sCreatedTNR);
					if (sIndErrMsg != &quot;&quot;)
					{
						TheApplication().RaiseErrorText(&quot;Line Number: &quot; + sLineNum + &quot; - &quot; + sIndErrMsg);
					}
					break;
					
				case &quot;NewConnect&quot;:
					sStockInd = psInputs.GetChild(i).GetProperty(&quot;VF Stock Indicator TBUI&quot;);
					sPrevStockInd = psInputs.GetChild(i).GetProperty(&quot;Stock Indicator&quot;);
					
                    //GJENA_030226 Commented Code for fullfillment
					if (sStockInd == sConnectNow || sStockInd == sConnectLater)
					    {
						/*if (sShippingValdnDone == &quot;N&quot;)//Validate Shipping Details only once
						{
							sIndErrMsg = ValidateShippingDetails(sOrderId, sShippingValdnDone);
							if (sIndErrMsg != &quot;&quot;)
							{
								TheApplication().RaiseErrorText(&quot;Line Number: &quot; + sLineNum + &quot; - &quot; + sIndErrMsg);
							}
						}*/
						if (strconnectiontype == &quot;SIM Only&quot;)
						{
							//SK 10.36.17 - Added below code for Retrogit 17.2 on 17.3
							sOrderItemId=psInputs.GetChild(i).GetProperty(&quot;Order Item Id&quot;);
							sOrderHeadId=psInputs.GetChild(i).GetProperty(&quot;Order Header Id&quot;);
							if(sActiveView != &quot;VF SSJ Connection Wizard View – Shopping Cart – TBUI&quot;)
							{
						
							arrayCheckAcc.push(psInputs.GetChild(i).GetProperty(&quot;Order Item Id&quot;));
							arrayAccLineNums.push(sLineNum);
							}
							//Glady: 20/04/2017 Delete Item Type &apos;Hardware&apos; from Fulfilment Line Item for SIMO Connection PKE47738
							boOrder = TheApplication().GetBusObject(&quot;VF Order Entry Thin BO&quot;); 
							bcFulfilment = boOrder.GetBusComp(&quot;VHA AOA Fulfilment Items&quot;);
							with(bcFulfilment)
							{
								ClearToQuery();
								SetViewMode(AllView);
								SetSearchExpr(&quot;[Order Id] = &apos;&quot;+ sOrderHeadId +&quot;&apos; AND [Related Service Order Id] = &apos;&quot;+ sOrderItemId +&quot;&apos;  AND [Item Type] = &apos;Hardware&apos;&quot;);
								ExecuteQuery(ForwardOnly);
								if(FirstRecord())
								{               		
									DeleteRecord();
								}
    						}//end of code PKE47738	
						}
						else
						{
							sIndErrMsg = PrepareFulItemsPS(psInputs.GetChild(i), Outputs, sCanAddSIM);//Add to Fulfil Items PS
						}
						if (sIndErrMsg != &quot;&quot;)
						{
							TheApplication().RaiseErrorText(&quot;Line Number: &quot; + sLineNum + &quot; - &quot; + sIndErrMsg);
						}
						
						sUpsertFulfilItems = &quot;Y&quot;;
						//Thulsi: 21/10/2015 - Added for MSOD
						if (gBillAccountId == &quot;&quot;) 
						{
							gBillAccountId = psInputs.GetChild(i).GetProperty(&quot;Billing Account Id&quot;);						
						}
						//vasavi added for PKE00000092961
                        if(strSIMType == eSIM)
                        {
                                boAOA = TheApplication().GetBusObject(&quot;VF Order Entry Thin BO&quot;); 
                                bcAOA = boAOA.GetBusComp(&quot;VHA AOA Fulfilment Items&quot;);
                                sAccOrderId = psInputs.GetChild(i).GetProperty(&quot;Order Header Id&quot;);
                                sAccOrderItemId = psInputs.GetChild(i).GetProperty(&quot;Order Item Id&quot;);
                                with(bcAOA)
                                {
                                    ActivateField(&quot;Accessory Type&quot;);
                                    ActivateField(&quot;Accessory Type Calc&quot;);
                                    ClearToQuery();
                                    SetViewMode(AllView);
                                    SetSearchExpr(&quot;[Order Id] = &apos;&quot;+ sAccOrderId +&quot;&apos; AND [Related Service Order Id] = &apos;&quot;+ sAccOrderItemId +&quot;&apos; AND [Accessory Type] IS NOT NULL&quot;);
                                    ExecuteQuery(ForwardOnly);
                                    var sRec = FirstRecord();
                                    while(sRec)
                                    {

                                        sSIMCheck = GetFieldValue(&quot;Accessory Type Calc&quot;);
                                        var sActiveViewName = TheApplication().ActiveViewName();
                                        if( sActiveViewName == &quot;VF Connection Wizard View – Shopping Cart – TBUI&quot;)
                                        {
                                            if(sSIMCheck == &quot;Y&quot;)
                                            {
                                                sIndErrMsg = &quot;SIM related Accessories are not allowed for SIM Type eSIM. Please choose other than SIM accessory and proceed.&quot;;
                                                TheApplication().RaiseErrorText(&quot;Line Number: &quot; + sLineNum + &quot; - &quot; + sIndErrMsg);
                                            }

                                        }
                                        sRec = NextRecord();
                                    }
                                }
                            }//vasavi added for PKE00000092961
						//EndOfCode 												
					}
					//Kathambari:23/03/2016 - Added for AOA.
					else if (sAOAFulfilItems == &quot;N&quot;) {
						var ssjFlow = TheApplication().GetProfileAttr(&quot;SSJFlow&quot;);//CM-10254,Addes for SSJ flow
						var OrItmId = psInputs.GetChild(i).GetProperty(&quot;Order Item Id&quot;);
						var stockIndLov = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_APP_STOCK_INDICATOR&quot;, &quot;Out of Stock&quot;);
						var OrderBusObj = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
						if(ssjFlow == &quot;Y&quot;)
							var acItemBC = OrderBusObj.GetBusComp(&quot;VHA SSJ Accessory Items&quot;);//CM-10254
						else
							var acItemBC = OrderBusObj.GetBusComp(&quot;VHA Accessory Items&quot;);
						
						with (acItemBC) {
							ClearToQuery();
							SetViewMode(AllView);
							ActivateField(&quot;VHA App Stock Indicator&quot;);
							var SearchExpr = &quot;([VHA App Stock Indicator] = &apos;&quot; + stockIndLov + &quot;&apos;) AND([Related Service Order Id] = &apos;&quot; + OrItmId + &quot;&apos;)&quot;;
							SetSearchExpr(SearchExpr);
							ExecuteQuery();
							var frec = FirstRecord();
							if (frec) {
								sAOAFulfilItems = &quot;Y&quot;;
							}
						}
						//YP Added for New Connect Accessory Out of Stock
						if (gBillAccountId == &quot;&quot;) 
						{
							gBillAccountId = psInputs.GetChild(i).GetProperty(&quot;Billing Account Id&quot;);						
						}						
					} //EndOfCode
					
					// ================= CM-8076 START – NewConnect: GPP OOS + SSJ APP In-Stock =================
                    if (sStockInd == sConnectNow || sStockInd == sConnectLater) // GPP is Out of Stock
                    {
                        var OrItmIdSSJ_NC = psInputs.GetChild(i).GetProperty(&quot;Order Item Id&quot;);
                        var boSSJOrder_NC = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
                        var bcSSJAcc_NC = boSSJOrder_NC.GetBusComp(&quot;VHA SSJ Accessory Items&quot;);
                        var appInStockLov_NC = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_APP_STOCK_INDICATOR&quot;, &quot;In Stock&quot;);

                        with (bcSSJAcc_NC)
                        {
                            ClearToQuery();
                            SetViewMode(AllView);
                            ActivateField(&quot;VHA App Stock Indicator&quot;);
                            ActivateField(&quot;Related Service Order Id&quot;);
                            SetSearchExpr(
                                &quot;[Related Service Order Id] = &apos;&quot; + OrItmIdSSJ_NC + &quot;&apos;&quot; +
                                &quot; AND [VHA App Stock Indicator] = &apos;&quot; + appInStockLov_NC + &quot;&apos;&quot;
                            );
                            ExecuteQuery(ForwardOnly);

                            if (FirstRecord())
                            {
                                sIndErrMsg = &quot;GPP is Out of Stock and APP is In Stock. Please change APP to Out of Stock (or align stock state) before proceeding.&quot;;
                                TheApplication().RaiseErrorText(&quot;Line Number: &quot; + sLineNum + &quot; - &quot; + sIndErrMsg);
                            }
                        }
                    }
                    // ================= CM-8076 END – NewConnect =================
					
					/*if (sStockInd != sConnectLater) 
					{
						var boWearable = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
						var bcWearable = boWearable.GetBusComp(&quot;VHA SSJ Accessory Items&quot;);
						var sServiceItemId = psInputs.GetChild(i).GetProperty(&quot;Order Item Id&quot;);
						var sWearableType = &quot;Wearable&quot;; // Verify if this should be a LookupValue

						with (bcWearable) 
						{
							ActivateField(&quot;Type&quot;);
							ActivateField(&quot;VHA EID&quot;);
							ActivateField(&quot;VHA IMEI&quot;);
							ActivateField(&quot;Related Service Order Id&quot;);
							ClearToQuery();
							SetViewMode(AllView);
							

							// Search for Wearable accessories linked to this specific Service Line
							var sSearch = &quot;[Related Service Order Id] = &apos;&quot; + sServiceItemId + &quot;&apos; AND [Type] = &apos;&quot; + sWearableType + &quot;&apos;&quot;;
							SetSearchExpr(sSearch);
							ExecuteQuery(ForwardOnly);

							var bHasRecord = FirstRecord();
							var sAccOOS = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_APP_STOCK_INDICATOR&quot;, &quot;Out of Stock&quot;);
							while (bHasRecord) 
							{
								 // NEW: Get the stock indicator of the ACCESSORY itself
									var sAccStock = GetFieldValue(&quot;VHA App Stock Indicator&quot;); 


								// Only validate if the accessory is NOT Out of Stock
									if (sAccStock != sAccOOS)
									{
										var sEID = GetFieldValue(&quot;VHA EID&quot;);
										var sIMEI = GetFieldValue(&quot;VHA IMEI&quot;);

										// Error if BOTH fields are empty/null
										if ((sEID == &quot;&quot; || sEID == null) &amp;&amp; (sIMEI == &quot;&quot; || sIMEI == null)) 
										{
											sIndErrMsg = &quot;For InStock Wearable , please capture either IMEI or EID details to proceed.&quot;;
											TheApplication().RaiseErrorText(&quot;Line Number: &quot; + sLineNum + &quot; - &quot; + sIndErrMsg);
										}
										//  If both are provided, verify they are tagged together
										else if (sEID != &quot;&quot; &amp;&amp; sEID != null &amp;&amp; sIMEI != &quot;&quot; &amp;&amp; sIMEI != null)
										{
											var boIMEIList = TheApplication().GetBusObject(&quot;VF IMEI List&quot;);
											var bcIMEIList = boIMEIList.GetBusComp(&quot;VF IMEI List&quot;);

											with (bcIMEIList)
											{
												ActivateField(&quot;IMEI&quot;);
												ActivateField(&quot;EID&quot;); 
												ClearToQuery();
												SetViewMode(AllView);
												 

												SetSearchSpec(&quot;IMEI&quot;, sIMEI);
												SetSearchSpec(&quot;EID&quot;, sEID);
												ExecuteQuery(ForwardOnly);

												
												if (!FirstRecord())
												{
													sIndErrMsg = &quot;The entered EID is not tagged to the entered IMEI. Please verify and re-enter valid details.&quot;;
													TheApplication().RaiseErrorText(&quot;Line Number: &quot; + sLineNum + &quot; - &quot; + sIndErrMsg);
												}
											}
											bcIMEIList = null;
											boIMEIList = null;
										}
									}
								bHasRecord = NextRecord();
							}
						}
						// Nullify objects
						bcWearable = null;
						boWearable = null;
					}*/

					if((sStockInd == sInStock) &amp;&amp; (sPrevStockInd == sConnectNow || sPrevStockInd == sConnectLater))
					{
						psInputs.GetChild(i).SetProperty(&quot;Delete Fulfilment Item&quot;, &quot;Delete&quot;);
					}
					if(psInputs.GetChild(i).GetProperty(&quot;Delete Fulfilment Item&quot;) == &quot;Delete&quot;)
					{
						sDeleteFulfilItem = &quot;Y&quot;;
					}
					break;
					
				case &quot;PortIn&quot;:
					sDontAllocate = &quot;&quot;;
					sCreatedTNR = &quot;&quot;;
					sIndErrMsg = CreateRequestTNR(sScenario, sCreatedTNR, psInputs.GetChild(i), sDontAllocate);//Create TNR
					if (sCreatedTNR !=&quot;&quot;)
					{
						psInputs.GetChild(i).SetProperty(&quot;VF TNR Id&quot;, sCreatedTNR);
						sInserntInOrder = &quot;Y&quot;;
					}
					if (sIndErrMsg != &quot;&quot;)
					{
						TheApplication().RaiseErrorText(&quot;Line Number: &quot; + sLineNum + &quot; - &quot; + sIndErrMsg);
					}
					if (sDontAllocate != &quot;Y&quot;)
					{
						//Allocate TNR
						sIndErrMsg = AllocateTNR(psInputs.GetChild(i).GetProperty(&quot;Order Header Id&quot;), psInputs.GetChild(i).GetProperty(&quot;Order Item Id&quot;), sCreatedTNR);
						if (sIndErrMsg != &quot;&quot;)
						{
							TheApplication().RaiseErrorText(&quot;Line Number: &quot; + sLineNum + &quot; - &quot; + sIndErrMsg);
						}
					}
					if(sAOAFulfilItems == &quot;N&quot;)
					{
						var OrItmId = psInputs.GetChild(i).GetProperty(&quot;Order Item Id&quot;);
						var stockIndLov = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_APP_STOCK_INDICATOR&quot;, &quot;Out of Stock&quot;);
						var OrderBusObj = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
						var acItemBC = OrderBusObj.GetBusComp(&quot;VHA Accessory Items&quot;);
						with (acItemBC) {
							ClearToQuery();
							SetViewMode(AllView);
							ActivateField(&quot;VHA App Stock Indicator&quot;);
							var SearchExpr = &quot;([VHA App Stock Indicator] = &apos;&quot; + stockIndLov + &quot;&apos;) AND([Related Service Order Id] = &apos;&quot; + OrItmId + &quot;&apos;)&quot;;
							SetSearchExpr(SearchExpr);
							ExecuteQuery();
							var frec = FirstRecord();
							if (frec) {
								sAOAFulfilItems = &quot;Y&quot;;
							}
						}
						//YP Added below for the case of Port In Accessory Out of Stock scenario
						if (gBillAccountId == &quot;&quot;) 
						{
							gBillAccountId = psInputs.GetChild(i).GetProperty(&quot;Billing Account Id&quot;);						
						}
					}
					break;
			}//end switch
		}//end for
		
		if (arrayCheckAcc.length &gt; 0)//Check for Mandatory Accessories
		{
			sIndErrMsg = CheckAccessory(arrayCheckAcc, arrayAccLineNums);
			if (sIndErrMsg != &quot;&quot;)
			{
				TheApplication().RaiseErrorText(&quot;Line Number: &quot; + sLineNum + &quot; - &quot; + sIndErrMsg);
			}
		}
		
		if (sDeleteFulfilItem == &quot;Y&quot;)
		{
			//DeleteFulfilmentItems(sFulfilDelOut);// Delete irrelevant fulfil items using the searschspec prepared above
			DissociateFulfilmentItems();//Performance Tuned
			for (var i=0;i &lt; iNoOfServices; i++)
			{
				psInputs.GetChild(i).SetProperty(&quot;Delete Fulfilment Item&quot;, &quot;Done&quot;);
			}
		}
		sPrevFulOrderId = psInputs.GetChild(0).GetProperty(&quot;Fulfilment Id&quot;);
