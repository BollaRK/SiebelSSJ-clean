			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mUpsertShipment"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mUpsertShipment(Inputs, Outputs)
{
/*
 * Component Name        : 	VF TBUI MSO Utilities
 * Function Name         : 	UpsertShipment
 * Component Information : 	Move Shipment record from connect to Fulfilment Order
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 03/11/2015	Roseline	R16.1 MSOD	Initial Version									
 */
	try
	{
		var sOrderBO = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
		var sConnOrderBC = sOrderBO.GetBusComp(&quot;Order Entry - Orders&quot;);
		var sConnFulBC = sOrderBO.GetBusComp(&quot;FS Shipment&quot;);
		var sOrderId = Inputs.GetProperty(&quot;Parent Order Id&quot;);
		var sFulOrderId = Inputs.GetProperty(&quot;Fulfilment Order Id&quot;);
		var sOrderBC, sFulBC, sFulUpdateBC, sShipId;
		
		with (sConnOrderBC)
		{
			ClearToQuery();
			SetViewMode(AllView);
			SetSearchSpec(&quot;Id&quot;, sOrderId);
			ExecuteQuery();
			if (FirstRecord())
			{
				with (sConnFulBC)
				{
					ClearToQuery();
					SetViewMode(AllView);
					SetSearchSpec(&quot;Primary Order Id&quot;, sOrderId);
					ExecuteQuery();
					if(sConnFulBC.FirstRecord())
					{
						ActivateField(&quot;VF Address Format&quot;);
						ActivateField(&quot;VF Address Floor Type&quot;);
						ActivateField(&quot;VF Address Floor&quot;);
						ActivateField(&quot;VF Address Building&quot;);
						ActivateField(&quot;VF Address Street Type&quot;);
						ActivateField(&quot;VF Shipment Street #&quot;);
						ActivateField(&quot;VF Shipment Street Address&quot;);
						ActivateField(&quot;VF Shipment City&quot;);
						ActivateField(&quot;VF Shipment State&quot;);
						ActivateField(&quot;VF Shipment Zipcode&quot;);
						ActivateField(&quot;VF Shipment Country&quot;);
						ActivateField(&quot;VF Private Bag&quot;);
						ActivateField(&quot;VF Private Bag Name&quot;);
						ActivateField(&quot;VF Rural Delivery&quot;);
						ActivateField(&quot;Ship To ID&quot;);
						ActivateField(&quot;Attention To&quot;);
						ActivateField(&quot;Business Name&quot;);
						ActivateField(&quot;No of Containers&quot;);
						ActivateField(&quot;Shipping Notification MSISDN&quot;);
						ActivateField(&quot;Shipping Notification Method&quot;);
						ActivateField(&quot;VF Email Address&quot;);
	
						var sAddrFormat = GetFieldValue(&quot;VF Address Format&quot;);
						var sAddrFloorType = GetFieldValue(&quot;VF Address Floor Type&quot;);
						var sAddrFloor = GetFieldValue(&quot;VF Address Floor&quot;);
						var sAddrBulding = GetFieldValue(&quot;VF Address Building&quot;);
						var sAddrStreetType = GetFieldValue(&quot;VF Address Street Type&quot;);
						var sAddrStreetNum = GetFieldValue(&quot;VF Shipment Street #&quot;);
						var sAddrShipmentAddress = GetFieldValue(&quot;VF Shipment Street Address&quot;);
						var sAddrCity = GetFieldValue(&quot;VF Shipment City&quot;);
						var sAddrState = GetFieldValue(&quot;VF Shipment State&quot;);
						var sAddrZipCode = GetFieldValue(&quot;VF Shipment Zipcode&quot;);
						var sAddrCountry = GetFieldValue(&quot;VF Shipment Country&quot;);
						var sAddrPBag = GetFieldValue(&quot;VF Private Bag&quot;);
						var sAddrPBagName = GetFieldValue(&quot;VF Private Bag Name&quot;);
						var sAddrRDelivery = GetFieldValue(&quot;VF Rural Delivery&quot;);
						var sAddrShipId = GetFieldValue(&quot;Ship To ID&quot;);
						var sAddrAttentionTo = GetFieldValue(&quot;Attention To&quot;);
						var sAddrBusinessName = GetFieldValue(&quot;Business Name&quot;);
						var sShipmentPreference = GetFieldValue(&quot;No of Containers&quot;); // JS 22012016 Changed field value from VHA Shipment Preference Calc
						var sShipmentNotificationMethod = GetFieldValue(&quot;Shipping Notification Method&quot;);
						var sShipmentMSISIDN = GetFieldValue(&quot;Shipping Notification MSISDN&quot;);
						var sShipmentEmail = GetFieldValue(&quot;VF Email Address&quot;);
					//SetFieldValue(&quot;Primary Order Id&quot;,&quot;&quot;);
					//	WriteRecord();
					}//end if(sConnFulBC.FirstRecord())
				}//end with (sConnFulBC)
			}//end if (FirstRecord())
		}//end with (sConnOrderBC)
		
		//Create Fulfilment Order with default shipment details
		sOrderBC = sOrderBO.GetBusComp(&quot;Order Entry - Orders&quot;);
		sFulBC = sOrderBO.GetBusComp(&quot;FS Shipment&quot;);
		with (sOrderBC)
		{
			ClearToQuery();
			SetViewMode(AllView);
			SetSearchSpec(&quot;Id&quot;, sFulOrderId);
			ExecuteQuery();
			if (FirstRecord())
			{
				with (sFulBC)
				{
					NewRecord(NewBefore);
					WriteRecord();
					sShipId = GetFieldValue(&quot;Id&quot;);
					//Outputs.SetProperty(&quot;FullShipId&quot;, GetFieldValue(&quot;Id&quot;)); 
				}
			}
		}
		
		//Update fulfiment Order with connect order shipment details
		sFulUpdateBC = sOrderBO.GetBusComp(&quot;VF FS Shipment TBUI&quot;);
		with (sFulUpdateBC)
		{
			ActivateField(&quot;VF Address Format&quot;);
			ActivateField(&quot;VF Address Floor Type&quot;);
			ActivateField(&quot;VF Address Floor&quot;);
			ActivateField(&quot;VF Address Building&quot;);
			ActivateField(&quot;VF Address Street Type&quot;);
			ActivateField(&quot;VF Shipment Street #&quot;);
			ActivateField(&quot;VF Shipment Street Address&quot;);
			ActivateField(&quot;VF Shipment City&quot;);
			ActivateField(&quot;VF Shipment State&quot;);
			ActivateField(&quot;VF Shipment Zipcode&quot;);
			ActivateField(&quot;VF Shipment Country&quot;);
			ActivateField(&quot;VF Private Bag&quot;);
			ActivateField(&quot;VF Private Bag Name&quot;);
			ActivateField(&quot;VF Rural Delivery&quot;);
			ActivateField(&quot;Ship To ID&quot;);
			ActivateField(&quot;Attention To&quot;);
			ActivateField(&quot;Business Name&quot;);
			ActivateField(&quot;No of Containers&quot;);
			ActivateField(&quot;Shipping Notification MSISDN&quot;);
			ActivateField(&quot;Shipping Notification Method&quot;);
			ActivateField(&quot;VF Email Address&quot;);
			ClearToQuery();
			SetViewMode(AllView);
			SetSearchSpec(&quot;Id&quot;, sShipId);
			ExecuteQuery();
			if (FirstRecord())
			{
				SetFieldValue(&quot;VF Address Format&quot;, sAddrFormat);
				SetFieldValue(&quot;VF Address Floor Type&quot;, sAddrFloorType);
				SetFieldValue(&quot;VF Address Floor&quot;, sAddrFloor);
				SetFieldValue(&quot;VF Address Building&quot;, sAddrBulding);
				SetFieldValue(&quot;VF Address Street Type&quot;, sAddrStreetType);
				SetFieldValue(&quot;VF Shipment Street #&quot;, sAddrStreetNum);
				SetFieldValue(&quot;VF Shipment Street Address&quot;, sAddrShipmentAddress);
				SetFieldValue(&quot;VF Shipment City&quot;, sAddrCity);
				SetFieldValue(&quot;VF Shipment State&quot;, sAddrState);
				SetFieldValue(&quot;VF Shipment Zipcode&quot;, sAddrZipCode);
				SetFieldValue(&quot;VF Shipment Country&quot;, sAddrCountry);
				SetFieldValue(&quot;VF Private Bag&quot;, sAddrPBag);
				SetFieldValue(&quot;VF Private Bag Name&quot;, sAddrPBagName);
				SetFieldValue(&quot;VF Rural Delivery&quot;, sAddrRDelivery);
				SetFieldValue(&quot;Ship To ID&quot;, sAddrShipId);
				SetFieldValue(&quot;Attention To&quot;, sAddrAttentionTo);
				SetFieldValue(&quot;Business Name&quot;, sAddrBusinessName);
				SetFieldValue(&quot;No of Containers&quot;, sShipmentPreference); // JS 22012016 Changed field value from VHA Shipment Preference Calc
				SetFieldValue(&quot;Shipping Notification Method&quot;,sShipmentNotificationMethod);
				SetFieldValue(&quot;Shipping Notification MSISDN&quot;,sShipmentMSISIDN);
				SetFieldValue(&quot;VF Email Address&quot;,sShipmentEmail);
				WriteRecord();
			}//end if (FirstRecord())
		}//end with (sFulUpdateBC)
	}
	catch (e)
	{
		throw e;
	}
	finally
	{
		sFulBC = null;
		sFulUpdateBC = null;
		sConnFulBC = null;
		sOrderBC = null;
		sConnOrderBC = null;
		sOrderBO = null;
	}
}"
