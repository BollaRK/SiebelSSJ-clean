			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetPrepayAmtOOS"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mGetPrepayAmtOOS(Inputs,Outputs)
{
	try
	{
		
		sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
		var oOrderBO=TheApplication().GetBusObject(&quot;Order Entry&quot;);
		var oOrderBC=oOrderBO.GetBusComp(&quot;Order Entry - Orders&quot;);
		var oOrderItemBC=oOrderBO.GetBusComp(&quot;Order Entry - Line Items&quot;);		
		var searchst1 = &quot;&quot;;
		var sOrdId = &quot;&quot;;
		var sAction = &quot;Add&quot;;
		var sPrepAmt = 0;
		var isRec = &quot;&quot;;
		with(oOrderBC)
		{	
			ActivateField(&quot;VF Fulfilment Order Id&quot;);
			ActivateField(&quot;Id&quot;);	
			ClearToQuery(); 
			SetViewMode(AllView);			
			searchst1 = &quot;[VF Fulfilment Order Id] = &apos;&quot; + sOrderId + &quot;&apos;&quot;;
			SetSearchExpr(searchst1);
			ExecuteQuery(ForwardOnly);
			if(FirstRecord())
			{
				sOrdId = GetFieldValue(&quot;Id&quot;);
			}
					
		}
		if(sOrdId != &quot;&quot; &amp;&amp; sOrdId != null)
		{
			with(oOrderItemBC)
			{
				ActivateField(&quot;Product Type&quot;);
				ActivateField(&quot;Order Header Id&quot;);
				ActivateField(&quot;Action Code&quot;);
				ActivateField(&quot;VF Siebel Product Type&quot;);					
				ClearToQuery(); 
				SetViewMode(AllView);			
				SetSearchExpr(&quot;(([Product Type] = &apos;Billing - GPP&apos; AND [VF Siebel Product Type] = &apos;Device&apos;) OR [Product Type] = &apos;Billing - APP&apos;) AND [Order Header Id] = &apos;&quot; + sOrdId +&quot;&apos; AND [Action Code] = &apos;&quot;+ sAction +&quot;&apos;&quot;);
				ExecuteQuery(ForwardOnly);
				isRec = FirstRecord();
				while(isRec)
				{												
					sPrepAmt = ToNumber(sPrepAmt) + ToNumber(mGetOrderItemAttr(oOrderBO,&quot;[Name]=&apos;Prepayment Amount&apos;&quot;));								
					isRec = NextRecord();
				}
			
			}
		
		}
		Outputs.SetProperty(&quot;TotalPrepayAmt&quot;, sPrepAmt);	
	}
	
	catch(e)
	{
		throw(e);
	}
	finally
	{
		sOrderId = null;
		oOrderBO = null;
		oOrderBC = null;
		oOrderItemBC = null;
		searchst1 = null;
		sOrdId = null;
		sAction = null;
		sPrepAmt = null;
		isRec = null;
	
	
	}

}"
			   SEQUENCE="72"
