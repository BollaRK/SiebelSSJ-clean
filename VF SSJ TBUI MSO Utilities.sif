			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCheckStockIndicator"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCheckStockIndicator(Inputs,Outputs)
{
try{
	var sOrderId = Inputs.GetProperty(&quot;Order Id&quot;);
	var sSessionId = Inputs.GetProperty(&quot;Session Id&quot;);
	var strInStock = &quot;N&quot;;
	Outputs.SetProperty(&quot;In Stock Indicator&quot;, &quot;N&quot;);
	var sStockIndLov = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_APP_STOCK_INDICATOR&quot;, &quot;In Stock&quot;);
	var oAccessoryBC = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;).GetBusComp(&quot;VHA Accessory Items&quot;);
	with(oAccessoryBC)
	{
	SetViewMode(AllView);
	ClearToQuery();
	SetSearchExpr( &quot;[Order Id]=&apos;&quot;+sOrderId+&quot;&apos; AND [VHA Non App]=&apos;N&apos; AND [VHA App Stock Indicator] = &apos;&quot;+sStockIndLov+&quot;&apos;&quot;);
	ExecuteQuery();
	if(FirstRecord())
	 strInStock = &quot;Y&quot;;
	}
	if(strInStock == &quot;Y&quot;)
	Outputs.SetProperty(&quot;In Stock Indicator&quot;, &quot;Y&quot;);
	}

  catch (e)
  {
    throw e;
  }
  finally
  {
    oAccessoryBC = null;
  }
	
}"
