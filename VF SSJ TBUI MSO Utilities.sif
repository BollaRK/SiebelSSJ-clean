			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mGetPrepayAmt"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mGetPrepayAmt(sOrderId, sPrepayOutput)
{
        var sPrepayBO = TheApplication().GetBusObject(&quot;VHA Prepayment Processing BO&quot;);
		var sPrepayBC = sPrepayBO.GetBusComp(&quot;VHA Prepayment Account XM&quot;);
	    //var OrderId = Inputs.GetProperty(&quot;OrderId&quot;);
		var sPPAmtUpfront = 0, sTotAcceUpfront = 0, sTotDeviceUpfront = 0, totalprepay = 0;
		var sPrepayOption;
		
		if(sRelOrdIdPP != null &amp;&amp; sRelOrdIdPP != &quot;&quot;)
		{				
			sOrderId = sRelOrdIdPP;			
		}
		with(sPrepayBC)
		{ 
		  ClearToQuery();
		  SetViewMode(AllView);
		  ActivateField(&quot;Service Order Id&quot;);
		  ActivateField(&quot;Total Prepayment&quot;);
          ActivateField(&quot;PP Amount Paid Upfront&quot;);
          ActivateField(&quot;Total Accessory PP Amount Paid Upfront&quot;);
		  ActivateField(&quot;Total Device PP Amount Paid Upfront&quot;);
		  ActivateField(&quot;Prepayment Option Type&quot;);
		  SetSearchSpec(&quot;Order Id&quot;, sOrderId);
          SetSearchSpec(&quot;Type&quot;, &quot;Prepayments&quot;);
		  ExecuteQuery(ForwardOnly);
			if(FirstRecord())
			{
               sPPAmtUpfront = GetFieldValue(&quot;PP Amount Paid Upfront&quot;);
               sTotAcceUpfront = GetFieldValue(&quot;Total Accessory PP Amount Paid Upfront&quot;);
               sTotDeviceUpfront = GetFieldValue(&quot;Total Device PP Amount Paid Upfront&quot;);
               sPrepayOption = GetFieldValue(&quot;Prepayment Option Type&quot;);
              //throw(&quot;NormalOrder&quot;+sPrepayamt);
			}
			else if(!FirstRecord())
			{
				ClearToQuery();
				SetViewMode(AllView);
				ActivateField(&quot;Service Order Id&quot;);
				ActivateField(&quot;Total Prepayment&quot;);
                ActivateField(&quot;PP Amount Paid Upfront&quot;);
		          ActivateField(&quot;Total Accessory PP Amount Paid Upfront&quot;);
				  ActivateField(&quot;Total Device PP Amount Paid Upfront&quot;);
				  ActivateField(&quot;Prepayment Option Type&quot;);
				SetSearchSpec(&quot;Payment Order Id&quot;, sOrderId);
				SetSearchSpec(&quot;Type&quot;, &quot;Prepayments&quot;);
                ExecuteQuery(ForwardOnly);
				if(FirstRecord())
				{
                   sPPAmtUpfront = GetFieldValue(&quot;PP Amount Paid Upfront&quot;);
	               sTotAcceUpfront = GetFieldValue(&quot;Total Accessory PP Amount Paid Upfront&quot;);
	               sTotDeviceUpfront = GetFieldValue(&quot;Total Device PP Amount Paid Upfront&quot;);
	               sPrepayOption = GetFieldValue(&quot;Prepayment Option Type&quot;);
                  // throw(&quot;FulfilmentOrder&quot;+sPrepayamt);
			    }	
			}

          }
            
			sPrepayOutput.SetProperty(&quot;PPAmountpaidupfront&quot;, sPPAmtUpfront);
            sPrepayOutput.SetProperty(&quot;TotalAccessoryUpfront&quot;, sTotAcceUpfront);
            sPrepayOutput.SetProperty(&quot;TotalDeviceAmountPaidUpfront&quot;, sTotDeviceUpfront);
            sPrepayOutput.SetProperty(&quot;PrepaymentOption&quot;, sPrepayOption);
          
         
}"
