			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCalcSIMOCount"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCalcSIMOCount(Inputs)
{
/* Component Name        : 	mCalcSIMOCount
* Component Information : 	This method is to validate pending SIMO connect services
* Modification History  :
* Date			Author		Config #	Description
* ============ ===========	===========	================================
* 04/02/2016	Kamali 		Initial Draft 
*/
	try
	{
		var oOrderBO=TheApplication().GetBusObject(&quot;Order Entry&quot;);
		//var oOrderBC=oOrderBO.GetBusComp(&quot;Order Entry - Orders&quot;);
		var bcOrderItem = oOrderBO.GetBusComp(&quot;Order Entry - Line Items (Simple)&quot;);
		var sServiceOrderId,sSearchStr=&quot;&quot;; 
		var strRootId,strProductCode,iPendingDFConections=0;
		var boAllIMEI = TheApplication().GetBusObject(&quot;VF MPP Orders&quot;);		
		var bcDevice = boAllIMEI.GetBusComp(&quot;VF MPP RCC Details&quot;);
		var bcAllIMEI = boAllIMEI.GetBusComp(&quot;VF Allocate IMEI&quot;);
		var oLineBC,oLineXA;
		
		var boOrder = TheApplication().GetBusObject(&quot;Order Entry - Simple&quot;);
		var bcOrderEntryOrders = boOrder.GetBusComp(&quot;Order Entry - Orders&quot;);
		var bcOrderEntryLines = boOrder.GetBusComp(&quot;Order Entry - Line Items (Simple)&quot;);
		with(bcOrderEntryOrders)
		{
			SetViewMode(AllView);
			ClearToQuery();
			SetSearchSpec(&quot;Account Id&quot;, Inputs.GetProperty(&quot;AccountId&quot;));
			SetSearchSpec(&quot;Order Sub Type&quot;, &quot;Fulfilment&quot;);
			SetSearchSpec(&quot;VF Order Function&quot;, &quot;Acquisition&quot;);
			//SetSearchSpec(&quot;VF Order Channel&quot;,&quot;VHA Online Store&quot;);
			SetSearchSpec(&quot;Status&quot;, &quot;Complete&quot;);
			ExecuteQuery(ForwardOnly);
			var isRecExist=FirstRecord();
			
			while(isRecExist)
			{
				bcOrderEntryLines.ActivateField(&quot;Related Service Order Id&quot;);
				bcOrderEntryLines.ClearToQuery();
				bcOrderEntryLines.SetSearchExpr (&quot;[Root Order Item Id]=[Id]&quot;);
				bcOrderEntryLines.ExecuteQuery();
				var iLineRec = bcOrderEntryLines.FirstRecord();
				while(iLineRec)
				{
					sServiceOrderId = bcOrderEntryLines.GetFieldValue(&quot;Related Service Order Id&quot;);
					if( sServiceOrderId != &apos;&apos; || sServiceOrderId != null)
					{
					
					with(bcOrderItem)
					{
						ClearToQuery();
						sSearchStr = &quot;[Root Order Item Id] =&apos;&quot;+sServiceOrderId+&quot;&apos; AND ([Status]=&apos;Pending&apos; OR [Status]=&apos;Pending Fulfilment&apos;)&quot;;
						SetSearchExpr (sSearchStr);
						ExecuteQuery();
						if(FirstRecord())
						{
							strProductCode=&quot;&quot;;
							strRootId=GetFieldValue(&quot;Id&quot;);
							
							with(bcAllIMEI)
							{
								ActivateField(&quot;Product Code&quot;);
								ClearToQuery();	
								SetViewMode(AllView);
								SetSearchSpec(&quot;Root Order Line Item&quot;, strRootId);
								ExecuteQuery(ForwardOnly);
							}
							if (bcAllIMEI.FirstRecord())
							{
								strProductCode = bcAllIMEI.GetFieldValue(&quot;Product Code&quot;);
							}
							if(	strProductCode==&quot;&quot; || strProductCode==null)
							{
								with (bcDevice)
								{
									ClearToQuery();	
									SetViewMode(AllView);
									ActivateField(&quot;Device Code&quot;);
									SetSearchSpec(&quot;Root Order Item Id&quot;, strRootId);
									SetSearchSpec(&quot;Action Code&quot;, &quot;&lt;&gt; Delete&quot;);
									ExecuteQuery(ForwardOnly);
									if (FirstRecord())
										strProductCode = GetFieldValue(&quot;Device Code&quot;);							
								}
							}
							if(	strProductCode==&quot;&quot; || strProductCode==null)
							{
								oLineBC = oOrderBO.GetBusComp(&quot;Order Entry - Line Items (Simple)&quot;);
								oLineXA = oOrderBO.GetBusComp(&quot;Order Item XA (Simple)&quot;);
								with (oLineBC)
								{
									 ClearToQuery();
									 SetViewMode(AllView);
									 //SetSearchSpec(&quot;Root Order Item Id&quot;, strRootId);
									 //SetSearchSpec(&quot;Product Type&quot;, &quot;Billing - MPP&quot;);
									 //SetSearchSpec(&quot;Action Code&quot;, &quot;&lt;&gt;Delete&quot;);
									 SetSearchExpr(&quot;[Root Order Item Id] = &apos;&quot;+strRootId+&quot;&apos; AND ([Product Type] = &apos;Billing - MPP&apos; OR [Product Type] = &apos;Billing - GPP&apos;) AND [Action Code] &lt;&gt; &apos;Delete&apos;&quot;);
									 ExecuteQuery(ForwardBackward);
									 if (FirstRecord())
									 {
										strProductCode = mGetOrderItemAttr(oOrderBO,&quot;[Name]=&apos;Device Product Code&apos;&quot;);
									}
								}
							}
							if(	strProductCode==&quot;&quot; || strProductCode==null)
							{
								iPendingDFConections=iPendingDFConections+1;
							}
						}
					}
                   }					
					iLineRec=bcOrderEntryLines.NextRecord();
				}
				isRecExist=NextRecord();	
			}
		}
		return(iPendingDFConections);
	}
	catch(e)
	{
		throw e;
	}
	finally
	{
		//Kailash - Modified BO,BC nullification
		oLineXA = null;
		oLineBC = null;
		bcOrderItem=null;						
		oOrderBO=null;
		/*Below variables are nullified by Sharukh on 18/03/2019*/
		bcDevice = null;
		bcAllIMEI = null;
		bcOrderEntryOrders = null;
		bcOrderEntryLines = null;
		boAllIMEI = null;
		boOrder = null;
		

	}

}"
			   SEQUENCE="40"
			   UPDATED="01/09/2026 15:43:17"
			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 15:43:17"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCalculateRRP"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCalculateRRP(Inputs,&amp;psOut)
{	try
	{	sOrderId = Inputs.GetProperty(&quot;OrderId&quot;);
	    var AppleFlag = Inputs.GetProperty(&quot;AppleVoucher&quot;);//ADUTTA:Apple Fraud
		var oOrderBO=TheApplication().GetBusObject(&quot;Order Entry&quot;);
		var oOrderBC=oOrderBO.GetBusComp(&quot;Order Entry - Orders&quot;);
		var oFulOrderBO = TheApplication().GetBusObject(&quot;Order Entry&quot;);
		var oFulOrderBC = oFulOrderBO.GetBusComp(&quot;Order Entry - Orders&quot;);
		var sOrderType,bVFFlg,strTerm, sItemName,strTermOverride,sOrderSubType;
		var sAssetIntegId;
		var oLineBC,oLineXA;
		var sParentOrderId; // Added for Defect 255
		var sPOrderId;
		var pOutputs= TheApplication().NewPropertySet();
		var sSearchStr = Inputs.GetProperty(&quot;SearchStr&quot;);
		sOrderType = Inputs.GetProperty(&quot;OrderFn&quot;);
		var sPreAmt = &quot;&quot;,iPPRRP = 0, iRCCPrepAmt = &quot;&quot;, iRRPPrepAmt = &quot;&quot;;
		var iRCCPP = 0,sPreAmt = 0, strRRPIncGSTPP = 0;
		var bsEAIService = TheApplication().GetService(&quot;EAI Siebel Adapter&quot;);
		var psInputs = TheApplication().NewPropertySet();
		var psOutputs = TheApplication().NewPropertySet();
		var psInps = TheApplication().NewPropertySet();
		var psOuts = TheApplication().NewPropertySet();
		var psOut1 = TheApplication().NewPropertySet();
		var sConnectLater = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_ORDER_STOCK_INDICATOR&quot;,&quot;Out of Stock - Connect Later&quot;);
		var sInStock = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_ORDER_STOCK_INDICATOR&quot;,&quot;In Stock&quot;);
		var sDevice = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_PROD_TYPE&quot;,&quot;Device&quot;);
		var sBillingMPP = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;PRODUCT_TYPE&quot;,&quot;Billing - MPP&quot;);
		var sBillingGPP = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;PRODUCT_TYPE&quot;,&quot;Billing - GPP&quot;);
		psInputs.SetProperty(&quot;OutputIntObjectName&quot;, &quot;VF Order Item Task Simple&quot;);
		if(sOrderType==&quot;Acquisition&quot;)
		{psInputs.SetProperty(&quot;SearchSpec&quot;,sSearchStr);}	
		else if(Inputs.GetProperty(&quot;Step&quot;) == &quot;Insert&quot;)
			psInputs.SetProperty(&quot;SearchSpec&quot;,&quot;[VF Order Item Task Simple.Order Header Id] = &apos;&quot; + sOrderId + &quot;&apos; AND ([VF Order Item Task Simple.VF Stock Indicator TBUI]=&apos;&quot;+sInStock+&quot;&apos; OR [VF Order Item Task Simple.VF Stock Indicator TBUI] IS NULL)&quot;);
		else
			psInputs.SetProperty(&quot;SearchSpec&quot;,&quot;[VF Order Item Task Simple.Order Header Id] = &apos;&quot; + sOrderId + &quot;&apos;&quot;);
		var iNoOfServices=0;
		var boHM, bcHMVer, bcHM, boAlIMEI, bcAlIMEI, sOrderChannel;
		var sTotalRRP =0;
		var strRRPIncGST, sErrMessage = &quot;&quot;, bContinue;
		var strProductCode = &quot;&quot;, strNewRatePlan = &quot;&quot;, strHandsetName = &quot;&quot;, strRootId = &quot;&quot;, stockInd = &quot;&quot;, connType = &quot;&quot;, IMEI = &quot;&quot;;
		var psPlanOut   = TheApplication().NewPropertySet();
		var boAllIMEI = TheApplication().GetBusObject(&quot;VF MPP Orders&quot;);
		var bcAllIMEI = boAllIMEI.GetBusComp(&quot;VF Allocate IMEI&quot;);
		var bcDevice = boAllIMEI.GetBusComp(&quot;VF MPP RCC Details&quot;);
		boHM = TheApplication().GetBusObject( &quot;VF Handset Matrix&quot; );
		bcHMVer = boHM.GetBusComp( &quot;VF Handset Matrix Version&quot; );
		bcHM = boHM.GetBusComp( &quot;VF Handset Matrix&quot; );
		var psPrefOut = TheApplication().NewPropertySet();
		bsEAIService.InvokeMethod(&quot;Query&quot;, psInputs, psOutputs);
		psInputs.Reset();
		psInputs = psOutputs.GetChild(0).GetChild(0).Copy();
		iNoOfServices = psInputs.GetChildCount();
		for (var i=0;i &lt; iNoOfServices; i++)
		{	strRRPIncGST= &quot;&quot;;
			sPreAmt = 0;
			bContinue = false;
			bVFFlg= &quot;Y&quot;;
			strProductCode = &quot;&quot;;
			stockInd = psInputs.GetChild(i).GetProperty(&quot;VF Stock Indicator TBUI&quot;);
			connType = psInputs.GetChild(i).GetProperty(&quot;VF ConnectionType&quot;);
			IMEI = psInputs.GetChild(i).GetProperty(&quot;VF IMEI TBUI&quot;);		
			strRootId = psInputs.GetChild(i).GetProperty(&quot;Id&quot;);
			with(oOrderBC)// Added for Defect 255
			{	ClearToQuery();
				SetViewMode(AllView);//Indumathi: 07/06/2018:Added setviewmode
				SetSearchSpec(&quot;Id&quot;, psInputs.GetChild(i).GetProperty(&quot;Order Header Id&quot;));
				ExecuteQuery();
				if(FirstRecord())
				{sOrderChannel = GetFieldValue(&quot;VF Order Channel&quot;); //Chitra Added for AOA2
				sOrderSubType = GetFieldValue(&quot;Order Sub Type&quot;);
				}
			}
			with(bcAllIMEI)
			{
				ClearToQuery();	
				SetViewMode(AllView);
				ActivateField(&quot;IMEI&quot;);
				ActivateField(&quot;Order Id&quot;);
				ActivateField(&quot;Device Name&quot;);
				ActivateField(&quot;Upfront Cost&quot;);
				ActivateField(&quot;Product Code&quot;);
				ActivateField(&quot;VF Flag&quot;);
				ActivateField(&quot;Mandatory Term&quot;);
				ActivateField(&quot;Mandatory Amount&quot;);
				SetSearchSpec(&quot;Root Order Line Item&quot;, strRootId);
				SetSearchSpec(&quot;Order Id&quot;, psInputs.GetChild(i).GetProperty(&quot;Order Header Id&quot;));
				ExecuteQuery(ForwardOnly);
			}
			if (bcAllIMEI.FirstRecord())
			{	strProductCode = bcAllIMEI.GetFieldValue(&quot;Product Code&quot;);
				bVFFlg = bcAllIMEI.GetFieldValue(&quot;VF Flag&quot;);}
			else // if out of stock - connect later fetch the device code
				strProductCode = psInputs.GetChild(i).GetProperty(&quot;VF Handset Code TBUI&quot;);
			if(psInputs.GetChild(i).GetProperty(&quot;Device Code&quot;) !=&quot;&quot;)
				strProductCode = psInputs.GetChild(i).GetProperty(&quot;Device Code&quot;);
			if(bVFFlg!=&quot;N&quot; &amp;&amp; (strProductCode == null || strProductCode ==&quot;&quot;))
			{	oLineBC = oOrderBO.GetBusComp(&quot;Order Entry - Line Items (Simple)&quot;);
				oLineXA = oOrderBO.GetBusComp(&quot;Order Item XA (Simple)&quot;);
				with (oLineBC)
				{	ClearToQuery();
					 SetViewMode(AllView);					
					 SetSearchExpr(&quot;[Root Order Item Id] = &apos;&quot;+strRootId+&quot;&apos; AND ([Product Type] = &apos;&quot;+sBillingMPP+&quot;&apos; OR ([Product Type] = &apos;&quot;+sBillingGPP+&quot;&apos; AND [VHA Siebel Product Type] = &apos;&quot;+sDevice+&quot;&apos;)) AND [Action Code] = &apos;Add&apos;&quot;);
					 ExecuteQuery(ForwardBackward);
					 if (FirstRecord())
					 {strProductCode = mGetOrderItemAttr(oOrderBO,&quot;[Name]=&apos;Item Code&apos;&quot;);}}}
			if (bVFFlg!=&quot;N&quot; &amp;&amp; (strProductCode == null || strProductCode ==&quot;&quot;))
			{with (bcDevice)
				{	ClearToQuery();	
					SetViewMode(AllView);
					SetSearchSpec(&quot;Order Header Id&quot;, psInputs.GetChild(i).GetProperty(&quot;Order Header Id&quot;));
					SetSearchSpec(&quot;Root Order Item Id&quot;, strRootId);
					SetSearchSpec(&quot;Action Code&quot;, &quot;&lt;&gt; Delete&quot;);
					ExecuteQuery(ForwardOnly);
					if (FirstRecord())
						strProductCode = GetFieldValue(&quot;Device Code&quot;);}}
			if ((strProductCode == null || strProductCode ==&quot;&quot;) &amp;&amp; sOrderType ==&quot;Acquisition&quot;)
			{	var oFulLineBC = TheApplication().GetBusObject(&quot;VHA Fulfilment TBUI Order&quot;).GetBusComp(&quot;VHA MACD Order Entry - Line Items (Header)&quot;);
				oFulLineBC.ClearToQuery();
				oFulLineBC.SetViewMode(AllView);
				oFulLineBC.SetSearchSpec(&quot;Related Service order Id&quot;, strRootId);
				oFulLineBC.SetSearchSpec(&quot;Order Header Id&quot;, sOrderId);
				oFulLineBC.ExecuteQuery(ForwardBackward);
				if (oFulLineBC.FirstRecord())
				{	var sRootId = oFulLineBC.GetFieldValue(&quot;Id&quot;); 
					with(oFulOrderBC)
					{	ClearToQuery();
						SetViewMode(AllView);
						SetSearchSpec(&quot;Id&quot;, sOrderId);
						ExecuteQuery();
						if(FirstRecord())
							strProductCode=&quot;&quot;;
					}
					oLineBC = oFulOrderBO.GetBusComp(&quot;Order Entry - Line Items (Simple)&quot;);
					oLineXA = oFulOrderBO.GetBusComp(&quot;Order Item XA (Simple)&quot;);
					with (oLineBC)
					{	 ClearToQuery();
						 SetViewMode(AllView);
						 SetSearchSpec(&quot;Root Order Item Id&quot;, sRootId);
						 SetSearchSpec(&quot;Product&quot;, &quot;Device&quot;);
						 ExecuteQuery(ForwardBackward);
						 if (FirstRecord())
						 {strProductCode = mGetOrderItemAttr(oFulOrderBO,&quot;[Name]=&apos;Device Code&apos;&quot;);}}}
			}
			if(sOrderSubType ==&quot;Modify&quot;)
			{
				sTotalRRP+= ToNumber(mGetGPPDetails(oOrderBO,psInputs.GetChild(i).GetProperty(&quot;Order Header Id&quot;),sTotalRRP,strRootId,psOut));
			}	
			else if((connType == &quot;SIM Only&quot; &amp;&amp;  (bVFFlg!=&quot;N&quot; &amp;&amp; (strProductCode == null || strProductCode ==&quot;&quot;))) || ( connType == &quot;&quot; &amp;&amp;  (bVFFlg!=&quot;N&quot; &amp;&amp; (strProductCode == null || strProductCode ==&quot;&quot;))))
			{	strRRPIncGST=ToNumber(TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_EQUIPMENT_NOTIONAL_VALUE&quot;,&quot;Equipment Value&quot;));
				sTotalRRP+=strRRPIncGST;}
			else if(strProductCode != &quot;&quot;)
			{	mMPPGetPlanDetails(strRootId,psPlanOut);
				if(psPlanOut.GetProperty(&quot;Plan&quot;))
				{	strNewRatePlan = psPlanOut.GetProperty(&quot;Plan&quot;);
					bcHMVer.ClearToQuery();
					bcHMVer.SetViewMode(AllView);
					bcHM.ActivateField(&quot;RRP&quot;);
					bcHM.ActivateField(&quot;RRP Exc GST&quot;);
					bcHM.ActivateField(&quot;Product Code&quot;);
					bcHM.ActivateField(&quot;Plan Name&quot;);
					bcHM.ActivateField(&quot;Id&quot;);
					bcHMVer.SetSearchSpec(&quot;Version Status&quot;, &quot;Live&quot;);
					bcHM.SetSearchSpec(&quot;Product Code&quot;, strProductCode);
					bcHM.SetSearchSpec(&quot;Plan Name&quot;, strNewRatePlan);
					bcHMVer.ExecuteQuery();
					if (bcHM.FirstRecord())
					{	strRRPIncGST = ToNumber(bcHM.GetFieldValue( &quot;RRP&quot; ));
						strTerm = psPlanOut.GetProperty(&quot;Term&quot;);	
							oLineBC = oOrderBO.GetBusComp(&quot;Order Entry - Line Items (Simple)&quot;);
							oLineXA = oOrderBO.GetBusComp(&quot;Order Item XA (Simple)&quot;);
							with (oLineBC)
							{	 ClearToQuery();
								 SetViewMode(AllView);
                                 ActivateField(&quot;Asset Integration Id&quot;);
								 SetSearchSpec(&quot;Root Order Item Id&quot;, strRootId);							
								 SetSearchSpec(&quot;Product Type&quot;, sBillingGPP);
								 SetSearchSpec(&quot;VHA Siebel Product Type&quot;,sDevice);
								 SetSearchSpec(&quot;Action Code&quot;, &quot;Add&quot;);
								 ExecuteQuery(ForwardBackward);
								 if (FirstRecord())
								 {	sPreAmt = ToNumber(mGetOrderItemAttr(oOrderBO,&quot;[Name]=&apos;Prepayment Amount&apos;&quot;));
                                    sAssetIntegId = GetFieldValue(&quot;Asset Integration Id&quot;);
									if(GetFieldValue(&quot;Order Sub Type&quot;) == &quot;Modify&quot;)
									strRRPIncGST = ToNumber(mGetOrderItemAttr(oOrderBO,&quot;[Name]=&apos;Contract Amount&apos;&quot;));
									if(strTerm==&quot;1&quot; || strTerm==&quot;&quot; || strTerm == null)
									{	strTerm = mGetOrderItemAttr(oOrderBO,&quot;[Name]=&apos;Term&apos;&quot;);
										strTermOverride = mGetOrderItemAttr(oOrderBO,&quot;[Name]=&apos;Term Override&apos;&quot;);	
										if(strTermOverride!=&quot;_&quot; &amp;&amp; (strTermOverride !=&quot;&quot; &amp;&amp; strTermOverride != null))
										{strTerm = strTermOverride;}
									}
								}
							}
						strRRPIncGSTPP = ToNumber(strRRPIncGST) - ToNumber(sPreAmt);
						psOut1.SetProperty(&quot;Type&quot;,&quot;Equipment Limit&quot;);
						psOut1.SetProperty(&quot;Term&quot;,strTerm); 
						psOut1.SetProperty(&quot;RRP&quot;,strRRPIncGSTPP);
						psOut1.SetProperty(&quot;OrderId&quot;,psInputs.GetChild(i).GetProperty(&quot;Order Header Id&quot;));
						psOut1.SetProperty(&quot;LineItemId&quot;,strRootId);
						psOut1.SetProperty(&quot;PlanProdType&quot;,psPlanOut.GetProperty(&quot;PlanProdType&quot;)); 
                        psOut1.SetProperty(&quot;AssetIntegId&quot;,sAssetIntegId);
                        psOut1.SetProperty(&quot;PrepaymentAmount&quot;,sPreAmt);
						psOut.AddChild(psOut1.Copy());   
					    psOut1.Reset();												
						sTotalRRP+=strRRPIncGST;		
						//sTotalRRP = ToNumber(sTotalRRP) - ToNumber(sPreAmt);
					}
					else
					{sErrMessage = &quot;Line Number: &quot; + psInputs.GetChild(i).GetProperty(&quot;VF Line Number&quot;) + &quot; - VFErr#9900990 :The Handset &apos;&quot; + strHandsetName + &quot;&apos; is not offered along with the rate plan: &apos;&quot; + strNewRatePlan + &quot;&apos;.Please reselect Plan.\r&quot;;
					}
				}//if(psPlanOut.GetProperty(&quot;Plan&quot;))
			}//if(strProductCode != &quot;&quot;)
			else if(bVFFlg==&quot;N&quot;)
			{
				var iRCC=0;
				var lRec;
				mMPPGetPlanDetails(strRootId,psPlanOut);
				if(psPlanOut.GetProperty(&quot;Plan&quot;))
				{
				oLineBC = oOrderBO.GetBusComp(&quot;Order Entry - Line Items (Simple)&quot;);
				oLineXA = oOrderBO.GetBusComp(&quot;Order Item XA (Simple)&quot;);
				with (oLineBC)
				{	 ClearToQuery();
					 SetViewMode(AllView);
					 ActivateField(&quot;Asset Integration Id&quot;);
					 SetSearchSpec(&quot;Root Order Item Id&quot;, strRootId);					
					 SetSearchSpec(&quot;Product Type&quot;, sBillingGPP);
					 SetSearchSpec(&quot;VHA Siebel Product Type&quot;,sDevice);
					 SetSearchSpec(&quot;Action Code&quot;, &quot;Add&quot;);
					 ExecuteQuery(ForwardBackward);
					 if (FirstRecord())
					 {
					 	iRCC+=ToNumber(mGetOrderItemAttr(oOrderBO,&quot;[Name]=&apos;Contract Amount&apos;&quot;));
						iRCC+=ToNumber(mGetOrderItemAttr(oOrderBO,&quot;[Name]=&apos;Upfront Payment Amount&apos;&quot;));						
						iRCCPrepAmt = ToNumber(mGetOrderItemAttr(oOrderBO,&quot;[Name]=&apos;Prepayment Amount&apos;&quot;));
						sTotalRRP+=iRCC;
						//sTotalRRP = ToNumber(sTotalRRP) - ToNumber(iRCCPrepAmt);
						iRCCPP = ToNumber(iRCC) - ToNumber(iRCCPrepAmt);
						strTerm = psPlanOut.GetProperty(&quot;Term&quot;);
						sAssetIntegId = GetFieldValue(&quot;Asset Integration Id&quot;);
						//sItemName = mGetOrderItemAttr(oOrderBO,&quot;[Name]=&apos;Item Name&apos;&quot;); 	
						if(strTerm==&quot;1&quot; || strTerm==&quot;&quot; || strTerm == null)
						{	strTerm = mGetOrderItemAttr(oOrderBO,&quot;[Name]=&apos;Term&apos;&quot;);
							strTermOverride = mGetOrderItemAttr(oOrderBO,&quot;[Name]=&apos;Term Override&apos;&quot;);				
							if(strTermOverride!=&quot;_&quot; &amp;&amp;(strTermOverride !=&quot;&quot; &amp;&amp; strTermOverride != null))
							{strTerm = strTermOverride;}	
						}
						psOut1.SetProperty(&quot;Type&quot;,&quot;Equipment Limit&quot;);
						psOut1.SetProperty(&quot;Term&quot;,strTerm);
						//psOut1.SetProperty(&quot;Item Name&quot;,sItemName);  // Sachi - 20/06/2019 - Added for R19.3 Insert Equipment Limit
						psOut1.SetProperty(&quot;RRP&quot;,iRCCPP);
						psOut1.SetProperty(&quot;OrderId&quot;,psInputs.GetChild(i).GetProperty(&quot;Order Header Id&quot;));
						psOut1.SetProperty(&quot;LineItemId&quot;,strRootId);
						psOut1.SetProperty(&quot;PlanProdType&quot;,psPlanOut.GetProperty(&quot;PlanProdType&quot;)); //Thileepa: 31/07/18: Added for PKE000000057942
						psOut1.SetProperty(&quot;PrepaymentAmount&quot;,iRCCPrepAmt);
						psOut1.SetProperty(&quot;AssetIntegId&quot;,sAssetIntegId);
						psOut.AddChild(psOut1.Copy());   
					    psOut1.Reset();				 	
					}
				}
				}
			}
			//Chitra Added for AOA2 - 29/04/2016
			var iRRP = 0; 
			var sAccessory = &quot;N&quot;;
			psPrefOut.Reset();
			if (sOrderChannel != &quot;VHA Online Store&quot; &amp;&amp; Inputs.GetProperty(&quot;Step&quot;) == &quot;Insert&quot; &amp;&amp; sOrderSubType !=&quot;Modify&quot;)//Suresh G 17/9/2019 - Chk for Modify done to avoid duplicate EL record creation for APP 
			{
				oLineBC = oOrderBO.GetBusComp(&quot;Order Entry - Line Items (Simple)&quot;);
				oLineXA = oOrderBO.GetBusComp(&quot;Order Item XA (Simple)&quot;);
					with (oLineBC)
					{
						 ActivateField(&quot;Asset Integration Id&quot;);
						 ClearToQuery();
						 SetViewMode(AllView);
						 SetSearchSpec(&quot;Root Order Item Id&quot;, strRootId);
						 SetSearchSpec(&quot;Product Type&quot;, &quot;Billing - APP&quot;);
						 SetSearchSpec(&quot;Action Code&quot;, &quot;Add&quot;);//Apoorva:Modified for PKE000000124467,previous code:SetSearchSpec(&quot;Action Code&quot;, &quot;&lt;&gt;Delete&quot;)
						 ExecuteQuery(ForwardBackward);
						 //if (FirstRecord())
						 //Indumathi: ATOM Project : Added while loop - 21/06/2017
						 var iRecCount = FirstRecord();
						 var strCategory = &quot;&quot;;
						 if (iRecCount)
						 {
						 while(iRecCount)
						 {
						  	// Indumathi modified for ATOM project - 23/06/2017
						  	iRRP = ToNumber(mGetOrderItemAttr(oOrderBO,&quot;[Name]=&apos;Total Accessories RRP Inc GST&apos;&quot;));
						  	iRRPPrepAmt = ToNumber(mGetOrderItemAttr(oOrderBO,&quot;[Name]=&apos;Prepayment Amount&apos;&quot;));
							var iAccConAmt = ToNumber(mGetOrderItemAttr(oOrderBO,&quot;[Name]=&apos;Contract Amount&apos;&quot;));
							sTotalRRP+=iRRP;
							//sTotalRRP = ToNumber(sTotalRRP) - ToNumber(iRRPPrepAmt);
							strTerm = mGetOrderItemAttr(oOrderBO,&quot;[Name]=&apos;Term&apos;&quot;)	
							psOut1.SetProperty(&quot;Term&quot;,strTerm);
							psOut1.SetProperty(&quot;RRP&quot;,iAccConAmt);
							psOut1.SetProperty(&quot;OrderId&quot;,psInputs.GetChild(i).GetProperty(&quot;Order Header Id&quot;));
							psOut1.SetProperty(&quot;LineItemId&quot;,strRootId);
							psOut1.SetProperty(&quot;Type&quot;,&quot;Accessory Limit&quot;);
							psOut1.SetProperty(&quot;AssetIntegId&quot;,GetFieldValue(&quot;Asset Integration Id&quot;));
							psOut1.SetProperty(&quot;PrepaymentAmount&quot;,iRRPPrepAmt);
							psOut.AddChild(psOut1.Copy());   
						    psOut1.Reset();	
						    iRecCount = NextRecord();			 	
						}
						}
						else
						{	mAPPGetAccessoryDetails(strRootId, psPrefOut);
							sTotalRRP+=ToNumber(psPrefOut.GetProperty(&quot;TotalRRP&quot;));
							if (psPrefOut.GetProperty(&quot;TotalNumofAccessories&quot;) &gt; 0)
							{	psOut1.SetProperty(&quot;Term&quot;,strTerm);
								psOut1.SetProperty(&quot;RRP&quot;, ToNumber(psPrefOut.GetProperty(&quot;TotalRRP&quot;)));
								psOut1.SetProperty(&quot;OrderId&quot;,psInputs.GetChild(i).GetProperty(&quot;Order Header Id&quot;));
								psOut1.SetProperty(&quot;LineItemId&quot;,strRootId);
								psOut1.SetProperty(&quot;Type&quot;,&quot;Accessory Limit&quot;);
								psOut.AddChild(psOut1.Copy());   
								psOut1.Reset();}}}
				}
				sPOrderId = psInputs.GetChild(i).GetProperty(&quot;Order Header Id&quot;);
				Inputs.SetProperty(&quot;OrderId&quot;,sPOrderId);				
				mCheckVoucherAmount(Inputs,pOutputs);				
				sTotalRRP+=ToNumber(pOutputs.GetProperty(&quot;ssVoucherAmount&quot;));
				var AppleLOV = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_CR_ENABLE_FLAG&quot;,&quot;Apple Plan&quot;)
				  if(AppleLOV == &quot;Y&quot; &amp;&amp; AppleFlag == &quot;Y&quot;)
                    {
				if((pOutputs.GetProperty(&quot;ssVoucherAmount&quot;)) == &quot;&quot; || (pOutputs.GetProperty(&quot;ssVoucherAmount&quot;) == null) || (pOutputs.GetProperty(&quot;ssVoucherAmount&quot;)) == &quot;0&quot;)
                       {

				  
                     //mCheckAppleVoucherAmount(Inputs,pOutputs,Inputs.GetProperty(&quot;OrderId&quot;))
				      sTotalRRP+=mGetAppleVoucherAmount(Inputs);
					    }
					 }


                   
				TheApplication().SetProfileAttr(&quot;TotalRRP&quot;,sTotalRRP + AppleFlag);
				
		}//for (i=0;i &lt; iNoOfervices; i++)
		if((sPreAmt == &quot;&quot; || sPreAmt == null) &amp;&amp; (iRCCPrepAmt == &quot;&quot; || iRCCPrepAmt == null) &amp;&amp; (iRRPPrepAmt == &quot;&quot; || iRRPPrepAmt == null))
		{sIfPrepayment = &quot;Y&quot;;}
		return(sTotalRRP);
	}
	catch(e)
	{
		throw e;
	}
	finally
	{
		if(defined(oFulLineBC)) { oFulLineBC = null; }/*This variable is nullified by GURUPRASAD on 23/10/2019*/
		bcDevice = null;/*This variable is nullified by GURUPRASAD on 23/10/2019*/
		bcAllIMEI = null;/*This variable is nullified by GURUPRASAD on 23/10/2019*/
		boAllIMEI = null;/*This variable is nullified by GURUPRASAD on 23/10/2019*/
		psInputs = null;
		psOutputs = null;
		bsEAIService = null;
		bcHMVer = null;
		bcHM = null;
		boHM = null;
		oLineBC = null;
		oLineXA = null;
		oFulOrderBC = null;
		oFulOrderBO = null;
		oOrderBC=null; //Roseline:05/08/2016 - BC and BO nullified at the last for crash issue
		oOrderBO=null;
		iRecCount=&quot;&quot;; //Indumathi: ATOM Project : Nullified variable - 21/06/2017
	}
}"
