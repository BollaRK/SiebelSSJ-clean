			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="CreateRequestTNR"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function CreateRequestTNR(spretopost, &amp;sCreatedTNR, Inputs, &amp;sDontAllocate)
{
	try
	{
		//TheApplication().TraceOn(&quot;&quot;, &quot;Allocation&quot;, &quot;All&quot;); VHA SASI:28/03/2019: Commeted out TRACE-ON as part 10% Customization(IP18 Upgrade)
        var Outputs = TheApplication().NewPropertySet();
		var oTNRBO = TheApplication().GetBusObject(&quot;VF MNP Transfer Number Request&quot;);
		var oTNRBC = oTNRBO.GetBusComp(&quot;VF Transfer Number Request - Without BC Read Prop&quot;);
		var bcTranNumReq = oTNRBO.GetBusComp(&quot;VF Transfer Number Request&quot;);
		/*var sAccountId = Inputs.GetProperty(&quot;CustAccountId&quot;);
		var sExtRefNum = Inputs.GetProperty(&quot;ExtRefNum&quot;);
		var sExtDOB = Inputs.GetProperty(&quot;ExtDOB&quot;); 
		var sPortMSISDN = Inputs.GetProperty(&quot;PortMSISDN&quot;);
		var sBillAcctId = Inputs.GetProperty(&quot;BillAcctId&quot;);*/
		var sAccountId = Inputs.GetProperty(&quot;Customer Account Id&quot;);
		var sExtRefNum = Inputs.GetProperty(&quot;VF Port In - Service Account TBUI&quot;);
		var sExtDOB = Inputs.GetProperty(&quot;VF Port In - DOB TBUI&quot;); 
		var sPortMSISDN = Inputs.GetProperty(&quot;VF Port In - Service Number TBUI&quot;);
		var sBillAcctId = Inputs.GetProperty(&quot;Billing Account Id&quot;);
		//var spretopost = Inputs.GetProperty(&quot;PretoPost&quot;);//TARIQ-03SEP2014-Coming as input property
		var sNewMSISDN = Inputs.GetProperty(&quot;New MSISDN&quot;);
		var sPrevPortMSISDN = Inputs.GetProperty(&quot;Port In MSISDN&quot;);
		var sPrevPortDOB = Inputs.GetProperty(&quot;Port In DOB&quot;);
		var sPrevPortAccNum = Inputs.GetProperty(&quot;Port In Account Number&quot;);
		var sPrevTNRId = Inputs.GetProperty(&quot;VF TNR Id&quot;);
		var sRootOrderId = Inputs.GetProperty(&quot;Order Item Id&quot;); //ROSELINE - 15/12/2014 - Added for RED PLUS CR
		var sProductId = Inputs.GetProperty(&quot;Product Id&quot;); //ROSELINE - 15/12/2014 - Added for RED PLUS CR
				
		var sIdTNR;
		var sStatus;
		var sStatusMsg;
		var sOpenClose;
		var strErrorMsg = &quot;&quot;;
		var strSessionType;
		var strInstalledAssetId;
		var boAccount;
		var bcInstalledAsset;
		var ExistMSISDN;
		
		/* PKE21344 - Added the below code as part of Nov BFX.
		* Subramanian Kalyan|19thAug2015| Port In MSISDN passed to the function getInstAssetIdFromActiveRel
		* to check if the Port In MSISDN is already present in Siebel. If so, User cannot use the Port IN MSISDN
		* as it is Pre-to-Post scenario. Error shown for the same below.
		* Code Changes Start
		*/
		// Setup the installed asset bus comp
		boAccount = TheApplication().GetBusObject(&quot;Account&quot;);
		// Using Indexed BC.
		bcInstalledAsset = boAccount.GetBusComp(&quot;Asset Mgmt - Asset - Header - Indexed&quot;);
		//bcInstalledAsset = boAccount.GetBusComp(&quot;Asset Mgmt - Asset - Header&quot;);
		
		TheApplication().Trace(&quot;CreateTNR -&gt; getInstAssetIdFromActiverel method:&quot;);
		
		ExistMSISDN = getInstAssetIdFromActiveRel(sPortMSISDN,bcInstalledAsset,Outputs,strErrorMsg);
		if(ExistMSISDN == &quot;Y&quot;)
		{
			strErrorMsg = &quot;Cannot perform Port In for Prepay MSISDN. The entered MSISDN already exists in Siebel.&quot;;
			return (strErrorMsg);
		}
		else
		{
				if (sNewMSISDN != &quot;&quot; &amp;&amp; sNewMSISDN != null)
				{
					sCreatedTNR = sPrevTNRId;
					sDontAllocate = &quot;Y&quot;;
					if (sNewMSISDN != sPortMSISDN)
					{
						if (sExtRefNum != sPrevPortAccNum)
							strErrorMsg = &quot;Please deallocate the MSISDN and then change the Port In Details&quot;;
							
						if (sPortMSISDN != sPrevPortMSISDN)
							strErrorMsg = &quot;Please deallocate the MSISDN and then change the Port In Details&quot;;
							
						if (sExtDOB != sPrevPortDOB)
							strErrorMsg = &quot;Please deallocate the MSISDN and then change the Port In Details&quot;;
					}
						
					return (strErrorMsg);
				}
				
				if (sPrevTNRId != &quot;&quot; &amp;&amp; sPrevTNRId != null)
				{
					sCreatedTNR = sPrevTNRId;
					if ((sExtRefNum != sPrevPortAccNum) || (sExtDOB != sPrevPortDOB))
					{
						strErrorMsg = UpdateTNR(sExtDOB, sPortMSISDN, sExtRefNum, sPrevTNRId, spretopost);
					}
						
					return (strErrorMsg);
				}
				var sSharingIndicator = mCheckSharingIndicator(sProductId,sRootOrderId); ////ROSELINE - 15/12/2014 - Added for RED PLUS CR
				with(oTNRBC)
				{
					NewRecord(NewBefore);
					sIdTNR = GetFieldValue(&quot;Id&quot;);
					SetFieldValue(&quot;Customer Account Id&quot;, sAccountId);
					SetFieldValue(&quot;MSISDN&quot;, sPortMSISDN);
					SetFieldValue(&quot;Billing Account Id&quot;,sBillAcctId);
					SetFieldValue(&quot;ServiceProvider&quot;, &quot;Vodafone AU&quot;);
					SetFieldValue(&quot;VF Sharing Indicator&quot;, sSharingIndicator); //ROSELINE - 15/12/2014 - Added for RED PLUS CR
					SetFieldValue(&quot;VF TBUI Flag&quot;, &quot;Y&quot;); //ROSELINE - 15/12/2014 - Added for RED PLUS CR
					if(spretopost == &quot;PortIn&quot;)	//Added to skip for Pre to Post flow//TARIQ-09SEP2014-Changed the value to PortIn
					{
						SetFieldValue(&quot;AccountReferenceNumber&quot;, sExtRefNum);
						SetFieldValue(&quot;CustomerDOB&quot;, sExtDOB);
						SetFieldValue(&quot;Transfer Type&quot;, &quot;External Port&quot;);
					}
					WriteRecord();
					//Validate PortIn
					try
					{
						InvokeMethod(&quot;Validate&quot;);
					}
					catch(e)
					{
						strErrorMsg = e.toString();
					}
					
					sStatus = GetFieldValue(&quot;Status&quot;);
					sStatusMsg = GetFieldValue(&quot;Status Message&quot;);
					sOpenClose = GetFieldValue(&quot;Status Summary&quot;);
					// Throw status msg
					if(sOpenClose == &quot;Open&quot;)
					{
						ActivateField(&quot;Allocate Prod Group Type&quot;);
						ActivateField(&quot;Status&quot;);
						SetFieldValue(&quot;Status&quot;, TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_TRANSFER_STATUS&quot;, &quot;Configure Subscription&quot;));
						SetFieldValue(&quot;Allocate Prod Group Type&quot;, TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_MSISDN_GROUP&quot;, &quot;General&quot;));
						//Outputs.SetProperty(&quot;TNRID&quot;,sIdTNR);
						sCreatedTNR = sIdTNR;
						WriteRecord();
					}
					else
					{
						/*if (strSessionType == TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_WIZARD_SESSION_TYPE&quot;, &quot;New Connection&quot;));
						{ */
						strErrorMsg = &quot;The MSISDN is not currently available to be ported in. Please refer to the Transfer Number Request for further details&quot;;
						//}
					}
				
				}//with(oTNRBC) 
				return(strErrorMsg);
		}
	
	}//try
	catch (e)
	{
		TheApplication().RaiseErrorText(e.toString());
	}
	finally
	{
		//Kailash-Modified BO,BC nullification

		bcTranNumReq = null;  /* This variable is nullified by Sharukh on 20/03/2019*/
 		oTNRBC = null;
 		bcInstalledAsset = null;
		oTNRBO = null;
		boAccount = null;
		Outputs = null;  /* This variable is nullified by Sharukh on 20/03/2019*/
		
		
		

		

	}

}"
			   SEQUENCE="13"
			   UPDATED="01/09/2026 15:43:16"
			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 15:43:16"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="CreateShipment"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function CreateShipment(sFulOrderId)
{
	try
	{
		var sOrderBO = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
		var sOrderBC = sOrderBO.GetBusComp(&quot;Order Entry - Orders&quot;);
		var sFulBC = sOrderBO.GetBusComp(&quot;FS Shipment&quot;);
		with (sOrderBC)
		{
			ClearToQuery();
			SetViewMode(AllView);
			SetSearchSpec(&quot;Id&quot;, sFulOrderId);
			ExecuteQuery();
			if (FirstRecord())
			{
				with (sFulBC)
				{
					NewRecord(NewBefore);
					WriteRecord();
					//Outputs.SetProperty(&quot;FullShipId&quot;, GetFieldValue(&quot;Id&quot;)); 
				}
			}
		}
	}
	catch (e)
	{
		throw e;
	}
	finally
	{
		sFulBC = null;
		sOrderBC = null;
		sOrderBO = null;
	}
}"
