			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mPrepaymentsOrderUpdate"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mPrepaymentsOrderUpdate(Inputs, Outputs)
{
	try
	{
		var strOrderId = Inputs.GetProperty(&quot;Order Id&quot;);
		var sFullfillmentOrdId = Inputs.GetProperty(&quot;Fullfillment Order Id&quot;);
		var boOrder = TheApplication().GetBusObject(&quot;VF Order Entry Thin BO&quot;);
		var boOrder1 = TheApplication().GetBusObject(&quot;VF Order Entry Thin BO&quot;);
		var bcOrder = boOrder.GetBusComp(&quot;VF Order Entry - Orders Thin BC&quot;);
		var bcLineItems = boOrder.GetBusComp(&quot;VHA Order Entry - Line Items Thin&quot;);
		var bcPrepayXM = boOrder1.GetBusComp(&quot;VHA Prepayment Account XM&quot;);
		var sOrderItemId = &quot;&quot;;
		var sPaymentOrdId = &quot;&quot;;
		var searchexpr = &quot;&quot;;
		var sOrderType = &quot;&quot;;	
		var sOrderFunction = &quot;&quot;;
		var sServiceOrdId = &quot;&quot;;
		
		with(bcOrder)
		{
			   SetViewMode(AllView);
			   ActivateField(&quot;Order Sub Type&quot;);
			   ActivateField(&quot;VF Order Function&quot;);					               
			   ClearToQuery();
			   if(sFullfillmentOrdId == null || sFullfillmentOrdId == &quot;&quot;)
			   searchexpr = &quot;[Id] = &apos;&quot; + strOrderId + &quot;&apos;&quot;;
			   else
			   searchexpr = &quot;[Id] = &apos;&quot; + sFullfillmentOrdId + &quot;&apos;&quot;;
			   SetSearchExpr(searchexpr);
			   ExecuteQuery(ForwardOnly);
			   if(FirstRecord())
			   {
			   		sOrderType 		= GetFieldValue(&quot;Order Sub Type&quot;);
					sOrderFunction 	= GetFieldValue(&quot;VF Order Function&quot;);			   		
			   		
			   		
			   		with(bcLineItems)
				   {
					   SetViewMode(AllView);					               
					   ClearToQuery();
					   ActivateField(&quot;Id&quot;);
					   if(sFullfillmentOrdId == null || sFullfillmentOrdId == &quot;&quot;)
					   searchexpr = &quot;[Order Header Id] = &apos;&quot; + strOrderId + &quot;&apos; AND [Parent Order Item Id]  IS NULL&quot;;
					   else
					   searchexpr = &quot;[Order Header Id] = &apos;&quot; + sFullfillmentOrdId + &quot;&apos; AND [Parent Order Item Id]  IS NULL&quot;;
					   SetSearchExpr(searchexpr);
					   ExecuteQuery(ForwardOnly);
					   if(FirstRecord())
					   {
						   sOrderItemId = GetFieldValue(&quot;Id&quot;);						   
						 
					   }
				   }
				   
				   /*with(bcPrepayXM)//Suresh G - Commented for R19.4
					{
					   SetViewMode(AllView);					               
					   ClearToQuery();
					   ActivateField(&quot;Payment Order Id&quot;);
					   ActivateField(&quot;Service Order Id&quot;);
					   ActivateField(&quot;Fullfillment Order Id&quot;);
					   searchexpr = &quot;[Order Id] = &apos;&quot; + strOrderId + &quot;&apos;&quot;
					   SetSearchExpr(searchexpr);
					   ExecuteQuery(ForwardOnly);
					   if(FirstRecord())
					   {
							sPaymentOrdId = GetFieldValue(&quot;Payment Order Id&quot;);
							sServiceOrdId = GetFieldValue(&quot;Service Order Id&quot;);
							sPrepaymentsUpdSkip = &quot;Y&quot;;
							if(((sPaymentOrdId != strOrderId) || (sServiceOrdId != sOrderItemId))&amp;&amp; (sFullfillmentOrdId != &quot;&quot; &amp;&amp; sFullfillmentOrdId != null))//SureshG - Modified condtion for R19.4 SIT defect
							{
								SetFieldValue(&quot;Payment Order Id&quot;, sFullfillmentOrdId);
								SetFieldValue(&quot;Service Order Id&quot;, sOrderItemId);
								SetFieldValue(&quot;Fullfillment Order Id&quot;, sFullfillmentOrdId);
								 
								WriteRecord();
								
							}
							
							else
							{
								SetFieldValue(&quot;Payment Order Id&quot;, strOrderId);
								SetFieldValue(&quot;Service Order Id&quot;, sOrderItemId);
								WriteRecord();
							}
						
					   }
					   
				   }*/
			   }
		}//endwithboOrder
			
	Outputs.SetProperty(&quot;Order Sub Type&quot;, sOrderType);
	Outputs.SetProperty(&quot;VF Order Function&quot;, sOrderFunction);
	}	
		
	
	catch(e)
	{
		throw(e);
	}
	
	finally
	{
		sOrderItemId = &quot;&quot;;
		sPaymentOrdId = &quot;&quot;;
		strOrderId = &quot;&quot;;
		sFullfillmentOrdId = &quot;&quot;;
		boOrder = &quot;&quot;;
		bcOrder = &quot;&quot;;
		bcLineItems = &quot;&quot;;
		bcPrepayXM = &quot;&quot;;
		searchexpr = &quot;&quot;;
		boOrder1=&quot;&quot;;


	}
	

}"
