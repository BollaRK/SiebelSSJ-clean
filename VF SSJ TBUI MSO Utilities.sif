		var sCovType5Gnsa = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;SPL_RATE_LIST_TYPE&quot;,&quot;VFAUPostPayFWA5GNSA&quot;);

		var boOrd = TheApplication().GetBusObject(&quot;Order Entry&quot;);
		var bcOrd = boOrd.GetBusComp(&quot;Order Entry - Orders&quot;);
		var bcLineItems = boOrd.GetBusComp(&quot;Order Entry - Line Items (Simple)&quot;);

		var sServiceAddrLogin = &quot;&quot;;
		var sServiceAddrId =&quot;&quot;;
				
		var vCoverageSwitch = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_COV_TYPE&quot;,&quot;CoverageSwitch&quot;);	
		var vCoverageSwitchFWA = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_COV_TYPE&quot;,&quot;FWACoverageEnforcementSwitch&quot;);
		var FWAClosureSwitch = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_COV_TYPE&quot;,&quot;FWAClosureSwitch&quot;);
        
        var sTBUIFWA = GetFWAFlowName(sOrderId,bcOrd);//ADUTTA:FWA
