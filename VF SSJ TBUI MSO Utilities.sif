			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="FindMPPContractTerm"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function FindMPPContractTerm(LineIn,&amp;psCopyInputs)
{

	try
	{
		var sLineItemId = LineIn.GetProperty(&quot;LineItemId&quot;);
		var i = LineIn.GetProperty(&quot;Cursor&quot;);
		var sLineBC = TheApplication().GetBusObject(&quot;VF Order Entry Thin BO&quot;).GetBusComp(&quot;VF Order Line Items - Thin BC&quot;);
		var oQuoteItemBO = TheApplication().GetBusObject(&quot;Quote&quot;);
		var oQuoteItemBC = oQuoteItemBO.GetBusComp(&quot;Quote Item&quot;);
		var oQuoteItemAttrBC = oQuoteItemBO.GetBusComp(&quot;Quote Item XA&quot;);
		var sDeviceProduct=&quot;&quot;;
		var sRootQuoteItemId=&quot;&quot;;
		var sQuoteGPPTerm= psCopyInputs.GetChild(i).GetProperty(&quot;MPP Contract Months TBUI&quot;);
		var sField=&quot;&quot;;
        var isrec;
		
		with (sLineBC)
		{
			ClearToQuery();
			SetViewMode(AllView);
			ActivateField(&quot;VF Sales Calc Quote Item Id&quot;);
            SetSearchExpr(&quot;[Order Id] = &apos;&quot;+sOrderId+&quot;&apos; AND [Id] = &apos;&quot;+sLineItemId+&quot;&apos; AND [Parent Order Item Id] IS NULL AND [Action Code] &lt;&gt; &apos;Delete&apos;&quot;);
			ExecuteQuery(ForwardBackward);
			if(FirstRecord())
			{		
				sRootQuoteItemId = GetFieldValue(&quot;VF Sales Calc Quote Item Id&quot;);
			}
			
		}
		TheApplication().SetProfileAttr(&quot;sRootQuoteItemId&quot;, sRootQuoteItemId);
		if(sRootQuoteItemId != null &amp;&amp; sRootQuoteItemId != &quot;&quot;)
		{
			with(oQuoteItemBC)
			{
				ClearToQuery();									
				ActivateField(&quot;Product Id&quot;);	
				ActivateField(&quot;Promotion Operation Type&quot;);
				ActivateField(&quot;Product&quot;);			
				ActivateField(&quot;Note&quot;);
				ActivateField(&quot;Quote Id&quot;);
				ActivateField(&quot;Root Quote Item Id&quot;);		
				SetViewMode(AllView);
				//SetSearchSpec(&quot;Quote Id&quot;, sQuoteId);
				SetSearchSpec(&quot;Root Quote Item Id&quot;, sRootQuoteItemId);
				SetSearchSpec(&quot;Promotion Operation Type&quot;, &quot;Device&quot;);
				SetSearchSpec(&quot;Note&quot;, &quot;Add&quot;);			
				ExecuteQuery(ForwardOnly);			
				if (FirstRecord())
				{								
					sDeviceProduct = GetFieldValue(&quot;Product&quot;);						
					var sQuoteItemAttrIdAcc = GetFieldValue(&quot;Id&quot;);
					TheApplication().SetProfileAttr(&quot;OrderDevice&quot;, sDeviceProduct + sQuoteItemAttrIdAcc);
					with(oQuoteItemAttrBC)
					{
					ClearToQuery();
					SetViewMode(AllView);
					ActivateField(&quot;Name&quot;);
					ActivateField(&quot;Value&quot;);	
					ActivateField(&quot;Object Id&quot;);
					SetSearchSpec(&quot;Object Id&quot;,sQuoteItemAttrIdAcc);
					ExecuteQuery(ForwardOnly);
					var sRec = FirstRecord();			
						while(sRec)
						{	           
						   sField = GetFieldValue(&quot;Name&quot;);
						   
						   if(sField == &quot;Term&quot;)           
							 sQuoteGPPTerm = GetFieldValue(&quot;Value&quot;);				
						   sRec = NextRecord();
						} 
					}
					TheApplication().SetProfileAttr(&quot;DevicecumTerm&quot;, sDeviceProduct + sQuoteGPPTerm);
				}				
			}
		}
		psCopyInputs.GetChild(i).SetProperty(&quot;MPP Contract Months TBUI&quot;, sQuoteGPPTerm);
		
	}
	catch (e)
	{
		throw e;
	}
	finally
	{
		sLineBC = null;
		oQuoteItemBC = null; 
		oQuoteItemAttrBC = null;
		oQuoteItemBO = null;
	}
}"
			   SEQUENCE="19"
			   UPDATED="01/09/2026 15:43:16"
			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 15:43:16"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="GetAssetDetails"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function GetAssetDetails(OrderId,ReturnOuts)
{

  try {
	var OrderBO = TheApplication().GetBusObject(&quot;VF Order Header&quot;);
	var OrderBC = OrderBO.GetBusComp(&quot;VF Order Header&quot;);
	var OrderLineBC = OrderBO.GetBusComp(&quot;VF Order Line Items - Simple&quot;);
	
	var APPProductType = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;PRODUCT_TYPE&quot;, &quot;Billing - APP&quot;);
	var GPPProductType = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;PRODUCT_TYPE&quot;,&quot;Billing - GPP&quot;);
	var sSearchStr = &quot;[Product Type] = &apos;&quot;+APPProductType+&quot;&apos; OR [Product Type] = &apos;&quot;+GPPProductType+&quot;&apos;&quot;;
	
	var ServiceOrderId = &quot;&quot;;
	var OrderNumber = &quot;&quot;;
	with(OrderBC)
	{
		ClearToQuery();
		ActivateField(&quot;Order Number&quot;);
		SetSearchSpec(&quot;Id&quot;,OrderId);
		ExecuteQuery();
		if(FirstRecord())
		{
			OrderNumber = GetFieldValue(&quot;Order Number&quot;);
			with(OrderLineBC)
			{
				ClearToQuery();
				ActivateField(&quot;Parent Order Item Id&quot;);
				SetSearchSpec(&quot;Parent Order Item Id&quot;,&quot;IS NULL&quot;);
				ExecuteQuery(ForwardOnly);
				if(FirstRecord())
				{
					ServiceOrderId = GetFieldValue(&quot;Id&quot;);	
				}
				
				ReturnOuts.SetProperty(&quot;ServiceOrderId&quot;,ServiceOrderId);
				ReturnOuts.SetProperty(&quot;OrderNumber&quot;,OrderNumber);
				ClearToQuery();
				ActivateField(&quot;Product Type&quot;);
				ActivateField(&quot;Custom Asset Integration Id&quot;);
				//SetSearchSpec(&quot;Product Type&quot;,APPProductType);
				SetSearchExpr(sSearchStr);
				ExecuteQuery(ForwardOnly);
				var isRec = FirstRecord();
				while(isRec)
				{
					//For each APP Line item set the property sets as below. Custom Asset Integration Id of the
					//From Order would match the APP ID of the APP record in the Accessories record.
					//Each property below would be named after the Custom Asset Integration Id and in the mPerformAOATasks
					//GetProperty of APPID would give the new APP Id to be set.	
					ReturnOuts.SetProperty(GetFieldValue(&quot;Custom Asset Integration Id&quot;),GetFieldValue(&quot;Id&quot;));
					isRec = OrderLineBC.NextRecord();
				}
			}			
		}
	}
	}
	catch (e)
	{
		throw e;
	}
	finally
	{
  /*Below variables are nullified by Sharukh on 18/03/2019*/
	OrderBC = null;
	OrderLineBC = null;
	OrderBO = null;
	
	}
}"
