			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCallSubmitOrderPrepayments"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCallSubmitOrderPrepayments(Inputs,Outputs)
{

try
	{
		/* Component Name        : 	TBUI - mSubmitOrder
		* Component Information : 	This method is to validate whether the &quot;MPP Product&quot; is added to an order
		* Modification History  :
		* Date			Author		Config #	Description
		* ============ ===========	===========	================================
		* 14/07/2014	Tariq 		Initial Draft Version - Cloned from VF Wizard Utilities with necessary changes to remove Wizard BO reference
		*/
		var strError = &quot;&quot;;
		var strFulfillmentOrderId = Inputs.GetProperty(&quot;FulfillmentOrderId&quot;);
		var strOrderId = Inputs.GetProperty(&quot;Order Id&quot;);
		var sStockIndicator = Inputs.GetProperty(&quot;StockIndicator&quot;);//TARIQ-26SEP2014-Added for MSO
		var sSubmitConnectOrder = &quot;Y&quot;;//TARIQ-26SEP2014-Added for MSO
		var sInStockFlag = Inputs.GetProperty(&quot;InStockFlag&quot;);
		var boOrder, bcOrder, bcLineItems;
		var bcPrepaymentsXM = &quot;&quot;;
		var strShipmentId = &quot;&quot;;
		var sParentOrderItemId = &quot;&quot;;
		var sFbbwmbb = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_FBB_PROPOSITION_TYPE&quot;, &quot;FBB with MBB&quot;);
		var sFbbonly = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_FBB_PROPOSITION_TYPE&quot;, &quot;FBB Only&quot;);
		var stockInd = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_ORDER_STOCK_INDICATOR&quot;, &quot;Out of Stock - Connect Later&quot;);
		var sProdType = &quot;&quot;;
		var searchexpr = &quot;&quot;;
		var sOnHoldOS = &quot;N&quot;;
		var sOrdFunction  = &quot;&quot;;
		var sOrdType = &quot;&quot;;
		var sId = &quot;&quot;;
		var sFlow = &quot;&quot;;
		var psInputs = TheApplication().NewPropertySet();
		var psOutputs = TheApplication().NewPropertySet();
		TheApplication().SetProfileAttr(&quot;OnHoldOS&quot;, sOnHoldOS);
		var bsWFProcManager = TheApplication().GetService (&quot;Workflow Process Manager&quot;);
		var sOrdInput 	= TheApplication().NewPropertySet();				
		var sOrdOutput = TheApplication().NewPropertySet();
		var strProcessName = &quot;VHA OM Submit Order Framework&quot;;
		var strWorkflowProcessError = &quot;&quot;;
		
		
		if (sInStockFlag == &quot;N&quot; &amp;&amp; strFulfillmentOrderId != &quot;&quot; &amp;&amp; sStockIndicator == TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_WIZ_CON_STOCK_INDICATOR&quot;, &quot;Out of Stock - Connect Later&quot;))
		{
			sSubmitConnectOrder = &quot;N&quot;;
		}
		
		//VHA Balamurugan 01/07/2020 : Added for PKE000000080834
		if(strOrderId != null &amp;&amp; strOrderId != &quot;&quot;)
		{
			var ErrMSG = mCheckFulfilmentOrderStatus(strOrderId);
			if(ErrMSG != null &amp;&amp; ErrMSG!= &quot;&quot;)
			{
			 throw(ErrMSG);
			}
		}//Ends here

		// Then submit the connection order
		Inputs.SetProperty(&quot;Order Id&quot;, strOrderId);
		Inputs.SetProperty(&quot;Calculate Charges&quot;, &quot;N&quot;);
		sOrderId = strOrderId;
		UpdateLineItems(&quot;YES&quot;);
		TheApplication().SetProfileAttr(&quot;121&quot;, sInStockFlag+ &quot; &quot; +sSubmitConnectOrder+ &quot; &quot;+sStockIndicator+&quot; &quot;+strFulfillmentOrderId);
		if (sSubmitConnectOrder == &quot;Y&quot;)
		{
			// Then submit the connection order
					
			boOrder = TheApplication().GetBusObject(&quot;VF Order Entry Thin BO&quot;);
			//bcOrder = boOrder.GetBusComp(&quot;VF Order Entry - Orders Thin BC&quot;);
			bcLineItems = boOrder.GetBusComp(&quot;VHA Order Entry - Line Items Thin&quot;);
			//bcPrepaymentsXM = boOrder.GetBusComp(&quot;VHA Prepayment Account XM&quot;);
			
			with(bcLineItems)
					        {
					               SetViewMode(AllView);					               
					               ClearToQuery();
								   searchexpr = &quot;[Order Header Id] = &apos;&quot; + strOrderId + &quot;&apos; AND [Parent Order Item Id]  IS NULL AND [VF Stock Indicator TBUI] = &apos;&quot; + stockInd + &quot;&apos; AND ([Siebel Product Type] = &apos;&quot; + sFbbwmbb + &quot;&apos; OR [Siebel Product Type] = &apos;&quot; + sFbbonly +&quot;&apos;)&quot;;
								   SetSearchExpr(searchexpr);
					               ExecuteQuery(ForwardOnly);
					               if(FirstRecord())
								   {
									   sOnHoldOS = &quot;Y&quot;;
								   }
							}
	
			psInputs.SetProperty(&quot;Order Id&quot;, strOrderId);
			psInputs.SetProperty(&quot;Fullfillment Order Id&quot;, &quot;&quot;);
			mPrepaymentsOrderUpdate(psInputs,psOutputs);
				
			TheApplication().SetProfileAttr(&quot;OnHoldOS&quot;, sOnHoldOS);
			
			sOrdType = psOutputs.GetProperty(&quot;Order Sub Type&quot;);
			sOrdFunction = psOutputs.GetProperty(&quot;VF Order Function&quot;);		
			//mSubmitOrder(Inputs);
			if (sOrdType == &quot;Fulfilment&quot;)
            {
              if(sOrdFunction == &quot;Acquisition&quot;)
                              sFlow = &quot;TBUI Connect&quot;;
               else
                              sFlow = &quot;TBUI Upgrade&quot;;
            }
            
            sOrdInput.SetProperty(&quot;Object Id&quot;, strOrderId);			 
			sOrdInput.SetProperty(&quot;RowId&quot;, strOrderId);		
			sOrdInput.SetProperty(&quot;Process Flow&quot;, sFlow);
			sOrdInput.SetProperty(&quot;PreValidate Flag&quot;, &quot;Y&quot;);
			sOrdInput.SetProperty(&quot;OrderValidate Flag&quot;, &quot;N&quot;);
			sOrdInput.SetProperty(&quot;PostValidate Flag&quot;, &quot;Y&quot;);
			sOrdInput.SetProperty(&quot;PreSubmit Flag&quot;, &quot;Y&quot;);
			sOrdInput.SetProperty(&quot;VF Calculate Charges&quot;, &quot;N&quot;);												 
			sOrdInput.SetProperty(&quot;ProcessName&quot;, strProcessName);
			bsWFProcManager.InvokeMethod(&quot;RunProcess&quot;, sOrdInput, sOrdOutput);
			strWorkflowProcessError = sOrdOutput.GetProperty(&quot;DisplayMessage&quot;);
            if (strWorkflowProcessError != &quot;&quot;)
                          TheApplication().RaiseErrorText(strWorkflowProcessError);

		}
		if (strFulfillmentOrderId != &quot;&quot;)
		{
			
			
			TheApplication().SetProfileAttr(&quot;VHA_TBUI_CONNECT_ORDER_ID&quot;,strOrderId); //Thulsi 30/10/2015 - R16.1 MSOD						
			
	
							
			psInputs.SetProperty(&quot;Order Id&quot;, strOrderId);
			psInputs.SetProperty(&quot;Fullfillment Order Id&quot;, strFulfillmentOrderId);
			if(sPrepaymentsUpdSkip == &quot;N&quot;)
   			{
   			mPrepaymentsOrderUpdate(psInputs,psOutputs);
  			}
			
							
			Inputs.SetProperty(&quot;Order Id&quot;, strFulfillmentOrderId);
			Inputs.SetProperty(&quot;Calculate Charges&quot;, &quot;N&quot;);
			
			sOrdType = psOutputs.GetProperty(&quot;Order Sub Type&quot;);
			sOrdFunction = psOutputs.GetProperty(&quot;VF Order Function&quot;);
			//mSubmitOrder(Inputs);
			if (sOrdType == &quot;Fulfilment&quot;)
            {
              if(sOrdFunction == &quot;Acquisition&quot;)
                              sFlow = &quot;TBUI Connect&quot;;
               else
                              sFlow = &quot;TBUI Upgrade&quot;;
            }
			
			sOrdInput.SetProperty(&quot;Object Id&quot;, strFulfillmentOrderId);			 
			//sOrdInput.SetProperty(&quot;Parent Order Id&quot;, strOrderId);			
			sOrdInput.SetProperty(&quot;Process Flow&quot;, sFlow);
			sOrdInput.SetProperty(&quot;PreValidate Flag&quot;, &quot;Y&quot;);
			sOrdInput.SetProperty(&quot;OrderValidate Flag&quot;, &quot;N&quot;);
			sOrdInput.SetProperty(&quot;PostValidate Flag&quot;, &quot;Y&quot;);
			sOrdInput.SetProperty(&quot;PreSubmit Flag&quot;, &quot;Y&quot;);
			sOrdInput.SetProperty(&quot;VF Calculate Charges&quot;, &quot;N&quot;);													 
			sOrdInput.SetProperty(&quot;ProcessName&quot;, strProcessName);
			bsWFProcManager.InvokeMethod(&quot;RunProcess&quot;, sOrdInput, sOrdOutput);
			strWorkflowProcessError = sOrdOutput.GetProperty(&quot;DisplayMessage&quot;);
            if (strWorkflowProcessError != &quot;&quot;)
                          TheApplication().RaiseErrorText(strWorkflowProcessError);
            }
					
	}
	catch(e)
	{
		//throw(e);
		if (defined(e.errText))
		{
			strError = e.errText; 
		}
		else
		{
			strError = ToString(e); 
		}
		 
		throw (strError);
	}
	finally
	{
		//Rinu - 04/07/2016 - commented below code for Sharing
		//bsProductModellingService = psInputs = psOutputs = null;
	}

}"
			   SEQUENCE="44"
			   UPDATED="01/09/2026 15:43:17"
			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 15:43:17"
			   CREATED_BY="SADMIN">
			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCheckAPPTerm"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mCheckAPPTerm (Inputs, Outputs)
{
try
	{
		var ERROR_CODE = &quot;95123&quot;;
		var ECODE = &quot;95156&quot;;
		var sErrorMsg = &quot;&quot;, j=0, isRecord;
		var orderId = Inputs.GetProperty(&quot;OrderId&quot;);
		var aAccId = Inputs.GetProperty(&quot;CustId&quot;);//SBBAU-Visa:proj
		var TrType = Inputs.GetProperty(&quot;TransactionType&quot;);//ANGANA:Project VISA
		var App = Inputs.GetProperty(&quot;GotoAPP&quot;);//ANGANA Visa Expiry Project
		var VisaExpiryResp = Inputs.GetProperty(&quot;VisaSkipResp&quot;);//ANGANA:Project VISA
		var sTerm = &quot;&quot;;//ANGANA Visa Expiry Project
		var boOrder = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
		var bcOrder = boOrder.GetBusComp(&quot;Order Entry - Line Items&quot;);
		var bcAccessories = boOrder.GetBusComp(&quot;VHA APP Accessory TBUI BC&quot;);
		//var sAPPProd =  TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_APP_PRODUCT&quot;,&quot;APP&quot;);
		var MSISDN = new Array();
		var TermNotFound = false;
		with (bcOrder)
		{
			ClearToQuery();
			ActivateField(&quot;Parent Order Item Id&quot;);
			SetViewMode(AllView);
			SetSearchSpec(&quot;Order Header Id&quot;, orderId);
			//YP Added this additional Serch Spec as only the Root needs to the searched. Line is between Root and APP
			SetSearchSpec(&quot;Parent Order Item Id&quot;, &quot;IS NULL&quot;);
			ExecuteQuery(ForwardOnly);
			var iRec = FirstRecord();
			while (iRec)
			{
				with (bcAccessories)
				{
					SetViewMode(AllView);
					ClearToQuery();
					ActivateField(&quot;Contract Term&quot;);
					ActivateField(&quot;VHA Manage APP Contract Term&quot;);				
					ActivateField(&quot;MSISDN&quot;);
					//SetSearchExpr(&quot;[Contract Term] is null or [Contract Term]=&apos;&apos;&quot;);
					SetSearchExpr(&quot;[VHA Manage APP Contract Term] is null or [VHA Manage APP Contract Term]=&apos;&apos;&quot;);
					ExecuteQuery();
					isRecord = FirstRecord();
					if(isRecord)
					{
						MSISDN [j] = GetFieldValue(&quot;MSISDN&quot;);
						j++;
						TermNotFound = true;
					}
				}

				iRec=NextRecord();
			}
		}
	var err = MSISDN .join(&quot;,&quot;);
	if(err  !=&quot;&quot;){
		sErrorMsg = &quot;VFErrorCode#&quot;+ERROR_CODE+ &quot; &quot; + TheApplication().LookupMessage(&quot;User Defined Errors&quot;, ERROR_CODE) + &quot; &quot; +err+&quot;. &quot;+ TheApplication().LookupMessage(&quot;User Defined Errors&quot;, ECODE);
		//sErrorMsg=&quot;Please Select Term for &quot;+err;
	}else if(TermNotFound){//YP added this for case where MSISDN is not set on the APP record
		sErrorMsg = &quot;VFErrorCode#&quot;+ERROR_CODE+ &quot; &quot; + TheApplication().LookupMessage(&quot;User Defined Errors&quot;, ERROR_CODE);
	}
	//Proj:Visa Changes-03April2023-Start
	if(VisaExpiryResp != &quot;Y&quot;)
	{	
		with (bcOrder)
        {
            ClearToQuery();
            ActivateField(&quot;Parent Order Item Id&quot;);
            SetViewMode(AllView);
            SetSearchSpec(&quot;Order Header Id&quot;, orderId);
            SetSearchSpec(&quot;Parent Order Item Id&quot;, &quot;IS NULL&quot;);
            ExecuteQuery(ForwardOnly);
            var iRec = FirstRecord();
            while (iRec)
            {
                with (bcAccessories)
                {
                    SetViewMode(AllView);
                    ClearToQuery();
                    ActivateField(&quot;Contract Term&quot;);
                    ActivateField(&quot;VHA Manage APP Contract Term&quot;);
                    TheApplication().SetProfileAttr(&quot;Term1&quot;,&quot;Term1&quot;);                                                        
                    SetSearchExpr(&quot;[Contract Term] IS NOT NULL&quot;);
                    ExecuteQuery();
                    isRecord = FirstRecord();
                    if(isRecord)
                    {                        
                        sTerm = GetFieldValue(&quot;Contract Term&quot;);
                    }
                }
                iRec=NextRecord();
            }
        }			
		var psIn = TheApplication().NewPropertySet();			
		var psOut = TheApplication().NewPropertySet();
		var sBS = TheApplication().GetService(&quot;VHA Store Pickup Reservation Service&quot;);			
		psIn.SetProperty(&quot;Term&quot;,sTerm);	
		psIn.SetProperty(&quot;Order Id&quot;,orderId);								
		psIn.SetProperty(&quot;CustId&quot;,aAccId);
        psIn.SetProperty(&quot;TransactionType&quot;,TrType);
		psIn.SetProperty(&quot;GotoAPP&quot;,App);
		sBS.InvokeMethod(&quot;GetVisaExpiryDate&quot;,psIn,psOut);				
		sErrorMsg = psOut.GetProperty(&quot;Error Message&quot;);																
	}
	//Proj:Visa Changes-03April2023-Start
	Outputs.SetProperty(&quot;ErrorMsg&quot;,sErrorMsg);
}
catch(e)
{
	TheApplication().RaiseErrorText(e);
}
finally
{
	bcAccessories = null;
	bcOrder = null;
	boOrder = null;
}
}"
