			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="CreateFulfilmentOrder"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function CreateFulfilmentOrder()
{
	try
	{
		var boOrder = TheApplication().GetBusObject(&quot;Order Entry (Sales)&quot;);
		var bcOrder = boOrder.GetBusComp(&quot;Order Entry - Orders&quot;);
		var bcFulfilItems = boOrder.GetBusComp(&quot;VF Fulfilment Items&quot;);
		var isRecord = false;
		with (bcOrder)
		{
			ClearToQuery();
			SetViewMode(AllView);
			SetSearchSpec(&quot;Id&quot;, sOrderId);
			ExecuteQuery(ForwardOnly);
			if (FirstRecord())
			{
				with (bcFulfilItems)
				{
					ClearToQuery();
					SetViewMode(AllView);
					//SetSearchExpr(SearchString);
					ExecuteQuery();
					if(FirstRecord())
					{
						TheApplication().SetProfileAttr(&quot;CreateFulfilOrderTBUI&quot;,&quot;YES&quot;);
						InvokeMethod(&quot;CreateFulfilOrder&quot;);
					}
				}
			}
		}
	}
	catch(e)
	{
		throw e;
	}
	finally
	{
		TheApplication().SetProfileAttr(&quot;CreateFulfilOrderTBUI&quot;,&quot;&quot;);
		bcFulfilItems = null;
		bcOrder = null;
		boOrder = null;
	}
}"
