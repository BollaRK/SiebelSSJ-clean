			</BUSINESS_SERVICE_SERVER_SCRIPT>
			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mMPPAddBSCall"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mMPPAddBSCall(i, &amp;psCopyInputs)
{
	/*
	* Component Name        : 	mMPPAddBSCall
	* Method Name           : 	
	* Component Information : 	
	*
	* Modification History  :
	* Date			Author		Config #	Description
	* ============ ===========	===========	================================
	* 18/09/2014	Balaji					Initial version
	*/
try
	{
	
	var sConnType = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VF_SERVICE_STOCK_TBUI&quot;,&quot;Plan and Device&quot;);
	var sConnectionType = psCopyInputs.GetChild(i).GetProperty(&quot;Connection Type&quot;);
	var sRCC = psCopyInputs.GetChild(i).GetProperty(&quot;MPP RCC F&quot;);
		
	
	//if(sConnectionType == sConnType)
	if(ToNumber(sRCC) &gt; 0)
		{
		var sLineItemId = psCopyInputs.GetChild(i).GetProperty(&quot;Order Line Id&quot;); //&quot;Order Item Id&quot;);
		var bsService = TheApplication().GetService(&quot;VF Generic Product Manipulation Service&quot;);
		var bsInputs = TheApplication().NewPropertySet();
		var bsOutputs = TheApplication().NewPropertySet();
		var sMPPContAmt = psCopyInputs.GetChild(i).GetProperty(&quot;MPP Contract Amount&quot;);
		var sSmartscrtaction = psCopyInputs.GetChild(i).GetProperty(&quot;MPP Contract Amount&quot;);
		var sMPPOrderAction = psCopyInputs.GetChild(i).GetProperty(&quot;MPP Contract Amount&quot;);
		//var sMPPContId = psCopyInputs.GetChild(i).GetProperty(&quot;MPP Contract Id&quot;);
		
		var sMPPContId = mGetMPPContId(sLineItemId);
		//var sMPPContId = psCopyInputs.GetChild(i).GetProperty(&quot;MPPContId&quot;);		
		//if upfront equal to rcc donot allow create mpp
		
		var sUpfrtamt = psCopyInputs.GetChild(i).GetProperty(&quot;MPP Pay To Dealer&quot;);
		//VHA Muthushankari - 14/6/2019 Commented below if condition as part of R19.3 Prepayments
		/*if (sUpfrtamt != sRCC) // Will be zero when Upfront equal to RCC
			{*/
			//Set Inputs
			
			bsInputs.SetProperty(&quot;Accept Code&quot;, psCopyInputs.GetChild(i).GetProperty(&quot;Credit Check Accept Code&quot;));
			
			bsInputs.SetProperty(&quot;Dealer Code&quot;, psCopyInputs.GetChild(i).GetProperty(&quot;Dealer Code&quot;));
			//bsInputs.SetProperty(&quot;Device Name&quot;, psCopyInputs.GetChild(i).GetProperty(&quot;Device Description&quot;));
			bsInputs.SetProperty(&quot;EMR&quot;, psCopyInputs.GetChild(i).GetProperty(&quot;MPP Estimated Monthly Amt&quot;));
			bsInputs.SetProperty(&quot;IMEI&quot;, psCopyInputs.GetChild(i).GetProperty(&quot;IMEI for Connection&quot;));
			bsInputs.SetProperty(&quot;IMEI Flag&quot;, psCopyInputs.GetChild(i).GetProperty(&quot;MPP IMEI Flag&quot;));
			bsInputs.SetProperty(&quot;MPP Product Name&quot;, psCopyInputs.GetChild(i).GetProperty(&quot;MPP Product Name&quot;));
			bsInputs.SetProperty(&quot;Order Id&quot;, sOrderId); // Get from task
			bsInputs.SetProperty(&quot;Period&quot;, psCopyInputs.GetChild(i).GetProperty(&quot;VF MPP Contract Months TBUI&quot;));
			bsInputs.SetProperty(&quot;Product Code&quot;, psCopyInputs.GetChild(i).GetProperty(&quot;Proposition Id&quot;));
			bsInputs.SetProperty(&quot;RCC&quot;, psCopyInputs.GetChild(i).GetProperty(&quot;MPP RCC F&quot;));
			bsInputs.SetProperty(&quot;Root Line Item Id&quot;, psCopyInputs.GetChild(i).GetProperty(&quot;Order Line Id&quot;));
			bsInputs.SetProperty(&quot;Transferred Balance&quot;, psCopyInputs.GetChild(i).GetProperty(&quot;MPP Transfer Balance&quot;));
			bsInputs.SetProperty(&quot;Contract Amount&quot;, psCopyInputs.GetChild(i).GetProperty(&quot;MPP Contract Amount&quot;));			
			bsInputs.SetProperty(&quot;Order Item Id&quot;, sMPPContId);
			bsInputs.SetProperty(&quot;Device Code&quot;, psCopyInputs.GetChild(i).GetProperty(&quot;Device Code&quot;));
			bsInputs.SetProperty(&quot;Device Name&quot;, psCopyInputs.GetChild(i).GetProperty(&quot;Device Name&quot;));
			//bsInputs.SetProperty(&quot;Order Item Id&quot;, psCopyInputs.GetChild(i).GetProperty(&quot;MPPContId&quot;));
//			bsInputs.SetProperty(&quot;Order Item Id&quot;, psCopyInputs.GetChild(i).GetProperty(&quot;MPP Contract Id&quot;));
			bsInputs.SetProperty(&quot;Due Date&quot;,&quot;&quot;);
		
			if(ToNumber(psCopyInputs.GetChild(i).GetProperty(&quot;MPP Pay To Dealer&quot;)) &gt; 0)
			{
			bsInputs.SetProperty(&quot;Upfront Payment Amount&quot;, psCopyInputs.GetChild(i).GetProperty(&quot;MPP Pay To Dealer&quot;));
			bsInputs.SetProperty(&quot;Additional Info&quot;,mGetPrepaymentOption(sOrderId));//VHA Muthushankari - 4/6/2019 - Added for R19.3 Prepayments
			}
			else if(ToNumber(psCopyInputs.GetChild(i).GetProperty(&quot;MPP Pay To Dealer&quot;)) == 0)
			{
				bsInputs.SetProperty(&quot;Upfront Payment Amount&quot;, &quot;&quot;);	
				bsInputs.SetProperty(&quot;Additional Info&quot;, &quot;&quot;);
			}
			
			if (sMPPContId != &quot;&quot; &amp;&amp; sMPPContId != null) //(sSmartscrtaction == &quot;EXIST&quot; &amp;&amp; sMPPOrderAction == &quot;ADD&quot;)//
				{	
				//Call Delete MPP and then Create MPP // if already MPP exists
				
				mDeleteMPPLineItem(bsInputs);
				//bsService.InvokeMethod(&quot;Delete MPP Contract&quot;, bsInputs, bsOutputs);
				bsOutputs.Reset();
				bsService.InvokeMethod(&quot;Add MPP Products&quot;, bsInputs, bsOutputs);
				sMPPContId = bsOutputs.GetProperty(&quot;MPPLineId&quot;);
				
				}
			else 
				{
				// Call Create MPP	
				
				bsService.InvokeMethod(&quot;Add MPP Products&quot;, bsInputs, bsOutputs);
				sMPPContId = bsOutputs.GetProperty(&quot;MPPLineId&quot;);
				
				}
			psCopyInputs.GetChild(i).SetProperty(&quot;VF Upfront Payment&quot;, &quot;&quot;);	
			psCopyInputs.GetChild(i).SetProperty(&quot;VF MPP Altered&quot;, &quot;0&quot;);
			psCopyInputs.GetChild(i).SetProperty(&quot;MPP Contract Id&quot;, sMPPContId);
			/*}
		else // Upfrt != RCC else
			{
			/* Changes start for PKE 23437
			* 5/08/2015 - Subramanian: For PKE 23437, Upfront == RCC for In Stock orders error obtained. 
			* Global variable PaymentOptions need to be set like in Native flow
			*/
			//TheApplication().SetSharedGlobal(&quot;PaymentOptions&quot;, sOrderId+&quot;Y&quot;);
			/* Changes End for PKE 23437 */
			/*psCopyInputs.GetChild(i).SetProperty(&quot;VF Upfront Payment&quot;, sUpfrtamt);
			psCopyInputs.GetChild(i).SetProperty(&quot;VF MPP Altered&quot;, &quot;0&quot;);
			}*/
		}
	else
		{			
		// Skip else Connection Type
		}
	}
catch (e)
	{
		throw e;
	}
finally
	{

	/*Below variables are nullified by Sharukh on 18/03/2019*/
	//bsService = null;
	if(defined(bsService)) { bsService = null; }/*This variable is nullified by GURUPRASAD on 03/10/2019*/
	bsInputs = null;
	bsOutputs = null;
		
	}
}"
