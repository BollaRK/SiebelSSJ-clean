			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mMPPAdd"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mMPPAdd(Inputs)
{
	/*
	* Component Name        : 	mMPPAdd
	* Method Name           : 	
	* Component Information : 	
	*
	* Modification History  :
	* Date			Author		Config #	Description
	* ============ ===========	===========	================================
	* 09/09/2014	Balaji					Initial version
	*/
try
	{
	
	var iNoOfServices = 0;
	var psCopyInputs = TheApplication().NewPropertySet();
	var sMPPCreated = Inputs.GetProperty(&quot;MPPCreated&quot;);
	var bsEAIService = TheApplication().GetService(&quot;EAI Siebel Adapter&quot;);
	var psLineInputs = TheApplication().NewPropertySet();
	var psLineOutputs = TheApplication().NewPropertySet();
	psLineInputs.SetProperty(&quot;SearchSpec&quot;,&quot;[VF MPP Order Smartscript Support - TBUI.Order Id] = &apos;&quot; + sOrderId + &quot;&apos;&quot;);
	psLineInputs.SetProperty(&quot;OutputIntObjectName&quot;, &quot;VF MPP Order Task Support&quot;);
	bsEAIService.InvokeMethod(&quot;Query&quot;, psLineInputs, psLineOutputs);	
	psCopyInputs = psLineOutputs.GetChild(0).GetChild(0).Copy();	
	iNoOfServices = psCopyInputs.GetChildCount();

	
	
	if (iNoOfServices &lt; 1)
		{
		TheApplication().RaiseErrorText(&quot;No Line Item added for this Order&quot;);
		}	
	//Loop Line Item to Add MPP
	for (var i=0; i &lt; iNoOfServices; i++)
		{
		var sAltered = psCopyInputs.GetChild(i).GetProperty(&quot;VF MPP Altered&quot;);
		if(sMPPCreated == &quot;Y&quot;)
			{
			if(sAltered == &quot;1&quot;) // Only if upfront amount is altered Add MPP will trigger (ie) back from order summary and changing the upfront
				{				
				mMPPAddBSCall(i, psCopyInputs);
				}
			}
		else // First time by default Add MPP will trigger for all line items
			{
				mMPPAddBSCall(i, psCopyInputs);
			}		
		}		
		// Update the &quot;VF Upfront Payment&quot; value in Line item BC
		var sOutIO = &quot;VF Order Item Task Insert&quot;;
		var sMap = &quot;VF MPP Task Line Item Update&quot;;
		mMPPBCUpsert(psCopyInputs, psLineOutputs, sOutIO, sMap);
		
		// Update the &quot;VF MPP Altered&quot; value in MPP BC
		sOutIO = &quot;VF MPP Order Task Support&quot;;
		sMap = &quot;VF MPP Update Order Task Support&quot;;
		mMPPBCUpsert(psCopyInputs, psLineOutputs, sOutIO, sMap);
		
		// Update the &quot;MPP Contract Id&quot; value in Task Validation BC
		sOutIO = &quot;VF Task Validation&quot;;
		sMap = &quot;VF MPP Update Task Validation&quot;;
		mMPPBCUpsert(psCopyInputs, psLineOutputs, sOutIO, sMap);
	}
catch (e)
	{
		throw e;
	}
finally
	{
	/*Below variables are nullified by Sharukh on 18/03/2019*/
	psCopyInputs = null;
	bsEAIService = null;
	psLineInputs = null;
	psLineOutputs = null;
		
	}
}"
			   SEQUENCE="86"
