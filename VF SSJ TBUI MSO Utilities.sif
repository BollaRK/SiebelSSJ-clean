			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mMPPMandatory"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function mMPPMandatory(strMandateTerm, strMandateAmount, &amp;psOut, strMandateMPPRespExists)
{
	/*
	* Component Name        : 	mMPPMandatory
	* Method Name           : 	
	* Component Information : 	
	*
	* Modification History  :
	* Date			Author		Config #	Description
	* ============ ===========	===========	================================
	* 07/09/2014	Balaji					Initial version
	*/
try
	{
	
	//TARIQ-25NOV2014-Moved the following code to mMPPEvaluate to be executed only once
	/*var strResponsibility = &quot;VF Function Access - Mandatory MPP Override&quot;;
	var strMandateMPPRespExists = mMPPCheckResponsibility(strResponsibility);
	TheApplication().SetProfileAttr(&quot;usrMandateMPPRespExists&quot;, strMandateMPPRespExists);*/
	if (strMandateAmount == &quot;&quot; || strMandateAmount == null) 
		{
		psOut.SetProperty(&quot;Mandate&quot;, &quot;N&quot;);
		} 
	else if (strMandateMPPRespExists == &quot;Y&quot;) 
		{
		psOut.SetProperty(&quot;Mandate&quot;, &quot;N&quot;);
		}
	else
		{}
				
}
catch (e) {
		throw(e);
	}

	finally {

	}
}"
