			<BUSINESS_SERVICE_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mAddAttribs"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/* Component Name        : 	mAddAttribs
* Component Information : 	Triggered from mAppendAttribs
*
* Modification History  :
* Date			Author		Config #	Description
* ============ ===========	===========	================================
* 26/10/2015	Thulsi 		Initial Draft Version  
*/
function mAddAttribs(sType, &amp;psListOfLineItemAttr,bcGeneric,sPropCode)
{	
try
{
	var sSetType;
	var psAttributes = TheApplication().NewPropertySet();	
	if (sType ==&quot;Root&quot;)
	{
		var sFBBwithMBB = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_FBB_PROPOSITION_TYPE&quot;,&quot;FBB with MBB&quot;);
		var sFBBOnly = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VHA_FBB_PROPOSITION_TYPE&quot;,&quot;FBB Only&quot;);
		
		psAttributes.SetProperty(&quot;Related Service Order Plan Name&quot;,		bcGeneric.GetFieldValue(&quot;Product&quot;));
		psAttributes.SetProperty(&quot;Call Barring PIN&quot;,			&quot;&quot;);
		/*if(bcGeneric.GetFieldValue(&quot;VF Root Siebel Prod Type&quot;) == sFBBwithMBB || bcGeneric.GetFieldValue(&quot;VF Root Siebel Prod Type&quot;) == sFBBOnly)
		{
			psAttributes.SetProperty(&quot;Proposition Code&quot;,			&quot;VFAUPostPayNBNwithMBB&quot;);
		}
		else
		{
			psAttributes.SetProperty(&quot;Proposition Code&quot;,			&quot;VFAUPostPayVoice&quot;);
		}*/
		psAttributes.SetProperty(&quot;Proposition Code&quot;,sPropCode); //Changed for kogan defect 138
		psAttributes.SetProperty(&quot;Initialised&quot;,					&quot;No&quot;);
		psAttributes.SetProperty(&quot;RestrictedAccessEnabled&quot;,		&quot;No&quot;);
		sSetType = &quot;OrderHeaderItemXa&quot;;
	}
	else if (sType == &quot;Device&quot;) 
	{
		psAttributes.SetProperty(&quot;Device Code&quot;,					bcGeneric.GetFieldValue(&quot;Hardware Code&quot;));
		psAttributes.SetProperty(&quot;Device Name&quot;,					bcGeneric.GetFieldValue(&quot;Hardware Name&quot;));
		psAttributes.SetProperty(&quot;Device Price Exc GST&quot;,		&quot;$0.00&quot;);
		psAttributes.SetProperty(&quot;Device Price Inc GST&quot;,		&quot;$0.00&quot;);
		psAttributes.SetProperty(&quot;Device RCC Exc GST&quot;,			&quot;$0.00&quot;);
		psAttributes.SetProperty(&quot;Device RCC Inc GST&quot;,			&quot;$0.00&quot;);	
		sSetType = &quot;OrderItemXa&quot;;
	}
	else if (sType == &quot;Accessory&quot;) 
	{
		psAttributes.SetProperty(&quot;Accessory Code&quot;,				bcGeneric.GetFieldValue(&quot;Accessory Code&quot;));
		psAttributes.SetProperty(&quot;Accessory Name&quot;,				bcGeneric.GetFieldValue(&quot;Accessory Type&quot;));
		psAttributes.SetProperty(&quot;Accessory Price Exc GST&quot;,		&quot;$0.00&quot;);
		psAttributes.SetProperty(&quot;Accessory Price Inc GST&quot;,		&quot;$0.00&quot;);
		psAttributes.SetProperty(&quot;Accessory RCC Exc GST&quot;,		&quot;$0.00&quot;);
		psAttributes.SetProperty(&quot;Accessory RCC Inc GST&quot;,		&quot;$0.00&quot;);
		psAttributes.SetProperty(&quot;Accessory Qty&quot;,		        &quot;1&quot;);	
		sSetType = &quot;OrderItemXa&quot;;
	}
	//Chitra added for APP attributes - 16.3 - 21-04-2016
	else if (sType == &quot;APPAccessory&quot;)
	{
		psAttributes.SetProperty(&quot;Accessory Code&quot;,				bcGeneric.GetFieldValue(&quot;Hardware Code&quot;));
		psAttributes.SetProperty(&quot;Accessory Name&quot;,				bcGeneric.GetFieldValue(&quot;VHA Hardware Name&quot;));
		psAttributes.SetProperty(&quot;Accessory RRP Exc GST&quot;,		bcGeneric.GetFieldValue(&quot;VHA RRP Exc GST&quot;));
		psAttributes.SetProperty(&quot;Accessory RRP Inc GST&quot;,		bcGeneric.GetFieldValue(&quot;VHA RRP inc GST&quot;));
		psAttributes.SetProperty(&quot;Related Order Number&quot;,		bcGeneric.GetFieldValue(&quot;Order Number&quot;));
		psAttributes.SetProperty(&quot;Related Service Order Id&quot;,	bcGeneric.GetFieldValue(&quot;Related Service Order Id&quot;));
		psAttributes.SetProperty(&quot;Category&quot;,			    	bcGeneric.GetFieldValue(&quot;VHA Category&quot;));
		sSetType = &quot;OrderItemXa&quot;;
	}
	
	var propName = psAttributes.GetFirstProperty();   
	while (propName != &quot;&quot;) 
	{
		var psAtrb		= TheApplication().NewPropertySet();		
		var propVal 	= psAttributes.GetProperty(propName); 		
		
		var psLineItemAttr = TheApplication().NewPropertySet();		
		psLineItemAttr.SetType(sSetType);
		psLineItemAttr.SetProperty(&quot;Name&quot;,propName);
		psLineItemAttr.SetProperty(&quot;Value&quot;,propVal);
		psLineItemAttr.SetProperty(&quot;Action Code&quot;,&quot;Add&quot;);
		psListOfLineItemAttr.AddChild(psLineItemAttr);
		
		propName = psAttributes.GetNextProperty();		
	}		
	
}
catch(e)
{
	if (defined(e.errText))
	{
		var strError = e.errText + &quot;\r&quot; + e.toString(); 
	}
	else
	{
		var strError = e.toString(); 
	}
	throw (strError);
}
finally
{

psAttributes = null;
psAtrb = null;
psLineItemAttr = null;

}	
}"
