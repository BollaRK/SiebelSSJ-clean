			<APPLET_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="ReuseFlgValue"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="function ReuseFlgValue(ReuseOrderLine)
{
	try
	{
		var sReuseOrder = &quot;&quot;;
		var sReuseFlg = &quot;&quot;;
		var sFBBOnly = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_FBB_PROPOSITION_TYPE&quot;,&quot;FBB Only&quot;)
		var sFBBWithMBB = TheApplication().InvokeMethod(&quot;LookupValue&quot;,&quot;VHA_FBB_PROPOSITION_TYPE&quot;,&quot;FBB with MBB&quot;)
		var bcParent=this.BusComp().ParentBusComp();
		if(bcParent!=&quot;&quot;)
		{
			if(bcParent.Name()==&quot;Order Entry - Orders&quot;)
			{
				bcParent.ActivateField(&quot;Id&quot;);
				sReuseOrder = bcParent.GetFieldValue(&quot;Id&quot;);
			}
		}
			var sBO = TheApplication().GetBusObject(&quot;Order Item&quot;);
			var sBC = sBO.GetBusComp(&quot;Order Entry - Line Items (Simple)&quot;);
			var psErrorInput, psErrorOutput, sErrorMessage, bsError;
			var sSearchspec = &quot;[Order Header Id] = &apos;&quot; + sReuseOrder + &quot;&apos; AND [Root Order Item Id] = [Id] AND [Action Code] &lt;&gt; &apos;Delete&apos; AND ([VF Siebel Product Type] = &apos;&quot; + sFBBOnly + &quot;&apos; OR [VF Siebel Product Type] = &apos;&quot; + sFBBWithMBB + &quot;&apos;)&quot;;
			with (sBC)
			{
						SetViewMode(AllView);
						ClearToQuery();
						ActivateField(&quot;Order Header Id&quot;);
						ActivateField(&quot;Root Order Item Id&quot;);
						ActivateField(&quot;VF Reuse Modem Flg&quot;);
						ActivateField(&quot;VF Siebel Product Type&quot;);
						ActivateField(&quot;Id&quot;);
						SetSearchExpr(sSearchspec);
						ExecuteQuery(ForwardOnly);
						if(FirstRecord())
						{
							sReuseFlg = GetFieldValue(&quot;VF Reuse Modem Flg&quot;);
						}	
			}
			return sReuseFlg;
	}
	catch (e) 
	{	
		if(!defined(e.errText))
		{
	        sErrorMessage = e.toString();
	    }
	    else
	    {
	    	sErrorMessage = e.errText;
	    }
	    
		psErrorInput  = TheApplication().NewPropertySet();
		psErrorOutput = TheApplication().NewPropertySet();
		bsError = TheApplication().GetService(&quot;VF Error Handling Service&quot;);
		psErrorInput.SetProperty(&quot;SourceName&quot;,&quot;PreInvoke&quot;);
		psErrorInput.SetProperty(&quot;FunctionName&quot;,&quot;ReuseFlgValue&quot;);
		psErrorInput.SetProperty(&quot;Error Msg&quot;, sErrorMessage); 
		bsError.InvokeMethod(&quot;HandleException&quot;,psErrorInput,psErrorOutput);
		sErrorMessage = psErrorOutput.GetProperty(&quot;ErrorMessage&quot;);
	}
	finally
	{
		
		sBC = null;
		sBO = null;
		psErrorInput = null;
		psErrorOutput = null;
	}
}"
			   SEQUENCE="3"
