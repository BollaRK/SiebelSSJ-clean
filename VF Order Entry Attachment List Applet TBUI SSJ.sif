			<APPLET_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mCreditCheckStatus"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Component Name			: VF Connect Wizard - Order Entry Attachment Form Applet
 * Method Name           	: mCreditCheckStatus
 * Component Information 	: Logic to check credit check status
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 4/07/2011 	HR						Added for Project Merlin
 * 18/08/2011	EW						Fixed Acceptance 7372
 */

function mCreditCheckStatus()
{	

	try
	{
		var boWizard = TheApplication().ActiveBusObject();
		var bcComFinProfile= boWizard.GetBusComp(&quot;VF Com Financial Profile&quot;);
		TheApplication().SetProfileAttr(&quot;AppConLiveConValidation&quot;,&quot;false&quot;);	
		with (bcComFinProfile)
		{
			var dtCCExpiryDate = new Date(GetFieldValue(&quot;VF Credit Check Expiry Date&quot;));
			var strCCExpiryDateToSys = 	dtCCExpiryDate.toSystem(); 
			var strCredtCheckStatus = GetFieldValue(&quot;VF Credit Check Status&quot;);
			var bConditionsAcceptedFlag = GetFieldValue(&quot;VF Conditional Approval Accepted&quot;);
			var strCurrentSysDate = Clib.time();
			var strCondAccepted = GetFieldValue(&quot;VF Conditional Approval Accepted&quot;);
			var LiveConnections = ToNumber(GetFieldValue(&quot;VF Live Connections&quot;));
			var ApprovedConnections = ToNumber(GetFieldValue(&quot;VF Approved Connections&quot;));
		//	var HandsetQty = ToNumber(GetFieldValue(&quot;VF Intended Handset Quantity&quot;)); // commented as this field is inactive at bc level-TBUI
			var strOverrideCode = GetFieldValue(&quot;VF Override Code&quot;);
							
			if (strCredtCheckStatus == &quot;APPROVE&quot; || strCredtCheckStatus == &quot;APPROVED&quot; || (strCredtCheckStatus == &quot;CONDAPPRVE&quot; &amp;&amp; strOverrideCode == &quot;APPROVE&quot;))
			{
				if (ApprovedConnections &lt;= LiveConnections)	//R12.3,TD 9784,VIJAYE,Included the validation while enable or disable the Generate Contract button
					TheApplication().SetProfileAttr(&quot;AppConLiveConValidation&quot;,&quot;true&quot;);							
			return true;
			}
			if (strCredtCheckStatus == &quot;REFER&quot; || strCredtCheckStatus == &quot;REFERRED&quot; || strCredtCheckStatus == &quot;Pending&quot; || (strCredtCheckStatus == &quot;CONDAPPRVE&quot; &amp;&amp; strOverrideCode != &quot;APPROVE&quot;)
			|| strCredtCheckStatus == &quot;WITHDRAW&quot; || strCredtCheckStatus == &quot;Failed&quot; || strCredtCheckStatus == &quot;DECLINE&quot; || strCredtCheckStatus == &quot;DECLINED&quot;)
			{
			return false;
			}
			
			if (ApprovedConnections &lt;= LiveConnections)
			{
			return false;
			}
			
 		}
	}
	catch (e)
	{
		throw (e);
	}
	finally
	{
		bcComFinProfile = null;
		boWizard = null;  /* This variable is nullified by Sharukh on 22/03/2019*/

	}
}"
			   SEQUENCE="1"
			   UPDATED="01/09/2026 16:01:53"
			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 16:01:53"
			   CREATED_BY="SADMIN">
			</APPLET_SERVER_SCRIPT>
			<APPLET_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="mPendingConAssDFO"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Component Name			: VF Connect Wizard - Order Entry Attachment Form Applet
 * Method Name           	: mPendingConAssDFO
 * Component Information 	: Added logic to look, Is there any pending connections associated to completed fulfilment order,if so return &apos;false&apos;.
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 12/04/2012 	VIJAYE					R12.3	Added for DFFO
 
 */

function mPendingConAssDFO()
{	

	try
	{
		var strConnValidation;
		var bcParent=this.BusComp().ParentBusComp();
		var sCAId,bsCAPendingConCount,psInputs,psOutputs,sConCount=0,strWarningMsg,sLiveCon,sApprCon;
			if(bcParent!=&quot;&quot;)
			{
				if(bcParent.Name()==&quot;Order Entry - Orders&quot;)
				{
					bcParent.ActivateField(&quot;Account Id&quot;);
					sCAId=bcParent.GetFieldValue(&quot;Account Id&quot;);
					bsCAPendingConCount = TheApplication().GetService(&quot;VF CA Pending Connect Count&quot;);
					psInputs = TheApplication().NewPropertySet();
					psOutputs = TheApplication().NewPropertySet();
					psInputs.SetProperty(&quot;CA Id&quot;,sCAId);
					bsCAPendingConCount.InvokeMethod(&quot;CountPendingDFConnections&quot;, psInputs, psOutputs);
					sConCount=psOutputs.GetProperty(&quot;PendingDFConections&quot;);
				}
			}
				strConnValidation = TheApplication().GetProfileAttr(&quot;AppConLiveConValidation&quot;);//R12.3,TD 9782,VIJAYE,Included the validation while enable or disable the Generate Contract button

				if(strConnValidation==&quot;true&quot; &amp;&amp; sConCount&gt;0)
					return false;
				else
					return true;
				
	}
	catch (e)
	{
		throw e;
	}
	finally
	{
		bcParent = null;
		bsCAPendingConCount = null;
		psInputs = null;
		psOutputs = null;
		TheApplication().SetProfileAttr(&quot;AppConLiveConValidation&quot;,&quot;false&quot;);	
	}
}"
			   SEQUENCE="2"
