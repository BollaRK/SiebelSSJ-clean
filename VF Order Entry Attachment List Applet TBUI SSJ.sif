			<APPLET_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="WebApplet_InvokeMethod"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Component Name        : 	VF Upgrade Wizard - Order Entry Attachment Form Applet
 * Method Name           : 	InvokeMethod
 * Component Information : 	Event Handler
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 11/05/2011	EW						Initial Version
 * 09/09/2011	EW						Updated for 11.D
 */
function WebApplet_InvokeMethod (MethodName)
{
	var boCurrent;
	var bcWizardSession;

	try
	{
		switch (MethodName)
		{			
			case &quot;GenerateContract&quot;:
			
				with (this.BusComp())
				{				
					// Refresh the business component
					ClearToQuery();
					SetSortSpec(&quot;Created (DESC)&quot;);
					ExecuteQuery();
													
					TheApplication().SetProfileAttr(&quot;EnableWizardSubmitOrderButton&quot;,&quot;Y&quot;);
				}
				
				// If on the wizard business component
				boCurrent = this.BusObject();
				if (boCurrent.Name() == &quot;VF Wizard&quot;)
				{
					bcWizardSession = boCurrent.GetBusComp(&quot;VF Wizard Session&quot;);
					
					// Set the flag to prevent users from going back in the wizard after contract
					// generation
					bcWizardSession.SetFieldValue(&quot;Can Navigate Back&quot;, &quot;N&quot;);
					bcWizardSession.WriteRecord();
				}
				break;
		}
	}
	catch (e)
	{
		throw e;
	}
	finally
	{
		bcWizardSession = null;
		boCurrent = null;
	}
}"
			   SEQUENCE="4"
			   UPDATED="01/09/2026 16:01:52"
			   UPDATED_BY="SADMIN"
			   CREATED="01/09/2026 16:01:52"
			   CREATED_BY="SADMIN">
			</APPLET_SERVER_SCRIPT>
			<APPLET_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="WebApplet_PreCanInvokeMethod"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Component Name        : 	VF Upgrade Wizard - Order Entry Attachment Form Applet
 * Method Name           : 	PreCanInvokeMethod
 * Component Information : 	Event Handler
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 11/05/2011	EW						Initial Version
 */
function WebApplet_PreCanInvokeMethod (MethodName, &amp;CanInvoke)
{
	try
	{
		switch (MethodName)
		{
			case &quot;GenerateLetter&quot;:
				CanInvoke = &quot;TRUE&quot;;
				return (CancelOperation);	
				break;	
			
			
			// HR: 14/07/2011 Added Code for Merlin			
			case &quot;GenerateContract&quot;:
			
			//KS: 3/20/2026 :SSJ Fullfillment
			var sProdAcc = &quot;N&quot;,lineRec = &quot;&quot;;
			var strReuseFlg = &quot;&quot;;//03/02/2025 Sakthi Added for reuse modem defect 2521
			var sOrderFunction = TheApplication().GetProfileAttr(&quot;sCOrderFunction&quot;);
			var sOrderSubType = TheApplication().GetProfileAttr(&quot;sCOrderSubType&quot;);
			var quoteId = TheApplication().GetProfileAttr(&quot;QuoteId&quot;);
			var bcOrderItem = TheApplication().GetBusObject(&quot;VHA SSJ Generic No Link BO&quot;).GetBusComp(&quot;Order Entry - Line Items (Simple)&quot;);
            with (bcOrderItem) 
			{
                SetViewMode(AllView);
                ClearToQuery();
                ActivateField(&quot;Product Type&quot;);
                ActivateField(&quot;Order Quote Id&quot;);
				ActivateField(&quot;Action Code&quot;);
				//ActivateField(&quot;Id&quot;);
				//var AccId = GetFieldValue(&quot;Id&quot;);
				//var product = GetFieldValue(&quot;Product&quot;);
				//var Actioncd = GetFieldValue(&quot;Action Code&quot;);
                SetSearchExpr(&quot;[Order Quote Id] = &apos;&quot; + quoteId + &quot;&apos; AND [Action Code] = &apos;Add&apos; AND ([Product Type] = &apos;Accessory&apos; OR [Product Type] = &apos;Billing - APP&apos;)&quot;);//MANOHARG:01062026:Modified code as per defect - CM-11725			
                ExecuteQuery(ForwardOnly);
                lineRec = FirstRecord();
                if(lineRec)  
				{
					sProdAcc =&quot;Y&quot;;
				}
				
			}
			//Roseline:16/06/2017 - Added below condition to disable the contract button for the maange service flow
			if((sOrderSubType == &quot;Connect&quot;) || (TheApplication().GetProfileAttr(&quot;ActiveViewName&quot;)== &quot;VHA Manage Services Order Summary View&quot;) || (TheApplication().GetProfileAttr(&quot;ActiveViewName&quot;)== &quot;VF New Connect MSO Order Summary View TBUI SSJ - eSIM Details&quot; &amp;&amp; sOrderFunction == &quot;&quot; &amp;&amp; sProdAcc ==&quot;Y&quot; &amp;&amp; (sOrderSubType == &quot;Change Proposition&quot; || sOrderSubType == &quot;Modify&quot;))) //OR condition added MM:CM-9365
			{		
				CanInvoke = &quot;TRUE&quot;;
				TheApplication().SetProfileAttr(&quot;GenerateContractMsg&quot;,&quot;Y&quot;);
				return (CancelOperation);		
			}
			
			//if(mCreditCheckStatus()&amp;&amp; mPendingConAssDFO())//R12.3,DFFO,VIJAYE,Added the condition mPendingConAssDFO for TD 11416
			if(mCreditCheckStatus() &amp;&amp; mPendingConAssDFO())
			{
				strReuseFlg = ReuseFlgValue();
				if(strReuseFlg == &quot;Y&quot;)//03/02/2025 Sakthi Added for reuse modem defect 2521	
				{
					CanInvoke = &quot;FALSE&quot;;
					TheApplication().SetProfileAttr(&quot;GenerateContractMsg&quot;,&quot;N&quot;);
					return (CancelOperation);
				}
				else
				{
					if(TheApplication().GetProfileAttr(&quot;ActiveViewName&quot;) == &quot;VF New Connect MSO Order Summary View TBUI SSJ - eSIM Details&quot; &amp;&amp; sOrderFunction == &quot;&quot; &amp;&amp; (sOrderSubType == &quot;Change Proposition&quot; || sOrderSubType == &quot;Modify&quot;) &amp;&amp; sProdAcc ==&quot;N&quot;)
					{
					CanInvoke = &quot;FALSE&quot;;
					TheApplication().SetProfileAttr(&quot;GenerateContractMsg&quot;,&quot;N&quot;);
					return (CancelOperation);
					}
					else
					{				
					CanInvoke = &quot;TRUE&quot;;
					TheApplication().SetProfileAttr(&quot;GenerateContractMsg&quot;,&quot;Y&quot;);
					return (CancelOperation);
					}
				}		
			}
			else
			{
				CanInvoke = &quot;FALSE&quot;;
				TheApplication().SetProfileAttr(&quot;GenerateContractMsg&quot;,&quot;N&quot;);
				return (CancelOperation);
			}
			break;		
				
			//27/05/2015 Tabrez June BFX PKE000000020703  /PKE000000018063			
			case &quot;DeleteRecord&quot;:
			
			this.BusComp().ActivateField(&quot;VF Order Status&quot;);
			var strStatus = this.BusComp().GetFieldValue(&quot;VF Order Status&quot;);
			
			if(strStatus == &quot;Submitted&quot;)
			{
				CanInvoke = &quot;FALSE&quot;;
				return (CancelOperation);
			}
			else
			{
				CanInvoke = &quot;TRUE&quot;;
				return (CancelOperation);
			}
			break;
				
			case &quot;SendEmail&quot;: //JS 24042020 added for NSA Email
			var sFileName = this.BusComp().GetFieldValue(&quot;VF Line Item Id&quot;);
			var sUserTypeCheck = TheApplication().InvokeMethod(&quot;LookupValue&quot;, &quot;VF_CR_ENABLE_FLAG&quot;, &quot;NSASendEmail&quot; + TheApplication().GetProfileAttr(&quot;VHA User Type&quot;));
			if (sFileName.indexOf(&quot;TNC.pdf&quot;) &gt;= 1 &amp;&amp; sUserTypeCheck == &quot;Y&quot;)
			{
				CanInvoke = &quot;TRUE&quot;;
				return (CancelOperation);
			}
			else
			{
				CanInvoke = &quot;FALSE&quot;;
				return (CancelOperation);
			}
			break;		

			default:
				return (ContinueOperation);			
		}
	}
	catch (e)
	{
		throw e;
	}
	finally
	{
		bcOrderItem = null;
	}
}"
			   SEQUENCE="5"
			   UPDATED="06/12/2026 16:11:46"
			   UPDATED_BY="KRISHNAS"
			   CREATED="01/09/2026 16:01:52"
			   CREATED_BY="SADMIN">
			</APPLET_SERVER_SCRIPT>
			<APPLET_SERVER_SCRIPT
			   INACTIVE="N"
			   NAME="WebApplet_PreInvokeMethod"
			   PROGRAM_LANGUAGE="JS"
			   SCRIPT="/*
 * Component Name        : 	VF Upgrade Wizard - Order Entry Attachment Form Applet
 * Method Name           : 	PreInvokeMethod
 * Component Information : 	Event Handler
 *
 * Modification History  :
 * Date			Author		Config #	Description
 * ============ ===========	===========	================================
 * 11/05/2011	EW						Initial Version
 */
function WebApplet_PreInvokeMethod (MethodName)
{
	try
	{
		switch (MethodName)
		{			
			case &quot;Drilldown&quot;:
			
				with (this.BusComp())
				{				
					// Refresh the business component
					
					//Subramanian 17SEP2014: Commented as only the first record is getting saved.
					/*ClearToQuery();
					ActivateField(&quot;OrderComments&quot;);
					SetSortSpec(&quot;Created (DESC)&quot;);
					ExecuteQuery();
					*/
				
					/*if (FirstRecord())
					{*/
						// Update the comments to indicate that the user has opened
						if (GetFieldValue(&quot;OrderComments&quot;) == &quot;&quot;)
						{
							SetFieldValue(&quot;OrderComments&quot;, TheApplication().LoginName() + &quot; - Attachment opened&quot;);
							WriteRecord();
						}
					//}
				}
				break;
			case &quot;DeleteRecord&quot;:
				var sView = TheApplication().ActiveViewName();
				if(sView == &quot;VF New Connect MSO Order Summary View TBUI Prepayment&quot; || sView == &quot;VF New Connect MSO Order Summary View TBUI&quot; || sView == &quot;VF New Connect MSO Order Summary View TBUI - eSIM Details&quot;)
				{
					with(this.BusComp())
					{
						var IsRec = FirstRecord();
						while(IsRec)
						{
							DeleteRecord();
							IsRec = FirstRecord();
						}
					}
				return CancelOperation;
				}
			break;
		}
	}
	catch (e)
	{
		throw e;
	}
	finally
	{

	}
}"
